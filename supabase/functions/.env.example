# Secrets das edge functions do Supabase. Nunca versione o `.env` real.
# Produção: supabase secrets set --env-file supabase/functions/.env
# Local:    supabase functions serve --env-file supabase/functions/.env
# Referência completa: docs/CONFIGURACAO_AMBIENTE.md
#
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são injetadas pelo
# próprio Supabase (produção e `functions serve`). Não as coloque neste arquivo:
# o CLI ignora nomes iniciados em SUPABASE_.

# CORS: origens permitidas separadas por vírgula (ex.: https://app.exemplo.com).
# localhost:8080 e localhost:8081 são sempre aceitos (inclusive em produção).
# Em `create-user`, se esta variável estiver vazia a resposta usa origem aberta (*):
# defina-a em produção.
ALLOWED_ORIGINS=
# Quando definida, desativa o fallback de CORS para localhost (use em produção).
FUNCTIONS_REGION=

# Stripe (billing-webhook, stripe-webhook, create-checkout, customer-portal, ...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook do Stripe dedicado à assinatura de números de telefone (webhook-phone-subscription)
STRIPE_PHONE_WEBHOOK_SECRET=

# WhatsApp Cloud API da Meta (enviar-whatsapp, send-whatsapp-batch)
WHATSAPP_ACCESS_TOKEN=

# Consulta de CPF no Serpro (consulta-cpf-serpro)
SERPRO_CLIENT_ID=
SERPRO_CLIENT_SECRET=
SERPRO_AUTHORIZED_CPF=

# Gateway de IA da Lovable (ai-route-whatsapp). Dependência externa que ainda está em uso.
LOVABLE_API_KEY=
