# Frontend (Vite). Copie para `.env` e preencha. Nunca versione o `.env`.
# Estas variáveis vão para o navegador: use somente a chave PÚBLICA (anon/publishable).
# Referência completa: docs/CONFIGURACAO_AMBIENTE.md

# URL do projeto Supabase (ex.: https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Chave pública (anon / publishable) do projeto Supabase
VITE_SUPABASE_PUBLISHABLE_KEY=
