import React, { useState, useEffect } from "react";
import { MainLayout } from "@/components/layout/MainLayout";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Textarea } from "@/components/ui/textarea";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import {
  Search,
  Send,
  MessageSquare,
  FileText,
  Clock,
  CheckCircle2,
  ExternalLink,
  ShieldAlert,
  Users,
} from "lucide-react";
import { useToast } from "@/hooks/use-toast";
import { useLayoutTitle } from "@/hooks/useLayoutTitle";
import {
  ResizableHandle,
  ResizablePanel,
  ResizablePanelGroup,
} from "@/components/ui/resizable";
import { cn } from "@/lib/utils";
import { useIsMobile } from "@/hooks/use-mobile";

interface Contact {
  id: string;
  name: string;
  phone: string;
  tags: string[];
  lastContact?: string;
  notes?: string;
}

interface Message {
  id: string;
  contactId: string;
  text: string;
  template: string;
  channel: "whatsapp" | "email";
  sentAt: string;
  sentBy: string;
  status: "sent" | "error";
}

const TEMPLATES = {
  "confirmation-d2": {
    name: "Confirmação D-2",
    text: "Olá {{nome}} 👋. Sua {{servico}} é {{data}} às {{hora}}. Confirmar: {{link_confirmar}} • Reagendar: {{link_reagendar}}",
  },
  "reminder-h3": {
    name: "Lembrete H-3h",
    text: "Lembrete: hoje às {{hora}}, {{servico}}. Confirmar: {{link_confirmar}} • Reagendar: {{link_reagendar}}",
  },
  "slot-available": {
    name: "Vaga liberada",
    text: "Vaga liberada hoje às {{hora}}. Pegar agora: {{link_agendar}} (ordem de chegada)",
  },
  budget: {
    name: "Orçamento",
    text: "Olá {{nome}}! Posso te enviar um orçamento para {{servico}}? Agende aqui: {{link_agendar}}",
  },
};

const MOCK_CONTACTS: Contact[] = [
  {
    id: "1",
    name: "Maria Silva",
    phone: "+55 11 99999-8888",
    tags: ["Novo lead"],
    lastContact: "2025-01-15T10:30:00",
    notes: "Prefere terças de manhã",
  },
  {
    id: "2",
    name: "João Santos",
    phone: "+55 11 98888-7777",
    tags: ["Retorno", "Confirmação pendente"],
    lastContact: "2025-01-14T15:20:00",
  },
  {
    id: "3",
    name: "Ana Costa",
    phone: "+55 11 97777-6666",
    tags: ["Orçamento"],
    lastContact: "2025-01-13T09:15:00",
  },
];

// Sub-components for cleaner fragmentation
const ContactsPane = ({ 
  searchQuery, 
  setSearchQuery, 
  filteredContacts, 
  selectedContact, 
  setSelectedContact 
}: any) => (
  <Card className="h-full flex flex-col p-0 border border-border/60 bg-card/50 backdrop-blur-sm rounded-[2px] shadow-medical overflow-hidden animate-in slide-in-from-left duration-500">
    <div className="p-4 border-b border-border/40 bg-muted/30">
      <div className="flex items-center justify-between mb-4">
        <h3 className="font-bold text-sm tracking-tight flex items-center gap-2">
          <Users className="h-4 w-4 text-primary" />
          CONTATOS
        </h3>
        <Badge variant="outline" className="rounded-[2px] font-mono text-[10px]">
          {filteredContacts.length} ATIVOS
        </Badge>
      </div>
      <div className="relative">
        <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
        <Input
          placeholder="Buscar pacientes..."
          className="pl-9 bg-background/50 border-border/40 focus:border-primary/50 rounded-[2px] h-9 text-sm"
          value={searchQuery}
          onChange={(e) => setSearchQuery(e.target.value)}
        />
      </div>
    </div>

    <div className="flex-1 overflow-y-auto p-2 scrollbar-thin scrollbar-thumb-border">
      <div className="space-y-1">
        {filteredContacts.map((contact: any, index: number) => (
          <div
            key={contact.id}
            onClick={() => setSelectedContact(contact)}
            style={{ animationDelay: `${index * 50}ms` }}
            className={cn(
              "group relative p-3 rounded-[2px] cursor-pointer transition-all duration-200 border animate-in fade-in slide-in-from-left-4",
              selectedContact?.id === contact.id
                ? "bg-primary/5 border-primary/40 shadow-sm"
                : "bg-transparent border-transparent hover:bg-muted/50 hover:border-border/30"
            )}
          >
            {selectedContact?.id === contact.id && (
              <div className="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-8 bg-primary rounded-r-full" />
            )}
            <div className="flex justify-between items-start mb-1">
              <span className={cn(
                "font-semibold text-sm transition-colors",
                selectedContact?.id === contact.id ? "text-primary" : "text-foreground"
              )}>
                {contact.name}
              </span>
              <span className="text-[10px] text-muted-foreground font-mono">
                {contact.phone.split(' ').pop()}
              </span>
            </div>
            <div className="flex flex-wrap gap-1">
              {contact.tags.map((tag: string) => (
                <Badge
                  key={tag}
                  variant="secondary"
                  className="px-1.5 py-0 rounded-[2px] text-[9px] bg-muted/60 text-muted-foreground border-none font-medium uppercase tracking-wider"
                >
                  {tag}
                </Badge>
              ))}
            </div>
          </div>
        ))}
        {filteredContacts.length === 0 && (
          <div className="py-12 text-center">
            <p className="text-xs text-muted-foreground">Nenhum contato encontrado</p>
          </div>
        )}
      </div>
    </div>
  </Card>
);

const ComposerPane = ({ 
  selectedContact, 
  selectedTemplate, 
  handleTemplateSelect, 
  messageText, 
  setMessageText, 
  handleSendWhatsApp,
  messageHistory,
  contactNotes,
  setContactNotes
}: any) => (
  <Card className="h-full border border-border/60 bg-card/50 backdrop-blur-sm rounded-[2px] shadow-medical overflow-hidden animate-in slide-in-from-right duration-500">
    {selectedContact ? (
      <Tabs defaultValue="compose" className="h-full flex flex-col">
        <div className="p-2 bg-muted/30 border-b border-border/40">
          <TabsList className="grid w-full grid-cols-3 bg-transparent p-0 gap-1">
            <TabsTrigger 
              value="compose" 
              className="rounded-[2px] data-[state=active]:bg-background data-[state=active]:shadow-sm text-xs font-bold tracking-tight h-8"
            >
              <Send className="h-3 w-3 mr-2" />
              ENVIAR
            </TabsTrigger>
            <TabsTrigger 
              value="history"
              className="rounded-[2px] data-[state=active]:bg-background data-[state=active]:shadow-sm text-xs font-bold tracking-tight h-8"
            >
              <Clock className="h-3 w-3 mr-2" />
              HISTÓRICO
            </TabsTrigger>
            <TabsTrigger 
              value="notes"
              className="rounded-[2px] data-[state=active]:bg-background data-[state=active]:shadow-sm text-xs font-bold tracking-tight h-8"
            >
              <FileText className="h-3 w-3 mr-2" />
              SESSÃO
            </TabsTrigger>
          </TabsList>
        </div>

        <div className="flex-1 overflow-y-auto">
          <TabsContent value="compose" className="m-0 p-6 space-y-6">
            <div className="flex items-center justify-between p-4 bg-primary/5 border border-primary/20 rounded-[2px] group">
              <div>
                <h3 className="text-sm font-bold text-foreground">
                  {selectedContact.name}
                </h3>
                <p className="text-xs text-muted-foreground font-mono mt-0.5">
                  {selectedContact.phone}
                </p>
              </div>
              <div className="h-10 w-10 flex items-center justify-center bg-primary/10 rounded-[2px] text-primary group-hover:rotate-12 transition-transform">
                <MessageSquare className="h-5 w-5" />
              </div>
            </div>

            <div className="space-y-4">
              <div className="space-y-2">
                <label className="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                  Templates Rápidos
                </label>
                <Select
                  value={selectedTemplate}
                  onValueChange={handleTemplateSelect}
                >
                  <SelectTrigger className="rounded-[2px] border-border/40 bg-background/50 h-10">
                    <SelectValue placeholder="Selecione um protocolo de envio" />
                  </SelectTrigger>
                  <SelectContent className="rounded-[2px]">
                    {Object.entries(TEMPLATES).map(([key, template]) => (
                      <SelectItem key={key} value={key} className="text-sm rounded-[2px]">
                        {template.name}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>

              <div className="space-y-2">
                <div className="flex items-center justify-between">
                  <label className="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                    Corpo da Mensagem
                  </label>
                  <span className="text-[10px] font-mono text-muted-foreground bg-muted px-1.5 py-0.5 rounded-[2px]">
                    {messageText.length} CHR
                  </span>
                </div>
                <Textarea
                  placeholder="Componha sua mensagem clínica..."
                  value={messageText}
                  onChange={(e) => setMessageText(e.target.value)}
                  rows={6}
                  className="resize-none rounded-[2px] border-border/40 bg-background/50 focus-visible:ring-1 focus-visible:ring-primary/30 p-4 text-sm leading-relaxed"
                />
                
                <div className="p-3 bg-muted/50 rounded-[2px] border border-border/40">
                  <p className="text-[9px] font-bold text-muted-foreground uppercase mb-2 tracking-widest">
                    Placeholders Dinâmicos
                  </p>
                  <div className="flex flex-wrap gap-1.5">
                    {["nome", "data", "hora", "servico", "link_confirmar"].map(tag => (
                      <code key={tag} className="text-[10px] bg-background px-2 py-0.5 border border-border/40 rounded-[2px] font-mono">
                        {"{{"}{tag}{"}}"}
                      </code>
                    ))}
                  </div>
                </div>
              </div>

              <Button
                onClick={handleSendWhatsApp}
                disabled={!messageText}
                className="w-full h-12 bg-success hover:bg-success/90 text-success-foreground rounded-[2px] font-bold uppercase tracking-wider shadow-sm transition-all hover:scale-[1.01] active:scale-[0.99]"
              >
                <ExternalLink className="h-4 w-4 mr-2" />
                Disparar WhatsApp Business
              </Button>
            </div>
          </TabsContent>

          <TabsContent value="history" className="m-0 p-6 space-y-4">
            <h3 className="text-xs font-bold uppercase tracking-widest text-muted-foreground mb-4">
              Registro de Comunicações
            </h3>
            {messageHistory.length === 0 ? (
              <div className="flex flex-col items-center justify-center py-12 text-center border-2 border-dashed border-border/40 rounded-[2px]">
                <Clock className="h-10 w-10 text-muted-foreground/30 mb-2" />
                <p className="text-xs text-muted-foreground italic">
                  Nenhum registro de disparo identificado para este contato.
                </p>
              </div>
            ) : (
              <div className="space-y-3">
                {messageHistory.map((msg: any) => (
                  <div
                    key={msg.id}
                    className="p-4 bg-muted/40 border border-border/30 rounded-[2px] space-y-3"
                  >
                    <div className="flex items-center justify-between">
                      <Badge variant="outline" className="rounded-[2px] text-[10px] font-mono">
                        {msg.template}
                      </Badge>
                      <Badge
                        variant={msg.status === "sent" ? "default" : "destructive"}
                        className="rounded-[2px] text-[10px] h-5"
                      >
                        {msg.status === "sent" ? (
                          <CheckCircle2 className="h-3 w-3 mr-1" />
                        ) : null}
                        {msg.status === "sent" ? "SUCESSO" : "ERRO"}
                      </Badge>
                    </div>
                    <p className="text-sm leading-relaxed text-foreground/80 font-medium">
                      "{msg.text}"
                    </p>
                    <div className="flex items-center justify-between pt-2 border-t border-border/20 text-[10px] text-muted-foreground font-mono uppercase">
                      <span>{msg.sentAt}</span>
                      <span>POR: {msg.sentBy}</span>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </TabsContent>

          <TabsContent value="notes" className="m-0 p-6 space-y-4">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-xs font-bold uppercase tracking-widest text-muted-foreground">
                Dossiê do Paciente (Notas Internas)
              </h3>
            </div>
            <Textarea
              placeholder="Descreva detalhes específicos de comunicação ou preferências do paciente..."
              value={contactNotes || selectedContact.notes || ""}
              onChange={(e) => setContactNotes(e.target.value)}
              rows={10}
              className="resize-none rounded-[2px] border-border/40 bg-background/50 focus-visible:ring-1 focus-visible:ring-primary/30 p-4 text-sm leading-relaxed"
            />
            <Button className="w-full bg-primary/10 hover:bg-primary/20 text-primary border border-primary/20 rounded-[2px] font-bold uppercase tracking-widest text-xs h-10">
              Atualizar Dossiê
            </Button>
          </TabsContent>
        </div>
      </Tabs>
    ) : (
      <div className="h-full flex flex-col items-center justify-center p-12 text-center bg-muted/10">
        <div className="relative mb-6">
          <div className="absolute inset-0 bg-primary/20 blur-3xl rounded-full" />
          <div className="relative h-24 w-24 flex items-center justify-center bg-card border border-primary/20 rounded-[2px] text-primary shadow-medical animate-pulse">
            <Users className="h-10 w-10" />
          </div>
        </div>
        <h3 className="text-lg font-bold text-foreground mb-2">
          Protocolo de Atendimento
        </h3>
        <p className="text-sm text-muted-foreground max-w-[280px]">
          Selecione um paciente na lista à esquerda para carregar o canal de comunicação direto.
        </p>
      </div>
    )}
  </Card>
);

const FlowChat = () => {
  const { toast } = useToast();
  const { setTitle, setSubtitle } = useLayoutTitle();
  const isMobile = useIsMobile();
  
  const [contacts] = useState<Contact[]>(MOCK_CONTACTS);
  const [selectedContact, setSelectedContact] = useState<Contact | null>(null);
  const [searchQuery, setSearchQuery] = useState("");
  const [messageText, setMessageText] = useState("");
  const [selectedTemplate, setSelectedTemplate] = useState("");
  const [messageHistory] = useState<Message[]>([]);
  const [contactNotes, setContactNotes] = useState("");

  useEffect(() => {
    setTitle("FlowChat");
    setSubtitle("Comunicação direta via WhatsApp");
  }, [setTitle, setSubtitle]);

  const filteredContacts = contacts.filter(
    (contact) =>
      contact.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
      contact.phone.includes(searchQuery),
  );

  const handleTemplateSelect = (templateKey: string) => {
    setSelectedTemplate(templateKey);
    setMessageText(TEMPLATES[templateKey as keyof typeof TEMPLATES].text);
  };

  const handleSendWhatsApp = () => {
    if (!selectedContact) return;

    const encodedMessage = encodeURIComponent(messageText);
    const whatsappLink = `https://wa.me/${selectedContact.phone.replace(/\D/g, "")}?text=${encodedMessage}`;

    window.open(whatsappLink, "_blank");

    toast({
      title: "WhatsApp aberto",
      description: "Mensagem carregada. Complete o envio no WhatsApp.",
    });

    setMessageText("");
    setSelectedTemplate("");
  };

  return (
    <MainLayout>
      <div className="h-[calc(100vh-12rem)] flex flex-col gap-6 animate-in fade-in duration-700">
        {/* Warning Banner - Premium Redesign */}
        <div className="relative overflow-hidden rounded-[2px] border border-warning/20 bg-warning/5 p-4 shadow-sm group">
          <div className="absolute top-0 left-0 w-1 h-full bg-warning" />
          <div className="flex items-start gap-3">
            <div className="p-2 rounded-[2px] bg-warning/10 text-warning group-hover:scale-110 transition-transform">
              <ShieldAlert className="h-5 w-5" />
            </div>
            <div>
              <h4 className="font-semibold text-foreground text-sm flex items-center gap-2">
                Protocolo de Segurança Ativo
              </h4>
              <p className="text-xs text-muted-foreground leading-relaxed mt-1">
                O FlowChat utiliza o link oficial do WhatsApp Business. 
                As interações e respostas do cliente ocorrem fora da plataforma CleanFlow 
                e não são capturadas pelo sistema para garantir a privacidade total.
              </p>
            </div>
          </div>
        </div>

        {isMobile ? (
          <div className="flex flex-col gap-6">
            <ContactsPane 
              searchQuery={searchQuery} 
              setSearchQuery={setSearchQuery} 
              filteredContacts={filteredContacts}
              selectedContact={selectedContact}
              setSelectedContact={setSelectedContact}
            />
            <ComposerPane 
              selectedContact={selectedContact}
              selectedTemplate={selectedTemplate}
              handleTemplateSelect={handleTemplateSelect}
              messageText={messageText}
              setMessageText={setMessageText}
              handleSendWhatsApp={handleSendWhatsApp}
              messageHistory={messageHistory}
              contactNotes={contactNotes}
              setContactNotes={setContactNotes}
            />
          </div>
        ) : (
          <ResizablePanelGroup direction="horizontal" className="flex-1 gap-6 items-stretch">
            <ResizablePanel defaultSize={30} minSize={25} className="bg-transparent">
              <ContactsPane 
                searchQuery={searchQuery} 
                setSearchQuery={setSearchQuery} 
                filteredContacts={filteredContacts}
                selectedContact={selectedContact}
                setSelectedContact={setSelectedContact}
              />
            </ResizablePanel>

            <ResizableHandle className="w-1 bg-transparent hover:bg-primary/10 transition-colors" />

            <ResizablePanel defaultSize={70}>
              <ComposerPane 
                selectedContact={selectedContact}
                selectedTemplate={selectedTemplate}
                handleTemplateSelect={handleTemplateSelect}
                messageText={messageText}
                setMessageText={setMessageText}
                handleSendWhatsApp={handleSendWhatsApp}
                messageHistory={messageHistory}
                contactNotes={contactNotes}
                setContactNotes={setContactNotes}
              />
            </ResizablePanel>
          </ResizablePanelGroup>
        )}
      </div>
    </MainLayout>
  );
};

export default FlowChat;
