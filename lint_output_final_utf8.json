, setIsLoading] = useState(true);\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [editingId, setEditingId] = useState<string | null>(null);\n  const { toast } = useToast();\n\n  const fetchProcedimentos = async () => {\n    try {\n      setIsLoading(true);\n      const { data, error } = await supabase\n        .from(\"procedimentos\")\n        .select(\"*\")\n        .order(\"nome\");\n\n      if (error) throw error;\n      setProcedimentos(data || []);\n    } catch (error) {\n      console.error(\"Erro ao buscar procedimentos:\", error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os procedimentos.\",\n        variant: \"destructive\",\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchProcedimentos();\n  }, []);\n\n  const toggleStatus = async (id: string, currentStatus: boolean) => {\n    try {\n      const { error } = await supabase\n        .from(\"procedimentos\")\n        .update({ ativo: !currentStatus })\n        .eq(\"id\", id);\n\n      if (error) throw error;\n\n      setProcedimentos((prev) =>\n        prev.map((proc) =>\n          proc.id === id ? { ...proc, ativo: !currentStatus } : proc,\n        ),\n      );\n\n      toast({\n        title: \"Status atualizado\",\n        description: `Procedimento ${!currentStatus ? \"ativado\" : \"desativado\"} com sucesso.`,\n      });\n    } catch (error) {\n      console.error(\"Erro ao atualizar status:\", error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel atualizar o status.\",\n        variant: \"destructive\",\n      });\n    }\n  };\n\n  const deleteProcedimento = async (id: string) => {\n    if (\n      !confirm(\n        \"Tem certeza que deseja excluir este procedimento? Esta a├º├úo n├úo pode ser desfeita.\",\n      )\n    )\n      return;\n\n    try {\n      const { error } = await supabase\n        .from(\"procedimentos\")\n        .delete()\n        .eq(\"id\", id);\n\n      if (error) throw error;\n\n      setProcedimentos((prev) => prev.filter((proc) => proc.id !== id));\n\n      toast({\n        title: \"Procedimento exclu├¡do\",\n        description: \"O procedimento foi removido com sucesso.\",\n      });\n    } catch (error) {\n      console.error(\"Erro ao excluir procedimento:\", error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel excluir o procedimento.\",\n        variant: \"destructive\",\n      });\n    }\n  };\n\n  const filteredProcedimentos = procedimentos.filter(\n    (proc) =>\n      proc.nome.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      proc.codigo_tuss?.toLowerCase().includes(searchTerm.toLowerCase()),\n  );\n\n  const activeProcedimentos = filteredProcedimentos.filter(\n    (p) => p.ativo,\n  ).length;\n\n  return (\n    <MainLayout>\n      <div className=\"space-y-6 p-6\">\n        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n          <div>\n            <h1 className=\"text-3xl font-bold text-foreground\">\n              Procedimentos\n            </h1>\n            <p className=\"text-muted-foreground\">\n              Gerencie os procedimentos oferecidos\n            </p>\n          </div>\n          <NewProcedimentoDialog onSuccess={fetchProcedimentos}>\n            <Button size=\"lg\">\n              <Settings className=\"mr-2 h-5 w-5\" />\n              Novo Procedimento\n            </Button>\n          </NewProcedimentoDialog>\n        </div>\n\n        <div className=\"flex gap-4\">\n          <div className=\"relative flex-1\">\n            <Search className=\"absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground h-4 w-4\" />\n            <Input\n              placeholder=\"Buscar procedimentos...\"\n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              className=\"pl-10\"\n            />\n          </div>\n        </div>\n\n        <Card className=\"p-6\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-3 rounded-lg bg-primary/10\">\n                <Settings className=\"h-6 w-6 text-primary\" />\n              </div>\n              <div>\n                <p className=\"text-sm text-muted-foreground\">\n                  Procedimentos Ativos\n                </p>\n                <p className=\"text-2xl font-bold\">{activeProcedimentos}</p>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-3 rounded-lg bg-secondary/10\">\n                <CheckCircle2 className=\"h-6 w-6 text-secondary-foreground\" />\n              </div>\n              <div>\n                <p className=\"text-sm text-muted-foreground\">\n                  Total de Procedimentos\n                </p>\n                <p className=\"text-2xl font-bold\">{procedimentos.length}</p>\n              </div>\n            </div>\n          </div>\n        </Card>\n\n        {isLoading ? (\n          <div className=\"flex justify-center items-center py-12\">\n            <Loader2 className=\"h-8 w-8 animate-spin text-primary\" />\n          </div>\n        ) : filteredProcedimentos.length === 0 ? (\n          <Card className=\"p-12\">\n            <div className=\"text-center\">\n              <Settings className=\"mx-auto h-12 w-12 text-muted-foreground/50 mb-4\" />\n              <h3 className=\"text-lg font-semibold mb-2\">\n                {searchTerm\n                  ? \"Nenhum procedimento encontrado\"\n                  : \"Nenhum procedimento cadastrado\"}\n              </h3>\n              <p className=\"text-muted-foreground mb-4\">\n                {searchTerm\n                  ? \"Tente ajustar sua busca\"\n                  : \"Comece adicionando seu primeiro procedimento\"}\n              </p>\n            </div>\n          </Card>\n        ) : (\n          <div className=\"grid gap-4\">\n            {filteredProcedimentos.map((procedimento) => (\n              <Card\n                key={procedimento.id}\n                className=\"p-6 hover:shadow-md transition-shadow\"\n              >\n                <div className=\"flex flex-col sm:flex-row justify-between gap-4\">\n                  <div className=\"flex-1 space-y-3\">\n                    <div className=\"flex items-start justify-between\">\n                      <div>\n                        <h3 className=\"font-semibold text-lg\">\n                          {procedimento.nome}\n                        </h3>\n                        {procedimento.codigo_tuss && (\n                          <p className=\"text-sm text-muted-foreground\">\n                            TUSS: {procedimento.codigo_tuss}\n                          </p>\n                        )}\n                      </div>\n                      <div className=\"flex items-center gap-2\">\n                        <Badge\n                          variant={procedimento.ativo ? \"default\" : \"secondary\"}\n                        >\n                          {procedimento.ativo ? \"Ativo\" : \"Inativo\"}\n                        </Badge>\n                        {procedimento.anestesia_necessaria && (\n                          <Badge variant=\"outline\">Anestesia</Badge>\n                        )}\n                      </div>\n                    </div>\n\n                    {procedimento.descricao && (\n                      <p className=\"text-sm text-muted-foreground\">\n                        {procedimento.descricao}\n                      </p>\n                    )}\n\n                    <div className=\"flex flex-wrap gap-4 text-sm\">\n                      <div className=\"flex items-center gap-2\">\n                        <Clock className=\"h-4 w-4 text-muted-foreground\" />\n                        <span>{procedimento.duracao_minutos} minutos</span>\n                      </div>\n                      {procedimento.valor && (\n                        <div className=\"flex items-center gap-2\">\n                          <DollarSign className=\"h-4 w-4 text-muted-foreground\" />\n                          <span>\n                            R$ {Number(procedimento.valor).toFixed(2)}\n                          </span>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n\n                  <div className=\"flex sm:flex-col gap-2 justify-end\">\n                    <div className=\"flex items-center gap-2\">\n                      <Switch\n                        checked={procedimento.ativo}\n                        onCheckedChange={() =>\n                          toggleStatus(procedimento.id, procedimento.ativo)\n                        }\n                      />\n                    </div>\n                    <EditProcedimentoDialog\n                      procedimentoId={procedimento.id}\n                      open={editingId === procedimento.id}\n                      onOpenChange={(open) =>\n                        setEditingId(open ? procedimento.id : null)\n                      }\n                      onSuccess={fetchProcedimentos}\n                    >\n                      <Button\n                        variant=\"outline\"\n                        size=\"sm\"\n                        onClick={() => setEditingId(procedimento.id)}\n                      >\n                        <Edit className=\"h-4 w-4\" />\n                      </Button>\n                    </EditProcedimentoDialog>\n                    <Button\n                      variant=\"outline\"\n                      size=\"sm\"\n                      onClick={() => deleteProcedimento(procedimento.id)}\n                    >\n                      <Trash2 className=\"h-4 w-4 text-destructive\" />\n                    </Button>\n                  </div>\n                </div>\n              </Card>\n            ))}\n          </div>\n        )}\n\n        {editingId && (\n          <EditProcedimentoDialog\n            procedimentoId={editingId}\n            open={true}\n            onOpenChange={(open) => !open && setEditingId(null)}\n            onSuccess={fetchProcedimentos}\n          />\n        )}\n      </div>\n    </MainLayout>\n  );\n};\n\nexport default Procedimentos;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Profissionais.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchProfessionals'. Either include it or remove the dependency array.","line":94,"column":6,"nodeType":"ArrayExpression","endLine":94,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [fetchProfessionals]","fix":{"range":[2755,2757],"text":"[fetchProfessionals]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\r\nimport { MainLayout } from \"@/components/layout/MainLayout\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Card } from \"@/components/ui/card\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport {\r\n  Edit,\r\n  Trash2,\r\n  User,\r\n  Loader2,\r\n  Search,\r\n  Mail,\r\n  Phone as IconeTelefone,\r\n  FileText,\r\n  Upload,\r\n} from \"lucide-react\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useToast } from \"@/hooks/use-toast\";\r\nimport { NewProfessionalDialog } from \"@/components/schedule/NewProfessionalDialog\";\r\nimport { EditProfessionalDialog } from \"@/components/schedule/EditProfessionalDialog\";\r\nimport { DeleteProfessionalDialog } from \"@/components/schedule/DeleteProfessionalDialog\";\r\n\r\ninterface Professional {\r\n  id: string;\r\n  nome: string;\r\n  email: string | null;\r\n  telefone: string | null;\r\n  cpf: string | null;\r\n  conselho_profissional: string | null;\r\n  numero_registro: string | null;\r\n  uf_registro: string | null;\r\n  role: string;\r\n  especialidade_id: string | null;\r\n  especialidades?: {\r\n    nome: string;\r\n  };\r\n  created_at: string;\r\n}\r\n\r\nconst Profissionais = () => {\r\n  const [professionals, setProfessionals] = useState<Professional[]>([]);\r\n  const [isLoading, setIsLoading] = useState(true);\r\n  const [searchTerm, setSearchTerm] = useState(\"\");\r\n  const [editingId, setEditingId] = useState<string | null>(null);\r\n  const [deletingProfessional, setDeletingProfessional] = useState<{\r\n    id: string;\r\n    nome: string;\r\n  } | null>(null);\r\n  const { toast } = useToast();\r\n\r\n  const fetchProfessionals = async () => {\r\n    try {\r\n      setIsLoading(true);\r\n      const { data: profData, error: profError } = await supabase\r\n        .from(\"profiles\")\r\n        .select(\r\n          `\r\n          *,\r\n          profissional_especialidades (\r\n            especialidade_id,\r\n            especialidades (\r\n              nome\r\n            )\r\n          )\r\n        `,\r\n        )\r\n        .eq(\"role\", \"profissional\")\r\n        .order(\"nome\");\r\n\r\n      if (profError) throw profError;\r\n\r\n      const professionalsWithEspecialidades = (profData || []).map((p) => ({\r\n        ...p,\r\n        especialidades:\r\n          p.profissional_especialidades?.[0]?.especialidades || null,\r\n      }));\r\n\r\n      setProfessionals(professionalsWithEspecialidades as any);\r\n    } catch (error) {\r\n      console.error(\"Erro ao buscar profissionais:\", error);\r\n      toast({\r\n        title: \"Erro\",\r\n        description: \"N├úo foi poss├¡vel carregar os profissionais.\",\r\n        variant: \"destructive\",\r\n      });\r\n    } finally {\r\n      setIsLoading(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    fetchProfessionals();\r\n  }, []);\r\n\r\n  const filteredProfessionals = professionals.filter(\r\n    (p) =>\r\n      p.nome.toLowerCase().includes(searchTerm.toLowerCase()) ||\r\n      (p.email && p.email.toLowerCase().includes(searchTerm.toLowerCase())) ||\r\n      (p.numero_registro && p.numero_registro.includes(searchTerm)),\r\n  );\r\n\r\n  return (\r\n    <MainLayout>\r\n      <div className=\"space-y-6\">\r\n        <div className=\"flex items-center justify-between\">\r\n          <div>\r\n            <h1 className=\"text-3xl font-bold text-foreground\">\r\n              Profissionais\r\n            </h1>\r\n            <p className=\"text-muted-foreground\">\r\n              Gerenciar cadastro de profissionais de sa├║de (\r\n              {professionals.length})\r\n            </p>\r\n          </div>\r\n          {!isLoading && professionals.length > 0 && (\r\n            <div className=\"flex gap-2\">\r\n              <Button\r\n                variant=\"outline\"\r\n                onClick={() =>\r\n                  (window.location.href = \"/profissionais/recontratar\")\r\n                }\r\n              >\r\n                <Upload className=\"mr-2 h-4 w-4\" />\r\n                Recontratar (CSV)\r\n              </Button>\r\n              <NewProfessionalDialog onSuccess={() => fetchProfessionals()} />\r\n            </div>\r\n          )}\r\n        </div>\r\n\r\n        <div className=\"relative\">\r\n          <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground\" />\r\n          <Input\r\n            placeholder=\"Buscar por nome, e-mail ou registro...\"\r\n            value={searchTerm}\r\n            onChange={(e) => setSearchTerm(e.target.value)}\r\n            className=\"pl-10\"\r\n          />\r\n        </div>\r\n\r\n        {isLoading ? (\r\n          <div className=\"flex items-center justify-center py-12\">\r\n            <Loader2 className=\"h-8 w-8 animate-spin text-primary\" />\r\n          </div>\r\n        ) : filteredProfessionals.length === 0 ? (\r\n          <div className=\"text-center py-12\">\r\n            <User className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\r\n            <h3 className=\"text-lg font-semibold mb-2\">\r\n              {searchTerm\r\n                ? \"Nenhum profissional encontrado\"\r\n                : \"Nenhum profissional cadastrado\"}\r\n            </h3>\r\n            <p className=\"text-muted-foreground mb-4\">\r\n              {searchTerm\r\n                ? \"Tente uma busca diferente\"\r\n                : \"Comece adicionando seu primeiro profissional\"}\r\n            </p>\r\n            {!searchTerm && (\r\n              <NewProfessionalDialog onSuccess={() => fetchProfessionals()} />\r\n            )}\r\n          </div>\r\n        ) : (\r\n          <div className=\"grid gap-4\">\r\n            {filteredProfessionals.map((professional) => (\r\n              <Card key={professional.id} className=\"p-6\">\r\n                <div className=\"flex items-start justify-between mb-4\">\r\n                  <div className=\"flex items-center gap-4\">\r\n                    <div className=\"p-3 bg-primary-light rounded-full\">\r\n                      <User className=\"h-6 w-6 text-primary\" />\r\n                    </div>\r\n                    <div>\r\n                      <h3 className=\"text-lg font-semibold text-foreground\">\r\n                        {professional.nome}\r\n                      </h3>\r\n                      {professional.especialidades && (\r\n                        <Badge variant=\"secondary\" className=\"mt-1\">\r\n                          {professional.especialidades.nome}\r\n                        </Badge>\r\n                      )}\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n\r\n                <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-4\">\r\n                  {professional.email && (\r\n                    <div className=\"flex items-center gap-2\">\r\n                      <Mail className=\"h-4 w-4 text-muted-foreground\" />\r\n                      <span className=\"text-sm\">{professional.email}</span>\r\n                    </div>\r\n                  )}\r\n                  {professional.telefone && (\r\n                    <div className=\"flex items-center gap-2\">\r\n                      <IconeTelefone className=\"h-4 w-4 text-muted-foreground\" />\r\n                      <span className=\"text-sm\">{professional.telefone}</span>\r\n                    </div>\r\n                  )}\r\n                  {professional.conselho_profissional &&\r\n                    professional.numero_registro && (\r\n                      <div className=\"flex items-center gap-2\">\r\n                        <FileText className=\"h-4 w-4 text-muted-foreground\" />\r\n                        <span className=\"text-sm\">\r\n                          {professional.conselho_profissional}{\" \"}\r\n                          {professional.numero_registro}\r\n                          {professional.uf_registro &&\r\n                            ` - ${professional.uf_registro}`}\r\n                        </span>\r\n                      </div>\r\n                    )}\r\n                </div>\r\n\r\n                <div className=\"flex gap-2\">\r\n                  <Button\r\n                    size=\"sm\"\r\n                    variant=\"outline\"\r\n                    onClick={() => setEditingId(professional.id)}\r\n                  >\r\n                    <Edit className=\"h-4 w-4 mr-2\" />\r\n                    Editar\r\n                  </Button>\r\n                  <Button\r\n                    size=\"sm\"\r\n                    variant=\"outline\"\r\n                    onClick={() =>\r\n                      setDeletingProfessional({\r\n                        id: professional.id,\r\n                        nome: professional.nome,\r\n                      })\r\n                    }\r\n                    className=\"text-destructive hover:text-destructive\"\r\n                  >\r\n                    <Trash2 className=\"h-4 w-4 mr-2\" />\r\n                    Excluir\r\n                  </Button>\r\n                </div>\r\n              </Card>\r\n            ))}\r\n          </div>\r\n        )}\r\n      </div>\r\n\r\n      {editingId && (\r\n        <EditProfessionalDialog\r\n          professionalId={editingId}\r\n          open={!!editingId}\r\n          onOpenChange={(open) => !open && setEditingId(null)}\r\n          onSuccess={() => fetchProfessionals()}\r\n        />\r\n      )}\r\n\r\n      {deletingProfessional && (\r\n        <DeleteProfessionalDialog\r\n          professional={deletingProfessional}\r\n          open={!!deletingProfessional}\r\n          onOpenChange={(open) => !open && setDeletingProfessional(null)}\r\n          onSuccess={() => fetchProfessionals()}\r\n        />\r\n      )}\r\n    </MainLayout>\r\n  );\r\n};\r\n\r\nexport default Profissionais;\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Prontuarios.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Relatorios.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchAllReports'. Either include it or remove the dependency array.","line":50,"column":6,"nodeType":"ArrayExpression","endLine":50,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [fetchAllReports]","fix":{"range":[2798,2800],"text":"[fetchAllReports]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\r\nimport { MainLayout } from \"@/components/layout/MainLayout\";\r\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\r\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from \"@/components/ui/card\";\r\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useToast } from \"@/hooks/use-toast\";\r\nimport {\r\n  Download, Search, Calendar, Users, Stethoscope,\r\n  FileText, Activity, AlertTriangle, Clock, CheckCircle2, FileDown, ArrowUpDown\r\n} from \"lucide-react\";\r\nimport { format } from \"date-fns\";\r\nimport { ptBR } from \"date-fns/locale\";\r\nimport autoTable from \"jspdf-autotable\";\r\nimport { Tables } from \"@/integrations/supabase/types\";\r\nimport \"./Relatorios.css\";\r\n\r\nexport default function Relatorios() {\r\n  const { toast } = useToast();\r\n  const [loading, setLoading] = useState(true);\r\n\r\n  // Estados de filtro para cada relat├│rio\r\n  const [filterAgendamento, setFilterAgendamento] = useState({ search: \"\", status: \"\", dateFrom: \"\", dateTo: \"\" });\r\n  const [filterPaciente, setFilterPaciente] = useState({ search: \"\", risco: \"\" });\r\n  const [filterProfissional, setFilterProfissional] = useState({ search: \"\", especialidade: \"\" });\r\n  const [filterConfirmacao, setFilterConfirmacao] = useState({ search: \"\", dateFrom: \"\", dateTo: \"\" });\r\n  const [filterListaEspera, setFilterListaEspera] = useState({ search: \"\", prioridade: \"\" });\r\n  const [filterAlerta, setFilterAlerta] = useState({ search: \"\", tipo: \"\", prioridade: \"\" });\r\n  const [filterMensagem, setFilterMensagem] = useState({ search: \"\", canal: \"\", status: \"\" });\r\n\r\n  // Estados de ordena├º├úo\r\n  const [sortAgendamento, setSortAgendamento] = useState({ field: 'inicio', direction: 'desc' as 'asc' | 'desc' });\r\n  const [sortPaciente, setSortPaciente] = useState({ field: 'nome', direction: 'asc' as 'asc' | 'desc' });\r\n  const [sortProfissional, setSortProfissional] = useState({ field: 'nome', direction: 'asc' as 'asc' | 'desc' });\r\n\r\n  // Estados para cada relat├│rio\r\n  const [agendamentos, setAgendamentos] = useState<any[]>([]);\r\n  const [pacientes, setPacientes] = useState<Tables<\"pacientes\">[]>([]);\r\n  const [profissionais, setProfissionais] = useState<any[]>([]);\r\n  const [confirmacoes, setConfirmacoes] = useState<any[]>([]);\r\n  const [listaEspera, setListaEspera] = useState<any[]>([]);\r\n  const [alertas, setAlertas] = useState<any[]>([]);\r\n  const [mensagens, setMensagens] = useState<Tables<\"log_mensagens\">[]>([]);\r\n\r\n  useEffect(() => {\r\n    fetchAllReports();\r\n  }, []);\r\n\r\n  const fetchAllReports = async () => {\r\n    setLoading(true);\r\n    try {\r\n      const { data: { user } } = await supabase.auth.getUser();\r\n      if (!user) return;\r\n\r\n      const { data: profile } = await supabase\r\n        .from('profiles')\r\n        .select('tenant_id')\r\n        .eq('id', user.id)\r\n        .single();\r\n\r\n      if (!profile?.tenant_id) return;\r\n\r\n      // Buscar agendamentos\r\n      const { data: agendamentosData } = await supabase\r\n        .from('agenda')\r\n        .select(`\r\n          *,\r\n          pacientes:paciente_id(nome, telefone),\r\n          procedimentos:servico_id(nome),\r\n          profiles:profissional_id(nome)\r\n        `)\r\n        .eq('tenant_id', profile.tenant_id)\r\n        .order('inicio', { ascending: false })\r\n        .limit(100);\r\n\r\n      // Buscar pacientes\r\n      const { data: pacientesData } = await supabase\r\n        .from('pacientes')\r\n        .select('*')\r\n        .eq('tenant_id', profile.tenant_id)\r\n        .order('created_at', { ascending: false });\r\n\r\n      // Buscar profissionais\r\n      const { data: profissionaisData } = await supabase\r\n        .from('profiles')\r\n        .select(`\r\n          *,\r\n          especialidades:especialidade_id(nome)\r\n        `)\r\n        .eq('tenant_id', profile.tenant_id)\r\n        .eq('role', 'profissional')\r\n        .order('created_at', { ascending: false });\r\n\r\n      // Buscar confirma├º├Áes (agendamentos confirmados)\r\n      const { data: confirmacoesData } = await supabase\r\n        .from('agenda')\r\n        .select(`\r\n          *,\r\n          pacientes:paciente_id(nome, telefone),\r\n          procedimentos:servico_id(nome)\r\n        `)\r\n        .eq('tenant_id', profile.tenant_id)\r\n        .eq('confirmado', true)\r\n        .order('confirmado_em', { ascending: false })\r\n        .limit(100);\r\n\r\n      // Buscar lista de espera\r\n      const { data: listaEsperaData } = await supabase\r\n        .from('lista_espera')\r\n        .select(`\r\n          *,\r\n          pacientes:paciente_id(nome, telefone),\r\n          procedimentos:servico_id(nome)\r\n        `)\r\n        .eq('tenant_id', profile.tenant_id)\r\n        .eq('ativo', true)\r\n        .order('prioridade', { ascending: false });\r\n\r\n      // Buscar alertas\r\n      const { data: alertasData } = await supabase\r\n        .from('alertas_risco')\r\n        .select(`\r\n          *,\r\n          pacientes:paciente_id(nome, telefone)\r\n        `)\r\n        .eq('tenant_id', profile.tenant_id)\r\n        .order('created_at', { ascending: false })\r\n        .limit(100);\r\n\r\n      // Buscar mensagens\r\n      const { data: mensagensData } = await supabase\r\n        .from('log_mensagens')\r\n        .select('*')\r\n        .eq('tenant_id', profile.tenant_id)\r\n        .order('created_at', { ascending: false })\r\n        .limit(100);\r\n\r\n      setAgendamentos(agendamentosData || []);\r\n      setPacientes(pacientesData || []);\r\n      setProfissionais(profissionaisData || []);\r\n      setConfirmacoes(confirmacoesData || []);\r\n      setListaEspera(listaEsperaData || []);\r\n      setAlertas(alertasData || []);\r\n      setMensagens(mensagensData || []);\r\n    } catch (error) {\r\n      console.error('Erro ao buscar relat├│rios:', error);\r\n      toast({\r\n        title: \"Erro ao carregar relat├│rios\",\r\n        description: \"N├úo foi poss├¡vel carregar os dados dos relat├│rios.\",\r\n        variant: \"destructive\",\r\n      });\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  const exportToCSV = (data: any[], filename: string) => {\r\n    if (data.length === 0) {\r\n      toast({\r\n        title: \"Sem dados para exportar\",\r\n        description: \"N├úo h├í dados dispon├¡veis neste relat├│rio.\",\r\n        variant: \"destructive\",\r\n      });\r\n      return;\r\n    }\r\n\r\n    const headers = Object.keys(data[0]).join(',');\r\n    const rows = data.map(row =>\r\n      Object.values(row).map(val =>\r\n        typeof val === 'object' ? JSON.stringify(val) : val\r\n      ).join(',')\r\n    );\r\n\r\n    const csv = [headers, ...rows].join('\\n');\r\n    const blob = new Blob([csv], { type: 'text/csv' });\r\n    const url = window.URL.createObjectURL(blob);\r\n    const a = document.createElement('a');\r\n    a.href = url;\r\n    a.download = `${filename}_${format(new Date(), 'yyyy-MM-dd')}.csv`;\r\n    a.click();\r\n\r\n    toast({\r\n      title: \"Exportado com sucesso\",\r\n      description: `Relat├│rio ${filename} exportado em CSV.`,\r\n    });\r\n  };\r\n\r\n  const exportToPDF = (data: any[], filename: string, columns: string[], headers: string[]) => {\r\n    if (data.length === 0) {\r\n      toast({\r\n        title: \"Sem dados para exportar\",\r\n        description: \"N├úo h├í dados dispon├¡veis neste relat├│rio.\",\r\n        variant: \"destructive\",\r\n      });\r\n      return;\r\n    }\r\n\r\n    const doc = new jsPDF();\r\n\r\n    // T├¡tulo\r\n    doc.setFontSize(16);\r\n    doc.text(`Relat├│rio - ${filename}`, 14, 15);\r\n    doc.setFontSize(10);\r\n    doc.text(`Gerado em: ${format(new Date(), \"dd/MM/yyyy HH:mm\", { locale: ptBR })}`, 14, 22);\r\n\r\n    // Tabela\r\n    const tableData = data.map(row =>\r\n      columns.map(col => {\r\n        const value = row[col];\r\n        if (typeof value === 'object' && value !== null) {\r\n          return JSON.stringify(value);\r\n        }\r\n        return value || '-';\r\n      })\r\n    );\r\n\r\n    autoTable(doc, {\r\n      head: [headers],\r\n      body: tableData,\r\n      startY: 28,\r\n      styles: { fontSize: 8 },\r\n      headStyles: { fillColor: [1, 108, 165] },\r\n    });\r\n\r\n    doc.save(`${filename}_${format(new Date(), 'yyyy-MM-dd')}.pdf`);\r\n\r\n    toast({\r\n      title: \"Exportado com sucesso\",\r\n      description: `Relat├│rio ${filename} exportado em PDF.`,\r\n    });\r\n  };\r\n\r\n  const getStatusBadge = (status: string) => {\r\n    const statusMap: Record<string, { label: string; variant: any }> = {\r\n      agendado: { label: \"Agendado\", variant: \"default\" },\r\n      confirmado: { label: \"Confirmado\", variant: \"success\" },\r\n      realizado: { label: \"Realizado\", variant: \"success\" },\r\n      cancelado: { label: \"Cancelado\", variant: \"destructive\" },\r\n      faltou: { label: \"Faltou\", variant: \"destructive\" },\r\n    };\r\n\r\n    const config = statusMap[status] || { label: status, variant: \"default\" };\r\n    return <Badge variant={config.variant as any}>{config.label}</Badge>;\r\n  };\r\n\r\n  const getPrioridadeBadge = (prioridade: string) => {\r\n    const prioridadeMap: Record<string, { variant: any }> = {\r\n      baixa: { variant: \"secondary\" },\r\n      media: { variant: \"default\" },\r\n      alta: { variant: \"warning\" },\r\n      critica: { variant: \"destructive\" },\r\n    };\r\n\r\n    const config = prioridadeMap[prioridade] || { variant: \"default\" };\r\n    return <Badge variant={config.variant as any}>{prioridade}</Badge>;\r\n  };\r\n\r\n  const sortData = (data: any[], field: string, direction: 'asc' | 'desc') => {\r\n    return [...data].sort((a, b) => {\r\n      let aVal = a[field];\r\n      let bVal = b[field];\r\n\r\n      // Handle nested objects (e.g., pacientes.nome)\r\n      if (field.includes('.')) {\r\n        const parts = field.split('.');\r\n        aVal = parts.reduce((obj, key) => obj?.[key], a);\r\n        bVal = parts.reduce((obj, key) => obj?.[key], b);\r\n      }\r\n\r\n      // Handle null values\r\n      if (aVal == null) return 1;\r\n      if (bVal == null) return -1;\r\n\r\n      // String comparison\r\n      if (typeof aVal === 'string' && typeof bVal === 'string') {\r\n        return direction === 'asc'\r\n          ? aVal.localeCompare(bVal)\r\n          : bVal.localeCompare(aVal);\r\n      }\r\n\r\n      // Number/Date comparison\r\n      return direction === 'asc' ? aVal - bVal : bVal - aVal;\r\n    });\r\n  };\r\n\r\n  const handleSort = (field: string, currentSort: any, setSortFunc: any) => {\r\n    const newDirection = currentSort.field === field && currentSort.direction === 'asc' ? 'desc' : 'asc';\r\n    setSortFunc({ field, direction: newDirection });\r\n  };\r\n\r\n  if (loading) {\r\n    return (\r\n      <MainLayout>\r\n        <div className=\"flex items-center justify-center min-h-screen\">\r\n          <p className=\"text-muted-foreground\">Carregando relat├│rios...</p>\r\n        </div>\r\n      </MainLayout>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <MainLayout>\r\n      <div className=\"space-y-6 reports-page\">\r\n        <div>\r\n          <h1 className=\"text-3xl font-bold text-foreground\">Relat├│rios</h1>\r\n          <p className=\"text-muted-foreground\">\r\n            Visualize e exporte relat├│rios completos do sistema\r\n          </p>\r\n        </div>\r\n\r\n        <Tabs defaultValue=\"agendamentos\" className=\"space-y-4\">\r\n          <TabsList className=\"grid w-full grid-cols-4 lg:grid-cols-7\">\r\n            <TabsTrigger value=\"agendamentos\">\r\n              <Calendar className=\"h-4 w-4 mr-2\" />\r\n              Agendamentos\r\n            </TabsTrigger>\r\n            <TabsTrigger value=\"pacientes\">\r\n              <Users className=\"h-4 w-4 mr-2\" />\r\n              Pacientes\r\n            </TabsTrigger>\r\n            <TabsTrigger value=\"profissionais\">\r\n              <Stethoscope className=\"h-4 w-4 mr-2\" />\r\n              Profissionais\r\n            </TabsTrigger>\r\n            <TabsTrigger value=\"confirmacoes\">\r\n              <CheckCircle2 className=\"h-4 w-4 mr-2\" />\r\n              Confirma├º├Áes\r\n            </TabsTrigger>\r\n            <TabsTrigger value=\"lista-espera\">\r\n              <Clock className=\"h-4 w-4 mr-2\" />\r\n              Lista Espera\r\n            </TabsTrigger>\r\n            <TabsTrigger value=\"alertas\">\r\n              <AlertTriangle className=\"h-4 w-4 mr-2\" />\r\n              Alertas\r\n            </TabsTrigger>\r\n            <TabsTrigger value=\"mensagens\">\r\n              <Activity className=\"h-4 w-4 mr-2\" />\r\n              Mensagens\r\n            </TabsTrigger>\r\n          </TabsList>\r\n\r\n          {/* Relat├│rio de Agendamentos */}\r\n          <TabsContent value=\"agendamentos\">\r\n            <Card>\r\n              <CardHeader>\r\n                <div className=\"flex items-center justify-between\">\r\n                  <div>\r\n                    <CardTitle>Relat├│rio de Agendamentos</CardTitle>\r\n                    <CardDescription>\r\n                      {agendamentos.filter(a => {\r\n                        const matchSearch = !filterAgendamento.search || a.pacientes?.nome?.toLowerCase().includes(filterAgendamento.search.toLowerCase());\r\n                        const matchStatus = !filterAgendamento.status || a.status === filterAgendamento.status;\r\n                        const matchDateFrom = !filterAgendamento.dateFrom || new Date(a.inicio) >= new Date(filterAgendamento.dateFrom);\r\n                        const matchDateTo = !filterAgendamento.dateTo || new Date(a.inicio) <= new Date(filterAgendamento.dateTo);\r\n                        return matchSearch && matchStatus && matchDateFrom && matchDateTo;\r\n                      }).length} agendamentos encontrados\r\n                    </CardDescription>\r\n                  </div>\r\n                  <div className=\"flex gap-2\">\r\n                    <Button\r\n                      onClick={() => exportToCSV(\r\n                        agendamentos.filter(a => {\r\n                          const matchSearch = !filterAgendamento.search || a.pacientes?.nome?.toLowerCase().includes(filterAgendamento.search.toLowerCase());\r\n                          const matchStatus = !filterAgendamento.status || a.status === filterAgendamento.status;\r\n                          const matchDateFrom = !filterAgendamento.dateFrom || new Date(a.inicio) >= new Date(filterAgendamento.dateFrom);\r\n                          const matchDateTo = !filterAgendamento.dateTo || new Date(a.inicio) <= new Date(filterAgendamento.dateTo);\r\n                          return matchSearch && matchStatus && matchDateFrom && matchDateTo;\r\n                        }),\r\n                        'agendamentos'\r\n                      )}\r\n                    >\r\n                      <Download className=\"h-4 w-4 mr-2\" />\r\n                      Exportar CSV\r\n                    </Button>\r\n                    <Button\r\n                      variant=\"destructive\"\r\n                      onClick={() => exportToPDF(\r\n                        agendamentos.filter(a => {\r\n                          const matchSearch = !filterAgendamento.search || a.pacientes?.nome?.toLowerCase().includes(filterAgendamento.search.toLowerCase());\r\n                          const matchStatus = !filterAgendamento.status || a.status === filterAgendamento.status;\r\n                          const matchDateFrom = !filterAgendamento.dateFrom || new Date(a.inicio) >= new Date(filterAgendamento.dateFrom);\r\n                          const matchDateTo = !filterAgendamento.dateTo || new Date(a.inicio) <= new Date(filterAgendamento.dateTo);\r\n                          return matchSearch && matchStatus && matchDateFrom && matchDateTo;\r\n                        }).map(a => ({\r\n                          data: format(new Date(a.inicio), \"dd/MM/yyyy HH:mm\", { locale: ptBR }),\r\n                          paciente: a.pacientes?.nome,\r\n                          servico: a.servicos?.nome,\r\n                          profissional: a.profiles?.nome || '-',\r\n                          status: a.status,\r\n                          confirmado: a.confirmado ? 'Sim' : 'N├úo'\r\n                        })),\r\n                        'agendamentos',\r\n                        ['data', 'paciente', 'servico', 'profissional', 'status', 'confirmado'],\r\n                        ['Data/Hora', 'Paciente', 'Servi├ºo', 'Profissional', 'Status', 'Confirmado']\r\n                      )}\r\n                    >\r\n                      <FileDown className=\"h-4 w-4 mr-2\" />\r\n                      Exportar PDF\r\n                    </Button>\r\n                  </div>\r\n                </div>\r\n              </CardHeader>\r\n              <CardContent>\r\n                <div className=\"mb-4 grid grid-cols-1 md:grid-cols-4 gap-4\">\r\n                  <div className=\"relative\">\r\n                    <Search className=\"absolute left-3 top-3 h-4 w-4 text-muted-foreground\" />\r\n                    <Input\r\n                      placeholder=\"Buscar paciente...\"\r\n                      value={filterAgendamento.search}\r\n                      onChange={(e) => setFilterAgendamento({ ...filterAgendamento, search: e.target.value })}\r\n                      className=\"pl-10\"\r\n                    />\r\n                  </div>\r\n                  <select\r\n                    className=\"flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm\"\r\n                    value={filterAgendamento.status}\r\n                    onChange={(e) => setFilterAgendamento({ ...filterAgendamento, status: e.target.value })}\r\n                  >\r\n                    <option value=\"\">Todos os status</option>\r\n                    <option value=\"agendado\">Agendado</option>\r\n                    <option value=\"confirmado\">Confirmado</option>\r\n                    <option value=\"realizado\">Realizado</option>\r\n                    <option value=\"cancelado\">Cancelado</option>\r\n                    <option value=\"faltou\">Faltou</option>\r\n                  </select>\r\n                  <Input\r\n                    type=\"date\"\r\n                    placeholder=\"Data in├¡cio\"\r\n                    value={filterAgendamento.dateFrom}\r\n                    onChange={(e) => setFilterAgendamento({ ...filterAgendamento, dateFrom: e.target.value })}\r\n                  />\r\n                  <Input\r\n                    type=\"date\"\r\n                    placeholder=\"Data fim\"\r\n                    value={filterAgendamento.dateTo}\r\n                    onChange={(e) => setFilterAgendamento({ ...filterAgendamento, dateTo: e.target.value })}\r\n                  />\r\n                </div>\r\n                <div className=\"rounded-md border\">\r\n                  <Table>\r\n                    <TableHeader>\r\n                      <TableRow>\r\n                        <TableHead>\r\n                          <Button\r\n                            variant=\"ghost\"\r\n                            size=\"sm\"\r\n                            className=\"h-8 px-2\"\r\n                            onClick={() => handleSort('inicio', sortAgendamento, setSortAgendamento)}\r\n                          >\r\n                            Data/Hora\r\n                            <ArrowUpDown className=\"ml-2 h-3 w-3\" />\r\n                          </Button>\r\n                        </TableHead>\r\n                        <TableHead>\r\n                          <Button\r\n                            variant=\"ghost\"\r\n                            size=\"sm\"\r\n                            className=\"h-8 px-2\"\r\n                            onClick={() => handleSort('pacientes.nome', sortAgendamento, setSortAgendamento)}\r\n                          >\r\n                            Paciente\r\n                            <ArrowUpDown className=\"ml-2 h-3 w-3\" />\r\n                          </Button>\r\n                        </TableHead>\r\n                        <TableHead>Servi├ºo</TableHead>\r\n                        <TableHead>Profissional</TableHead>\r\n                        <TableHead>\r\n                          <Button\r\n                            variant=\"ghost\"\r\n                            size=\"sm\"\r\n                            className=\"h-8 px-2\"\r\n                            onClick={() => handleSort('status', sortAgendamento, setSortAgendamento)}\r\n                          >\r\n                            Status\r\n                            <ArrowUpDown className=\"ml-2 h-3 w-3\" />\r\n                          </Button>\r\n                        </TableHead>\r\n                        <TableHead>Confirmado</TableHead>\r\n                      </TableRow>\r\n                    </TableHeader>\r\n                    <TableBody>\r\n                      {sortData(\r\n                        agendamentos.filter(a => {\r\n                          const matchSearch = !filterAgendamento.search || a.pacientes?.nome?.toLowerCase().includes(filterAgendamento.search.toLowerCase());\r\n                          const matchStatus = !filterAgendamento.status || a.status === filterAgendamento.status;\r\n                          const matchDateFrom = !filterAgendamento.dateFrom || new Date(a.inicio) >= new Date(filterAgendamento.dateFrom);\r\n                          const matchDateTo = !filterAgendamento.dateTo || new Date(a.inicio) <= new Date(filterAgendamento.dateTo);\r\n                          return matchSearch && matchStatus && matchDateFrom && matchDateTo;\r\n                        }),\r\n                        sortAgendamento.field,\r\n                        sortAgendamento.direction\r\n                      ).map((agendamento) => (\r\n                        <TableRow key={agendamento.id}>\r\n                          <TableCell className=\"selectable-text\">\r\n                            {format(new Date(agendamento.inicio), \"dd/MM/yyyy HH:mm\", { locale: ptBR })}\r\n                          </TableCell>\r\n                          <TableCell className=\"selectable-text\">{agendamento.pacientes?.nome}</TableCell>\r\n                          <TableCell className=\"selectable-text\">{agendamento.servicos?.nome}</TableCell>\r\n                          <TableCell className=\"selectable-text\">{agendamento.profiles?.nome || '-'}</TableCell>\r\n                          <TableCell>{getStatusBadge(agendamento.status)}</TableCell>\r\n                          <TableCell>\r\n                            {agendamento.confirmado ? (\r\n                              <Badge variant=\"success\">Sim</Badge>\r\n                            ) : (\r\n                              <Badge variant=\"secondary\">N├úo</Badge>\r\n                            )}\r\n                          </TableCell>\r\n                        </TableRow>\r\n                      ))}\r\n                    </TableBody>\r\n                  </Table>\r\n                </div>\r\n              </CardContent>\r\n            </Card>\r\n          </TabsContent>\r\n\r\n          {/* Relat├│rio de Pacientes */}\r\n          <TabsContent value=\"pacientes\">\r\n            <Card>\r\n              <CardHeader>\r\n                <div className=\"flex items-center justify-between\">\r\n                  <div>\r\n                    <CardTitle>Relat├│rio de Pacientes</CardTitle>\r\n                    <CardDescription>\r\n                      {pacientes.filter(p => {\r\n                        const matchSearch = !filterPaciente.search || p.nome?.toLowerCase().includes(filterPaciente.search.toLowerCase());\r\n                        const matchRisco = !filterPaciente.risco ||\r\n                          (filterPaciente.risco === 'alto' && p.risco_no_show > 70) ||\r\n                          (filterPaciente.risco === 'medio' && p.risco_no_show > 40 && p.risco_no_show <= 70) ||\r\n                          (filterPaciente.risco === 'baixo' && p.risco_no_show <= 40);\r\n                        return matchSearch && matchRisco;\r\n                      }).length} pacientes encontrados\r\n                    </CardDescription>\r\n                  </div>\r\n                  <div className=\"flex gap-2\">\r\n                    <Button onClick={() => exportToCSV(\r\n                      pacientes.filter(p => {\r\n                        const matchSearch = !filterPaciente.search || p.nome?.toLowerCase().includes(filterPaciente.search.toLowerCase());\r\n                        const matchRisco = !filterPaciente.risco ||\r\n                          (filterPaciente.risco === 'alto' && p.risco_no_show > 70) ||\r\n                          (filterPaciente.risco === 'medio' && p.risco_no_show > 40 && p.risco_no_show <= 70) ||\r\n                          (filterPaciente.risco === 'baixo' && p.risco_no_show <= 40);\r\n                        return matchSearch && matchRisco;\r\n                      }), 'pacientes')}>\r\n                      <Download className=\"h-4 w-4 mr-2\" />\r\n                      Exportar CSV\r\n                    </Button>\r\n                    <Button variant=\"destructive\" onClick={() => exportToPDF(\r\n                      pacientes.filter(p => {\r\n                        const matchSearch = !filterPaciente.search || p.nome?.toLowerCase().includes(filterPaciente.search.toLowerCase());\r\n                        const matchRisco = !filterPaciente.risco ||\r\n                          (filterPaciente.risco === 'alto' && p.risco_no_show > 70) ||\r\n                          (filterPaciente.risco === 'medio' && p.risco_no_show > 40 && p.risco_no_show <= 70) ||\r\n                          (filterPaciente.risco === 'baixo' && p.risco_no_show <= 40);\r\n                        return matchSearch && matchRisco;\r\n                      }).map(p => ({\r\n                        nome: p.nome,\r\n                        telefone: p.telefone,\r\n                        email: p.email || '-',\r\n                        risco: `${p.risco_no_show}%`,\r\n                        faltas: p.historico_faltas,\r\n                        cadastro: format(new Date(p.created_at), \"dd/MM/yyyy\", { locale: ptBR })\r\n                      })),\r\n                      'pacientes',\r\n                      ['nome', 'telefone', 'email', 'risco', 'faltas', 'cadastro'],\r\n                      ['Nome', 'Telefone', 'Email', 'Risco No-Show', 'Faltas', 'Cadastro']\r\n                    )}>\r\n                      <FileDown className=\"h-4 w-4 mr-2\" />\r\n                      Exportar PDF\r\n                    </Button>\r\n                  </div>\r\n                </div>\r\n              </CardHeader>\r\n              <CardContent>\r\n                <div className=\"mb-4 grid grid-cols-1 md:grid-cols-2 gap-4\">\r\n                  <div className=\"relative\">\r\n                    <Search className=\"absolute left-3 top-3 h-4 w-4 text-muted-foreground\" />\r\n                    <Input\r\n                      placeholder=\"Buscar paciente...\"\r\n                      value={filterPaciente.search}\r\n                      onChange={(e) => setFilterPaciente({ ...filterPaciente, search: e.target.value })}\r\n                      className=\"pl-10\"\r\n                    />\r\n                  </div>\r\n                  <select\r\n                    className=\"flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm\"\r\n                    value={filterPaciente.risco}\r\n                    onChange={(e) => setFilterPaciente({ ...filterPaciente, risco: e.target.value })}\r\n                  >\r\n                    <option value=\"\">Todos os riscos</option>\r\n                    <option value=\"baixo\">Baixo (Ôëñ40%)</option>\r\n                    <option value=\"medio\">M├®dio (41-70%)</option>\r\n                    <option value=\"alto\">Alto (&gt;70%)</option>\r\n                  </select>\r\n                </div>\r\n                <div className=\"rounded-md border\">\r\n                  <Table>\r\n                    <TableHeader>\r\n                      <TableRow>\r\n                        <TableHead>\r\n                          <Button\r\n                            variant=\"ghost\"\r\n                            size=\"sm\"\r\n                            className=\"h-8 px-2\"\r\n                            onClick={() => handleSort('nome', sortPaciente, setSortPaciente)}\r\n                          >\r\n                            Nome\r\n                            <ArrowUpDown className=\"ml-2 h-3 w-3\" />\r\n                          </Button>\r\n                        </TableHead>\r\n                        <TableHead>Telefone</TableHead>\r\n                        <TableHead>Email</TableHead>\r\n                        <TableHead>\r\n                          <Button\r\n                            variant=\"ghost\"\r\n                            size=\"sm\"\r\n                            className=\"h-8 px-2\"\r\n                            onClick={() => handleSort('risco_no_show', sortPaciente, setSortPaciente)}\r\n                          >\r\n                            Risco No-Show\r\n                            <ArrowUpDown className=\"ml-2 h-3 w-3\" />\r\n                          </Button>\r\n                        </TableHead>\r\n                        <TableHead>\r\n                          <Button\r\n                            variant=\"ghost\"\r\n                            size=\"sm\"\r\n                            className=\"h-8 px-2\"\r\n                            onClick={() => handleSort('historico_faltas', sortPaciente, setSortPaciente)}\r\n                          >\r\n                            Faltas\r\n                            <ArrowUpDown className=\"ml-2 h-3 w-3\" />\r\n                          </Button>\r\n                        </TableHead>\r\n                        <TableHead>\r\n                          <Button\r\n                            variant=\"ghost\"\r\n                            size=\"sm\"\r\n                            className=\"h-8 px-2\"\r\n                            onClick={() => handleSort('created_at', sortPaciente, setSortPaciente)}\r\n                          >\r\n                            Cadastro\r\n                            <ArrowUpDown className=\"ml-2 h-3 w-3\" />\r\n                          </Button>\r\n                        </TableHead>\r\n                      </TableRow>\r\n                    </TableHeader>\r\n                    <TableBody>\r\n                      {sortData(\r\n                        pacientes.filter(p => {\r\n                          const matchSearch = !filterPaciente.search || p.nome?.toLowerCase().includes(filterPaciente.search.toLowerCase());\r\n                          const matchRisco = !filterPaciente.risco ||\r\n                            (filterPaciente.risco === 'alto' && p.risco_no_show > 70) ||\r\n                            (filterPaciente.risco === 'medio' && p.risco_no_show > 40 && p.risco_no_show <= 70) ||\r\n                            (filterPaciente.risco === 'baixo' && p.risco_no_show <= 40);\r\n                          return matchSearch && matchRisco;\r\n                        }),\r\n                        sortPaciente.field,\r\n                        sortPaciente.direction\r\n                      ).map((paciente) => (\r\n                        <TableRow key={paciente.id}>\r\n                          <TableCell className=\"selectable-text\">{paciente.nome}</TableCell>\r\n                          <TableCell className=\"selectable-text\">{paciente.telefone}</TableCell>\r\n                          <TableCell className=\"selectable-text\">{paciente.email || '-'}</TableCell>\r\n                          <TableCell>\r\n                            <Badge variant={\r\n                              paciente.risco_no_show > 70 ? \"destructive\" :\r\n                                paciente.risco_no_show > 40 ? \"warning\" : \"success\"\r\n                            }>\r\n                              {paciente.risco_no_show}%\r\n                            </Badge>\r\n                          </TableCell>\r\n                          <TableCell>{paciente.historico_faltas}</TableCell>\r\n                          <TableCell className=\"selectable-text\">\r\n                            {format(new Date(paciente.created_at), \"dd/MM/yyyy\", { locale: ptBR })}\r\n                          </TableCell>\r\n                        </TableRow>\r\n                      ))}\r\n                    </TableBody>\r\n                  </Table>\r\n                </div>\r\n              </CardContent>\r\n            </Card>\r\n          </TabsContent>\r\n\r\n          {/* Relat├│rio de Profissionais */}\r\n          <TabsContent value=\"profissionais\">\r\n            <Card>\r\n              <CardHeader>\r\n                <div className=\"flex items-center justify-between\">\r\n                  <div>\r\n                    <CardTitle>Relat├│rio de Profissionais</CardTitle>\r\n                    <CardDescription>\r\n                      {profissionais.filter(p => {\r\n                        const matchSearch = !filterProfissional.search || p.nome?.toLowerCase().includes(filterProfissional.search.toLowerCase());\r\n                        const matchEsp = !filterProfissional.especialidade || p.especialidades?.nome?.toLowerCase().includes(filterProfissional.especialidade.toLowerCase());\r\n                        return matchSearch && matchEsp;\r\n                      }).length} profissionais encontrados\r\n                    </CardDescription>\r\n                  </div>\r\n                  <div className=\"flex gap-2\">\r\n                    <Button onClick={() => exportToCSV(\r\n                      profissionais.filter(p => {\r\n                        const matchSearch = !filterProfissional.search || p.nome?.toLowerCase().includes(filterProfissional.search.toLowerCase());\r\n                        const matchEsp = !filterProfissional.especialidade || p.especialidades?.nome?.toLowerCase().includes(filterProfissional.especialidade.toLowerCase());\r\n                        return matchSearch && matchEsp;\r\n                      }), 'profissionais')}>\r\n                      <Download className=\"h-4 w-4 mr-2\" />\r\n                      Exportar CSV\r\n                    </Button>\r\n                    <Button variant=\"destructive\" onClick={() => exportToPDF(\r\n                      profissionais.filter(p => {\r\n                        const matchSearch = !filterProfissional.search || p.nome?.toLowerCase().includes(filterProfissional.search.toLowerCase());\r\n                        const matchEsp = !filterProfissional.especialidade || p.especialidades?.nome?.toLowerCase().includes(filterProfissional.especialidade.toLowerCase());\r\n                        return matchSearch && matchEsp;\r\n                      }).map(p => ({\r\n                        nome: p.nome,\r\n                        email: p.email,\r\n                        telefone: p.telefone || '-',\r\n                        especialidade: p.especialidades?.nome || '-',\r\n                        registro: `${p.conselho_profissional} ${p.numero_registro}`,\r\n                        cadastro: format(new Date(p.creat