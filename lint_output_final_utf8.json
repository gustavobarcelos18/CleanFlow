geView.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\admin\\WhatsAppMetrics.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\admin\\WhatsAppMetricsDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\admin\\WhatsAppNotificationBadge.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\admin\\WhatsAppPhoneManager.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\admin\\WhatsAppTemplateBuilder.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\atendimento\\AtendimentoTimer.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\atendimento\\PacientesDoDia.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\atendimento\\ProntuarioAtendimento.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'checkProntuarioExistente', 'loadHistorico', 'loadPacienteInfo', and 'loadProximoAgendamento'. Either include them or remove the dependency array.","line":77,"column":6,"nodeType":"ArrayExpression","endLine":77,"endColumn":19,"suggestions":[{"desc":"Update the dependencies array to be: [agendamento, checkProntuarioExistente, loadHistorico, loadPacienteInfo, loadProximoAgendamento]","fix":{"range":[2304,2317],"text":"[agendamento, checkProntuarioExistente, loadHistorico, loadPacienteInfo, loadProximoAgendamento]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useState } from \"react\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { toast } from \"sonner\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Separator } from \"@/components/ui/separator\";\nimport { ScrollArea } from \"@/components/ui/scroll-area\";\nimport { \n  ArrowLeft, \n  Save, \n  FileCheck, \n  Clock, \n  Activity,\n  Stethoscope,\n  ClipboardList,\n  History\n} from \"lucide-react\";\nimport { format } from \"date-fns\";\nimport { ptBR } from \"date-fns/locale\";\nimport { AtendimentoTimer } from \"./AtendimentoTimer\";\n\ninterface ProntuarioAtendimentoProps {\n  agendamento: any;\n  onClose: () => void;\n}\n\nexport function ProntuarioAtendimento({ agendamento, onClose }: ProntuarioAtendimentoProps) {\n  const [loading, setLoading] = useState(false);\n  const [historicoLoading, setHistoricoLoading] = useState(true);\n  const [historico, setHistorico] = useState<any[]>([]);\n  const [pacienteInfo, setPacienteInfo] = useState<any>(null);\n  const [prontuarioAtual, setProntuarioAtual] = useState<any>(null);\n  const [proximoAgendamento, setProximoAgendamento] = useState<Date | undefined>(undefined);\n  const [formData, setFormData] = useState({\n    // Anamnese (primeira consulta)\n    queixa_principal: '',\n    historia_doenca_atual: '',\n    historia_pregressa: '',\n    alergias: [] as string[],\n    medicamentos_uso: [] as string[],\n    historia_familiar: '',\n    historia_social: '',\n    \n    // SOAP\n    subjetivo: '',\n    objetivo: '',\n    avaliacao: '',\n    plano: '',\n    \n    // Sinais Vitais\n    pressao_arterial: '',\n    frequencia_cardiaca: '',\n    temperatura: '',\n    peso: '',\n    altura: '',\n    saturacao_o2: '',\n    \n    // Diagn├│stico\n    cid10_principal: '',\n    hipotese_diagnostica: '',\n    \n    // Observa├º├Áes\n    observacoes: '',\n    evolucao: '',\n  });\n\n  useEffect(() => {\n    loadPacienteInfo();\n    loadHistorico();\n    checkProntuarioExistente();\n    loadProximoAgendamento();\n  }, [agendamento]);\n\n  const loadPacienteInfo = async () => {\n    try {\n      const { data, error } = await supabase\n        .from('pacientes')\n        .select('*')\n        .eq('id', agendamento.paciente_id)\n        .single();\n\n      if (error) throw error;\n      setPacienteInfo(data);\n    } catch (error: any) {\n      console.error('Erro ao carregar dados do paciente:', error);\n    }\n  };\n\n  const loadProximoAgendamento = async () => {\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) return;\n\n      const { data, error } = await supabase\n        .from('agenda')\n        .select('inicio')\n        .eq('profissional_id', user.id)\n        .gt('inicio', agendamento.inicio)\n        .neq('status', 'cancelado')\n        .order('inicio', { ascending: true })\n        .limit(1)\n        .maybeSingle();\n\n      if (data) {\n        setProximoAgendamento(new Date(data.inicio));\n      }\n    } catch (error: any) {\n      console.error('Erro ao carregar pr├│ximo agendamento:', error);\n    }\n  };\n\n  const loadHistorico = async () => {\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) return;\n\n      const { data, error } = await supabase\n        .from('prontuarios' as any)\n        .select('*')\n        .eq('paciente_id', agendamento.paciente_id)\n        .eq('profissional_id', user.id)\n        .order('data_atendimento', { ascending: false });\n\n      if (error) throw error;\n      setHistorico(data || []);\n    } catch (error: any) {\n      console.error('Erro ao carregar hist├│rico:', error);\n    } finally {\n      setHistoricoLoading(false);\n    }\n  };\n\n  const checkProntuarioExistente = async () => {\n    try {\n      const { data, error } = await supabase\n        .from('prontuarios' as any)\n        .select('*')\n        .eq('agendamento_id', agendamento.id)\n        .maybeSingle();\n\n      if (error && error.code !== 'PGRST116') throw error;\n      \n      if (data) {\n        setProntuarioAtual(data);\n        const prontuario = data as any;\n        setFormData({\n          queixa_principal: prontuario.queixa_principal || '',\n          historia_doenca_atual: prontuario.historia_doenca_atual || '',\n          historia_pregressa: prontuario.historia_pregressa || '',\n          alergias: prontuario.alergias || [],\n          medicamentos_uso: prontuario.medicamentos_uso || [],\n          historia_familiar: prontuario.historia_familiar || '',\n          historia_social: prontuario.historia_social || '',\n          subjetivo: prontuario.subjetivo || '',\n          objetivo: prontuario.objetivo || '',\n          avaliacao: prontuario.avaliacao || '',\n          plano: prontuario.plano || '',\n          pressao_arterial: prontuario.pressao_arterial || '',\n          frequencia_cardiaca: prontuario.frequencia_cardiaca?.toString() || '',\n          temperatura: prontuario.temperatura?.toString() || '',\n          peso: prontuario.peso?.toString() || '',\n          altura: prontuario.altura?.toString() || '',\n          saturacao_o2: prontuario.saturacao_o2?.toString() || '',\n          cid10_principal: prontuario.cid10_principal || '',\n          hipotese_diagnostica: prontuario.hipotese_diagnostica || '',\n          observacoes: prontuario.observacoes || '',\n          evolucao: prontuario.evolucao || '',\n        });\n      }\n    } catch (error: any) {\n      console.error('Erro ao verificar prontu├írio:', error);\n    }\n  };\n\n  const handleInputChange = (field: string, value: any) => {\n    setFormData(prev => ({ ...prev, [field]: value }));\n  };\n\n  const calcularIMC = () => {\n    const peso = parseFloat(formData.peso);\n    const altura = parseFloat(formData.altura);\n    if (peso && altura && altura > 0) {\n      return (peso / (altura * altura)).toFixed(2);\n    }\n    return null;\n  };\n\n  const handleSave = async (finalizar: boolean = false) => {\n    try {\n      setLoading(true);\n\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) return;\n\n      const { data: profile } = await supabase\n        .from('profiles')\n        .select('tenant_id')\n        .eq('id', user.id)\n        .single();\n\n      if (!profile) return;\n\n      const imc = calcularIMC();\n      const prontuarioData = {\n        tenant_id: profile.tenant_id,\n        paciente_id: agendamento.paciente_id,\n        profissional_id: user.id,\n        agendamento_id: agendamento.id,\n        data_atendimento: new Date().toISOString(),\n        \n        queixa_principal: formData.queixa_principal || null,\n        historia_doenca_atual: formData.historia_doenca_atual || null,\n        historia_pregressa: formData.historia_pregressa || null,\n        alergias: formData.alergias.length > 0 ? formData.alergias : null,\n        medicamentos_uso: formData.medicamentos_uso.length > 0 ? formData.medicamentos_uso : null,\n        historia_familiar: formData.historia_familiar || null,\n        historia_social: formData.historia_social || null,\n        \n        subjetivo: formData.subjetivo || null,\n        objetivo: formData.objetivo || null,\n        avaliacao: formData.avaliacao || null,\n        plano: formData.plano || null,\n        \n        pressao_arterial: formData.pressao_arterial || null,\n        frequencia_cardiaca: formData.frequencia_cardiaca ? parseInt(formData.frequencia_cardiaca) : null,\n        temperatura: formData.temperatura ? parseFloat(formData.temperatura) : null,\n        peso: formData.peso ? parseFloat(formData.peso) : null,\n        altura: formData.altura ? parseFloat(formData.altura) : null,\n        imc: imc ? parseFloat(imc) : null,\n        saturacao_o2: formData.saturacao_o2 ? parseInt(formData.saturacao_o2) : null,\n        \n        cid10_principal: formData.cid10_principal || null,\n        hipotese_diagnostica: formData.hipotese_diagnostica || null,\n        \n        observacoes: formData.observacoes || null,\n        evolucao: formData.evolucao || null,\n        \n        status: finalizar ? 'finalizado' : 'rascunho',\n        finalizado_em: finalizar ? new Date().toISOString() : null,\n      };\n\n      let result;\n      if (prontuarioAtual) {\n        result = await supabase\n          .from('prontuarios' as any)\n          .update(prontuarioData)\n          .eq('id', prontuarioAtual.id)\n          .select()\n          .single();\n      } else {\n        result = await supabase\n          .from('prontuarios' as any)\n          .insert(prontuarioData)\n          .select()\n          .single();\n      }\n\n      if (result.error) throw result.error;\n\n      // Atualizar status do agendamento\n      if (finalizar) {\n        await supabase\n          .from('agenda')\n          .update({ status: 'concluido' })\n          .eq('id', agendamento.id);\n      } else {\n        await supabase\n          .from('agenda')\n          .update({ status: 'em_atendimento' })\n          .eq('id', agendamento.id);\n      }\n\n      toast.success(finalizar ? 'Prontu├írio finalizado com sucesso' : 'Rascunho salvo');\n      \n      if (finalizar) {\n        onClose();\n      } else {\n        setProntuarioAtual(result.data);\n      }\n    } catch (error: any) {\n      console.error('Erro ao salvar prontu├írio:', error);\n      toast.error('Erro ao salvar prontu├írio');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const isPrimeiraConsulta = historico.length === 0;\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <div className=\"flex items-center gap-4\">\n          <Button variant=\"ghost\" size=\"icon\" onClick={onClose}>\n            <ArrowLeft className=\"h-4 w-4\" />\n          </Button>\n          <div>\n            <h2 className=\"text-2xl font-bold\">{pacienteInfo?.nome}</h2>\n            <p className=\"text-sm text-muted-foreground\">\n              {format(new Date(agendamento.inicio), \"dd 'de' MMMM 'de' yyyy '├ás' HH:mm\", { locale: ptBR })}\n            </p>\n          </div>\n        </div>\n        <div className=\"flex gap-2\">\n          <Button \n            variant=\"outline\" \n            onClick={() => handleSave(false)}\n            disabled={loading}\n          >\n            <Save className=\"h-4 w-4 mr-2\" />\n            Salvar Rascunho\n          </Button>\n          <Button \n            onClick={() => handleSave(true)}\n            disabled={loading}\n          >\n            <FileCheck className=\"h-4 w-4 mr-2\" />\n            Finalizar Atendimento\n          </Button>\n        </div>\n      </div>\n\n      {/* Temporizador de Atendimento */}\n      <AtendimentoTimer \n        inicioAtendimento={new Date(agendamento.inicio)}\n        duracaoMinutos={agendamento.servicos?.duracao_minutos || 60}\n        proximoAtendimento={proximoAgendamento}\n      />\n\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"flex items-center gap-2\">\n            <Activity className=\"h-5 w-5\" />\n            Dados Vitais\n          </CardTitle>\n        </CardHeader>\n        <CardContent>\n          <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n            <div>\n              <Label>Press├úo Arterial</Label>\n              <Input\n                placeholder=\"120/80\"\n                value={formData.pressao_arterial}\n                onChange={(e) => handleInputChange('pressao_arterial', e.target.value)}\n              />\n            </div>\n            <div>\n              <Label>FC (bpm)</Label>\n              <Input\n                type=\"number\"\n                placeholder=\"72\"\n                value={formData.frequencia_cardiaca}\n                onChange={(e) => handleInputChange('frequencia_cardiaca', e.target.value)}\n              />\n            </div>\n            <div>\n              <Label>Temperatura (┬░C)</Label>\n              <Input\n                type=\"number\"\n                step=\"0.1\"\n                placeholder=\"36.5\"\n                value={formData.temperatura}\n                onChange={(e) => handleInputChange('temperatura', e.target.value)}\n              />\n            </div>\n            <div>\n              <Label>SpO2 (%)</Label>\n              <Input\n                type=\"number\"\n                placeholder=\"98\"\n                value={formData.saturacao_o2}\n                onChange={(e) => handleInputChange('saturacao_o2', e.target.value)}\n              />\n            </div>\n            <div>\n              <Label>Peso (kg)</Label>\n              <Input\n                type=\"number\"\n                step=\"0.01\"\n                placeholder=\"70\"\n                value={formData.peso}\n                onChange={(e) => handleInputChange('peso', e.target.value)}\n              />\n            </div>\n            <div>\n              <Label>Altura (m)</Label>\n              <Input\n                type=\"number\"\n                step=\"0.01\"\n                placeholder=\"1.75\"\n                value={formData.altura}\n                onChange={(e) => handleInputChange('altura', e.target.value)}\n              />\n            </div>\n            <div>\n              <Label>IMC</Label>\n              <Input\n                value={calcularIMC() || 'ÔÇö'}\n                disabled\n                className=\"bg-muted\"\n              />\n            </div>\n          </div>\n        </CardContent>\n      </Card>\n\n      <Tabs defaultValue={isPrimeiraConsulta ? \"anamnese\" : \"soap\"}>\n        <TabsList className=\"grid w-full grid-cols-3\">\n          {isPrimeiraConsulta && (\n            <TabsTrigger value=\"anamnese\">\n              <ClipboardList className=\"h-4 w-4 mr-2\" />\n              Anamnese\n            </TabsTrigger>\n          )}\n          <TabsTrigger value=\"soap\">\n            <Stethoscope className=\"h-4 w-4 mr-2\" />\n            SOAP\n          </TabsTrigger>\n          <TabsTrigger value=\"historico\">\n            <History className=\"h-4 w-4 mr-2\" />\n            Hist├│rico ({historico.length})\n          </TabsTrigger>\n        </TabsList>\n\n        {isPrimeiraConsulta && (\n          <TabsContent value=\"anamnese\" className=\"space-y-4\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Anamnese - Primeira Consulta</CardTitle>\n              </CardHeader>\n              <CardContent className=\"space-y-4\">\n                <div>\n                  <Label>Queixa Principal</Label>\n                  <Textarea\n                    placeholder=\"Motivo da consulta...\"\n                    value={formData.queixa_principal}\n                    onChange={(e) => handleInputChange('queixa_principal', e.target.value)}\n                    rows={3}\n                  />\n                </div>\n                <div>\n                  <Label>Hist├│ria da Doen├ºa Atual</Label>\n                  <Textarea\n                    placeholder=\"Descreva a evolu├º├úo dos sintomas...\"\n                    value={formData.historia_doenca_atual}\n                    onChange={(e) => handleInputChange('historia_doenca_atual', e.target.value)}\n                    rows={4}\n                  />\n                </div>\n                <div>\n                  <Label>Hist├│ria Patol├│gica Pregressa</Label>\n                  <Textarea\n                    placeholder=\"Doen├ºas anteriores, cirurgias, interna├º├Áes...\"\n                    value={formData.historia_pregressa}\n                    onChange={(e) => handleInputChange('historia_pregressa', e.target.value)}\n                    rows={3}\n                  />\n                </div>\n                <div className=\"grid grid-cols-2 gap-4\">\n                  <div>\n                    <Label>Alergias</Label>\n                    <Textarea\n                      placeholder=\"Medicamentos, alimentos...\"\n                      value={formData.alergias.join(', ')}\n                      onChange={(e) => handleInputChange('alergias', e.target.value.split(',').map(s => s.trim()).filter(Boolean))}\n                      rows={2}\n                    />\n                  </div>\n                  <div>\n                    <Label>Medicamentos em Uso</Label>\n                    <Textarea\n                      placeholder=\"Liste os medicamentos atuais...\"\n                      value={formData.medicamentos_uso.join(', ')}\n                      onChange={(e) => handleInputChange('medicamentos_uso', e.target.value.split(',').map(s => s.trim()).filter(Boolean))}\n                      rows={2}\n                    />\n                  </div>\n                </div>\n                <div>\n                  <Label>Hist├│ria Familiar</Label>\n                  <Textarea\n                    placeholder=\"Doen├ºas na fam├¡lia...\"\n                    value={formData.historia_familiar}\n                    onChange={(e) => handleInputChange('historia_familiar', e.target.value)}\n                    rows={2}\n                  />\n                </div>\n                <div>\n                  <Label>Hist├│ria Social</Label>\n                  <Textarea\n                    placeholder=\"H├íbitos, profiss├úo, estilo de vida...\"\n                    value={formData.historia_social}\n                    onChange={(e) => handleInputChange('historia_social', e.target.value)}\n                    rows={2}\n                  />\n                </div>\n              </CardContent>\n            </Card>\n          </TabsContent>\n        )}\n\n        <TabsContent value=\"soap\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Registro SOAP</CardTitle>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div>\n                <Label>S - Subjetivo</Label>\n                <p className=\"text-xs text-muted-foreground mb-2\">\n                  Queixas e sintomas relatados pelo paciente\n                </p>\n                <Textarea\n                  placeholder=\"Paciente relata...\"\n                  value={formData.subjetivo}\n                  onChange={(e) => handleInputChange('subjetivo', e.target.value)}\n                  rows={4}\n                />\n              </div>\n\n              <div>\n                <Label>O - Objetivo</Label>\n                <p className=\"text-xs text-muted-foreground mb-2\">\n                  Achados do exame f├¡sico e dados objetivos\n                </p>\n                <Textarea\n                  placeholder=\"Ao exame f├¡sico...\"\n                  value={formData.objetivo}\n                  onChange={(e) => handleInputChange('objetivo', e.target.value)}\n                  rows={4}\n                />\n              </div>\n\n              <div>\n                <Label>A - Avalia├º├úo</Label>\n                <p className=\"text-xs text-muted-foreground mb-2\">\n                  Impress├úo diagn├│stica e racioc├¡nio cl├¡nico\n                </p>\n                <Textarea\n                  placeholder=\"Hip├│tese diagn├│stica...\"\n                  value={formData.avaliacao}\n                  onChange={(e) => handleInputChange('avaliacao', e.target.value)}\n                  rows={4}\n                />\n              </div>\n\n              <div>\n                <Label>P - Plano</Label>\n                <p className=\"text-xs text-muted-foreground mb-2\">\n                  Conduta terap├¬utica e orienta├º├Áes\n                </p>\n                <Textarea\n                  placeholder=\"Prescri├º├Áes, exames, orienta├º├Áes...\"\n                  value={formData.plano}\n                  onChange={(e) => handleInputChange('plano', e.target.value)}\n                  rows={5}\n                />\n              </div>\n\n              <Separator />\n\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div>\n                  <Label>CID-10 Principal</Label>\n                  <Input\n                    placeholder=\"Ex: J00\"\n                    value={formData.cid10_principal}\n                    onChange={(e) => handleInputChange('cid10_principal', e.target.value)}\n                  />\n                </div>\n                <div>\n                  <Label>Hip├│tese Diagn├│stica</Label>\n                  <Input\n                    placeholder=\"Ex: Rinofaringite aguda\"\n                    value={formData.hipotese_diagnostica}\n                    onChange={(e) => handleInputChange('hipotese_diagnostica', e.target.value)}\n                  />\n                </div>\n              </div>\n\n              <div>\n                <Label>Observa├º├Áes Adicionais</Label>\n                <Textarea\n                  placeholder=\"Informa├º├Áes complementares...\"\n                  value={formData.observacoes}\n                  onChange={(e) => handleInputChange('observacoes', e.target.value)}\n                  rows={3}\n                />\n              </div>\n\n              <div>\n                <Label>Evolu├º├úo do Quadro</Label>\n                <Textarea\n                  placeholder=\"Evolu├º├úo desde o ├║ltimo atendimento...\"\n                  value={formData.evolucao}\n                  onChange={(e) => handleInputChange('evolucao', e.target.value)}\n                  rows={3}\n                />\n              </div>\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        <TabsContent value=\"historico\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Hist├│rico de Atendimentos</CardTitle>\n            </CardHeader>\n            <CardContent>\n              {historicoLoading ? (\n                <p className=\"text-center text-muted-foreground py-8\">Carregando hist├│rico...</p>\n              ) : historico.length === 0 ? (\n                <p className=\"text-center text-muted-foreground py-8\">\n                  Nenhum atendimento anterior registrado\n                </p>\n              ) : (\n                <ScrollArea className=\"h-[500px]\">\n                  <div className=\"space-y-4\">\n                    {historico.map((registro) => (\n                      <Card key={registro.id} className=\"border-l-4 border-l-primary\">\n                        <CardContent className=\"p-4\">\n                          <div className=\"flex items-start justify-between mb-3\">\n                            <div className=\"flex items-center gap-2\">\n                              <Clock className=\"h-4 w-4 text-muted-foreground\" />\n                              <span className=\"font-medium\">\n                                {format(new Date(registro.data_atendimento), \"dd/MM/yyyy '├ás' HH:mm\", { locale: ptBR })}\n                              </span>\n                            </div>\n                            <Badge variant={registro.status === 'finalizado' ? 'default' : 'secondary'}>\n                              {registro.status}\n                            </Badge>\n                          </div>\n\n                          {registro.subjetivo && (\n                            <div className=\"mb-2\">\n                              <p className=\"text-sm font-medium text-muted-foreground\">Subjetivo:</p>\n                              <p className=\"text-sm\">{registro.subjetivo}</p>\n                            </div>\n                          )}\n\n                          {registro.avaliacao && (\n                            <div className=\"mb-2\">\n                              <p className=\"text-sm font-medium text-muted-foreground\">Avalia├º├úo:</p>\n                              <p className=\"text-sm\">{registro.avaliacao}</p>\n                            </div>\n                          )}\n\n                          {registro.plano && (\n                            <div className=\"mb-2\">\n                              <p className=\"text-sm font-medium text-muted-foreground\">Plano:</p>\n                              <p className=\"text-sm\">{registro.plano}</p>\n                            </div>\n                          )}\n\n                          {registro.cid10_principal && (\n                            <div className=\"mt-3 pt-3 border-t\">\n                              <Badge variant=\"outline\">\n                                CID-10: {registro.cid10_principal}\n                                {registro.hipotese_diagnostica && ` - ${registro.hipotese_diagnostica}`}\n                              </Badge>\n                            </div>\n                          )}\n                        </CardContent>\n                      </Card>\n                    ))}\n                  </div>\n                </ScrollArea>\n              )}\n            </CardContent>\n          </Card>\n        </TabsContent>\n      </Tabs>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\auth\\RequireRole.tsx","messages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":43,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":43,"endColumn":32},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":58,"column":14,"nodeType":"Identifier","messageId":"namedExport","endLine":58,"endColumn":24}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { Navigate } from 'react-router-dom';\nimport { useAuth } from '@/hooks/useAuth';\nimport { useUserRoles, AppRole } from '@/hooks/useUserRoles';\nimport { AccessDenied } from '@/pages/AccessDenied';\n\ninterface RequireRoleProps {\n  roles: AppRole[];\n  children: React.ReactNode;\n  redirectTo?: string;\n}\n\nexport function RequireRole({ roles, children, redirectTo }: RequireRoleProps) {\n  const { user, loading: authLoading } = useAuth();\n  const { hasRole, isLoading: rolesLoading } = useUserRoles();\n\n  // Show loading while checking auth and roles\n  if (authLoading || rolesLoading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-screen\">\n        <p className=\"text-muted-foreground\">Verificando permiss├Áes...</p>\n      </div>\n    );\n  }\n\n  // Redirect to login if not authenticated\n  if (!user) {\n    return <Navigate to=\"/login\" replace />;\n  }\n\n  // Check if user has required role\n  if (!hasRole(roles)) {\n    if (redirectTo) {\n      return <Navigate to={redirectTo} replace />;\n    }\n    return <AccessDenied />;\n  }\n\n  return <>{children}</>;\n}\n\n// HOC version for wrapping components\nexport function withRequireRole<P extends object>(\n  WrappedComponent: React.ComponentType<P>,\n  roles: AppRole[],\n  redirectTo?: string\n) {\n  return function WithRoleComponent(props: P) {\n    return (\n      <RequireRole roles={roles} redirectTo={redirectTo}>\n        <WrappedComponent {...props} />\n      </RequireRole>\n    );\n  };\n}\n\n// Route guard presets for common patterns\nexport const RoleGuards = {\n  // Financial routes - financeiro_tenant, admin_tenant, org_finance, org_admin\n  financial: ['financeiro_tenant', 'admin_tenant', 'org_finance', 'org_admin'] as AppRole[],\n  \n  // Support routes - suporte, admin_tenant, org_admin\n  support: ['suporte', 'admin_tenant', 'org_admin'] as AppRole[],\n  \n  // Configuration routes - admin_tenant, org_admin\n  config: ['admin_tenant', 'org_admin'] as AppRole[],\n  \n  // Any admin (tenant or org level)\n  anyAdmin: ['admin_tenant', 'org_admin', 'unit_admin'] as AppRole[],\n  \n  // Organization level only\n  orgLevel: ['org_admin', 'org_finance'] as AppRole[],\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\beauty\\BeautyDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\billing\\BillingBanner.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\common\\DynamicForm.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\configuracoes\\FelicitacoesConfig.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\configuracoes\\FinanceiroConfig.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\configuracoes\\PlanosConfig.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchData'. Either include it or remove the dependency array.","line":56,"column":8,"nodeType":"ArrayExpression","endLine":56,"endColumn":28,"suggestions":[{"desc":"Update the dependencies array to be: [fetchData, profile.tenant_id]","fix":{"range":[1982,2002],"text":"[fetchData, profile.tenant_id]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Card } from \"@/components/ui/card\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter } from \"@/components/ui/dialog\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport { useToast } from \"@/hooks/use-toast\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useAuth } from \"@/hooks/useAuth\";\r\nimport { Check, Loader2, AlertTriangle } from \"lucide-react\";\r\n\r\ninterface Plan {\r\n    codigo_plano: string;\r\n    descricao: string;\r\n    preco_mensal_brl: number;\r\n    moeda: string;\r\n    ativo: boolean;\r\n    features: string[]; // Mocked for now\r\n}\r\n\r\ninterface Subscription {\r\n    id: string;\r\n    codigo_plano: string;\r\n    status: string;\r\n    ciclo_fim: string;\r\n    edition: string;\r\n}\r\n\r\ninterface PreviewData {\r\n    current_plan: { name: string; price: number };\r\n    new_plan: { name: string; price: number };\r\n    prorata_amount: number;\r\n    total_now: number;\r\n    next_cycle_total: number;\r\n    effective_date: string;\r\n}\r\n\r\nconst PlanosConfig = () => {\r\n    const { profile } = useAuth();\r\n    const { toast } = useToast();\r\n    const [loading, setLoading] = useState(true);\r\n    const [subscription, setSubscription] = useState<Subscription | null>(null);\r\n    const [plans, setPlans] = useState<Plan[]>([]);\r\n\r\n    const [selectedPlan, setSelectedPlan] = useState<Plan | null>(null);\r\n    const [isDialogOpen, setIsDialogOpen] = useState(false);\r\n    const [previewData, setPreviewData] = useState<PreviewData | null>(null);\r\n    const [loadingPreview, setLoadingPreview] = useState(false);\r\n    const [processingChange, setProcessingChange] = useState(false);\r\n\r\n    const [companySeats, setCompanySeats] = useState(5); // Default included\r\n\r\n    useEffect(() => {\r\n        fetchData();\r\n    }, [profile?.tenant_id]);\r\n\r\n    const fetchData = async () => {\r\n        if (!profile?.tenant_id) return;\r\n        try {\r\n            setLoading(true);\r\n\r\n            // Fetch Plans\r\n            const { data: plansData } = await supabase\r\n                .from('planos_precos')\r\n                .select('*')\r\n                .eq('ativo', true)\r\n                .order('preco_mensal_brl');\r\n\r\n            // Add mock features\r\n            const plansWithFeatures = plansData?.map(p => ({\r\n                ...p,\r\n                features: getFeaturesForPlan(p.codigo_plano)\r\n            })) || [];\r\n\r\n            setPlans(plansWithFeatures);\r\n\r\n            // Fetch Subscription\r\n            const { data: subData } = await supabase\r\n                .from('assinaturas')\r\n                .select('*')\r\n                .eq('tenant_id', profile.tenant_id)\r\n                .in('status', ['active', 'trialing', 'past_due'])\r\n                .single();\r\n\r\n            setSubscription(subData);\r\n\r\n            // If company plan, fetch current seats\r\n            if (subData?.codigo_plano === 'company_base') {\r\n                const { data: seatData } = await supabase\r\n                    .from('assinatura_seats')\r\n                    .select('quantidade')\r\n                    .eq('assinatura_id', subData.id)\r\n                    .eq('tipo', 'profissional')\r\n                    .single();\r\n\r\n                if (seatData) setCompanySeats(seatData.quantidade);\r\n            }\r\n\r\n        } catch (error) {\r\n            console.error(\"Error fetching billing data:\", error);\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const getFeaturesForPlan = (code: string) => {\r\n        switch (code) {\r\n            case 'free_solo': return ['1 Profissional', 'At├® 50 Clientes', 'Agendamento Manual'];\r\n            case 'pro_solo': return ['1 Profissional', 'Clientes Ilimitados', 'WhatsApp Autom├ítico', 'Agendamento Online'];\r\n            case 'company_base': return ['At├® 5 Profissionais (Inclusos)', '3 Secret├írias', 'Multi-usu├írio', 'Relat├│rios Avan├ºados'];\r\n            default: return [];\r\n        }\r\n    };\r\n\r\n    const handleSelectPlan = (plan: Plan) => {\r\n        setSelectedPlan(plan);\r\n        setIsDialogOpen(true);\r\n        // If selecting company, reset seats to min or current if already company\r\n        if (plan.codigo_plano === 'company_base') {\r\n            // If already company, keep current seats, else default to 5\r\n            if (subscription?.codigo_plano === 'company_base') {\r\n                // Keep current (already in state)\r\n            } else {\r\n                setCompanySeats(5);\r\n            }\r\n        }\r\n        fetchPreview(plan, plan.codigo_plano === 'company_base' ? companySeats : undefined);\r\n    };\r\n\r\n    const fetchPreview = async (plan: Plan, seats?: number) => {\r\n        if (!subscription) return;\r\n\r\n        // Determine if downgrade\r\n        const currentPlanPrice = plans.find(p => p.codigo_plano === subscription.codigo_plano)?.preco_mensal_brl || 0;\r\n        const isDowngrade = plan.preco_mensal_brl < currentPlanPrice;\r\n        const effective = isDowngrade ? 'next_cycle' : 'immediate';\r\n\r\n        setLoadingPreview(true);\r\n        try {\r\n            const { data, error } = await supabase.functions.invoke('billing-ops', {\r\n                body: {\r\n                    action: 'preview_change',\r\n                    tenantId: profile?.tenant_id,\r\n                    subscriptionId: subscription.id,\r\n                    newPlanCode: plan.codigo_plano,\r\n                    newSeats: seats ? { profissional: seats } : {},\r\n                    effective: effective\r\n                }\r\n            });\r\n\r\n            if (error) throw error;\r\n            setPreviewData(data);\r\n        } catch (error) {\r\n            console.error(\"Error fetching preview:\", error);\r\n            toast({\r\n                title: \"Erro ao calcular valores\",\r\n                description: \"Tente novamente mais tarde.\",\r\n                variant: \"destructive\"\r\n            });\r\n        } finally {\r\n            setLoadingPreview(false);\r\n        }\r\n    };\r\n\r\n    const handleConfirmChange = async () => {\r\n        if (!subscription || !selectedPlan || !previewData) return;\r\n        setProcessingChange(true);\r\n        try {\r\n            // If changing plan\r\n            if (selectedPlan.codigo_plano !== subscription.codigo_plano) {\r\n                const currentPlanPrice = plans.find(p => p.codigo_plano === subscription.codigo_plano)?.preco_mensal_brl || 0;\r\n                const isDowngrade = selectedPlan.preco_mensal_brl < currentPlanPrice;\r\n                const effective = isDowngrade ? 'next_cycle' : 'immediate';\r\n\r\n                const { error } = await supabase.functions.invoke('billing-ops', {\r\n                    body: {\r\n                        action: 'change_plan',\r\n                        tenantId: profile?.tenant_id,\r\n                        subscriptionId: subscription.id,\r\n                        newPlanCode: selectedPlan.codigo_plano,\r\n                        effective: effective\r\n                    }\r\n                });\r\n                if (error) throw error;\r\n            }\r\n\r\n            // If company plan and seats changed (or just switched to company)\r\n            if (selectedPlan.codigo_plano === 'company_base') {\r\n                const { error } = await supabase.functions.invoke('billing-ops', {\r\n                    body: {\r\n                        action: 'change_seats',\r\n                        tenantId: profile?.tenant_id,\r\n                        subscriptionId: subscription.id,\r\n                        type: 'profissional',\r\n                        newQuantity: companySeats\r\n                    }\r\n                });\r\n                if (error) throw error;\r\n            }\r\n\r\n            toast({\r\n                title: \"Plano alterado com sucesso!\",\r\n                description: \"As altera├º├Áes j├í est├úo em vigor.\"\r\n            });\r\n            setIsDialogOpen(false);\r\n            fetchData(); // Refresh\r\n        } catch (error) {\r\n            console.error(\"Error changing plan:\", error);\r\n            toast({\r\n                title: \"Erro ao alterar plano\",\r\n                description: \"N├úo foi poss├¡vel processar a altera├º├úo.\",\r\n                variant: \"destructive\"\r\n            });\r\n        } finally {\r\n            setProcessingChange(false);\r\n        }\r\n    };\r\n\r\n    if (loading) {\r\n        return <div className=\"flex justify-center p-8\"><Loader2 className=\"animate-spin\" /></div>;\r\n    }\r\n\r\n    return (\r\n        <div className=\"space-y-6\">\r\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\r\n                {plans.map((plan) => {\r\n                    const isCurrent = subscription?.codigo_plano === plan.codigo_plano;\r\n                    return (\r\n                        <Card key={plan.codigo_plano} className={`p-6 flex flex-col ${isCurrent ? 'border-primary ring-1 ring-primary' : ''}`}>\r\n                            <div className=\"flex justify-between items-start mb-4\">\r\n                                <div>\r\n                                    <h3 className=\"text-xl font-bold\">{plan.descricao}</h3>\r\n                                    <p className=\"text-2xl font-bold mt-2\">\r\n                                        R$ {plan.preco_mensal_brl.toFixed(2)}\r\n                                        <span className=\"text-sm font-normal text-muted-foreground\">/m├¬s</span>\r\n                                    </p>\r\n                                </div>\r\n                                {isCurrent && <Badge>Atual</Badge>}\r\n                            </div>\r\n\r\n                            <ul className=\"space-y-2 mb-6 flex-1\">\r\n                                {plan.features.map((feature, idx) => (\r\n                                    <li key={idx} className=\"flex items-center text-sm\">\r\n                                        <Check className=\"h-4 w-4 text-green-500 mr-2\" />\r\n                                        {feature}\r\n                                    </li>\r\n                                ))}\r\n                            </ul>\r\n\r\n                            <Button\r\n                                variant={isCurrent ? \"outline\" : \"default\"}\r\n                                className=\"w-full\"\r\n                                onClick={() => handleSelectPlan(plan)}\r\n                                disabled={isCurrent && plan.codigo_plano !== 'company_base'} // Allow clicking current if company (to change seats)\r\n                            >\r\n                                {isCurrent ? (plan.codigo_plano === 'company_base' ? \"Gerenciar Seats\" : \"Plano Atual\") : \"Selecionar Plano\"}\r\n                            </Button>\r\n                        </Card>\r\n                    );\r\n                })}\r\n            </div>\r\n\r\n            <Dialog open={isDialogOpen} onOpenChange={setIsDialogOpen}>\r\n                <DialogContent className=\"sm:max-w-[500px]\">\r\n                    <DialogHeader>\r\n                        <DialogTitle>Confirmar Altera├º├úo de Plano</DialogTitle>\r\n                        <DialogDescription>\r\n                            Revise os detalhes da altera├º├úo antes de confirmar.\r\n                        </DialogDescription>\r\n                    </DialogHeader>\r\n\r\n                    {selectedPlan?.codigo_plano === 'company_base' && (\r\n                        <div className=\"py-4 border-b\">\r\n                            <Label>N├║mero de Profissionais</Label>\r\n                            <div className=\"flex items-center gap-4 mt-2\">\r\n                                <Button\r\n                                    variant=\"outline\"\r\n                                    size=\"sm\"\r\n                                    onClick={() => {\r\n                                        const newVal = Math.max(1, companySeats - 1);\r\n                                        setCompanySeats(newVal);\r\n                                        fetchPreview(selectedPlan, newVal);\r\n                                    }}\r\n                                >-</Button>\r\n                                <span className=\"text-lg font-bold\">{companySeats}</span>\r\n                                <Button\r\n                                    variant=\"outline\"\r\n                                    size=\"sm\"\r\n                                    onClick={() => {\r\n                                        const newVal = companySeats + 1;\r\n                                        setCompanySeats(newVal);\r\n                                        fetchPreview(selectedPlan, newVal);\r\n                                    }}\r\n                                >+</Button>\r\n                            </div>\r\n                            <p className=\"text-sm text-muted-foreground mt-2\">\r\n                                {companySeats <= 5 ? \"Incluso no plano (at├® 5)\" : `${companySeats - 5} profissional(is) extra(s)`}\r\n                            </p>\r\n                        </div>\r\n                    )}\r\n\r\n                    {loadingPreview ? (\r\n                        <div className=\"py-8 flex justify-center\"><Loader2 className=\"animate-spin\" /></div>\r\n                    ) : previewData ? (\r\n                        <div className=\"space-y-4 py-4\">\r\n                            <div className=\"flex justify-between text-sm\">\r\n                                <span>Plano Atual:</span>\r\n                                <span className=\"font-medium\">{previewData.current_plan.name}</span>\r\n                            </div>\r\n                            <div className=\"flex justify-between text-sm\">\r\n                                <span>Novo Plano:</span>\r\n                                <span className=\"font-medium\">{previewData.new_plan.name}</span>\r\n                            </div>\r\n\r\n                            <div className=\"border-t pt-2 mt-2\">\r\n                                <div className=\"flex justify-between text-sm\">\r\n                                    <span>Valor Pr├│-rata (Hoje):</span>\r\n                                    <span className=\"font-bold text-primary\">R$ {previewData.total_now.toFixed(2)}</span>\r\n                                </div>\r\n                                <p className=\"text-xs text-muted-foreground\">Cobrado imediatamente no cart├úo cadastrado.</p>\r\n                            </div>\r\n\r\n                            <div className=\"bg-muted p-3 rounded-md mt-2\">\r\n                                <div className=\"flex justify-between text-sm font-medium\">\r\n                                    <span>Pr├│xima Mensalidade:</span>\r\n                                    <span>R$ {previewData.next_cycle_total.toFixed(2)}</span>\r\n                                </div>\r\n                                <p className=\"text-xs text-muted-foreground mt-1\">A partir de {new Date(previewData.effective_date).toLocaleDateString()}</p>\r\n                            </div>\r\n                        </div>\r\n                    ) : (\r\n                        <div className=\"py-4 text-center text-red-500\">Erro ao carregar preview.</div>\r\n                    )}\r\n\r\n                    <DialogFooter>\r\n                        <Button variant=\"outline\" onClick={() => setIsDialogOpen(false)}>Cancelar</Button>\r\n                        <Button onClick={handleConfirmChange} disabled={processingChange || loadingPreview}>\r\n                            {processingChange ? <Loader2 className=\"animate-spin mr-2\" /> : null}\r\n                            Confirmar Altera├º├úo\r\n                        </Button>\r\n                    </DialogFooter>\r\n                </DialogContent>\r\n            </Dialog>\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default PlanosConfig;\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\configuracoes\\SegmentoConfig.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchCurrentSegment'. Either include it or remove the dependency array.","line":35,"column":6,"nodeType":"ArrayExpression","endLine":35,"endColumn":26,"suggestions":[{"desc":"Update the dependencies array to be: [fetchCurrentSegment, profile.tenant_id]","fix":{"range":[1429,1449],"text":"[fetchCurrentSegment, profile.tenant_id]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from 'react';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Badge } from '@/components/ui/badge';\nimport { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';\nimport {\n  Stethoscope,\n  Sparkles,\n  Dog,\n  Scissors,\n  GraduationCap,\n  Wrench,\n  Loader2,\n  Info,\n  Lock\n} from 'lucide-react';\nimport { supabase } from '@/integrations/supabase/client';\nimport { useAuth } from '@/hooks/useAuth';\n\nconst SEGMENTOS = [\n  { codigo: 'saude', nome: 'Sa├║de', icone: Stethoscope, descricao: 'Cl├¡nicas, consult├│rios m├®dicos' },\n  { codigo: 'estetica', nome: 'Est├®tica & Beleza', icone: Sparkles, descricao: 'Est├║dios, SPAs, sal├Áes' },\n  { codigo: 'veterinaria', nome: 'Veterin├íria', icone: Dog, descricao: 'Cl├¡nicas veterin├írias, pet shops' },\n  { codigo: 'odontologia', nome: 'Odontologia', icone: Scissors, descricao: 'Consult├│rios odontol├│gicos' },\n  { codigo: 'educacao', nome: 'Educa├º├úo & Cursos', icone: GraduationCap, descricao: 'Escolas, cursos, treinamentos' },\n  { codigo: 'oficina', nome: 'Oficina & Servi├ºos', icone: Wrench, descricao: 'Mec├ónicas, assist├¬ncias t├®cnicas' },\n];\n\nexport default function SegmentoConfig() {\n  const { profile } = useAuth();\n  const [segmentoAtual, setSegmentoAtual] = useState<string>('');\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetchCurrentSegment();\n  }, [profile?.tenant_id]);\n\n  const fetchCurrentSegment = async () => {\n    if (!profile?.tenant_id) return;\n\n    try {\n      const { data, error } = await supabase\n        .from('tenant_profile')\n        .select('segmentos')\n        .eq('tenant_id', profile.tenant_id)\n        .single();\n\n      if (error) throw error;\n\n      const segmentos = data?.segmentos as Array<{ codigo: string }> | null;\n      const codigo = segmentos?.[0]?.codigo || '';\n      setSegmentoAtual(codigo);\n    } catch (error) {\n      console.error('Error fetching segment:', error);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const segmentoInfo = SEGMENTOS.find(s => s.codigo === segmentoAtual);\n\n  if (loading) {\n    return (\n      <Card>\n        <CardContent className=\"flex items-center justify-center py-8\">\n          <Loader2 className=\"h-6 w-6 animate-spin text-muted-foreground\" />\n        </CardContent>\n      </Card>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <Alert>\n        <Info className=\"h-4 w-4\" />\n        <AlertTitle>Configura├º├úo Permanente</AlertTitle>\n        <AlertDescription>\n          O segmento de atua├º├úo define a estrutura de dados e terminologias do sistema.\n          Para garantir a integridade das suas informa├º├Áes, ele n├úo pode ser alterado ap├│s a cria├º├úo da conta.\n        </AlertDescription>\n      </Alert>\n\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"flex items-center gap-2\">\n            {segmentoInfo && <segmentoInfo.icone className=\"h-5 w-5\" />}\n            Segmento do Neg├│cio\n          </CardTitle>\n          <CardDescription>\n            Seu ambiente est├í configurado para o seguinte segmento:\n          </CardDescription>\n        </CardHeader>\n        <CardContent>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3\">\n            {SEGMENTOS.map(seg => {\n              const Icon = seg.icone;\n              const isCurrent = segmentoAtual === seg.codigo;\n\n              return (\n                <div\n                  key={seg.codigo}\n                  className={`p-4 rounded-lg border-2 transition-all relative ${isCurrent\n                      ? 'border-primary bg-primary/5'\n                      : 'border-border opacity-50 grayscale'\n                    }`}\n                >\n                  {!isCurrent && (\n                    <div className=\"absolute top-2 right-2\">\n                      <Lock className=\"h-4 w-4 text-muted-foreground\" />\n                    </div>\n                  )}\n\n                  <div className=\"flex items-start gap-3\">\n                    <div className={`p-2 rounded-lg ${isCurrent ? 'bg-primary text-primary-foreground' : 'bg-muted'}`}>\n                      <Icon className=\"h-5 w-5\" />\n                    </div>\n                    <div className=\"flex-1 min-w-0\">\n                      <div className=\"flex items-center gap-2\">\n                        <h4 className=\"font-medium truncate\">{seg.nome}</h4>\n                        {isCurrent && <Badge variant=\"default\" className=\"text-xs\">Atual</Badge>}\n                      </div>\n                      <p className=\"text-sm text-muted-foreground truncate\">{seg.descricao}</p>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </CardContent>\n      </Card>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\dashboard\\AppointmentCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\dashboard\\DashboardOverview.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\dashboard\\StatsCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\dashboard\\WhatsAppCreditsWidget.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\erros\\ErrorBoundary.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\financeiro\\ContasPix.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\financeiro\\ContasReceber.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\financeiro\\FormasPagamento.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\financeiro\\PlanoSaudeValores.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\financial\\CommissionSettings.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchData'. Either include it or remove the dependency array.","line":33,"column":8,"nodeType":"ArrayExpression","endLine":33,"endColumn":10,"suggestions":[{"desc":"Update the dependencies array to be: [fetchData]","fix":{"range":[1009,1011],"text":"[fetchData]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\r\nimport { useState, useEffect } from 'react';\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { Button } from '@/components/ui/button';\r\nimport { Input } from '@/components/ui/input';\r\nimport { Label } from '@/components/ui/label';\r\nimport { useToast } from '@/components/ui/use-toast';\r\nimport { Card } from '@/components/ui/card';\r\nimport { Loader2 } from 'lucide-react';\r\n\r\ninterface Professional {\r\n    id: string;\r\n    nome: string;\r\n    email: string;\r\n}\r\n\r\ninterface CommissionConfig {\r\n    id?: string;\r\n    professional_id: string;\r\n    percentage: number;\r\n    fixed_value: number;\r\n}\r\n\r\nexport function CommissionSettings() {\r\n    const [professionals, setProfessionals] = useState<Professional[]>([]);\r\n    const [configs, setConfigs] = useState<Record<string, CommissionConfig>>({});\r\n    const [loading, setLoading] = useState(true);\r\n    const [saving, setSaving] = useState(false);\r\n    const { toast } = useToast();\r\n\r\n    useEffect(() => {\r\n        fetchData();\r\n    }, []);\r\n\r\n    const fetchData = async () => {\r\n        setLoading(true);\r\n        try {\r\n            // 1. Fetch professionals linked to this tenant\r\n            // Assuming we can get profiles with role 'professional' and same tenant\r\n            const { data: profiles, error: profilesError } = await supabase\r\n                .from('profiles')\r\n                .select('id, nome, email')\r\n                .eq('role', 'professional'); // Filter by tenant_id is handled by RLS usually, but let's be safe if needed\r\n\r\n            if (profilesError) throw profilesError;\r\n\r\n            // 2. Fetch existing commission configs\r\n            const { data: commissionConfigs, error: configError } = await supabase\r\n                .from('professional_commissions')\r\n                .select('*');\r\n\r\n            if (configError) throw configError;\r\n\r\n            const configMap: Record<string, CommissionConfig> = {};\r\n            commissionConfigs?.forEach((c: CommissionConfig) => {\r\n                configMap[c.professional_id] = c;\r\n            });\r\n\r\n            setProfessionals(profiles || []);\r\n            setConfigs(configMap);\r\n\r\n        } catch (error) {\r\n            console.error(\"Error fetching commission data:\", error);\r\n            toast({\r\n                title: \"Erro ao carregar dados\",\r\n                description: \"N├úo foi poss├¡vel carregar as configura├º├Áes de comiss├úo.\",\r\n                variant: \"destructive\"\r\n            });\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const handleSave = async (professionalId: string) => {\r\n        setSaving(true);\r\n        try {\r\n            const config = configs[professionalId];\r\n            if (!config) return;\r\n\r\n            const { data: { user } } = await supabase.auth.getUser();\r\n            if (!user) return;\r\n\r\n            // Get tenant_id from profile\r\n            const { data: profile } = await supabase\r\n                .from('profiles')\r\n                .select('tenant_id')\r\n                .eq('id', user.id)\r\n                .single();\r\n\r\n            if (!profile) throw new Error(\"Profile not found\");\r\n\r\n            const payload = {\r\n                tenant_id: profile.tenant_id,\r\n                professional_id: professionalId,\r\n                percentage: config.percentage || 0,\r\n                fixed_value: config.fixed_value || 0\r\n            };\r\n\r\n            const { error } = await supabase\r\n                .from('professional_commissions')\r\n                .upsert(payload, { onConflict: 'tenant_id, professional_id' });\r\n\r\n            if (error) throw error;\r\n\r\n            toast({\r\n                title: \"Sucesso\",\r\n                description: \"Comiss├úo atualizada com sucesso.\"\r\n            });\r\n\r\n        } catch (error) {\r\n            console.error(\"Error saving commission:\", error);\r\n            toast({\r\n                title: \"Erro ao salvar\",\r\n                description: \"N├úo foi poss├¡vel salvar a comiss├úo.\",\r\n                variant: \"destructive\"\r\n            });\r\n        } finally {\r\n            setSaving(false);\r\n        }\r\n    };\r\n\r\n    const handleChange = (professionalId: string, field: 'percentage' | 'fixed_value', value: string) => {\r\n        const numValue = parseFloat(value) || 0;\r\n        setConfigs(prev => ({\r\n            ...prev,\r\n            [professionalId]: {\r\n                ...prev[professionalId],\r\n                professional_id: professionalId,\r\n                [field]: numValue\r\n            }\r\n        }));\r\n    };\r\n\r\n    if (loading) return <div className=\"flex justify-center p-8\"><Loader2 className=\"animate-spin\" /></div>;\r\n\r\n    return (\r\n        <div className=\"space-y-6\">\r\n            <h3 className=\"text-lg font-semibold\">Configura├º├úo de Comiss├Áes</h3>\r\n            <p className=\"text-sm text-muted-foreground\">Defina a porcentagem ou valor fixo que cada profissional recebe por atendimento.</p>\r\n\r\n            <div className=\"grid gap-4\">\r\n                {professionals.map(prof => (\r\n                    <Card key={prof.id} className=\"p-4 flex items-center justify-between gap-4\">\r\n                        <div className=\"flex-1\">\r\n                            <p className=\"font-medium\">{prof.nome || prof.email}</p>\r\n                            <p className=\"text-xs text-muted-foreground\">{prof.email}</p>\r\n                        </div>\r\n\r\n                        <div className=\"flex items-end gap-2\">\r\n                            <div>\r\n                                <Label className=\"text-xs\">Porcentagem (%)</Label>\r\n                                <Input\r\n                                    type=\"number\"\r\n                                    className=\"w-24\"\r\n                                    value={configs[prof.id]?.percentage ?? ''}\r\n                                    onChange={(e) => handleChange(prof.id, 'percentage', e.target.value)}\r\n                                    placeholder=\"0%\"\r\n                                />\r\n                            </div>\r\n                            <div>\r\n                                <Label className=\"text-xs\">Valor Fixo (R$)</Label>\r\n                                <Input\r\n                                    type=\"number\"\r\n                                    className=\"w-24\"\r\n                                    value={configs[prof.id]?.fixed_value ?? ''}\r\n                                    onChange={(e) => handleChange(prof.id, 'fixed_value', e.target.value)}\r\n                                    placeholder=\"R$ 0,00\"\r\n                                />\r\n                            </div>\r\n                            <Button\r\n                                size=\"sm\"\r\n                                onClick={() => handleSave(prof.id)}\r\n                                disabled={saving}\r\n                            >\r\n                                Salvar\r\n                            </Button>\r\n                        </div>\r\n                    </Card>\r\n                ))}\r\n                {professionals.length === 0 && (\r\n                    <p className=\"text-sm text-muted-foreground text-center py-8\">Nenhum profissional encontrado nesta cl├¡nica.</p>\r\n                )}\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{