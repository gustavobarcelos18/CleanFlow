lePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Agenda.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'refetchAppointments'. Either include it or remove the dependency array.","line":210,"column":6,"nodeType":"ArrayExpression","endLine":210,"endColumn":20,"suggestions":[{"desc":"Update the dependencies array to be: [refetchAppointments, selectedDate]","fix":{"range":[6811,6825],"text":"[refetchAppointments, selectedDate]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\r\nimport { MainLayout } from \"@/components/layout/MainLayout\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { DragSchedule } from \"@/components/schedule/DragSchedule\";\r\nimport { AppointmentCard } from \"@/components/dashboard/AppointmentCard\";\r\nimport { NewAppointmentDialog } from \"@/components/schedule/NewAppointmentDialog\";\r\nimport { EditAppointmentDialog } from \"@/components/schedule/EditAppointmentDialog\";\r\nimport { NextDayPreview } from \"@/components/schedule/NextDayPreview\";\r\nimport { MonthlyCalendar } from \"@/components/schedule/MonthlyCalendar\";\r\nimport { DigitalClock } from \"@/components/schedule/DigitalClock\";\r\nimport {\r\n  Popover,\r\n  PopoverContent,\r\n  PopoverTrigger,\r\n} from \"@/components/ui/popover\";\r\nimport { Calendar as CalendarComponent } from \"@/components/ui/calendar\";\r\nimport {\r\n  Plus,\r\n  Filter,\r\n  Search,\r\n  Calendar,\r\n  ChevronLeft,\r\n  ChevronRight,\r\n} from \"lucide-react\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useToast } from \"@/hooks/use-toast\";\r\nimport {\r\n  format,\r\n  addDays,\r\n  subDays,\r\n  startOfDay,\r\n  endOfDay,\r\n  isToday,\r\n  isValid,\r\n} from \"date-fns\";\r\nimport { ptBR } from \"date-fns/locale\";\r\nimport { cn } from \"@/lib/utils\";\r\nimport { detectConflict, calculateAdjustments } from \"@/lib/scheduleConflicts\";\r\nimport { useAgendaDia } from \"@/hooks/data/useAgendaDia\";\r\nimport {\r\n  AlertDialog,\r\n  AlertDialogAction,\r\n  AlertDialogCancel,\r\n  AlertDialogContent,\r\n  AlertDialogDescription,\r\n  AlertDialogFooter,\r\n  AlertDialogHeader,\r\n  AlertDialogTitle,\r\n} from \"@/components/ui/alert-dialog\";\r\n\r\nconst Agenda = () => {\r\n  const [viewMode, setViewMode] = useState<\"cards\" | \"timeline\">(\"timeline\");\r\n  const [appointments, setAppointments] = useState<any[]>([]);\r\n  const [appointmentsWithConflicts, setAppointmentsWithConflicts] = useState<\r\n    any[]\r\n  >([]);\r\n  const [nextDayAppointments, setNextDayAppointments] = useState<any[]>([]);\r\n\r\n  const [selectedDate, setSelectedDate] = useState<Date>(new Date());\r\n  const [editingAppointmentId, setEditingAppointmentId] = useState<\r\n    string | null\r\n  >(null);\r\n  const [deletingAppointmentId, setDeletingAppointmentId] = useState<\r\n    string | null\r\n  >(null);\r\n  const [rescheduleDialogOpen, setRescheduleDialogOpen] = useState(false);\r\n  const [rescheduleAppointmentId, setRescheduleAppointmentId] = useState<\r\n    string | null\r\n  >(null);\r\n  const [rescheduleTime, setRescheduleTime] = useState(\"\");\r\n  const [conflictAdjustDialogOpen, setConflictAdjustDialogOpen] =\r\n    useState(false);\r\n  const [conflictAdjustData, setConflictAdjustData] = useState<{\r\n    appointmentId: string;\r\n    newTime: string;\r\n    affectedCount: number;\r\n  } | null>(null);\r\n  const [newAppointmentDialogOpen, setNewAppointmentDialogOpen] =\r\n    useState(false);\r\n  const [newAppointmentTime, setNewAppointmentTime] = useState(\"\");\r\n  const { toast } = useToast();\r\n\r\n  const {\r\n    data: appointmentsData,\r\n    isLoading: isLoadingAppointments,\r\n    refetch: refetchAppointments,\r\n  } = useAgendaDia({\r\n    date: selectedDate,\r\n  });\r\n\r\n  const { data: nextDayData, isLoading: isLoadingNextDay } = useAgendaDia({\r\n    date: addDays(selectedDate, 1),\r\n  });\r\n\r\n  useEffect(() => {\r\n    if (appointmentsData) {\r\n      const formattedAppointments = appointmentsData.map((apt: any) => {\r\n        const inicioDate = apt?.inicio ? new Date(apt.inicio) : null;\r\n        const fimDate = apt?.fim ? new Date(apt.fim) : null;\r\n\r\n        const safeTime =\r\n          inicioDate && isValid(inicioDate)\r\n            ? format(inicioDate, \"HH:mm\")\r\n            : \"--:--\";\r\n\r\n        const safeDuration =\r\n          inicioDate && fimDate && isValid(inicioDate) && isValid(fimDate)\r\n            ? Math.round((fimDate.getTime() - inicioDate.getTime()) / 60000)\r\n            : 30; // default de 30 min\r\n\r\n        return {\r\n          id: apt.id,\r\n          patientName: apt.pacientes?.nome || \"Paciente\",\r\n          time: safeTime,\r\n          doctor: apt.profiles?.nome || \"Profissional\",\r\n          status: apt.status || \"pending\",\r\n          phone: apt.pacientes?.telefone || \"\",\r\n          duration: safeDuration,\r\n          ordem: apt.ordem,\r\n          inicio: apt.inicio,\r\n          riskLevel: apt.no_show_risk_level,\r\n        };\r\n      });\r\n\r\n      setAppointments(formattedAppointments);\r\n\r\n      // Detectar conflitos\r\n      const withConflicts = formattedAppointments.map((apt: any) => {\r\n        const aptInicio = new Date(apt.inicio);\r\n        const aptFim = new Date(aptInicio);\r\n        aptFim.setMinutes(aptInicio.getMinutes() + apt.duration);\r\n\r\n        const conflict = detectConflict(\r\n          apt.id,\r\n          aptInicio,\r\n          aptFim,\r\n          formattedAppointments,\r\n        );\r\n\r\n        return {\r\n          ...apt,\r\n          hasConflict: !!conflict,\r\n          conflictMinutes: conflict?.overlapMinutes || 0,\r\n        };\r\n      });\r\n\r\n      setAppointmentsWithConflicts(withConflicts);\r\n    }\r\n  }, [appointmentsData]);\r\n\r\n  useEffect(() => {\r\n    if (nextDayData) {\r\n      const formattedAppointments = nextDayData.map((apt: any) => {\r\n        const inicioDate = apt?.inicio ? new Date(apt.inicio) : null;\r\n        const fimDate = apt?.fim ? new Date(apt.fim) : null;\r\n\r\n        const safeTime =\r\n          inicioDate && isValid(inicioDate)\r\n            ? format(inicioDate, \"HH:mm\")\r\n            : \"--:--\";\r\n\r\n        const safeDuration =\r\n          inicioDate && fimDate && isValid(inicioDate) && isValid(fimDate)\r\n            ? Math.round((fimDate.getTime() - inicioDate.getTime()) / 60000)\r\n            : 30;\r\n\r\n        return {\r\n          id: apt.id,\r\n          patientName: apt.pacientes?.nome || \"Paciente\",\r\n          time: safeTime,\r\n          doctor: apt.profiles?.nome || \"Profissional\",\r\n          status: apt.status || \"pending\",\r\n          phone: apt.pacientes?.telefone || \"\",\r\n          duration: safeDuration,\r\n          ordem: apt.ordem,\r\n          inicio: apt.inicio,\r\n        };\r\n      });\r\n\r\n      setNextDayAppointments(formattedAppointments);\r\n    }\r\n  }, [nextDayData]);\r\n\r\n  // Configurar realtime\r\n  useEffect(() => {\r\n    const channel = supabase\r\n      .channel(\"agenda-changes\")\r\n      .on(\r\n        \"postgres_changes\",\r\n        {\r\n          event: \"*\",\r\n          schema: \"public\",\r\n          table: \"agenda\",\r\n        },\r\n        (payload) => {\r\n          console.log(\"Mudan├ºa na agenda:\", payload);\r\n          // Usar um pequeno delay para evitar m├║ltiplas chamadas simult├óneas\r\n          setTimeout(() => {\r\n            // Invalidate queries to trigger refetch\r\n            refetchAppointments();\r\n          }, 100);\r\n        },\r\n      )\r\n      .subscribe();\r\n\r\n    return () => {\r\n      supabase.removeChannel(channel);\r\n    };\r\n  }, [selectedDate]);\r\n\r\n  // Recarregar dados ao trocar de visualiza├º├úo ou data\r\n  // useEffect(() => {\r\n  //   fetchAppointments();\r\n  //   fetchNextDayAppointments();\r\n  // }, [viewMode, selectedDate]);\r\n\r\n  const handlePreviousDay = () => {\r\n    setSelectedDate((prev) => subDays(prev, 1));\r\n  };\r\n\r\n  const handleNextDay = () => {\r\n    setSelectedDate((prev) => addDays(prev, 1));\r\n  };\r\n\r\n  const handleNavigateToNextDay = () => {\r\n    setSelectedDate((prev) => addDays(prev, 1));\r\n  };\r\n\r\n  const handleToday = () => {\r\n    setSelectedDate(new Date());\r\n  };\r\n\r\n  const getPageTitle = () => {\r\n    if (isToday(selectedDate)) {\r\n      return \"Agenda de Hoje\";\r\n    }\r\n    const dayName = format(selectedDate, \"EEEE\", { locale: ptBR });\r\n    const formattedDate = format(selectedDate, \"dd/MM/yyyy\", { locale: ptBR });\r\n    const capitalizedDay = dayName.charAt(0).toUpperCase() + dayName.slice(1);\r\n    return `Agenda do dia ${formattedDate} - ${capitalizedDay}`;\r\n  };\r\n\r\n  const timeSlots = [\r\n    { id: \"slot-08:00\", time: \"08:00\" },\r\n    { id: \"slot-08:30\", time: \"08:30\" },\r\n    { id: \"slot-09:00\", time: \"09:00\" },\r\n    { id: \"slot-09:30\", time: \"09:30\" },\r\n    { id: \"slot-10:00\", time: \"10:00\" },\r\n    { id: \"slot-10:30\", time: \"10:30\" },\r\n    { id: \"slot-11:00\", time: \"11:00\" },\r\n    { id: \"slot-11:30\", time: \"11:30\" },\r\n    { id: \"slot-12:00\", time: \"12:00\" },\r\n    { id: \"slot-12:30\", time: \"12:30\" },\r\n    { id: \"slot-13:00\", time: \"13:00\" },\r\n    { id: \"slot-13:30\", time: \"13:30\" },\r\n    { id: \"slot-14:00\", time: \"14:00\" },\r\n    { id: \"slot-14:30\", time: \"14:30\" },\r\n    { id: \"slot-15:00\", time: \"15:00\" },\r\n    { id: \"slot-15:30\", time: \"15:30\" },\r\n    { id: \"slot-16:00\", time: \"16:00\" },\r\n    { id: \"slot-16:30\", time: \"16:30\" },\r\n    { id: \"slot-17:00\", time: \"17:00\" },\r\n    { id: \"slot-17:30\", time: \"17:30\" },\r\n  ];\r\n\r\n  const handleAppointmentMove = async (\r\n    appointmentId: string,\r\n    newTime: string,\r\n  ) => {\r\n    try {\r\n      const appointment = appointments.find((app) => app.id === appointmentId);\r\n      if (!appointment) return;\r\n\r\n      const [hours, minutes] = newTime.split(\":\");\r\n      const newInicio = new Date(appointment.inicio);\r\n      newInicio.setHours(parseInt(hours), parseInt(minutes), 0, 0);\r\n\r\n      const newFim = new Date(newInicio);\r\n      newFim.setMinutes(newInicio.getMinutes() + appointment.duration);\r\n\r\n      // Validar se o hor├írio j├í passou\r\n      const now = new Date();\r\n      if (newInicio < now) {\r\n        toast({\r\n          title: \"Hor├írio inv├ílido\",\r\n          description:\r\n            \"N├úo ├® poss├¡vel mover um agendamento para um hor├írio que j├í passou.\",\r\n          variant: \"destructive\",\r\n        });\r\n        return;\r\n      }\r\n\r\n      // Detectar conflitos de hor├írio\r\n      const conflictingAppointments = appointments.filter((app) => {\r\n        if (app.id === appointmentId) return false;\r\n\r\n        const appInicio = new Date(app.inicio);\r\n        const appFim = new Date(appInicio);\r\n        appFim.setMinutes(appInicio.getMinutes() + app.duration);\r\n\r\n        // Verificar se h├í sobreposi├º├úo\r\n        return newInicio < appFim && newFim > appInicio;\r\n      });\r\n\r\n      // Atualiza├º├úo otimista - atualizar UI imediatamente\r\n      const updatedAppointments = appointments.map((app) => {\r\n        if (app.id === appointmentId) {\r\n          return {\r\n            ...app,\r\n            time: newTime,\r\n            inicio: newInicio.toISOString(),\r\n          };\r\n        }\r\n        return app;\r\n      });\r\n\r\n      // Reajustar appointments conflitantes\r\n      let adjustedAppointments = [...updatedAppointments];\r\n      const dbUpdates: Array<{ id: string; inicio: string; fim: string }> = [\r\n        {\r\n          id: appointmentId,\r\n          inicio: newInicio.toISOString(),\r\n          fim: newFim.toISOString(),\r\n        },\r\n      ];\r\n\r\n      if (conflictingAppointments.length > 0) {\r\n        let nextAvailableTime = new Date(newFim);\r\n\r\n        for (const conflicting of conflictingAppointments) {\r\n          const conflictInicio = nextAvailableTime;\r\n          const conflictFim = new Date(nextAvailableTime);\r\n          conflictFim.setMinutes(\r\n            conflictInicio.getMinutes() + conflicting.duration,\r\n          );\r\n\r\n          // Atualizar no estado local\r\n          adjustedAppointments = adjustedAppointments.map((app) => {\r\n            if (app.id === conflicting.id) {\r\n              return {\r\n                ...app,\r\n                time: format(conflictInicio, \"HH:mm\"),\r\n                inicio: conflictInicio.toISOString(),\r\n              };\r\n            }\r\n            return app;\r\n          });\r\n\r\n          // Adicionar ├ás atualiza├º├Áes do banco\r\n          dbUpdates.push({\r\n            id: conflicting.id,\r\n            inicio: conflictInicio.toISOString(),\r\n            fim: conflictFim.toISOString(),\r\n          });\r\n\r\n          nextAvailableTime = conflictFim;\r\n        }\r\n      }\r\n\r\n      // Atualizar UI imediatamente (otimista)\r\n      setAppointments(adjustedAppointments);\r\n\r\n      // Atualizar tamb├®m appointmentsWithConflicts para refletir mudan├ºa imediata\r\n      const updatedWithConflicts = adjustedAppointments.map((apt) => {\r\n        const aptInicio = new Date(apt.inicio);\r\n        const aptFim = new Date(aptInicio);\r\n        aptFim.setMinutes(aptInicio.getMinutes() + apt.duration);\r\n\r\n        const conflict = detectConflict(\r\n          apt.id,\r\n          aptInicio,\r\n          aptFim,\r\n          adjustedAppointments,\r\n        );\r\n\r\n        return {\r\n          ...apt,\r\n          hasConflict: !!conflict,\r\n          conflictMinutes: conflict?.overlapMinutes || 0,\r\n        };\r\n      });\r\n      setAppointmentsWithConflicts(updatedWithConflicts);\r\n\r\n      // Salvar todas as mudan├ºas no banco\r\n      for (const update of dbUpdates) {\r\n        const { error } = await supabase\r\n          .from(\"agenda\")\r\n          .update({\r\n            inicio: update.inicio,\r\n            fim: update.fim,\r\n          })\r\n          .eq(\"id\", update.id);\r\n\r\n        if (error) throw error;\r\n      }\r\n\r\n      toast({\r\n        title: \"Sucesso\",\r\n        description:\r\n          conflictingAppointments.length > 0\r\n            ? `Hor├írio atualizado! ${conflictingAppointments.length} consulta(s) reajustada(s).`\r\n            : \"Hor├írio atualizado com sucesso!\",\r\n      });\r\n    } catch (error) {\r\n      console.error(\"Erro ao mover agendamento:\", error);\r\n      toast({\r\n        title: \"Erro\",\r\n        description: \"N├úo foi poss├¡vel atualizar o hor├írio.\",\r\n        variant: \"destructive\",\r\n      });\r\n      // Reverter para estado do banco\r\n      refetchAppointments();\r\n    }\r\n  };\r\n\r\n  const handleCardReorder = async (appointmentId: string, targetId: string) => {\r\n    // Abrir di├ílogo para solicitar novo hor├írio\r\n    setRescheduleAppointmentId(appointmentId);\r\n    setRescheduleDialogOpen(true);\r\n  };\r\n\r\n  const handleEmptySlotClick = (time: string) => {\r\n    setNewAppointmentTime(time);\r\n    setNewAppointmentDialogOpen(true);\r\n  };\r\n\r\n  const handleResolveConflict = async (appointmentId: string) => {\r\n    const appointment = appointmentsWithConflicts.find(\r\n      (apt) => apt.id === appointmentId,\r\n    );\r\n    if (!appointment) return;\r\n\r\n    // Mostrar dialog para ajustar hor├írio\r\n    setConflictAdjustData({\r\n      appointmentId,\r\n      newTime: appointment.time,\r\n      affectedCount: 0, // Calculado ao confirmar\r\n    });\r\n    setRescheduleTime(appointment.time);\r\n    setConflictAdjustDialogOpen(true);\r\n  };\r\n\r\n  const handleConfirmConflictAdjust = async () => {\r\n    if (!conflictAdjustData || !rescheduleTime) return;\r\n\r\n    try {\r\n      const appointment = appointments.find(\r\n        (app) => app.id === conflictAdjustData.appointmentId,\r\n      );\r\n      if (!appointment) return;\r\n\r\n      const [hours, minutes] = rescheduleTime.split(\":\");\r\n      const newInicio = new Date(appointment.inicio);\r\n      newInicio.setHours(parseInt(hours), parseInt(minutes), 0, 0);\r\n\r\n      // Calcular ajustes necess├írios\r\n      const adjustments = calculateAdjustments(\r\n        conflictAdjustData.appointmentId,\r\n        newInicio,\r\n        appointment.duration,\r\n        appointments,\r\n      );\r\n\r\n      // Se h├í ajustes necess├írios e o usu├írio n├úo viu o aviso ainda\r\n      if (adjustments.length > 0 && conflictAdjustData.affectedCount === 0) {\r\n        setConflictAdjustData({\r\n          ...conflictAdjustData,\r\n          affectedCount: adjustments.length,\r\n        });\r\n        return; // Mostrar aviso primeiro\r\n      }\r\n\r\n      // Aplicar ajustes\r\n      const updates = [\r\n        {\r\n          id: conflictAdjustData.appointmentId,\r\n          inicio: newInicio,\r\n          fim: new Date(newInicio.getTime() + appointment.duration * 60000),\r\n        },\r\n        ...adjustments,\r\n      ];\r\n\r\n      // Atualizar no banco\r\n      for (const update of updates) {\r\n        const { error } = await supabase\r\n          .from(\"agenda\")\r\n          .update({\r\n            inicio: update.inicio.toISOString(),\r\n            fim: update.fim.toISOString(),\r\n          })\r\n          .eq(\"id\", update.id);\r\n\r\n        if (error) throw error;\r\n      }\r\n\r\n      toast({\r\n        title: \"Sucesso\",\r\n        description: `Hor├írio ajustado. ${adjustments.length > 0 ? `${adjustments.length} agendamento(s) posterior(es) tamb├®m foram ajustados.` : \"\"}`,\r\n      });\r\n\r\n      // Recarregar\r\n      refetchAppointments();\r\n      setConflictAdjustDialogOpen(false);\r\n      setConflictAdjustData(null);\r\n      setRescheduleTime(\"\");\r\n    } catch (error) {\r\n      console.error(\"Erro ao ajustar hor├írios:\", error);\r\n      toast({\r\n        title: \"Erro\",\r\n        description: \"N├úo foi poss├¡vel ajustar os hor├írios.\",\r\n        variant: \"destructive\",\r\n      });\r\n    }\r\n  };\r\n\r\n  const handleConfirmReschedule = async () => {\r\n    if (!rescheduleAppointmentId || !rescheduleTime) {\r\n      toast({\r\n        title: \"Erro\",\r\n        description: \"Por favor, informe o novo hor├írio.\",\r\n        variant: \"destructive\",\r\n      });\r\n      return;\r\n    }\r\n\r\n    try {\r\n      const appointment = appointments.find(\r\n        (app) => app.id === rescheduleAppointmentId,\r\n      );\r\n      if (!appointment) return;\r\n\r\n      const [hours, minutes] = rescheduleTime.split(\":\");\r\n      const newInicio = new Date(appointment.inicio);\r\n      newInicio.setHours(parseInt(hours), parseInt(minutes), 0, 0);\r\n\r\n      const newFim = new Date(newInicio);\r\n      newFim.setMinutes(newInicio.getMinutes() + appointment.duration);\r\n\r\n      // Validar se o hor├írio j├í passou\r\n      const now = new Date();\r\n      if (newInicio < now) {\r\n        toast({\r\n          title: \"Hor├írio inv├ílido\",\r\n          description:\r\n            \"N├úo ├® poss├¡vel reagendar para um hor├írio que j├í passou.\",\r\n          variant: \"destructive\",\r\n        });\r\n        return;\r\n      }\r\n\r\n      // Atualizar no banco\r\n      const { error } = await supabase\r\n        .from(\"agenda\")\r\n        .update({\r\n          inicio: newInicio.toISOString(),\r\n          fim: newFim.toISOString(),\r\n        })\r\n        .eq(\"id\", rescheduleAppointmentId);\r\n\r\n      if (error) throw error;\r\n\r\n      // Atualizar UI\r\n      setAppointments((prev) =>\r\n        prev.map((app) => {\r\n          if (app.id === rescheduleAppointmentId) {\r\n            return {\r\n              ...app,\r\n              time: rescheduleTime,\r\n              inicio: newInicio.toISOString(),\r\n            };\r\n          }\r\n          return app;\r\n        }),\r\n      );\r\n\r\n      toast({\r\n        title: \"Sucesso\",\r\n        description: \"Hor├írio atualizado com sucesso!\",\r\n      });\r\n\r\n      // Fechar di├ílogo e limpar estado\r\n      setRescheduleDialogOpen(false);\r\n      setRescheduleAppointmentId(null);\r\n      setRescheduleTime(\"\");\r\n    } catch (error) {\r\n      console.error(\"Erro ao reagendar:\", error);\r\n      toast({\r\n        title: \"Erro\",\r\n        description: \"N├úo foi poss├¡vel atualizar o hor├írio.\",\r\n        variant: \"destructive\",\r\n      });\r\n    }\r\n  };\r\n\r\n  const handleDelete = async () => {\r\n    if (!deletingAppointmentId) return;\r\n\r\n    try {\r\n      const { error } = await supabase\r\n        .from(\"agenda\")\r\n        .delete()\r\n        .eq(\"id\", deletingAppointmentId);\r\n\r\n      if (error) throw error;\r\n\r\n      // Atualizar UI imediatamente\r\n      setAppointments((prev) =>\r\n        prev.filter((app) => app.id !== deletingAppointmentId),\r\n      );\r\n\r\n      toast({\r\n        title: \"Sucesso\",\r\n        description: \"Agendamento exclu├¡do com sucesso!\",\r\n      });\r\n    } catch (error) {\r\n      console.error(\"Erro ao excluir agendamento:\", error);\r\n      toast({\r\n        title: \"Erro\",\r\n        description: \"N├úo foi poss├¡vel excluir o agendamento.\",\r\n        variant: \"destructive\",\r\n      });\r\n    } finally {\r\n      setDeletingAppointmentId(null);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <MainLayout>\r\n      <div className=\"space-y-6\">\r\n        <div className=\"flex items-center justify-between flex-wrap gap-4\">\r\n          <div>\r\n            <h1 className=\"text-3xl font-bold text-foreground\">\r\n              {getPageTitle()}\r\n            </h1>\r\n            <p className=\"text-muted-foreground\">\r\n              Gerenciar consultas e hor├írios\r\n            </p>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"flex items-center justify-between flex-wrap gap-4\">\r\n          <div className=\"flex items-center gap-2\">\r\n            <Button\r\n              variant=\"outline\"\r\n              size=\"icon\"\r\n              onClick={handlePreviousDay}\r\n              title=\"Dia anterior\"\r\n            >\r\n              <ChevronLeft className=\"h-4 w-4\" />\r\n            </Button>\r\n\r\n            <Popover>\r\n              <PopoverTrigger asChild>\r\n                <Button variant=\"outline\" className=\"min-w-[200px]\">\r\n                  <Calendar className=\"h-4 w-4 mr-2\" />\r\n                  {format(selectedDate, \"dd/MM/yyyy - EEEE\", { locale: ptBR })}\r\n                </Button>\r\n              </PopoverTrigger>\r\n              <PopoverContent className=\"w-auto p-0\" align=\"start\">\r\n                <CalendarComponent\r\n                  mode=\"single\"\r\n                  selected={selectedDate}\r\n                  onSelect={(date) => date && setSelectedDate(date)}\r\n                  initialFocus\r\n                  locale={ptBR}\r\n                  className={cn(\"p-3 pointer-events-auto\")}\r\n                />\r\n              </PopoverContent>\r\n            </Popover>\r\n\r\n            <Button\r\n              variant=\"outline\"\r\n              size=\"icon\"\r\n              onClick={handleNextDay}\r\n              title=\"Pr├│ximo dia\"\r\n            >\r\n              <ChevronRight className=\"h-4 w-4\" />\r\n            </Button>\r\n\r\n            {!isToday(selectedDate) && (\r\n              <Button variant=\"outline\" onClick={handleToday}>\r\n                Hoje\r\n              </Button>\r\n            )}\r\n          </div>\r\n\r\n          <div className=\"flex gap-2\">\r\n            <Button\r\n              variant={viewMode === \"timeline\" ? \"default\" : \"outline\"}\r\n              size=\"sm\"\r\n              onClick={() => setViewMode(\"timeline\")}\r\n            >\r\n              <Calendar className=\"h-4 w-4 mr-2\" />\r\n              Timeline\r\n            </Button>\r\n            <Button\r\n              variant={viewMode === \"cards\" ? \"default\" : \"outline\"}\r\n              size=\"sm\"\r\n              onClick={() => setViewMode(\"cards\")}\r\n            >\r\n              Cards\r\n            </Button>\r\n          </div>\r\n\r\n          <div className=\"flex gap-3\">\r\n            <Button variant=\"outline\">\r\n              <Filter className=\"h-4 w-4 mr-2\" />\r\n              Filtros\r\n            </Button>\r\n            <Button variant=\"outline\">\r\n              <Search className=\"h-4 w-4 mr-2\" />\r\n              Buscar\r\n            </Button>\r\n            <NewAppointmentDialog\r\n              selectedDate={selectedDate}\r\n              onSuccess={() => refetchAppointments()}\r\n              open={newAppointmentDialogOpen}\r\n              onOpenChange={(open) => {\r\n                setNewAppointmentDialogOpen(open);\r\n                if (!open) setNewAppointmentTime(\"\");\r\n              }}\r\n              selectedTime={newAppointmentTime}\r\n            >\r\n              <Button>\r\n                <Plus className=\"h-4 w-4 mr-2\" />\r\n                Nova Consulta\r\n              </Button>\r\n            </NewAppointmentDialog>\r\n          </div>\r\n        </div>\r\n\r\n        {isLoadingAppointments ? (\r\n          <div className=\"flex items-center justify-center p-12\">\r\n            <div className=\"text-center\">\r\n              <div className=\"animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4\"></div>\r\n              <p className=\"text-muted-foreground\">\r\n                Carregando agendamentos...\r\n              </p>\r\n            </div>\r\n          </div>\r\n        ) : (\r\n          <div className=\"grid grid-cols-1 xl:grid-cols-[350px_1fr_400px] lg:grid-cols-[320px_1fr] gap-6\">\r\n            {/* Coluna Esquerda - Calend├írio Mensal */}\r\n            <div className=\"lg:sticky lg:top-6 lg:self-start\">\r\n              <MonthlyCalendar\r\n                selectedDate={selectedDate}\r\n                onDateSelect={setSelectedDate}\r\n              />\r\n            </div>\r\n\r\n            {/* Coluna Central - Agenda do Dia */}\r\n            <div>\r\n              {viewMode === \"timeline\" ? (\r\n                <>\r\n                  <div className=\"mb-4 p-4 bg-muted rounded-lg\">\r\n                    <p className=\"text-sm text-muted-foreground\">\r\n                      <strong>Arrastar e Soltar:</strong> Arraste os\r\n                      agendamentos para reorganizar os hor├írios. As altera├º├Áes\r\n                      ser├úo salvas automaticamente.\r\n                    </p>\r\n                  </div>\r\n                  <DragSchedule\r\n                    appointments={appointmentsWithConflicts}\r\n                    timeSlots={timeSlots}\r\n                    onAppointmentMove={handleAppointmentMove}\r\n                    viewMode=\"timeline\"\r\n                    onEdit={setEditingAppointmentId}\r\n                    onDelete={setDeletingAppointmentId}\r\n                    onResolveConflict={handleResolveConflict}\r\n                    onEmptySlotClick={handleEmptySlotClick}\r\n                    selectedDate={selectedDate}\r\n                  />\r\n                </>\r\n              ) : (\r\n                <>\r\n                  <div className=\"mb-4 p-4 bg-muted rounded-lg\">\r\n                    <p className=\"text-sm text-muted-foreground\">\r\n                      <strong>Arrastar e Soltar:</strong> Arraste os cards para\r\n                      reorganizar a ordem dos agendamentos.\r\n                    </p>\r\n                  </div>\r\n                  <DragSchedule\r\n                    appointments={appointmentsWithConflicts}\r\n                    timeSlots={[]}\r\n                    onAppointmentMove={handleAppointmentMove}\r\n                    onCardReorder={handleCardReorder}\r\n                    viewMode=\"cards\"\r\n                    onEdit={setEditingAppointmentId}\r\n                    onDelete={setDeletingAppointmentId}\r\n                    onResolveConflict={handleResolveConflict}\r\n                    selectedDate={selectedDate}\r\n                  />\r\n                </>\r\n              )}\r\n            </div>\r\n\r\n            {/* Coluna Direita - Preview do Pr├│ximo Dia e Rel├│gio (apenas em telas XL) */}\r\n            <div className=\"hidden xl:block xl:sticky xl:top-6 xl:self-start space-y-4\">\r\n              <NextDayPreview\r\n                date={addDays(selectedDate, 1)}\r\n                appointments={nextDayAppointments}\r\n                onNavigate={handleNavigateToNextDay}\r\n                isLoading={isLoadingNextDay}\r\n              />\r\n              <DigitalClock />\r\n            </div>\r\n          </div>\r\n        )}\r\n      </div>\r\n\r\n      {editingAppointmentId && (\r\n        <EditAppointmentDialog\r\n          appointmentId={editingAppointmentId}\r\n          onSuccess={() => {\r\n            fetchAppointments();\r\n            fetchNextDayAppointments();\r\n            setEditingAppointmentId(null);\r\n          }}\r\n        >\r\n          <Button style={{ display: \"none\" }} />\r\n        </EditAppointmentDialog>\r\n      )}\r\n\r\n      <AlertDialog\r\n        open={!!deletingAppointmentId}\r\n        onOpenChange={() => setDeletingAppointmentId(null)}\r\n      >\r\n        <AlertDialogContent>\r\n          <AlertDialogHeader>\r\n            <AlertDialogTitle>Confirmar Exclus├úo</AlertDialogTitle>\r\n            <AlertDialogDescription>\r\n              Tem certeza que deseja excluir este agendamento? Esta a├º├úo n├úo\r\n              pode ser desfeita.\r\n            </AlertDialogDescription>\r\n          </AlertDialogHeader>\r\n          <AlertDialogFooter>\r\n            <AlertDialogCancel>Cancelar</AlertDialogCancel>\r\n            <AlertDialogAction\r\n              onClick={handleDelete}\r\n              className=\"bg-destructive text-destructive-foreground hover:bg-destructive/90\"\r\n            >\r\n              Excluir\r\n            </AlertDialogAction>\r\n          </AlertDialogFooter>\r\n        </AlertDialogContent>\r\n      </AlertDialog>\r\n\r\n      {/* Dialog de ajuste de conflito */}\r\n      <AlertDialog\r\n        open={conflictAdjustDialogOpen}\r\n        onOpenChange={setConflictAdjustDialogOpen}\r\n      >\r\n        <AlertDialogContent>\r\n          <AlertDialogHeader>\r\n            <AlertDialogTitle>Ajustar Hor├írio Conflitante</AlertDialogTitle>\r\n            <AlertDialogDescription>\r\n              {conflictAdjustData?.affectedCount === 0 ? (\r\n                <>\r\n                  <p className=\"mb-4\">\r\n                    Ajuste o hor├írio deste agendamento para resolver o conflito:\r\n                  </p>\r\n                  <Input\r\n                    type=\"time\"\r\n                    value={rescheduleTime}\r\n                    onChange={(e) => setRescheduleTime(e.target.value)}\r\n                    className=\"mb-2\"\r\n                  />\r\n                </>\r\n              ) : (\r\n                <p>\r\n                  Este ajuste afetar├í{\" \"}\r\n                  <strong>{conflictAdjustData?.affectedCount}</strong>{\" \"}\r\n                  agendamento(s) posterior(es), que ser├úo automaticamente\r\n                  remarcados. Deseja continuar?\r\n                </p>\r\n              )}\r\n            </AlertDialogDescription>\r\n          </AlertDialogHeader>\r\n          <AlertDialogFooter>\r\n            <AlertDialogCancel\r\n              onClick={() => {\r\n                setConflictAdjustDialogOpen(false);\r\n                setConflictAdjustData(null);\r\n                setRescheduleTime(\"\");\r\n              }}\r\n            >\r\n              Cancelar\r\n            </AlertDialogCancel>\r\n            <AlertDialogAction onClick={handleConfirmConflictAdjust}>\r\n              {conflictAdjustData?.affectedCount === 0\r\n                ? \"Verificar Ajuste\"\r\n                : \"Confirmar Altera├º├Áes\"}\r\n            </AlertDialogAction>\r\n          </AlertDialogFooter>\r\n        </AlertDialogContent>\r\n      </AlertDialog>\r\n\r\n      <AlertDialog\r\n        open={rescheduleDialogOpen}\r\n        onOpenChange={setRescheduleDialogOpen}\r\n      >\r\n        <AlertDialogContent>\r\n          <AlertDialogHeader>\r\n            <AlertDialogTitle>Novo Hor├írio</AlertDialogTitle>\r\n            <AlertDialogDescription>\r\n              Informe o novo hor├írio para este agendamento:\r\n            </AlertDialogDescription>\r\n          </AlertDialogHeader>\r\n          <div className=\"py-4\">\r\n            <input\r\n              type=\"time\"\r\n              value={rescheduleTime}\r\n              onChange={(e) => setRescheduleTime(e.target.value)}\r\n              className=\"w-full px-3 py-2 border border-border rounded-md bg-background text-foreground\"\r\n            />\r\n          </div>\r\n          <AlertDialogFooter>\r\n            <AlertDialogCancel\r\n              onClick={() => {\r\n                setRescheduleDialogOpen(false);\r\n                setRescheduleAppointmentId(null);\r\n                setRescheduleTime(\"\");\r\n              }}\r\n            >\r\n              Cancelar\r\n            </AlertDialogCancel>\r\n            <AlertDialogAction onClick={handleConfirmReschedule}>\r\n              Confirmar\r\n            </AlertDialogAction>\r\n          </AlertDialogFooter>\r\n        </AlertDialogContent>\r\n      </AlertDialog>\r\n    </MainLayout>\r\n  );\r\n};\r\n\r\nexport default Agenda;\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\AgendamentoPublico.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadTenantAndServices'. Either include it or remove the dependency array.","line":41,"column":6,"nodeType":"ArrayExpression","endLine":41,"endColumn":18,"suggestions":[{"desc":"Update the dependencies array to be: [loadTenantAndServices, tenantSlug]","fix":{"range":[1832,1844],"text":"[loadTenantAndServices, tenantSlug]"}}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadAvailableSlots'. Either include it or remove the dependency array.","line":146,"column":6,"nodeType":"ArrayExpression","endLine":146,"endColumn":59,"suggestions":[{"desc":"Update the dependencies array to be: [selectedDate, selectedService, selectedProfessional, loadAvailableSlots]","fix":{"range":[5159,5212],"text":"[selectedDate, selectedService, selectedProfessional, loadAvailableSlots]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\r\nimport { useSearchParams } from \"react-router-dom\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from \"@/components/ui/card\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport { Calendar } from \"@/components/ui/calendar\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { toast } from \"sonner\";\r\nimport { Calendar as CalendarIcon, Clock, User, Phone, Mail, CheckCircle } from \"lucide-react\";\r\nimport { LandingHeader } from \"@/components/landing/LandingHeader\";\r\nimport { LandingFooter } from \"@/components/landing/LandingFooter\";\r\n\r\nexport default function AgendamentoPublico() {\r\n  const [searchParams] = useSearchParams();\r\n  const tenantSlug = searchParams.get('clinica');\r\n\r\n  const [step, setStep] = useState<'select-service' | 'select-datetime' | 'fill-data' | 'confirm'>('select-service');\r\n  const [loading, setLoading] = useState(true);\r\n  const [services, setServices] = useState<any[]>([]);\r\n  const [professionals, setProfessionals] = useState<any[]>([]);\r\n  const [availableSlots, setAvailableSlots] = useState<any[]>([]);\r\n\r\n  const [selectedService, setSelectedService] = useState<any>(null);\r\n  const [selectedProfessional, setSelectedProfessional] = useState<any>(null);\r\n  const [selectedDate, setSelectedDate] = useState<Date | undefined>(undefined);\r\n  const [selectedSlot, setSelectedSlot] = useState<string>(\"\");\r\n\r\n  const [patientData, setPatientData] = useState({\r\n    nome: \"\",\r\n    telefone: \"\",\r\n    email: \"\",\r\n    notas: \"\",\r\n  });\r\n\r\n  const [tenantId, setTenantId] = useState<string | null>(null);\r\n\r\n  useEffect(() => {\r\n    loadTenantAndServices();\r\n  }, [tenantSlug]);\r\n\r\n  const loadTenantAndServices = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      // Buscar configura├º├úo de agendamento online pelo slug\r\n      const { data: config, error: configError } = await supabase\r\n        .from('agendamento_online_config')\r\n        .select('*, tenants(*)')\r\n        .eq('slug_publico', tenantSlug)\r\n        .eq('ativo', true)\r\n        .single();\r\n\r\n      if (configError || !config) {\r\n        toast.error('Link de agendamento n├úo encontrado ou inativo');\r\n        return;\r\n      }\r\n\r\n      setTenantId(config.tenant_id);\r\n\r\n      // Buscar servi├ºos dispon├¡veis\r\n      const { data: servicesData } = await supabase\r\n        .from('servicos')\r\n        .select('*')\r\n        .eq('tenant_id', config.tenant_id)\r\n        .eq('ativo', true);\r\n\r\n      setServices(servicesData || []);\r\n\r\n      // Buscar profissionais\r\n      const { data: profsData } = await supabase\r\n        .from('profiles')\r\n        .select('*')\r\n        .eq('tenant_id', config.tenant_id)\r\n        .in('role', ['profissional', 'admin']);\r\n\r\n      setProfessionals(profsData || []);\r\n    } catch (error) {\r\n      console.error('Erro ao carregar dados:', error);\r\n      toast.error('Erro ao carregar informa├º├Áes de agendamento');\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  const loadAvailableSlots = async () => {\r\n    if (!selectedDate || !selectedService || !selectedProfessional) return;\r\n\r\n    try {\r\n      // Buscar hor├írios j├í ocupados\r\n      const startOfDay = new Date(selectedDate);\r\n      startOfDay.setHours(0, 0, 0, 0);\r\n\r\n      const endOfDay = new Date(selectedDate);\r\n      endOfDay.setHours(23, 59, 59, 999);\r\n\r\n      const { data: appointments } = await supabase\r\n        .from('agenda')\r\n        .select('inicio, fim')\r\n        .eq('profissional_id', selectedProfessional.id)\r\n        .gte('inicio', startOfDay.toISOString())\r\n        .lte('inicio', endOfDay.toISOString());\r\n\r\n      // Gerar slots dispon├¡veis (8h ├ás 18h, a cada 30 min)\r\n      const slots = [];\r\n      const startHour = 8;\r\n      const endHour = 18;\r\n\r\n      for (let hour = startHour; hour < endHour; hour++) {\r\n        for (const minute of [0, 30]) {\r\n          const slotTime = new Date(selectedDate);\r\n          slotTime.setHours(hour, minute, 0, 0);\r\n\r\n          const slotEndTime = new Date(slotTime);\r\n          slotEndTime.setMinutes(slotEndTime.getMinutes() + selectedService.duracao_minutos);\r\n\r\n          // Verificar se est├í ocupado\r\n          const isOccupied = appointments?.some((apt: any) => {\r\n            const aptStart = new Date(apt.inicio);\r\n            const aptEnd = new Date(apt.fim);\r\n            return (slotTime >= aptStart && slotTime < aptEnd) ||\r\n              (slotEndTime > aptStart && slotEndTime <= aptEnd);\r\n          });\r\n\r\n          if (!isOccupied && slotTime > new Date()) {\r\n            slots.push({\r\n              time: slotTime.toTimeString().slice(0, 5),\r\n              datetime: slotTime,\r\n            });\r\n          }\r\n        }\r\n      }\r\n\r\n      setAvailableSlots(slots);\r\n    } catch (error) {\r\n      console.error('Erro ao carregar hor├írios:', error);\r\n      toast.error('Erro ao carregar hor├írios dispon├¡veis');\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (selectedDate && selectedService && selectedProfessional) {\r\n      loadAvailableSlots();\r\n    }\r\n  }, [selectedDate, selectedService, selectedProfessional]);\r\n\r\n  const handleConfirmAppointment = async () => {\r\n    try {\r\n      if (!selectedSlot || !selectedDate || !tenantId) return;\r\n\r\n      // Criar ou buscar paciente\r\n      let patientId;\r\n\r\n      const { data: existingPatient } = await supabase\r\n        .from('pacientes')\r\n        .select('id')\r\n        .eq('tenant_id', tenantId)\r\n        .eq('telefone', patientData.telefone)\r\n        .single();\r\n\r\n      if (existingPatient) {\r\n        patientId = existingPatient.id;\r\n      } else {\r\n        const { data: newPatient, error: patientError } = await supabase\r\n          .from('pacientes')\r\n          .insert({\r\n            tenant_id: tenantId,\r\n            nome: patientData.nome,\r\n            telefone: patientData.telefone,\r\n            email: patientData.email,\r\n            notas_internas: patientData.notas,\r\n            consentimento_lgpd: true,\r\n            consentimento_data: new Date().toISOString(),\r\n          })\r\n          .select()\r\n          .single();\r\n\r\n        if (patientError) throw patientError;\r\n        patientId = newPatient.id;\r\n      }\r\n\r\n      // Criar agendamento\r\n      const [hours, minutes] = selectedSlot.split(':').map(Number);\r\n      const startTime = new Date(selectedDate);\r\n      startTime.setHours(hours, minutes, 0, 0);\r\n\r\n      const endTime = new Date(startTime);\r\n      endTime.setMinutes(endTime.getMinutes() + selectedService.duracao_minutos);\r\n\r\n      const { error: agendamentoError } = await supabase\r\n        .from('agenda')\r\n        .insert({\r\n          tenant_id: tenantId,\r\n          paciente_id: patientId,\r\n          profissional_id: selectedProfessional.id,\r\n          servico_id: selectedService.id,\r\n          inicio: startTime.toISOString(),\r\n          fim: endTime.toISOString(),\r\n          status: 'agendado',\r\n          origem: 'online',\r\n          confirmado: false,\r\n        });\r\n\r\n      if (agendamentoError) throw agendamentoError;\r\n\r\n      // Registrar consentimento\r\n      await supabase.from('consent_records' as any).insert({\r\n        tenant_id: tenantId,\r\n        contact_id: patientId,\r\n        contact_type: 'paciente',\r\n        consent_type: 'operational',\r\n        status: 'opted_in',\r\n        origin: 'agendamento_online',\r\n        term_version: '1.0',\r\n        given_at: new Date().toISOString(),\r\n      });\r\n\r\n      setStep('confirm');\r\n      toast.success('Agendamento realizado com sucesso!');\r\n    } catch (error: any) {\r\n      console.error('Erro ao confirmar agendamento:', error);\r\n      toast.error('Erro ao realizar agendamento');\r\n    }\r\n  };\r\n\r\n  if (loading) {\r\n    return (\r\n      <div className=\"min-h-screen flex items-center justify-center\">\r\n        <div className=\"animate-spin rounded-full h-12 w-12 border-b-2 border-primary\"></div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  if (!tenantSlug || !tenantId) {\r\n    return (\r\n      <div className=\"min-h-screen flex items-center justify-center\">\r\n        <Card className=\"w-full max-w-md\">\r\n          <CardContent className=\"p-6\">\r\n            <p className=\"text-center text-muted-foreground\">\r\n              Link de agendamento inv├ílido\r\n            </p>\r\n          </CardContent>\r\n        </Card>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-background\">\r\n      <LandingHeader />\r\n\r\n      <main className=\"container mx-auto px-4 py-12\">\r\n        {step === 'confirm' ? (\r\n          <Card className=\"max-w-2xl mx-auto\">\r\n            <CardContent className=\"p-12 text-center\">\r\n              <CheckCircle className=\"h-16 w-16 text-green-500 mx-auto mb-4\" />\r\n              <h2 className=\"text-2xl font-bold mb-2\">Agendamento Confirmado!</h2>\r\n              <p className=\"text-muted-foreground mb-4\">\r\n                Seu agendamento foi realizado com sucesso. Em breve voc├¬ receber├í uma confirma├º├úo por WhatsApp.\r\n              </p>\r\n              <div className=\"bg-muted p-4 rounded-lg mb-6\">\r\n                <p className=\"font-medium\">{selectedService?.nome}</p>\r\n                <p className=\"text-sm text-muted-foreground\">\r\n                  Dr(a). {selectedProfessional?.nome}\r\n                </p>\r\n                <p className=\"text-sm text-muted-foreground\">\r\n                  {selectedDate?.toLocaleDateString('pt-BR')} ├ás {selectedSlot}\r\n                </p>\r\n              </div>\r\n              <Button onClick={() => window.location.reload()}>\r\n                Fazer Novo Agendamento\r\n              </Button>\r\n            </CardContent>\r\n          </Card>\r\n        ) : (\r\n          <div className=\"max-w-4xl mx-auto\">\r\n            <Card>\r\n              <CardHeader>\r\n                <CardTitle className=\"text-2xl\">Agendamento Online</CardTitle>\r\n                <CardDescription>\r\n                  Siga os passos para agendar sua consulta\r\n                </CardDescription>\r\n              </CardHeader>\r\n              <CardContent>\r\n                {/* Progress Steps */}\r\n                <div className=\"flex justify-between mb-8\">\r\n                  {['Servi├ºo', 'Data e Hora', 'Dados', 'Confirmar'].map((label, idx) => (\r\n                    <div key={idx} className=\"flex items-center\">\r\n                      <div className={`w-8 h-8 rounded-full flex items-center justify-center ${['select-service', 'select-datetime', 'fill-data', 'confirm'][idx] === step\r\n                        ? 'bg-primary text-white'\r\n                        : 'bg-muted'\r\n                        }`}>\r\n                        {idx + 1}\r\n                      </div>\r\n                      <span className=\"ml-2 text-sm hidden sm:inline\">{label}</span>\r\n                    </div>\r\n                  ))}\r\n                </div>\r\n\r\n                {step === 'select-service' && (\r\n                  <div className=\"space-y-4\">\r\n                    <h3 className=\"font-semibold mb-4\">Selecione o Servi├ºo</h3>\r\n                    <div className=\"grid gap-4\">\r\n                      {services.map((service) => (\r\n                        <Card\r\n                          key={service.id}\r\n                          className={`cursor-pointer hover:border-primary transition-colors ${selectedService?.id === service.id ? 'border-primary' : ''\r\n                            }`}\r\n                          onClick={() => setSelectedService(service)}\r\n                        >\r\n                          <CardContent className=\"p-4\">\r\n                            <div className=\"flex justify-between items-start\">\r\n                              <div>\r\n                                <h4 className=\"font-medium\">{service.nome}</h4>\r\n                                <p className=\"text-sm text-muted-foreground\">\r\n                                  {service.duracao_minutos} minutos\r\n                                </p>\r\n                              </div>\r\n                              {service.preco && (\r\n                                <Badge>R$ {service.preco}</Badge>\r\n                              )}\r\n                            </div>\r\n                          </CardContent>\r\n                        </Card>\r\n                      ))}\r\n                    </div>\r\n                    <Button\r\n                      onClick={() => setStep('select-datetime')}\r\n                      disabled={!selectedService}\r\n                      className=\"w-full\"\r\n                    >\r\n                      Continuar\r\n                    </Button>\r\n                  </div>\r\n                )}\r\n\r\n                {step === 'select-datetime' && (\r\n                  <div className=\"space-y-6\">\r\n                    <div>\r\n                      <h3 className=\"font-semibold mb-4\">Selecione o Profissional</h3>\r\n                      <div className=\"grid gap-3\">\r\n                        {professionals.map((prof) => (\r\n                          <Card\r\n                            key={prof.id}\r\n                            className={`cursor-pointer hover:border-primary transition-colors ${selectedProfessional?.id === prof.id ? 'border-primary' : ''\r\n                              }`}\r\n                            onClick={() => setSelectedProfessional(prof)}\r\n                          >\r\n                            <CardContent className=\"p-3 flex items-center gap-3\">\r\n                              <User className=\"h-8 w-8 text-muted-foreground\" />\r\n                              <div>\r\n                                <p className=\"font-medium\">Dr(a). {prof.nome}</p>\r\n                              </div>\r\n                            </CardContent>\r\n                          </Card>\r\n                        ))}\r\n                      </div>\r\n                    </div>\r\n\r\n                    {selectedProfessional && (\r\n                      <div>\r\n                        <h3 className=\"font-semibold mb-4\">Selecione a Data</h3>\r\n                        <Calendar\r\n                          mode=\"single\"\r\n                          selected={selectedDate}\r\n                          onSelect={setSelectedDate}\r\n                          disabled={(date) => date < new Date() || date.getDay() === 0}\r\n                          className=\"rounded-md border mx-auto\"\r\n                        />\r\n                      </div>\r\n                    )}\r\n\r\n                    {selectedDate && availableSlots.length > 0 && (\r\n                      <div>\r\n                        <h3 className=\"font-semibold mb-4\">Hor├írios Dispon├¡veis</h3>\r\n                        <div className=\"grid grid-cols-4 gap-2\">\r\n                          {availableSlots.map((slot) => (\r\n                            <Button\r\n                              key={slot.time}\r\n                              variant={selectedSlot === slot.time ? \"default\" : \"outline\"}\r\n                              onClick={() => setSelectedSlot(slot.time)}\r\n                              className=\"text-sm\"\r\n                            >\r\n                              {slot.time}\r\n                            </Button>\r\n                          ))}\r\n                        </div>\r\n                      </div>\r\n                    )}\r\n\r\n                    <div className=\"flex gap-2\">\r\n                      <Button variant=\"outline\" onClick={() => setStep('select-service')}>\r\n                        Voltar\r\n                      </Button>\r\n                      <Button\r\n                        onClick={() => setStep('fill-data')}\r\n                        disabled={!selectedSlot}\r\n                        className=\"flex-1\"\r\n                      >\r\n                        Continuar\r\n                      </Button>\r\n                    </div>\r\n                  </div>\r\n                )}\r\n\r\n                {step === 'fill-data' && (\r\n                  <div className=\"space-y-4\">\r\n                    <h3 className=\"font-semibold mb-4\">Seus Dados</h3>\r\n                    <div className=\"space-y-2\">\r\n                      <Label htmlFor=\"nome\">Nome Completo *</Label>\r\n                      <Input\r\n                        id=\"nome\"\r\n                        value={patientData.nome}\r\n                        onChange={(e) => setPatientData({ ...patientData, nome: e.target.value })}\r\n                        required\r\n                      />\r\n                    </div>\r\n                    <div className=\"space-y-2\">\r\n                      <Label htmlFor=\"telefone\">Telefone (WhatsApp) *</Label>\r\n                      <Input\r\n                        id=\"telefone\"\r\n                        type=\"tel\"\r\n                        value={patientData.telefone}\r\n                        onChange={(e) => setPatientData({ ...patientData, telefone: e.target.value })}\r\n                        placeholder=\"(00) 00000-0000\"\r\n                        required\r\n                      />\r\n                    </div>\r\n                    <div className=\"space-y-2\">\r\n                      <Label htmlFor=\"email\">E-mail</Label>\r\n                      <Input\r\n                        id=\"email\"\r\n                        type=\"email\"\r\n                        value={patientData.email}\r\n                        onChange={(e) => setPatientData({ ...patientData, email: e.target.value })}\r\n                      />\r\n                    </div>\r\n                    <div className=\"space-y-2\">\r\n                      <Label htmlFor=\"notas\">Observa├º├Áes</Label>\r\n                      <Input\r\n                        id=\"notas\"\r\n                        value={patientData.notas}\r\n                        onChange={(e) => setPatientData({ ...patientData, notas: e.target.value })}\r\n                        placeholder=\"Algo que o profissional deva saber...\"\r\n                      />\r\n                    </div>\r\n                    <div className=\"flex gap-2\">\r\n                      <Button variant=\"outline\" onClick={() => setStep('select-datetime')}>\r\n                        Voltar\r\n                      </Button>\r\n                      <Button\r\n                        onClick={handleConfirmAppointment}\r\n                        disabled={!patientData.nome || !patientData.telefone}\r\n                        className=\"flex-1\"\r\n                      >\r\n                        Confirmar Agendamento\r\n                      </Button>\r\n                    </div>\r\n                  </div>\r\n                )}\r\n              </CardContent>\r\n            </Card>\r\n          </div>\r\n        )}\r\n      </main>\r\n\r\n      <LandingFooter />\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\AlarmesLembretes.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadAlarmes'. Either include it or remove the dependency array.","line":46,"column":8,"nodeType":"ArrayExpression","endLine":46,"endColumn":54,"suggestions":[{"desc":"Update the dependencies array to be: [profile?.tenant_id, filtroTipo, filtroStatus, loadAlarmes]","fix":{"range":[1891,1937],"text":"[profile?.tenant_id, filtroTipo, filtroStatus, loadAlarmes]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\nimport { MainLayout } from \"@/components/layout/MainLayout\";\r\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport { Textarea } from \"@/components/ui/textarea\";\r\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\r\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from \"@/components/ui/dialog\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\r\nimport { Calendar } from \"@/components/ui/calendar\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useAuth } from \"@/hooks/useAuth\";\r\nimport { toast } from \"sonner\";\r\nimport {\r\n    Plus, Bell, Clock, CheckCircle2, AlertCircle, Calendar as CalendarIcon,\r\n    Trash2, Edit, Filter, TrendingUp\r\n} from \"lucide-react\";\r\nimport { format } from \"date-fns\";\r\nimport { ptBR } from \"date-fns/locale\";\r\n\r\ninterface Alarme {\r\n    id: string;\r\n    titulo: string;\r\n    descricao: string;\r\n    tipo: 'alarme' | 'lembrete' | 'tarefa';\r\n    prioridade: 'baixa' | 'media' | 'alta' | 'urgente';\r\n    data_hora: string;\r\n    concluido: boolean;\r\n    ativo: boolean;\r\n    canal_notificacao: string;\r\n}\r\n\r\nexport default function AlarmesLembretes() {\r\n    const { profile } = useAuth();\r\n    const [alarmes, setAlarmes] = useState<Alarme[]>([]);\r\n    const [filtroTipo, setFiltroTipo] = useState<string>('todos');\r\n    const [filtroStatus, setFiltroStatus] = useState<string>('pendentes');\r\n    const [loading, setLoading] = useState(true);\r\n\r\n    useEffect(() => {\r\n        if (profile?.tenant_id) {\r\n            loadAlarmes();\r\n        }\r\n    }, [profile?.tenant_id, filtroTipo, filtroStatus]);\r\n\r\n    const loadAlarmes = async () => {\r\n        try {\r\n            setLoading(true);\r\n\r\n            let query = supabase\r\n                .from('alarmes_lembretes')\r\n                .select('*')\r\n                .eq('tenant_id', profile.tenant_id)\r\n                .order('data_hora', { ascending: true });\r\n\r\n            if (filtroTipo !== 'todos') {\r\n                query = query.eq('tipo', filtroTipo);\r\n            }\r\n\r\n            if (filtroStatus === 'pendentes') {\r\n                query = query.eq('concluido', false).eq('ativo', true);\r\n            } else if (filtroStatus === 'concluidos') {\r\n                query = query.eq('concluido', true);\r\n            }\r\n\r\n            const { data, error } = await query;\r\n\r\n            if (error) throw error;\r\n            setAlarmes(data || []);\r\n        } catch (error) {\r\n            console.error('Erro ao carregar alarmes:', error);\r\n            toast.error('Erro ao carregar alarmes');\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const handleCriarAlarme = async (data: Partial<Alarme>) => {\r\n        try {\r\n            const { error } = await supabase\r\n                .from('alarmes_lembretes')\r\n                .insert({\r\n                    tenant_id: profile.tenant_id,\r\n                    usuario_id: profile.id,\r\n                    ...data\r\n                });\r\n\r\n            if (error) throw error;\r\n\r\n            toast.success('Alarme criado com sucesso!');\r\n            loadAlarmes();\r\n        } catch (error) {\r\n            toast.error('Erro ao criar alarme');\r\n        }\r\n    };\r\n\r\n    const handleConcluir = async (id: string) => {\r\n        try {\r\n            const { error } = await supabase.rpc('marcar_alarme_concluido', {\r\n                p_alarme_id: id,\r\n                p_usuario_id: profile.id\r\n            });\r\n\r\n            if (error) throw error;\r\n\r\n            toast.success('Alarme conclu├¡do!');\r\n            loadAlarmes();\r\n        } catch (error) {\r\n            toast.error('Erro ao concluir alarme');\r\n        }\r\n    };\r\n\r\n    const handleExcluir = async (id: string) => {\r\n        try {\r\n            const { error } = await supabase\r\n                .from('alarmes_lembretes')\r\n                .delete()\r\n                .eq('id', id);\r\n\r\n            if (error) throw error;\r\n\r\n            toast.success('Alarme exclu├¡do!');\r\n            loadAlarmes();\r\n        } catch (error) {\r\n            toast.error('Erro ao excluir alarme');\r\n        }\r\n    };\r\n\r\n    const getTipoBadge = (tipo: string) => {\r\n        const configs = {\r\n            alarme: { color: 'bg-red-100 text-red-800', icon: AlertCircle, label: 'Alarme' },\r\n            lembrete: { color: 'bg-blue-100 text-blue-800', icon: Bell, label: 'Lembrete' },\r\n            tarefa: { color: 'bg-green-100 text-green-800', icon: CheckCircle2, label: 'Tarefa' }\r\n        };\r\n\r\n        const config = configs[tipo as keyof typeof configs] || configs.lembrete;\r\n        const Icon = config.icon;\r\n\r\n        return (\r\n            <Badge className={config.color}>\r\n                <Icon className=\"h-3 w-3 mr-1\" />\r\n                {config.label}\r\n            </Badge>\r\n        );\r\n    };\r\n\r\n    const getPrioridadeBadge = (prioridade: string) => {\r\n        const colors = {\r\n            baixa: 'bg-gray-100 text-gray-800',\r\n            media: 'bg-yellow-100 text-yellow-800',\r\n            alta: 'bg-orange-100 text-orange-800',\r\n            urgente: 'bg-red-100 text-red-800'\r\n        };\r\n\r\n        return (\r\n            <Badge className={colors[prioridade as keyof typeof colors] || colors.media}>\r\n                {prioridade.toUpperCase()}\r\n            </Badge>\r\n        );\r\n    };\r\n\r\n    const isAtrasado = (dataHora: string) => {\r\n        return new Date(dataHora) < new Date();\r\n    };\r\n\r\n    return (\r\n        <MainLayout>\r\n            <div className=\"container mx-auto p-6 space-y-6\">\r\n                {/* Header */}\r\n                <div className=\"flex items-center justify-between\">\r\n                    <div>\r\n                        <h1 className=\"text-2xl font-bold tracking-tight\">Alarmes e Lembretes</h1>\r\n                        <p className=\"text-muted-foreground\">Gerencie seus alarmes, lembretes e tarefas</p>\r\n                    </div>\r\n                    <NovoAlarmeDialog onCreate={handleCriarAlarme} />\r\n                </div>\r\n\r\n                {/* Filtros */}\r\n                <Card>\r\n                    <CardContent className=\"pt-6\">\r\n                        <div className=\"flex gap-4\">\r\n                            <div className=\"flex-1\">\r\n                                <Label>Tipo</Label>\r\n                                <Select value={filtroTipo} onValueChange={setFiltroTipo}>\r\n                                    <SelectTrigger>\r\n                                        <SelectValue />\r\n                                    </SelectTrigger>\r\n                                    <SelectContent>\r\n                                        <SelectItem value=\"todos\">Todos</SelectItem>\r\n                                        <SelectItem value=\"alarme\">Alarmes</SelectItem>\r\n                                        <SelectItem value=\"lembrete\">Lembretes</SelectItem>\r\n                                        <SelectItem value=\"tarefa\">Tarefas</SelectItem>\r\n                                    </SelectContent>\r\n                                </Select>\r\n                            </div>\r\n                            <div className=\"flex-1\">\r\n                                <Label>Status</Label>\r\n                                <Select value={filtroStatus} onValueChange={setFiltroStatus}>\r\n                                    <SelectTrigger>\r\n                                        <SelectValue />\r\n                                    </SelectTrigger>\r\n                                    <SelectContent>\r\n                                        <SelectItem value=\"pendentes\">Pendentes</SelectItem>\r\n                                        <SelectItem value=\"concluidos\">Conclu├¡dos</SelectItem>\r\n                                        <SelectItem value=\"todos\">Todos</SelectItem>\r\n                                    </SelectContent>\r\n                                </Select>\r\n                            </div>\r\n                        </div>\r\n                    </CardContent>\r\n                </Card>\r\n\r\n                {/* Lista de Alarmes */}\r\n                <div className=\"space-y-3\">\r\n                    {loading ? (\r\n                        <div className=\"text-center py-8\">Carregando...</div>\r\n                    ) : alarmes.length === 0 ? (\r\n                        <Card>\r\n                            <CardContent className=\"py-12 text-center\">\r\n                                <Bell className=\"h-12 w-12 mx-auto mb-4 text-muted-foreground opacity-50\" />\r\n                                <p className=\"text-muted-foreground\">Nenhum alarme encontrado</p>\r\n                            </CardContent>\r\n                        </Card>\r\n                    ) : (\r\n                        alarmes.map((alarme) => (\r\n                            <Card key={alarme.id} className={`${isAtrasado(alarme.data_hora) && !alarme.concluido ? 'border-red-300 bg-red-50/50' : ''\r\n                                }`}>\r\n                                <CardContent className=\"p-4\">\r\n                                    <div className=\"flex items-start justify-between\">\r\n                                        <div className=\"flex-1\">\r\n                                            <div className=\"flex items-center gap-2 mb-2\">\r\n                                                <h3 className=\"font-semibold\">{alarme.titulo}</h3>\r\n                                                {getTipoBadge(alarme.tipo)}\r\n                                                {getPrioridadeBadge(alarme.prioridade)}\r\n                                                {isAtrasado(alarme.data_hora) && !alarme.concluido && (\r\n                                                    <Badge variant=\"destructive\">Atrasado</Badge>\r\n                                                )}\r\n                                                {alarme.concluido && (\r\n                                                    <Badge className=\"bg-green-100 text-green-800\">\r\n                                                        <CheckCircle2 className=\"h-3 w-3 mr-1\" />\r\n                                                        Conclu├¡do\r\n                                                    </Badge>\r\n                                                )}\r\n                                            </div>\r\n\r\n                                            {alarme.descricao && (\r\n                                                <p className=\"text-sm text-muted-foreground mb-2\">{alarme.descricao}</p>\r\n                                            )}\r\n\r\n                                            <div className=\"flex items-center gap-4 text-sm text-muted-foreground\">\r\n                                                <span className=\"flex items-center gap-1\">\r\n                                                    <CalendarIcon className=\"h-4 w-4\" />\r\n                                                    {format(new Date(alarme.data_hora), \"dd/MM/yyyy '├ás' HH:mm\", { locale: ptBR })}\r\n                                                </span>\r\n                                                <span className=\"flex items-center gap-1\">\r\n                                                    <Bell className=\"h-4 w-4\" />\r\n                                                    {alarme.canal_notificacao}\r\n                                                </span>\r\n                                            </div>\r\n                                        </div>\r\n\r\n                                        <div className=\"flex gap-2\">\r\n                                            {!alarme.concluido && (\r\n                                                <Button\r\n                                                    size=\"sm\"\r\n                                                    variant=\"outline\"\r\n                                                    onClick={() => handleConcluir(alarme.id)}\r\n                                                >\r\n                                                    <CheckCircle2 className=\"h-4 w-4\" />\r\n                                                </Button>\r\n                                            )}\r\n                                            <Button\r\n                                                size=\"sm\"\r\n                                                variant=\"ghost\"\r\n                                                onClick={() => handleExcluir(alarme.id)}\r\n                                            >\r\n                                                <Trash2 className=\"h-4 w-4\" />\r\n                                            </Button>\r\n                                        </div>\r\n                                    </div>\r\n                                </CardContent>\r\n                            </Card>\r\n                        ))\r\n                    )}\r\n                </div>\r\n            </div>\r\n        </MainLayout>\r\n    );\r\n}\r\n\r\nfunction NovoAlarmeDialog({ onCreate }: { onCreate: (data: any) => void }) {\r\n    const [open, setOpen] = useState(false);\r\n    const [titulo, setTitulo] = useState('');\r\n    const [descricao, setDescricao] = useState('');\r\n    const [tipo, setTipo] = useState('lembrete');\r\n    const [prioridade, setPrioridade] = useState('media');\r\n    const [data, setData] = useState<Date | undefined>(new Date());\r\n    const [hora, setHora] = useState('09:00');\r\n    const [canal, setCanal] = useState('sistema');\r\n\r\n    const handleSubmit = (e: React.FormEvent) => {\r\n        e.preventDefault();\r\n\r\n        if (!data) {\r\n            toast.error('Selecione uma data');\r\n            return;\r\n        }\r\n\r\n        const [horas, minutos] = hora.split(':');\r\n        const dataHora = new Date(data);\r\n        dataHora.setHours(parseInt(horas), parseInt(minutos));\r\n\r\n        onCreate({\r\n            titulo,\r\n            descricao,\r\n            tipo,\r\n            prioridade,\r\n            data_hora: dataHora.toISOString(),\r\n            canal_notificacao: canal\r\n        });\r\n\r\n        setOpen(false);\r\n        setTitulo('');\r\n        setDescricao('');\r\n        setTipo('lembrete');\r\n        setPrioridade('media');\r\n        setData(new Date());\r\n        setHora('09:00');\r\n        setCanal('sistema');\r\n    };\r\n\r\n    return (\r\n        <Dialog open={open} onOpenChange={setOpen}>\r\n            <DialogTrigger asChild>\r\n                <Button>\r\n                    <Plus className=\"mr-2 h-4 w-4\" /> Novo Alarme\r\n                </Button>\r\n            </DialogTrigger>\r\n            <DialogContent className=\"max-w-2xl\">\r\n                <DialogHeader>\r\n                    <DialogTitle>Criar Alarme/Lembrete</DialogTitle>\r\n                </DialogHeader>\r\n                <form onSubmit={handleSubmit} className=\"space-y-4\">\r\n                    <div>\r\n                        <Label>T├¡tulo</Label>\r\n                        <Input\r\n                            placeholder=\"Ex: Ligar para paciente\"\r\n                            value={titulo}\r\n                            onChange={e => setTitulo(e.target.value)}\r\n                            required\r\n                        />\r\n                    </div>\r\n\r\n                    <div>\r\n                        <Label>Descri├º├úo</Label>\r\n                        <Textarea\r\n                            placeholder=\"Detalhes adicionais...\"\r\n                            value={descricao}\r\n                            onChange={e => setDescricao(e.target.value)}\r\n                            rows={3}\r\n                        />\r\n                    </div>\r\n\r\n                    <div className=\"grid grid-cols-2 gap-4\">\r\n                        <div>\r\n                            <Label>Tipo</Label>\r\n                            <Select value={tipo} onValueChange={setTipo}>\r\n                                <SelectTrigger>\r\n                                    <SelectValue />\r\n                                </SelectTrigger>\r\n                                <SelectContent>\r\n                                    <SelectItem value=\"alarme\">Alarme (Urgente)</SelectItem>\r\n                                    <SelectItem value=\"lembrete\">Lembrete</SelectItem>\r\n                                    <SelectItem value=\"tarefa\">Tarefa</SelectItem>\r\n                                </SelectContent>\r\n                            </Select>\r\n                        </div>\r\n\r\n                        <div>\r\n                            <Label>Prioridade</Label>\r\n                            <Select value={prioridade} onValueChange={setPrioridade}>\r\n                                <SelectTrigger>\r\n                                    <SelectValue />\r\n                                </SelectTrigger>\r\n                                <SelectContent>\r\n                                    <SelectItem value=\"baixa\">Baixa</SelectItem>\r\n                                    <SelectItem value=\"media\">M├®dia</SelectItem>\r\n                                    <SelectItem value=\"alta\">Alta</SelectItem>\r\n                                    <SelectItem value=\"urgente\">Urgente</SelectItem>\r\n                                </SelectContent>\r\n                            </Select>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div className=\"grid grid-cols-2 gap-4\">\r\n                        <div>\r\n                            <Label>Data</Label>\r\n                            <Calendar\r\n                                mode=\"single\"\r\n                                selected={data}\r\n                                onSelect={setData}\r\n                                locale={ptBR}\r\n                                className=\"rounded-md border\"\r\n                            />\r\n                        </div>\r\n\r\n                        <div className=\"space-y-4\">\r\n                            <div>\r\n                                <Label>Hora</Label>\r\n                                <Input\r\n                                    type=\"time\"\r\n                                    value={hora}\r\n                                    onChange={e => setHora(e.target.value)}\r\n                                    required\r\n                                />\r\n                            </div>\r\n\r\n                            <div>\r\n                                <Label>Canal de Notifica├º├úo</Label>\r\n                                <Select value={canal} onValueChange={setCanal}>\r\n                                    <SelectTrigger>\r\n                                        <SelectValue />\r\n                                    </SelectTrigger>\r\n                                    <SelectContent>\r\n                                        <SelectItem value=\"sistema\">Sistema</SelectItem>\r\n                                        <SelectItem value=\"email\">E-mail</SelectItem>\r\n                                        <SelectItem value=\"whatsapp\">WhatsApp</SelectItem>\r\n                                        <SelectItem value=\"todos\">Todos</SelectItem>\r\n                                    </SelectContent>\r\n                                </Select>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div className=\"flex gap-2 justify-end\">\r\n                        <Button type=\"button\" variant=\"outline\" onClick={() => setOpen(false)}>\r\n                            Cancelar\r\n                        </Button>\r\n                        <Button type=\"submit\">\r\n                            Criar Alarme\r\n                        </Button>\r\n                    </div>\r\n                </form>\r\n            </DialogContent>\r\n        </Dialog>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\AnalyticsDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Atendimento.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\CaixaDiario.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchEntries'. Either include it or remove the dependency array.","line":81,"column":6,"nodeType":"ArrayExpression","endLine":81,"endColumn":20,"suggestions":[{"desc":"Update the dependencies array to be: [fetchEntries, selectedDate]","fix":{"range":[2612,2626],"text":"[fetchEntries, selectedDate]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\nimport { MainLayout } from \"@/components/layout/MainLayout\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { Loader2, TrendingUp, TrendingDown, DollarSign } from \"lucide-react\";\nimport { format, parseISO } from \"date-fns\";\nimport { ptBR } from \"date-fns/locale\";\n\ninterface CaixaEntry {\n  id: string;\n  data: string;\n  tipo_lancamento: string;\n  valor: number;\n  descricao: string | null;\n  forma_pagamento: string | null;\n  paciente_id: string | null;\n  profissional_id: string | null;\n  conta_pix_id: string | null;\n  conta_receber_id: string | null;\n  pacientes: { nome: string } | null;\n  profiles: { nome: string } | null;\n  contas_pix: { nome: string; chave_pix: string } | null;\n  contas_receber: {\n    valor: number;\n    plano_saude_id: string | null;\n    planos_saude: { nome: string } | null;\n  } | null;\n}\n\nexport default function CaixaDiario() {\n  const [entries, setEntries] = useState<CaixaEntry[]>([]);\n  const [isLoading, setIsLoading] = useState(true);\n  const [selectedDate, setSelectedDate] = useState(format(new Date(), 'yyyy-MM-dd'));\n  const { toast } = useToast();\n\n  const fetchEntries = async () => {\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) throw new Error(\"Usu├írio n├úo autenticado\");\n\n      const { data: profile } = await supabase\n        .from(\"profiles\")\n        .select(\"tenant_id\")\n        .eq(\"id\", user.id)\n        .single();\n\n      if (!profile?.tenant_id) throw new Error(\"Tenant n├úo encontrado\");\n\n      const { data, error } = await supabase\n        .from(\"caixa_diario\")\n        .select(`\n          *,\n          pacientes!caixa_diario_paciente_id_fkey(nome),\n          profiles!caixa_diario_profissional_id_fkey(nome),\n          contas_pix(nome, chave_pix),\n          contas_receber(valor, plano_saude_id, planos_saude(nome))\n        `)\n        .eq(\"tenant_id\", profile.tenant_id)\n        .eq(\"data\", selectedDate)\n        .order(\"created_at\", { ascending: false });\n\n      if (error) throw error;\n      setEntries(data || []);\n    } catch (error: any) {\n      toast({\n        title: \"Erro ao carregar caixa\",\n        description: error.message,\n        variant: \"destructive\",\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchEntries();\n  }, [selectedDate]);\n\n  const totals = entries.reduce(\n    (acc, entry) => {\n      if (entry.tipo_lancamento === 'entrada') {\n        acc.entrada += entry.valor;\n\n        // Detalhamento por forma de pagamento\n        const forma = entry.forma_pagamento || 'N├úo especificado';\n        if (!acc.porForma[forma]) {\n          acc.porForma[forma] = 0;\n        }\n        acc.porForma[forma] += entry.valor;\n\n        // Detalhamento de PIX por conta\n        if (forma.toLowerCase().includes('pix') && entry.contas_pix) {\n          const contaPix = entry.contas_pix.nome;\n          if (!acc.porContaPix[contaPix]) {\n            acc.porContaPix[contaPix] = 0;\n          }\n          acc.porContaPix[contaPix] += entry.valor;\n        }\n      } else {\n        acc.saida += entry.valor;\n      }\n      return acc;\n    },\n    { \n      entrada: 0, \n      saida: 0,\n      porForma: {} as Record<string, number>,\n      porContaPix: {} as Record<string, number>\n    }\n  );\n\n  const saldo = totals.entrada - totals.saida;\n\n  if (isLoading) {\n    return (\n      <MainLayout>\n        <div className=\"flex items-center justify-center h-96\">\n          <Loader2 className=\"h-8 w-8 animate-spin text-primary\" />\n        </div>\n      </MainLayout>\n    );\n  }\n\n  return (\n    <MainLayout>\n      <div className=\"space-y-6\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h1 className=\"text-3xl font-bold tracking-tight\">Caixa Di├írio</h1>\n            <p className=\"text-muted-foreground\">\n              Controle financeiro di├írio da cl├¡nica\n            </p>\n          </div>\n        </div>\n\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"data\">Data</Label>\n          <Input\n            id=\"data\"\n            type=\"date\"\n            value={selectedDate}\n            onChange={(e) => setSelectedDate(e.target.value)}\n            className=\"w-48\"\n          />\n        </div>\n\n        <div className=\"grid gap-4 md:grid-cols-3\">\n          <Card>\n            <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n              <CardTitle className=\"text-sm font-medium\">Entradas</CardTitle>\n              <TrendingUp className=\"h-4 w-4 text-green-600\" />\n            </CardHeader>\n            <CardContent>\n              <div className=\"text-2xl font-bold text-green-600\">\n                R$ {totals.entrada.toFixed(2)}\n              </div>\n            </CardContent>\n          </Card>\n\n          <Card>\n            <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n              <CardTitle className=\"text-sm font-medium\">Sa├¡das</CardTitle>\n              <TrendingDown className=\"h-4 w-4 text-red-600\" />\n            </CardHeader>\n            <CardContent>\n              <div className=\"text-2xl font-bold text-red-600\">\n                R$ {totals.saida.toFixed(2)}\n              </div>\n            </CardContent>\n          </Card>\n\n          <Card>\n            <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n              <CardTitle className=\"text-sm font-medium\">Saldo</CardTitle>\n              <DollarSign className=\"h-4 w-4\" />\n            </CardHeader>\n            <CardContent>\n              <div className={`text-2xl font-bold ${saldo >= 0 ? 'text-green-600' : 'text-red-600'}`}>\n                R$ {saldo.toFixed(2)}\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n\n        {/* Detalhamento por Forma de Pagamento */}\n        {Object.keys(totals.porForma).length > 0 && (\n          <Card>\n            <CardHeader>\n              <CardTitle>Detalhamento por Forma de Pagamento</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                {Object.entries(totals.porForma).map(([forma, valor]) => (\n                  <div key={forma} className=\"space-y-1\">\n                    <p className=\"text-sm font-medium text-muted-foreground\">{forma}</p>\n                    <p className=\"text-2xl font-bold\">R$ {valor.toFixed(2)}</p>\n                  </div>\n                ))}\n              </div>\n            </CardContent>\n          </Card>\n        )}\n\n        {/* Detalhamento PIX por Conta */}\n        {Object.keys(totals.porContaPix).length > 0 && (\n          <Card>\n            <CardHeader>\n              <CardTitle>Recebimentos PIX por Conta</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <div className=\"space-y-2\">\n                {Object.entries(totals.porContaPix).map(([conta, valor]) => (\n                  <div key={conta} className=\"flex justify-between items-center p-2 bg-muted/50 rounded\">\n                    <span className=\"font-medium\">{conta}</span>\n                    <span className=\"text-lg font-bold\">R$ {valor.toFixed(2)}</span>\n                  </div>\n                ))}\n              </div>\n            </CardContent>\n          </Card>\n        )}\n\n        <Card>\n          <CardHeader>\n            <CardTitle>Movimenta├º├Áes</CardTitle>\n          </CardHeader>\n          <CardContent>\n            {entries.length === 0 ? (\n              <div className=\"text-center py-8 text-muted-foreground\">\n                Nenhuma movimenta├º├úo registrada nesta data\n              </div>\n            ) : (\n              <div className=\"space-y-4\">\n                {entries.map((entry) => (\n                  <div\n                    key={entry.id}\n                    className=\"flex items-center justify-between p-4 border rounded-lg\"\n                  >\n                    <div className=\"flex-1\">\n                      <div className=\"font-medium\">{entry.descricao || 'Sem descri├º├úo'}</div>\n                      <div className=\"text-sm text-muted-foreground space-y-0.5\">\n                        {entry.pacientes?.nome && <div>Paciente: {entry.pacientes.nome}</div>}\n                        {entry.profiles?.nome && <div>Profissional: {entry.profiles.nome}</div>}\n                        {entry.forma_pagamento && <div>Pagamento: {entry.forma_pagamento}</div>}\n                        {entry.contas_pix && (\n                          <div>Conta PIX: {entry.contas_pix.nome}</div>\n                        )}\n                        {entry.contas_receber?.planos_saude && (\n                          <div>Plano: {entry.contas_receber.planos_saude.nome} (A receber)</div>\n                        )}\n                      </div>\n                    </div>\n                    <div className={`text-lg font-semibold ${\n                      entry.tipo_lancamento === 'entrada' ? 'text-green-600' : 'text-red-600'\n                    }`}>\n                      {entry.tipo_lancamento === 'entrada' ? '+' : '-'} R$ {entry.valor.toFixed(2)}\n                    </div>\n                  </div>\n                ))}\n              </div>\n            )}\n          </CardContent>\n        </Card>\n      </div>\n    </MainLayout>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Configuracoes.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchEspecialidades'. Either include it or remove the dependency array.","line":94,"column":6,"nodeType":"ArrayExpression","endLine":94,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [fetchEspecialidades]","fix":{"range":[3135,3137],"text":"[fetchEspecialidades]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { MainLayout } from \"@/components/layout/MainLayout\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card } from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { InviteMember } from \"@/components/settings/InviteMember\";\nimport { PendingInvitationsList } from \"@/components/settings/PendingInvitationsList\";\nimport { Slider } from \"@/components/ui/slider\";\nimport { supabase } from \"@/integrations/supabase/client\";\n\nfunction hexToHSL(hex: string): string {\n  const result = /^#?([a-f\\d]{2})([a-f\\d]{2})([a-f\\d]{2})$/i.exec(hex);\n  if (!result) return \"210 100% 45%\";\n  let r = parseInt(result[1], 16);\n  let g = parseInt(result[2], 16);\n  let b = parseInt(result[3], 16);\n  r /= 255; g /= 255; b /= 255;\n  const max = Math.max(r, g, b), min = Math.min(r, g, b);\n  let h = 0, s, l = (max + min) / 2;\n  if (max === min) {\n    h = s = 0;\n  } else {\n    const d = max - min;\n    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);\n    switch (max) {\n      case r: h = (g - b) / d + (g < b ? 6 : 0); break;\n      case g: h = (b - r) / d + 2; break;\n      case b: h = (r - g) / d + 4; break;\n    }\n    h /= 6;\n  }\n  s = Math.round(s * 100);\n  l = Math.round(l * 100);\n  h = Math.round(h * 360);\n  return `${h} ${s}% ${l}%`;\n}\nimport { useToast } from \"@/hooks/use-toast\";\nimport { useAuth } from \"@/hooks/useAuth\";\nimport { useTenantData } from \"@/hooks/useTenantData\";\nimport {\n  Settings,\n  Palette,\n  MessageSquare,\n  Clock,\n  Shield,\n  Building,\n  Stethoscope,\n  Loader2,\n  Plus,\n  DollarSign,\n  Save,\n  Layers,\n  CreditCard,\n  Users,\n  HelpCircle\n} from \"lucide-react\";\nimport { useRef } from \"react\";\nimport FinanceiroConfig from \"@/components/configuracoes/FinanceiroConfig\";\nimport SegmentoConfig from \"@/components/configuracoes/SegmentoConfig\";\nimport PlanosConfig from \"@/components/configuracoes/PlanosConfig\";\nimport { TourControl } from \"@/components/tour/TourControl\";\n\ninterface Especialidade {\n  id: string;\n  nome: string;\n}\n\nconst Configuracoes = () => {\n  const { profile } = useAuth();\n  const { tenantData, updateTenantData } = useTenantData();\n  const [especialidades, setEspecialidades] = useState<Especialidade[]>([]);\n  const [isLoadingEspecialidades, setIsLoadingEspecialidades] = useState(true);\n  const [isSaving, setIsSaving] = useState(false);\n  const [selectedTypes, setSelectedTypes] = useState<string[]>([]);\n  const [scheduleMode, setScheduleMode] = useState<\"por_profissional\" | \"por_clinica_sala\">(\"por_profissional\");\n  const [clinicData, setClinicData] = useState({\n    razaoSocial: \"\",\n    nomeFantasia: \"\",\n    cnpj: \"\",\n    timezone: \"America/Sao_Paulo\",\n    primaryColor: \"#016CA5\",\n    accentColor: \"#25D366\",\n    fontSize: 16\n  });\n  const { toast } = useToast();\n\n  useEffect(() => {\n    fetchEspecialidades();\n  }, []);\n\n  // Sync local state with tenant data from context\n  useEffect(() => {\n    if (tenantData) {\n      setClinicData(prev => ({\n        ...prev,\n        razaoSocial: tenantData.razao_social || tenantData.nome || \"\",\n        nomeFantasia: tenantData.nome_fantasia || \"\",\n        cnpj: tenantData.cnpj || \"\",\n        fontSize: tenantData.font_size || 16,\n        primaryColor: tenantData.cor_primaria || \"#016CA5\",\n        accentColor: tenantData.cor_acao || \"#25D366\"\n      }));\n    }\n  }, [tenantData]);\n\n  const previewRef = useRef<HTMLDivElement>(null);\n\n  // Apply font size and colors ONLY to the preview container\n  useEffect(() => {\n    const previewElement = previewRef.current;\n    if (!previewElement) return;\n\n    // Font Size\n    if (clinicData.fontSize) {\n      previewElement.style.fontSize = `${clinicData.fontSize}px`;\n    }\n\n    // Colors\n    if (clinicData.primaryColor) {\n      const hsl = hexToHSL(clinicData.primaryColor);\n      previewElement.style.setProperty('--primary', hsl);\n      previewElement.style.setProperty('--ring', hsl);\n    }\n\n    if (clinicData.accentColor) {\n      const hsl = hexToHSL(clinicData.accentColor);\n      previewElement.style.setProperty('--accent', hsl);\n    }\n  }, [clinicData.fontSize, clinicData.primaryColor, clinicData.accentColor]);\n\n  const handleSaveConfiguracoes = async () => {\n    if (!profile?.tenant_id) return;\n\n    if (!clinicData.razaoSocial.trim()) {\n      toast({\n        title: \"Campo obrigat├│rio\",\n        description: \"A Raz├úo Social ├® obrigat├│ria.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    setIsSaving(true);\n    try {\n      const { error } = await supabase\n        .from('tenants')\n        .update({\n          razao_social: clinicData.razaoSocial,\n          nome_fantasia: clinicData.nomeFantasia || null,\n          cnpj: clinicData.cnpj || null,\n          nome: clinicData.razaoSocial, // Keep nome in sync with razao_social for backwards compatibility\n          font_size: clinicData.fontSize,\n          cor_primaria: clinicData.primaryColor,\n          cor_acao: clinicData.accentColor\n        })\n        .eq('id', profile.tenant_id);\n\n      if (error) throw error;\n\n      // Update the global tenant context so sidebar updates immediately\n      updateTenantData({\n        razao_social: clinicData.razaoSocial,\n        nome_fantasia: clinicData.nomeFantasia,\n        cnpj: clinicData.cnpj,\n        nome: clinicData.razaoSocial,\n        font_size: clinicData.fontSize,\n        cor_primaria: clinicData.primaryColor,\n        cor_acao: clinicData.accentColor\n      });\n\n      toast({\n        title: \"Sucesso\",\n        description: \"Configura├º├Áes salvas com sucesso!\"\n      });\n    } catch (error) {\n      console.error('Erro ao salvar configura├º├Áes:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel salvar as configura├º├Áes.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  const fetchEspecialidades = async () => {\n    try {\n      setIsLoadingEspecialidades(true);\n      const { data, error } = await supabase\n        .from('especialidades')\n        .select('id, nome')\n        .eq('ativo', true)\n        .order('nome');\n\n      if (error) throw error;\n\n      // Adicionar \"Outra Especialidade\" no final\n      const especialidadesComOutra = [\n        ...(data || []),\n        { id: 'outra', nome: 'Outra Especialidade' }\n      ];\n\n      setEspecialidades(especialidadesComOutra);\n    } catch (error) {\n      console.error('Erro ao buscar especialidades:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar as especialidades.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoadingEspecialidades(false);\n    }\n  };\n\n  const toggleClinicType = (typeId: string) => {\n    setSelectedTypes(prev =>\n      prev.includes(typeId)\n        ? prev.filter(id => id !== typeId)\n        : [...prev, typeId]\n    );\n  };\n\n  return (\n\n    <MainLayout>\n      <div className=\"space-y-6\">\n        <div>\n          <h1 className=\"text-3xl font-bold text-foreground\">Configura├º├Áes da Cl├¡nica</h1>\n          <p className=\"text-muted-foreground\">\n            Personalize sua cl├¡nica e configure as funcionalidades do CleanFlow\n          </p>\n        </div>\n\n        <Tabs defaultValue=\"geral\" className=\"space-y-6\">\n          <TabsList className=\"w-full flex justify-start overflow-x-auto\">\n            <TabsTrigger value=\"geral\">\n              <Building className=\"h-4 w-4 mr-2\" />\n              Geral\n            </TabsTrigger>\n            <TabsTrigger value=\"segmento\">\n              <Layers className=\"h-4 w-4 mr-2\" />\n              Segmento\n            </TabsTrigger>\n            <TabsTrigger value=\"identidade\">\n              <Palette className=\"h-4 w-4 mr-2\" />\n              Apar├¬ncia\n            </TabsTrigger>\n            <TabsTrigger value=\"agenda\">\n              <Clock className=\"h-4 w-4 mr-2\" />\n              Agenda\n            </TabsTrigger>\n            <TabsTrigger value=\"financeiro\">\n              <DollarSign className=\"h-4 w-4 mr-2\" />\n              Financeiro\n            </TabsTrigger>\n            <TabsTrigger value=\"planos\">\n              <CreditCard className=\"h-4 w-4 mr-2\" />\n              Planos\n            </TabsTrigger>\n            <TabsTrigger value=\"mensagens\">\n              <MessageSquare className=\"h-4 w-4 mr-2\" />\n              Mensagens\n            </TabsTrigger>\n            <TabsTrigger value=\"lgpd\">\n              <Shield className=\"h-4 w-4 mr-2\" />\n              LGPD\n            </TabsTrigger>\n            <TabsTrigger value=\"equipe\">\n              <Users className=\"h-4 w-4 mr-2\" />\n              Equipe\n            </TabsTrigger>\n            <TabsTrigger value=\"ajuda\">\n              <HelpCircle className=\"h-4 w-4 mr-2\" />\n              Ajuda\n            </TabsTrigger>\n          </TabsList>\n\n          <TabsContent value=\"ajuda\" className=\"space-y-6\">\n            <TourControl />\n          </TabsContent>\n\n          <TabsContent value=\"equipe\" className=\"space-y-6\">\n            <Card className=\"p-6\">\n              <h3 className=\"text-lg font-semibold mb-4\">Gest├úo de Equipe</h3>\n              <p className=\"text-sm text-muted-foreground mb-6\">\n                Convide novos membros para sua cl├¡nica e gerencie permiss├Áes.\n              </p>\n              <InviteMember />\n              <PendingInvitationsList />\n            </Card>\n          </TabsContent>\n\n          <TabsContent value=\"segmento\" className=\"space-y-6\">\n            <SegmentoConfig />\n          </TabsContent>\n\n          <TabsContent value=\"geral\" className=\"space-y-6\">\n            <Card className=\"p-6\">\n              <h3 className=\"text-lg font-semibold mb-4\">Informa├º├Áes B├ísicas</h3>\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                <div>\n                  <Label htmlFor=\"razao-social\">Raz├úo Social *</Label>\n                  <Input\n                    id=\"razao-social\"\n                    placeholder=\"Nome legal da empresa\"\n                    value={clinicData.razaoSocial}\n                    onChange={(e) => setClinicData(prev => ({ ...prev, razaoSocial: e.target.value }))}\n                  />\n                  <p className=\"text-xs text-muted-foreground mt-1\">Nome legal registrado</p>\n                </div>\n                <div>\n                  <Label htmlFor=\"nome-fantasia\">Nome Fantasia</Label>\n                  <Input\n                    id=\"nome-fantasia\"\n                    placeholder=\"Nome comercial (opcional)\"\n                    value={clinicData.nomeFantasia}\n                    onChange={(e) => setClinicData(prev => ({ ...prev, nomeFantasia: e.target.value }))}\n                  />\n                  <p className=\"text-xs text-muted-foreground mt-1\">Nome exibido no sistema</p>\n                </div>\n                <div>\n                  <Label htmlFor=\"cnpj\">CNPJ (opcional)</Label>\n                  <Input\n                    id=\"cnpj\"\n                    placeholder=\"00.000.000/0000-00\"\n                    value={clinicData.cnpj}\n                    onChange={(e) => setClinicData(prev => ({ ...prev, cnpj: e.target.value }))}\n                  />\n                </div>\n              </div>\n            </Card>\n\n            <Card className=\"p-6\">\n              <h3 className=\"text-lg font-semibold mb-4\">Especialidades da Cl├¡nica</h3>\n              <p className=\"text-sm text-muted-foreground mb-4\">\n                Selecione as especialidades oferecidas pela sua cl├¡nica\n              </p>\n\n              {isLoadingEspecialidades ? (\n                <div className=\"flex items-center justify-center py-8\">\n                  <Loader2 className=\"h-6 w-6 animate-spin text-primary\" />\n                </div>\n              ) : especialidades.length === 0 ? (\n                <div className=\"text-center py-8\">\n                  <Stethoscope className=\"h-12 w-12 mx-auto text-muted-foreground mb-2\" />\n                  <p className=\"text-sm text-muted-foreground\">\n                    Nenhuma especialidade cadastrada. Cadastre especialidades em Especialidades.\n                  </p>\n                </div>\n              ) : (\n                <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3\">\n                  {especialidades.map((especialidade) => {\n                    const isSelected = selectedTypes.includes(especialidade.id);\n                    const isOutra = especialidade.id === 'outra';\n\n                    return (\n                      <button\n                        key={especialidade.id}\n                        onClick={() => toggleClinicType(especialidade.id)}\n                        className={`p-4 rounded-lg border-2 transition-all text-left ${isSelected\n                          ? \"border-primary bg-primary-light text-primary\"\n                          : \"border-border hover:border-primary/50\"\n                          } ${isOutra ? \"border-dashed\" : \"\"}`}\n                      >\n                        <div className=\"flex items-center gap-2\">\n                          {isOutra ? (\n                            <Plus className=\"h-5 w-5 flex-shrink-0\" />\n                          ) : (\n                            <Stethoscope className=\"h-5 w-5 flex-shrink-0\" />\n                          )}\n                          <p className=\"text-sm font-medium line-clamp-2\">{especialidade.nome}</p>\n                        </div>\n                      </button>\n                    );\n                  })}\n                </div>\n              )}\n            </Card>\n          </TabsContent>\n\n          <TabsContent value=\"agenda\" className=\"space-y-6\">\n            <Card className=\"p-6\">\n              <h3 className=\"text-lg font-semibold mb-4\">Modo de Agendamento</h3>\n              <div className=\"space-y-4\">\n                <div className={`p-4 border rounded-lg cursor-pointer transition-colors ${scheduleMode === \"por_profissional\" ? \"border-primary bg-primary-light\" : \"border-border\"\n                  }`} onClick={() => setScheduleMode(\"por_profissional\")}>\n                  <div className=\"flex items-center gap-3\">\n                    <div className={`w-4 h-4 rounded-full border-2 ${scheduleMode === \"por_profissional\" ? \"border-primary bg-primary\" : \"border-border\"\n                      }`} />\n                    <div>\n                      <h4 className=\"font-medium\">Por Profissional</h4>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Cada m├®dico/dentista tem sua pr├│pria agenda\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                <div className={`p-4 border rounded-lg cursor-pointer transition-colors ${scheduleMode === \"por_clinica_sala\" ? \"border-primary bg-primary-light\" : \"border-border\"\n                  }`} onClick={() => setScheduleMode(\"por_clinica_sala\")}>\n                  <div className=\"flex items-center gap-3\">\n                    <div className={`w-4 h-4 rounded-full border-2 ${scheduleMode === \"por_clinica_sala\" ? \"border-primary bg-primary\" : \"border-border\"\n                      }`} />\n                    <div>\n                      <h4 className=\"font-medium\">Por Cl├¡nica/Sala</h4>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Agenda por sala/consult├│rio, profissional alocado depois\n                      </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </Card>\n\n            <Card className=\"p-6\">\n              <h3 className=\"text-lg font-semibold mb-4\">Pol├¡ticas de Agendamento</h3>\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                <div>\n                  <Label htmlFor=\"antecedencia\">Anteced├¬ncia M├¡nima (horas)</Label>\n                  <Input id=\"antecedencia\" type=\"number\" defaultValue=\"12\" />\n                </div>\n                <div>\n                  <Label htmlFor=\"janela\">Janela de Agendamento (dias)</Label>\n                  <Input id=\"janela\" type=\"number\" defaultValue=\"21\" />\n                </div>\n                <div className=\"flex items-center space-x-2\">\n                  <Switch id=\"overbooking\" />\n                  <Label htmlFor=\"overbooking\">Permitir Overbooking</Label>\n                </div>\n              </div>\n            </Card>\n          </TabsContent>\n\n          <TabsContent value=\"mensagens\" className=\"space-y-6\">\n            <Card className=\"p-6\">\n              <h3 className=\"text-lg font-semibold mb-4\">Canais de Mensagem</h3>\n              <div className=\"space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h4 className=\"font-medium\">WhatsApp (Deep Link)</h4>\n                    <p className=\"text-sm text-muted-foreground\">Gratuito - abre conversa no WhatsApp</p>\n                  </div>\n                  <Switch defaultChecked />\n                </div>\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h4 className=\"font-medium\">CallMeBot (WhatsApp autom├ítico)</h4>\n                    <p className=\"text-sm text-muted-foreground\">Gratuito - envio autom├ítico</p>\n                  </div>\n                  <Switch />\n                </div>\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h4 className=\"font-medium\">E-mail</h4>\n                    <p className=\"text-sm text-muted-foreground\">Configur├ível por provedor</p>\n                  </div>\n                  <Switch defaultChecked />\n                </div>\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h4 className=\"font-medium\">SMS</h4>\n                    <p className=\"text-sm text-muted-foreground\">Desabilitado por padr├úo</p>\n                  </div>\n                  <Switch />\n                </div>\n              </div>\n            </Card>\n\n            <Card className=\"p-6\">\n              <h3 className=\"text-lg font-semibold mb-4\">Templates de Mensagem</h3>\n              <div className=\"space-y-4\">\n                <div>\n                  <Label htmlFor=\"template-d2\">Confirma├º├úo D-2 (WhatsApp)</Label>\n                  <Textarea\n                    id=\"template-d2\"\n                    defaultValue=\"Ol├í {{paciente}}, sua consulta ├® {{data}} ├ás {{hora}} com {{profissional}} na {{clinica}}. Confirmar: {{link_confirmar}} ÔÇó Reagendar: {{link_reagendar}}\"\n                    rows={3}\n                  />\n                </div>\n                <div>\n                  <Label htmlFor=\"template-h3\">Lembrete H-3h (WhatsApp)</Label>\n                  <Textarea\n                    id=\"template-h3\"\n                    defaultValue=\"Lembrete: hoje ├ás {{hora}} com {{profissional}}. Confirmar: {{link_confirmar}} ÔÇó Reagendar: {{link_reagendar}}\"\n                    rows={3}\n                  />\n                </div>\n              </div>\n            </Card>\n          </TabsContent>\n\n          <TabsContent value=\"financeiro\" className=\"space-y-6\">\n            <FinanceiroConfig />\n          </TabsContent>\n\n          <TabsContent value=\"planos\" className=\"space-y-6\">\n            <PlanosConfig />\n          </TabsContent>\n\n          <TabsContent value=\"identidade\" className=\"space-y-6\">\n            <Card className=\"p-6\">\n              <h3 className=\"text-lg font-semibold mb-4\">Apar├¬ncia e Cores</h3>\n\n              <div className=\"space-y-8\">\n                <div>\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <div>\n                      <Label htmlFor=\"font-size\" className=\"text-base\">Tamanho da Fonte</Label>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Ajuste o tamanho da fonte do sistema para melhor legibilidade.\n                      </p>\n                    </div>\n                    <Badge variant=\"outline\" className=\"text-base px-3 py-1\">\n                      {clinicData.fontSize}px\n                    </Badge>\n                  </div>\n                  <Slider\n                    id=\"font-size\"\n                    min={12}\n                    max={20}\n                    step={1}\n                    value={[clinicData.fontSize]}\n                    onValueChange={(value) => setClinicData(prev => ({ ...prev, fontSize: value[0] }))}\n                    className=\"w-full max-w-xl\"\n                  />\n                  <div className=\"flex justify-between text-xs text-muted-foreground max-w-xl mt-2\">\n                    <span>Pequeno (12px)</span>\n                    <span>Padr├úo (16px)</span>\n                    <span>Grande (20px)</span>\n                  </div>\n\n                  {/* Preview Section */}\n                  <div\n                    ref={previewRef}\n                    className=\"mt-8 p-6 border rounded-lg bg-background/50\"\n                  >\n                    <h4 className=\"text-sm font-medium text-muted-foreground mb-4\">Visualiza├º├úo</h4>\n                    <div className=\"space-y-4\">\n                      <div>\n                        <h1 className=\"text-2xl font-bold\">T├¡tulo Principal (H1)</h1>\n                        <p className=\"text-sm text-muted-foreground\">Exemplo de t├¡tulo de p├ígina</p>\n                      </div>\n                      <div>\n                        <h2 className=\"text-xl font-semibold\">Subt├¡tulo (H2)</h2>\n                        <p className=\"text-base\">\n                          Este ├® um exemplo de texto padr├úo do corpo. O tamanho da fonte ajustado afetar├í a legibilidade de todo o conte├║do.\n                        </p>\n                      </div>\n                      <div className=\"flex items-center gap-2\">\n                        <Badge>Badge</Badge>\n                        <Button size=\"sm\">Bot├úo Pequeno</Button>\n                        <p className=\"text-sm text-muted-foreground\">Texto pequeno e legendas</p>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t\">\n                  <div>\n                    <Label htmlFor=\"primary-color\">Cor Prim├íria</Label>\n                    <div className=\"flex items-center gap-3\">\n                      <Input\n                        id=\"primary-color\"\n                        type=\"color\"\n                        value={clinicData.primaryColor}\n                        onChange={(e) => setClinicData(prev => ({ ...prev, primaryColor: e.target.value }))}\n                        className=\"w-16 h-10\"\n                      />\n                      <Input\n                        value={clinicData.primaryColor}\n                        onChange={(e) => setClinicData(prev => ({ ...prev, primaryColor: e.target.value }))}\n                      />\n                    </div>\n                  </div>\n                  <div>\n                    <Label htmlFor=\"accent-color\">Cor de A├º├úo</Label>\n                    <div className=\"flex items-center gap-3\">\n                      <Input\n                        id=\"accent-color\"\n                        type=\"color\"\n                        value={clinicData.accentColor}\n                        onChange={(e) => setClinicData(prev => ({ ...prev, accentColor: e.target.value }))}\n                        className=\"w-16 h-10\"\n                      />\n                      <Input\n                        value={clinicData.accentColor}\n                        onChange={(e) => setClinicData(prev => ({ ...prev, accentColor: e.target.value }))}\n                      />\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </Card>\n          </TabsContent>\n\n          <TabsContent value=\"lgpd\" className=\"space-y-6\">\n            <Card className=\"p-6\">\n              <h3 className=\"text-lg font-semibold mb-4\">Configura├º├Áes LGPD</h3>\n              <div className=\"space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h4 className=\"font-medium\">Consentimento Obrigat├│rio</h4>\n                    <p className=\"text-sm text-muted-foreground\">Exigir aceite antes do agendamento</p>\n                  </div>\n                  <Switch defaultChecked />\n                </div>\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h4 className=\"font-medium\">Logs de Auditoria</h4>\n                    <p className=\"text-sm text-muted-foreground\">Registrar todas as a├º├Áes</p>\n                  </div>\n                  <Switch defaultChecked />\n                </div>\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h4 className=\"font-medium\">Minimiza├º├úo de Dados</h4>\n                    <p className=\"text-sm text-muted-foreground\">Coletar apenas dados essenciais</p>\n                  </div>\n                  <Switch defaultChecked />\n                </div>\n              </div>\n            </Card>\n          </TabsContent>\n        </Tabs>\n\n        <div className=\"flex gap-3\">\n          <Button size=\"lg\" onClick={handleSaveConfiguracoes} disabled={isSaving}>\n            {isSaving ? (\n              <>\n                <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n                Salvando...\n              </>\n            ) : (\n              <>\n                <Save className=\"h-4 w-4 mr-2\" />\n                Salvar Configura├º├Áes\n              </>\n            )}\n          </Button>\n          <Button variant=\"outline\" size=\"lg\">\n            Cancelar\n          </Button>\n        </div>\n      </div>\n    </MainLayout>\n  );\n};\n\nexport default Configuracoes;","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\ConfiguracoesWhatsApp.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Contact.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Especialidades.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchEspecialidades'. Either include it or remove the dependency array.","line":60,"column":6,"nodeType":"ArrayExpression","endLine":60,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [fetchEspecialidades]","fix":{"range":[1796,1798],"text":"[fetchEspecialidades]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { MainLayout } from \"@/components/layout/MainLayout\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card } from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Input } from \"@/components/ui/input\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { \n  Edit, \n  Trash2, \n  Loader2,\n  Search,\n  Stethoscope\n} from \"lucide-react\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { NewEspecialidadeDialog } from \"@/components/schedule/NewEspecialidadeDialog\";\nimport { EditEspecialidadeDialog } from \"@/components/schedule/EditEspecialidadeDialog\";\n\ninterface Especialidade {\n  id: string;\n  nome: string;\n  descricao: string | null;\n  codigo_cfm: string | null;\n  ativo: boolean;\n  created_at: string;\n}\n\nconst Especialidades = () => {\n  const [especialidades, setEspecialidades] = useState<Especialidade[]>([]);\n  const [isLoading, setIsLoading] = useState(true);\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [editingId, setEditingId] = useState<string | null>(null);\n  const { toast } = useToast();\n\n  const fetchEspecialidades = async () => {\n    try {\n      setIsLoading(true);\n      const { data, error } = await supabase\n        .from('especialidades')\n        .select('*')\n        .order('nome');\n\n      if (error) throw error;\n      setEspecialidades(data || []);\n    } catch (error) {\n      console.error('Erro ao buscar especialidades:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar as especialidades.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchEspecialidades();\n  }, []);\n\n  const toggleStatus = async (id: string, currentStatus: boolean) => {\n    try {\n      const { error } = await supabase\n        .from('especialidades')\n        .update({ ativo: !currentStatus })\n        .eq('id', id);\n\n      if (error) throw error;\n\n      setEspecialidades(prev => prev.map(e => \n        e.id === id ? { ...e, ativo: !currentStatus } : e\n      ));\n\n      toast({\n        title: \"Status atualizado\",\n        description: `Especialidade ${!currentStatus ? \"ativada\" : \"desativada\"} com sucesso.`\n      });\n    } catch (error) {\n      console.error('Erro ao atualizar status:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel atualizar o status.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const deleteEspecialidade = async (id: string) => {\n    // Importar valida├º├úo\n    const { validateEspecialidadeDelete } = await import('@/lib/deleteValidation');\n    \n    // Validar antes de excluir\n    const validation = await validateEspecialidadeDelete(id);\n    \n    if (!validation.canDelete) {\n      toast({\n        title: \"N├úo ├® poss├¡vel excluir\",\n        description: validation.message,\n        variant: \"destructive\",\n        duration: 10000\n      });\n      return;\n    }\n\n    if (!confirm(\"Tem certeza que deseja excluir esta especialidade?\")) return;\n\n    try {\n      const { error } = await supabase\n        .from('especialidades')\n        .delete()\n        .eq('id', id);\n\n      if (error) throw error;\n\n      setEspecialidades(prev => prev.filter(e => e.id !== id));\n      \n      toast({\n        title: \"Especialidade exclu├¡da\",\n        description: \"A especialidade foi removida com sucesso.\"\n      });\n    } catch (error) {\n      console.error('Erro ao excluir:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel excluir a especialidade.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const filteredEspecialidades = especialidades.filter(e => \n    e.nome.toLowerCase().includes(searchTerm.toLowerCase()) ||\n    (e.codigo_cfm && e.codigo_cfm.includes(searchTerm))\n  );\n\n  return (\n    <MainLayout>\n      <div className=\"space-y-6\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h1 className=\"text-3xl font-bold text-foreground\">Especialidades M├®dicas</h1>\n            <p className=\"text-muted-foreground\">\n              Gerenciar especialidades reconhecidas ({especialidades.length})\n            </p>\n          </div>\n          {!isLoading && especialidades.length > 0 && (\n            <NewEspecialidadeDialog onSuccess={() => fetchEspecialidades()} />\n          )}\n        </div>\n\n        <div className=\"relative\">\n          <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground\" />\n          <Input\n            placeholder=\"Buscar por nome ou c├│digo CFM...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"pl-10\"\n          />\n        </div>\n\n        {isLoading ? (\n          <div className=\"flex items-center justify-center py-12\">\n            <Loader2 className=\"h-8 w-8 animate-spin text-primary\" />\n          </div>\n        ) : filteredEspecialidades.length === 0 ? (\n          <div className=\"text-center py-12\">\n            <Stethoscope className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n            <h3 className=\"text-lg font-semibold mb-2\">\n              {searchTerm ? \"Nenhuma especialidade encontrada\" : \"Nenhuma especialidade cadastrada\"}\n            </h3>\n            <p className=\"text-muted-foreground mb-4\">\n              {searchTerm ? \"Tente uma busca diferente\" : \"Comece adicionando sua primeira especialidade\"}\n            </p>\n            {!searchTerm && <NewEspecialidadeDialog onSuccess={() => fetchEspecialidades()} />}\n          </div>\n        ) : (\n          <div className=\"grid gap-4\">\n            {filteredEspecialidades.map((especialidade) => (\n              <Card key={especialidade.id} className=\"p-6\">\n                <div className=\"flex items-start justify-between mb-4\">\n                  <div className=\"flex items-center gap-4\">\n                    <div className=\"p-3 bg-primary-light rounded-full\">\n                      <Stethoscope className=\"h-6 w-6 text-primary\" />\n                    </div>\n                    <div>\n                      <h3 className=\"text-lg font-semibold text-foreground\">{especialidade.nome}</h3>\n                      {especialidade.codigo_cfm && (\n                        <p className=\"text-sm text-muted-foreground\">C├│digo CFM: {especialidade.codigo_cfm}</p>\n                      )}\n                      {especialidade.descricao && (\n                        <p className=\"text-sm text-muted-foreground mt-1\">{especialidade.descricao}</p>\n                      )}\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <Badge variant={especialidade.ativo ? \"default\" : \"secondary\"}>\n                      {especialidade.ativo ? \"Ativo\" : \"Inativo\"}\n                    </Badge>\n                    <Switch\n                      checked={especialidade.ativo}\n                      onCheckedChange={() => toggleStatus(especialidade.id, especialidade.ativo)}\n                    />\n                  </div>\n                </div>\n\n                <div className=\"flex gap-2\">\n                  <Button \n                    size=\"sm\" \n                    variant=\"outline\"\n                    onClick={() => setEditingId(especialidade.id)}\n                  >\n                    <Edit className=\"h-4 w-4 mr-2\" />\n                    Editar\n                  </Button>\n                  <Button\n                    size=\"sm\" \n                    variant=\"outline\" \n                    onClick={() => deleteEspecialidade(especialidade.id)}\n                    className=\"text-destructive hover:text-destructive\"\n                  >\n                    <Trash2 className=\"h-4 w-4 mr-2\" />\n                    Excluir\n                  </Button>\n                </div>\n              </Card>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {editingId && (\n        <EditEspecialidadeDialog\n          especialidadeId={editingId}\n          open={!!editingId}\n          onOpenChange={(open) => !open && setEditingId(null)}\n          onSuccess={() => fetchEspecialidades()}\n        />\n      )}\n    </MainLayout>\n  );\n};\n\nexport default Especialidades;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Exames.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchExames'. Either include it or remove the dependency array.","line":69,"column":6,"nodeType":"ArrayExpression","endLine":69,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [fetchExames]","fix":{"range":[1902,1904],"text":"[fetchExames]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { MainLayout } from \"@/components/layout/MainLayout\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card } from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { Input } from \"@/components/ui/input\";\nimport {\n  Edit,\n  Trash2,\n  Clock,\n  DollarSign,\n  TestTube,\n  Loader2,\n  CheckCircle2,\n  Search\n} from \"lucide-react\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { NewExameDialog } from \"@/components/schedule/NewExameDialog\";\nimport { EditExameDialog } from \"@/components/schedule/EditExameDialog\";\n\ninterface Exame {\n  id: string;\n  nome: string;\n  codigo_tuss: string | null;\n  descricao: string | null;\n  tempo_preparo_minutos: number | null;\n  tempo_jejum_horas: number | null;\n  duracao_minutos: number | null;\n  preco: number | null;\n  instrucoes: string | null;\n  requisitos: string | null;\n  ativo: boolean;\n  created_at: string;\n}\n\nconst Exames = () => {\n  const [exames, setExames] = useState<Exame[]>([]);\n  const [isLoading, setIsLoading] = useState(true);\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [editingId, setEditingId] = useState<string | null>(null);\n  const { toast } = useToast();\n\n  const fetchExames = async () => {\n    try {\n      setIsLoading(true);\n      const { data, error } = await supabase\n        .from('exames')\n        .select('*')\n        .order('nome');\n\n      if (error) throw error;\n      setExames(data || []);\n    } catch (error) {\n      console.error('Erro ao buscar exames:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os exames.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchExames();\n  }, []);\n\n  const toggleStatus = async (id: string, currentStatus: boolean) => {\n    try {\n      const { error } = await supabase\n        .from('exames')\n        .update({ ativo: !currentStatus })\n        .eq('id', id);\n\n      if (error) throw error;\n\n      setExames(prev => prev.map(exame =>\n        exame.id === id ? { ...exame, ativo: !currentStatus } : exame\n      ));\n\n      toast({\n        title: \"Status atualizado\",\n        description: `Exame ${!currentStatus ? \"ativado\" : \"desativado\"} com sucesso.`\n      });\n    } catch (error) {\n      console.error('Erro ao atualizar status:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel atualizar o status.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const deleteExame = async (id: string) => {\n    if (!confirm(\"Tem certeza que deseja excluir este exame? Esta a├º├úo n├úo pode ser desfeita.\")) return;\n\n    try {\n      const { error } = await supabase\n        .from('exames')\n        .delete()\n        .eq('id', id);\n\n      if (error) throw error;\n\n      setExames(prev => prev.filter(exame => exame.id !== id));\n\n      toast({\n        title: \"Exame exclu├¡do\",\n        description: \"O exame foi removido com sucesso.\"\n      });\n    } catch (error) {\n      console.error('Erro ao excluir exame:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel excluir o exame.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const filteredExames = exames.filter(exame =>\n    exame.nome.toLowerCase().includes(searchTerm.toLowerCase()) ||\n    exame.codigo_tuss?.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  const activeExames = filteredExames.filter(e => e.ativo).length;\n\n  return (\n    <MainLayout>\n      <div className=\"space-y-6 p-6\">\n        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n          <div>\n            <h1 className=\"text-3xl font-bold text-foreground\">Exames</h1>\n            <p className=\"text-muted-foreground\">\n              Gerencie os exames oferecidos\n            </p>\n          </div>\n          <NewExameDialog onSuccess={fetchExames}>\n            <Button size=\"lg\">\n              <TestTube className=\"mr-2 h-5 w-5\" />\n              Novo Exame\n            </Button>\n          </NewExameDialog>\n        </div>\n\n        <div className=\"flex gap-4\">\n          <div className=\"relative flex-1\">\n            <Search className=\"absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground h-4 w-4\" />\n            <Input\n              placeholder=\"Buscar exames...\"\n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              className=\"pl-10\"\n            />\n          </div>\n        </div>\n\n        <Card className=\"p-6\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-3 rounded-lg bg-primary/10\">\n                <TestTube className=\"h-6 w-6 text-primary\" />\n              </div>\n              <div>\n                <p className=\"text-sm text-muted-foreground\">Exames Ativos</p>\n                <p className=\"text-2xl font-bold\">{activeExames}</p>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-3 rounded-lg bg-secondary/10\">\n                <CheckCircle2 className=\"h-6 w-6 text-secondary-foreground\" />\n              </div>\n              <div>\n                <p className=\"text-sm text-muted-foreground\">Total de Exames</p>\n                <p className=\"text-2xl font-bold\">{exames.length}</p>\n              </div>\n            </div>\n          </div>\n        </Card>\n\n        {isLoading ? (\n          <div className=\"flex justify-center items-center py-12\">\n            <Loader2 className=\"h-8 w-8 animate-spin text-primary\" />\n          </div>\n        ) : filteredExames.length === 0 ? (\n          <Card className=\"p-12\">\n            <div className=\"text-center\">\n              <TestTube className=\"mx-auto h-24 w-24 text-muted-foreground mb-4\" />\n              <h3 className=\"text-lg font-semibold mb-2\">\n                {searchTerm ? \"Nenhum exame encontrado\" : \"Nenhum exame cadastrado\"}\n              </h3>\n              <p className=\"text-muted-foreground mb-4\">\n                {searchTerm\n                  ? \"Tente ajustar sua busca\"\n                  : \"Comece adicionando seu primeiro exame\"\n                }\n              </p>\n            </div>\n          </Card>\n        ) : (\n          <div className=\"grid gap-4\">\n            {filteredExames.map((exame) => (\n              <Card key={exame.id} className=\"p-6 hover:shadow-md transition-shadow\">\n                <div className=\"flex flex-col sm:flex-row justify-between gap-4\">\n                  <div className=\"flex-1 space-y-3\">\n                    <div className=\"flex items-start justify-between\">\n                      <div>\n                        <h3 className=\"font-semibold text-lg\">{exame.nome}</h3>\n                        {exame.codigo_tuss && (\n                          <p className=\"text-sm text-muted-foreground\">\n                            TUSS: {exame.codigo_tuss}\n                          </p>\n                        )}\n                      </div>\n                      <Badge variant={exame.ativo ? \"default\" : \"secondary\"}>\n                        {exame.ativo ? \"Ativo\" : \"Inativo\"}\n                      </Badge>\n                    </div>\n\n                    {exame.descricao && (\n                      <p className=\"text-sm text-muted-foreground\">{exame.descricao}</p>\n                    )}\n\n                    <div className=\"flex flex-wrap gap-4 text-sm\">\n                      {exame.duracao_minutos && (\n                        <div className=\"flex items-center gap-2\">\n                          <Clock className=\"h-4 w-4 text-muted-foreground\" />\n                          <span>{exame.duracao_minutos} minutos</span>\n                        </div>\n                      )}\n                      {exame.tempo_preparo_minutos && (\n                        <div className=\"flex items-center gap-2\">\n                          <Clock className=\"h-4 w-4 text-muted-foreground\" />\n                          <span>Preparo: {exame.tempo_preparo_minutos} min</span>\n                        </div>\n                      )}\n                      {exame.tempo_jejum_horas && (\n                        <div className=\"flex items-center gap-2\">\n                          <Clock className=\"h-4 w-4 text-muted-foreground\" />\n                          <span>Jejum: {exame.tempo_jejum_horas}h</span>\n                        </div>\n                      )}\n                      {exame.preco && (\n                        <div className=\"flex items-center gap-2\">\n                          <DollarSign className=\"h-4 w-4 text-muted-foreground\" />\n                          <span>R$ {Number(exame.preco).toFixed(2)}</span>\n                        </div>\n                      )}\n                    </div>\n\n                    {(exame.instrucoes || exame.requisitos) && (\n                      <div className=\"text-sm space-y-1\">\n                        {exame.instrucoes && (\n                          <p className=\"text-muted-foreground\"><strong>Instru├º├Áes:</strong> {exame.instrucoes}</p>\n                        )}\n                        {exame.requisitos && (\n                          <p className=\"text-muted-foreground\"><strong>Requisitos:</strong> {exame.requisitos}</p>\n                        )}\n                      </div>\n                    )}\n                  </div>\n\n                  <div className=\"flex sm:flex-col gap-2 justify-end\">\n                    <div className=\"flex items-center gap-2\">\n                      <Switch\n                        checked={exame.ativo}\n                        onCheckedChange={() => toggleStatus(exame.id, exame.ativo)}\n                      />\n                    </div>\n                    <EditExameDialog\n                      exameId={exame.id}\n                      open={editingId === exame.id}\n                      onOpenChange={(open) => setEditingId(open ? exame.id : null)}\n                      onSuccess={fetchExames}\n                    >\n                      <Button\n                        variant=\"outline\"\n                        size=\"sm\"\n                        onClick={() => setEditingId(exame.id)}\n                      >\n                        <Edit className=\"h-4 w-4\" />\n                      </Button>\n                    </EditExameDialog>\n                    <Button\n                      variant=\"outline\"\n                      size=\"sm\"\n                      onClick={() => deleteExame(exame.id)}\n                    >\n                      <Trash2 className=\"h-4 w-4 text-destructive\" />\n                    </Button>\n                  </div>\n                </div>\n              </Card>\n            ))}\n          </div>\n        )}\n\n        {editingId && (\n          <EditExameDialog\n            exameId={editingId}\n            open={true}\n            onOpenChange={(open) => !open && setEditingId(null)}\n            onSuccess={fetchExames}\n          />\n        )}\n      </div>\n    </MainLayout>\n  );\n};\n\nexport default Exames;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Financeiro.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\FlowChat.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\HubCentral.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath"