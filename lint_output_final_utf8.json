   navigate('/patient-login');\n        return;\n      }\n\n      setPaciente((pacienteUsuario as any).pacientes);\n\n      // Buscar agendamentos futuros\n      const { data: agendamentosData } = await supabase\n        .from('agenda')\n        .select('*, procedimentos:servico_id(nome), profiles(nome)')\n        .eq('paciente_id', (pacienteUsuario as any).paciente_id)\n        .gte('inicio', new Date().toISOString())\n        .order('inicio', { ascending: true })\n        .limit(10);\n\n      setAgendamentos(agendamentosData || []);\n\n      // Buscar documentos\n      const { data: documentosData } = await supabase\n        .from('paciente_documentos' as any)\n        .select('*')\n        .eq('paciente_id', (pacienteUsuario as any).paciente_id)\n        .eq('visivel_paciente', true)\n        .order('created_at', { ascending: false })\n        .limit(10);\n\n      setDocumentos(documentosData || []);\n\n      // Buscar prontu├írios finalizados\n      const { data: prontuariosData } = await supabase\n        .from('prontuarios' as any)\n        .select('*, profiles(nome)')\n        .eq('paciente_id', (pacienteUsuario as any).paciente_id)\n        .in('status', ['finalizado', 'assinado'])\n        .order('data_atendimento', { ascending: false })\n        .limit(10);\n\n      setProntuarios(prontuariosData || []);\n\n    } catch (error) {\n      console.error('Erro ao carregar dados:', error);\n      toast.error('Erro ao carregar dados do paciente');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleLogout = async () => {\n    await supabase.auth.signOut();\n    navigate('/patient-login');\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-screen\">\n        <div className=\"text-center\">\n          <div className=\"animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4\"></div>\n          <p>Carregando...</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <header className=\"border-b\">\n        <div className=\"container mx-auto px-4 py-4 flex items-center justify-between\">\n          <div>\n            <h1 className=\"text-2xl font-bold\">Portal do Paciente</h1>\n            <p className=\"text-sm text-muted-foreground\">\n              Bem-vindo(a), {paciente?.nome}\n            </p>\n          </div>\n          <Button variant=\"outline\" onClick={handleLogout}>\n            <LogOut className=\"h-4 w-4 mr-2\" />\n            Sair\n          </Button>\n        </div>\n      </header>\n\n      <main className=\"container mx-auto px-4 py-8\">\n        <Tabs defaultValue=\"novo\" className=\"space-y-6\">\n          <TabsList className=\"grid w-full grid-cols-5\">\n            <TabsTrigger value=\"novo\">\n              <Plus className=\"h-4 w-4 mr-2\" />\n              Novo Agendamento\n            </TabsTrigger>\n            <TabsTrigger value=\"agendamentos\">\n              <Calendar className=\"h-4 w-4 mr-2\" />\n              Agendamentos\n            </TabsTrigger>\n            <TabsTrigger value=\"documentos\">\n              <FileText className=\"h-4 w-4 mr-2\" />\n              Documentos\n            </TabsTrigger>\n            <TabsTrigger value=\"historico\">\n              <Clock className=\"h-4 w-4 mr-2\" />\n              Hist├│rico\n            </TabsTrigger>\n            <TabsTrigger value=\"videoconsulta\">\n              <Video className=\"h-4 w-4 mr-2\" />\n              Videoconsulta\n            </TabsTrigger>\n          </TabsList>\n\n          <TabsContent value=\"novo\" className=\"space-y-4\">\n            <AgendamentoOnline\n              pacienteId={paciente?.id}\n              tenantId={paciente?.tenant_id}\n            />\n          </TabsContent>\n\n          <TabsContent value=\"agendamentos\" className=\"space-y-4\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Pr├│ximas Consultas</CardTitle>\n              </CardHeader>\n              <CardContent>\n                {agendamentos.length === 0 ? (\n                  <p className=\"text-muted-foreground text-center py-8\">\n                    Nenhuma consulta agendada\n                  </p>\n                ) : (\n                  <div className=\"space-y-4\">\n                    {agendamentos.map((agendamento) => (\n                      <div\n                        key={agendamento.id}\n                        className=\"border rounded-lg p-4 flex items-center justify-between\"\n                      >\n                        <div>\n                          <p className=\"font-medium\">{agendamento.servicos?.nome}</p>\n                          <p className=\"text-sm text-muted-foreground\">\n                            Dr(a). {agendamento.profiles?.nome}\n                          </p>\n                          <p className=\"text-sm text-muted-foreground\">\n                            {new Date(agendamento.inicio).toLocaleDateString('pt-BR', {\n                              weekday: 'long',\n                              year: 'numeric',\n                              month: 'long',\n                              day: 'numeric',\n                              hour: '2-digit',\n                              minute: '2-digit'\n                            })}\n                          </p>\n                        </div>\n                        <div className=\"flex gap-2\">\n                          {agendamento.confirmado ? (\n                            <span className=\"text-xs bg-green-100 text-green-800 px-2 py-1 rounded\">\n                              Confirmado\n                            </span>\n                          ) : (\n                            <Button size=\"sm\" variant=\"outline\">\n                              Confirmar\n                            </Button>\n                          )}\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </CardContent>\n            </Card>\n          </TabsContent>\n\n          <TabsContent value=\"documentos\" className=\"space-y-4\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Meus Documentos</CardTitle>\n              </CardHeader>\n              <CardContent>\n                {documentos.length === 0 ? (\n                  <p className=\"text-muted-foreground text-center py-8\">\n                    Nenhum documento dispon├¡vel\n                  </p>\n                ) : (\n                  <div className=\"space-y-4\">\n                    {documentos.map((documento) => (\n                      <div\n                        key={documento.id}\n                        className=\"border rounded-lg p-4 flex items-center justify-between\"\n                      >\n                        <div>\n                          <p className=\"font-medium\">{documento.titulo}</p>\n                          <p className=\"text-sm text-muted-foreground\">\n                            {documento.tipo.charAt(0).toUpperCase() + documento.tipo.slice(1)}\n                          </p>\n                          <p className=\"text-xs text-muted-foreground\">\n                            {new Date(documento.created_at).toLocaleDateString('pt-BR')}\n                          </p>\n                        </div>\n                        <Button size=\"sm\" variant=\"outline\">\n                          Visualizar\n                        </Button>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </CardContent>\n            </Card>\n          </TabsContent>\n\n          <TabsContent value=\"historico\" className=\"space-y-4\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Hist├│rico de Consultas</CardTitle>\n              </CardHeader>\n              <CardContent>\n                {prontuarios.length === 0 ? (\n                  <p className=\"text-muted-foreground text-center py-8\">\n                    Nenhum hist├│rico dispon├¡vel\n                  </p>\n                ) : (\n                  <div className=\"space-y-4\">\n                    {prontuarios.map((prontuario) => (\n                      <div\n                        key={prontuario.id}\n                        className=\"border rounded-lg p-4\"\n                      >\n                        <div className=\"flex items-center justify-between mb-2\">\n                          <p className=\"font-medium\">\n                            Dr(a). {prontuario.profiles?.nome}\n                          </p>\n                          <p className=\"text-sm text-muted-foreground\">\n                            {new Date(prontuario.data_atendimento).toLocaleDateString('pt-BR')}\n                          </p>\n                        </div>\n                        {prontuario.avaliacao && (\n                          <p className=\"text-sm text-muted-foreground mb-2\">\n                            <strong>Avalia├º├úo:</strong> {prontuario.avaliacao}\n                          </p>\n                        )}\n                        {prontuario.plano && (\n                          <p className=\"text-sm text-muted-foreground\">\n                            <strong>Plano:</strong> {prontuario.plano}\n                          </p>\n                        )}\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </CardContent>\n            </Card>\n          </TabsContent>\n\n          <TabsContent value=\"videoconsulta\" className=\"space-y-4\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Videoconsultas</CardTitle>\n              </CardHeader>\n              <CardContent>\n                <p className=\"text-muted-foreground text-center py-8\">\n                  Nenhuma videoconsulta dispon├¡vel no momento\n                </p>\n              </CardContent>\n            </Card>\n          </TabsContent>\n        </Tabs>\n      </main>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Perfil.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\PlanosSaude.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchPlanos'. Either include it or remove the dependency array.","line":62,"column":6,"nodeType":"ArrayExpression","endLine":62,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [fetchPlanos]","fix":{"range":[1971,1973],"text":"[fetchPlanos]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\nimport { MainLayout } from \"@/components/layout/MainLayout\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Input } from \"@/components/ui/input\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { Loader2, Plus, Pencil, Trash2, Search } from \"lucide-react\";\nimport { NewPlanoSaudeDialog } from \"@/components/planos/NewPlanoSaudeDialog\";\nimport { EditPlanoSaudeDialog } from \"@/components/planos/EditPlanoSaudeDialog\";\n\ninterface PlanoSaude {\n  id: string;\n  nome: string;\n  descricao: string | null;\n  ativo: boolean;\n  created_at: string;\n}\n\nexport default function PlanosSaude() {\n  const [planos, setPlanos] = useState<PlanoSaude[]>([]);\n  const [isLoading, setIsLoading] = useState(true);\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [editingId, setEditingId] = useState<string | null>(null);\n  const { toast } = useToast();\n\n  const fetchPlanos = async () => {\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) throw new Error(\"Usu├írio n├úo autenticado\");\n\n      const { data: profile } = await supabase\n        .from(\"profiles\")\n        .select(\"tenant_id\")\n        .eq(\"id\", user.id)\n        .single();\n\n      if (!profile?.tenant_id) throw new Error(\"Tenant n├úo encontrado\");\n\n      const { data, error } = await supabase\n        .from(\"planos_saude\")\n        .select(\"*\")\n        .eq(\"tenant_id\", profile.tenant_id)\n        .order(\"nome\");\n\n      if (error) throw error;\n      setPlanos(data || []);\n    } catch (error: any) {\n      toast({\n        title: \"Erro ao carregar planos\",\n        description: error.message,\n        variant: \"destructive\",\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchPlanos();\n  }, []);\n\n  const handleDelete = async (id: string, nome: string) => {\n    if (!confirm(`Tem certeza que deseja excluir o plano \"${nome}\"?`)) return;\n\n    try {\n      const { error } = await supabase\n        .from(\"planos_saude\")\n        .delete()\n        .eq(\"id\", id);\n\n      if (error) throw error;\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Plano exclu├¡do com sucesso.\",\n      });\n      fetchPlanos();\n    } catch (error: any) {\n      toast({\n        title: \"Erro ao excluir plano\",\n        description: error.message,\n        variant: \"destructive\",\n      });\n    }\n  };\n\n  const filteredPlanos = planos.filter(plano =>\n    plano.nome.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  if (isLoading) {\n    return (\n      <MainLayout>\n        <div className=\"flex items-center justify-center h-96\">\n          <Loader2 className=\"h-8 w-8 animate-spin text-primary\" />\n        </div>\n      </MainLayout>\n    );\n  }\n\n  return (\n    <MainLayout>\n      <div className=\"space-y-6\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h1 className=\"text-3xl font-bold tracking-tight\">Planos de Sa├║de</h1>\n            <p className=\"text-muted-foreground\">\n              Gerencie os planos de sa├║de aceitos pela cl├¡nica\n            </p>\n          </div>\n          <NewPlanoSaudeDialog onSuccess={fetchPlanos}>\n            <Button>\n              <Plus className=\"mr-2 h-4 w-4\" />\n              Novo Plano\n            </Button>\n          </NewPlanoSaudeDialog>\n        </div>\n\n        <div className=\"relative\">\n          <Search className=\"absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground h-4 w-4\" />\n          <Input\n            placeholder=\"Buscar planos...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"pl-10\"\n          />\n        </div>\n\n        {filteredPlanos.length === 0 ? (\n          <Card>\n            <CardContent className=\"flex flex-col items-center justify-center py-12\">\n              <p className=\"text-muted-foreground mb-4\">\n                {searchTerm ? \"Nenhum plano encontrado\" : \"Nenhum plano cadastrado\"}\n              </p>\n              {!searchTerm && (\n                <NewPlanoSaudeDialog onSuccess={fetchPlanos}>\n                  <Button>\n                    <Plus className=\"mr-2 h-4 w-4\" />\n                    Cadastrar Primeiro Plano\n                  </Button>\n                </NewPlanoSaudeDialog>\n              )}\n            </CardContent>\n          </Card>\n        ) : (\n          <div className=\"grid gap-4 md:grid-cols-2 lg:grid-cols-3\">\n            {filteredPlanos.map((plano) => (\n              <Card key={plano.id}>\n                <CardHeader className=\"flex flex-row items-start justify-between space-y-0 pb-2\">\n                  <CardTitle className=\"text-lg font-semibold\">\n                    {plano.nome}\n                  </CardTitle>\n                  <Badge variant={plano.ativo ? \"default\" : \"secondary\"}>\n                    {plano.ativo ? \"Ativo\" : \"Inativo\"}\n                  </Badge>\n                </CardHeader>\n                <CardContent className=\"space-y-4\">\n                  {plano.descricao && (\n                    <p className=\"text-sm text-muted-foreground\">\n                      {plano.descricao}\n                    </p>\n                  )}\n                  <div className=\"flex gap-2\">\n                    <Button\n                      variant=\"outline\"\n                      size=\"sm\"\n                      onClick={() => setEditingId(plano.id)}\n                      className=\"flex-1\"\n                    >\n                      <Pencil className=\"mr-2 h-3 w-3\" />\n                      Editar\n                    </Button>\n                    <Button\n                      variant=\"outline\"\n                      size=\"sm\"\n                      onClick={() => handleDelete(plano.id, plano.nome)}\n                      className=\"flex-1\"\n                    >\n                      <Trash2 className=\"mr-2 h-3 w-3\" />\n                      Excluir\n                    </Button>\n                  </div>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n        )}\n\n        {editingId && (\n          <EditPlanoSaudeDialog\n            planoId={editingId}\n            open={!!editingId}\n            onOpenChange={(open) => !open && setEditingId(null)}\n            onSuccess={fetchPlanos}\n          />\n        )}\n      </div>\n    </MainLayout>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Privacy.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErro