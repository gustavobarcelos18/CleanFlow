   .from('exames_procedimentos')\n        .update({\n          nome: formData.nome.trim(),\n          tipo: formData.tipo,\n          codigo_tuss: formData.codigo_tuss.trim() || null,\n          descricao: formData.descricao.trim() || null,\n          tempo_preparo_minutos: formData.tempo_preparo_minutos ? parseInt(formData.tempo_preparo_minutos) : null,\n          tempo_jejum_horas: formData.tempo_jejum_horas ? parseInt(formData.tempo_jejum_horas) : null,\n          duracao_minutos: formData.duracao_minutos ? parseInt(formData.duracao_minutos) : null,\n          valor: formData.valor ? parseFloat(formData.valor) : null,\n          instrucoes: formData.instrucoes.trim() || null,\n          requisitos: formData.requisitos.trim() || null,\n          updated_at: new Date().toISOString()\n        })\n        .eq('id', itemId);\n\n      if (error) throw error;\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Item atualizado com sucesso.\"\n      });\n\n      onOpenChange(false);\n\n      if (onSuccess) {\n        onSuccess();\n      }\n    } catch (error) {\n      console.error('Erro ao atualizar:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel atualizar o item.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      <DialogContent className=\"max-w-3xl max-h-[90vh] overflow-y-auto\">\n        <DialogHeader>\n          <DialogTitle className=\"text-xl\">Editar Exame/Procedimento</DialogTitle>\n          <DialogDescription>\n            Atualize as informa├º├Áes do exame ou procedimento\n          </DialogDescription>\n        </DialogHeader>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"nome\">Nome *</Label>\n              <Input\n                id=\"nome\"\n                value={formData.nome}\n                onChange={(e) => setFormData({ ...formData, nome: e.target.value })}\n                placeholder=\"Nome do exame ou procedimento\"\n                required\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"tipo\">Tipo *</Label>\n              <Select value={formData.tipo} onValueChange={(value) => setFormData({ ...formData, tipo: value as TipoExameProcedimento })}>\n                <SelectTrigger>\n                  <SelectValue placeholder=\"Selecione o tipo\" />\n                </SelectTrigger>\n                <SelectContent>\n                  <SelectItem value=\"exame_laboratorial\">Exame Laboratorial</SelectItem>\n                  <SelectItem value=\"exame_imagem\">Exame de Imagem</SelectItem>\n                  <SelectItem value=\"procedimento_cirurgico\">Procedimento Cir├║rgico</SelectItem>\n                  <SelectItem value=\"procedimento_terapeutico\">Procedimento Terap├¬utico</SelectItem>\n                  <SelectItem value=\"procedimento_diagnostico\">Procedimento Diagn├│stico</SelectItem>\n                </SelectContent>\n              </Select>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"codigo_tuss\">C├│digo TUSS</Label>\n              <Input\n                id=\"codigo_tuss\"\n                value={formData.codigo_tuss}\n                onChange={(e) => setFormData({ ...formData, codigo_tuss: e.target.value })}\n                placeholder=\"C├│digo TUSS\"\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"valor\">Valor (R$)</Label>\n              <Input\n                id=\"valor\"\n                type=\"number\"\n                step=\"0.01\"\n                min=\"0\"\n                value={formData.valor}\n                onChange={(e) => setFormData({ ...formData, valor: e.target.value })}\n                placeholder=\"0.00\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"descricao\">Descri├º├úo</Label>\n            <Textarea\n              id=\"descricao\"\n              value={formData.descricao}\n              onChange={(e) => setFormData({ ...formData, descricao: e.target.value })}\n              placeholder=\"Descri├º├úo detalhada\"\n              rows={2}\n            />\n          </div>\n\n          <div className=\"grid grid-cols-3 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"tempo_preparo\">Tempo Preparo (min)</Label>\n              <Input\n                id=\"tempo_preparo\"\n                type=\"number\"\n                min=\"0\"\n                value={formData.tempo_preparo_minutos}\n                onChange={(e) => setFormData({ ...formData, tempo_preparo_minutos: e.target.value })}\n                placeholder=\"0\"\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"tempo_jejum\">Tempo Jejum (horas)</Label>\n              <Input\n                id=\"tempo_jejum\"\n                type=\"number\"\n                min=\"0\"\n                value={formData.tempo_jejum_horas}\n                onChange={(e) => setFormData({ ...formData, tempo_jejum_horas: e.target.value })}\n                placeholder=\"0\"\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"duracao\">Dura├º├úo (min)</Label>\n              <Input\n                id=\"duracao\"\n                type=\"number\"\n                min=\"0\"\n                value={formData.duracao_minutos}\n                onChange={(e) => setFormData({ ...formData, duracao_minutos: e.target.value })}\n                placeholder=\"0\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"instrucoes\">Instru├º├Áes</Label>\n            <Textarea\n              id=\"instrucoes\"\n              value={formData.instrucoes}\n              onChange={(e) => setFormData({ ...formData, instrucoes: e.target.value })}\n              placeholder=\"Instru├º├Áes para o paciente\"\n              rows={2}\n            />\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"requisitos\">Requisitos</Label>\n            <Textarea\n              id=\"requisitos\"\n              value={formData.requisitos}\n              onChange={(e) => setFormData({ ...formData, requisitos: e.target.value })}\n              placeholder=\"Requisitos necess├írios\"\n              rows={2}\n            />\n          </div>\n\n          <div className=\"flex justify-end gap-3 pt-4\">\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              onClick={() => onOpenChange(false)}\n              disabled={isLoading}\n            >\n              Cancelar\n            </Button>\n            <Button type=\"submit\" disabled={isLoading}>\n              {isLoading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n              Salvar Altera├º├Áes\n            </Button>\n          </div>\n        </form>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\EditPatientDialog.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchPatient'. Either include it or remove the dependency array.","line":53,"column":6,"nodeType":"ArrayExpression","endLine":53,"endColumn":23,"suggestions":[{"desc":"Update the dependencies array to be: [fetchPatient, open, patientId]","fix":{"range":[1847,1864],"text":"[fetchPatient, open, patientId]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect, useRef } from \"react\";\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription } from \"@/components/ui/dialog\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { FlexibleDatePicker } from \"@/components/ui/flexible-date-picker\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { Loader2 } from \"lucide-react\";\nimport { format, parse } from \"date-fns\";\n\ninterface EditPatientDialogProps {\n  patientId: string;\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  onSuccess?: () => void;\n}\n\nexport function EditPatientDialog({ \n  patientId, \n  open, \n  onOpenChange, \n  onSuccess \n}: EditPatientDialogProps) {\n  const [isLoading, setIsLoading] = useState(false);\n  const [initialData, setInitialData] = useState({\n    nome: \"\",\n    telefone: \"\",\n    email: \"\",\n    preferencia_contato: \"whatsapp\" as \"whatsapp\" | \"sms\" | \"email\",\n    consentimento_lgpd: false,\n    notas_internas: \"\",\n    data_nascimento: undefined as Date | undefined,\n    plano_saude_id: \"\",\n    numero_carteirinha: \"\"\n  });\n  const [formData, setFormData] = useState(initialData);\n  const [hasChanges, setHasChanges] = useState(false);\n  const [planosSaude, setPlanosSaude] = useState<any[]>([]);\n  const nomeRef = useRef<HTMLInputElement>(null);\n  const telefoneRef = useRef<HTMLInputElement>(null);\n\n  const { toast } = useToast();\n\n  useEffect(() => {\n    if (open && patientId) {\n      fetchPatient();\n      fetchPlanosSaude();\n    }\n  }, [open, patientId]);\n\n  useEffect(() => {\n    const changed = JSON.stringify(formData) !== JSON.stringify(initialData);\n    setHasChanges(changed);\n  }, [formData, initialData]);\n\n  const fetchPlanosSaude = async () => {\n    try {\n      const { data, error } = await supabase\n        .from('planos_saude')\n        .select('id, nome')\n        .eq('ativo', true)\n        .order('nome');\n\n      if (error) throw error;\n      setPlanosSaude(data || []);\n    } catch (error) {\n      console.error('Erro ao buscar planos de sa├║de:', error);\n    }\n  };\n\n  const fetchPatient = async () => {\n    try {\n      const { data, error } = await (supabase as any)\n        .from('pacientes')\n        .select('*')\n        .eq('id', patientId)\n        .maybeSingle();\n\n      if (error) throw error;\n\n      if (data) {\n        // Converter data_nascimento de string para Date (parsing robusto)\n        let dataNascimento: Date | undefined = undefined;\n        if (data.data_nascimento) {\n          const [y, m, d] = (data.data_nascimento as string).split('-').map(Number);\n          const parsedDate = new Date(y, (m ?? 1) - 1, d ?? 1);\n          if (\n            !isNaN(parsedDate.getTime()) &&\n            parsedDate.getFullYear() === y &&\n            parsedDate.getMonth() === ((m ?? 1) - 1) &&\n            parsedDate.getDate() === (d ?? 1)\n          ) {\n            dataNascimento = parsedDate;\n          }\n        }\n\n        const patientData = {\n          nome: data.nome || \"\",\n          telefone: data.telefone || \"\",\n          email: data.email || \"\",\n          preferencia_contato: data.preferencia_contato || \"whatsapp\",\n          consentimento_lgpd: data.consentimento_lgpd || false,\n          notas_internas: data.notas_internas || \"\",\n          data_nascimento: dataNascimento,\n          plano_saude_id: data.plano_saude_id || \"\",\n          numero_carteirinha: data.numero_carteirinha || \"\"\n        };\n        setInitialData(patientData);\n        setFormData(patientData);\n      }\n    } catch (error) {\n      console.error('Erro ao buscar paciente:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os dados do paciente.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    const missingFields: string[] = [];\n    if (!formData.nome.trim()) missingFields.push(\"Nome\");\n    if (!formData.telefone.trim()) missingFields.push(\"Telefone\");\n\n    if (missingFields.length > 0) {\n      toast({\n        title: \"Campos obrigat├│rios n├úo preenchidos\",\n        description: `Por favor, preencha: ${missingFields.join(\", \")}`,\n        variant: \"destructive\"\n      });\n      \n      if (!formData.nome.trim()) nomeRef.current?.focus();\n      else if (!formData.telefone.trim()) telefoneRef.current?.focus();\n      \n      return;\n    }\n\n    try {\n      setIsLoading(true);\n\n      // Validar e formatar data de nascimento\n      let dataNascimentoFormatada = null;\n      if (formData.data_nascimento instanceof Date && !isNaN(formData.data_nascimento.getTime())) {\n        dataNascimentoFormatada = format(formData.data_nascimento, 'yyyy-MM-dd');\n      }\n\n      const { data: updated, error } = await (supabase as any)\n        .from('pacientes')\n        .update({\n          nome: formData.nome.trim(),\n          telefone: formData.telefone.trim(),\n          email: formData.email.trim() || null,\n          preferencia_contato: formData.preferencia_contato,\n          consentimento_lgpd: formData.consentimento_lgpd,\n          notas_internas: formData.notas_internas.trim() || null,\n          data_nascimento: dataNascimentoFormatada,\n          plano_saude_id: formData.plano_saude_id || null,\n          numero_carteirinha: formData.numero_carteirinha?.trim() || null,\n          updated_at: new Date().toISOString()\n        })\n        .eq('id', patientId)\n        .select()\n        .maybeSingle();\n\n      if (error) throw error;\n      if (!updated) throw new Error('Nenhuma linha atualizada. Verifique permiss├Áes de grava├º├úo.');\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Paciente atualizado com sucesso.\"\n      });\n\n      onOpenChange(false);\n\n      if (onSuccess) {\n        onSuccess();\n      }\n    } catch (error) {\n      console.error('Erro ao atualizar:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel atualizar o paciente.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      <DialogContent className=\"max-w-2xl\">\n        <DialogHeader>\n          <DialogTitle className=\"text-xl\">Editar Paciente</DialogTitle>\n          <DialogDescription>\n            Atualize as informa├º├Áes do paciente\n          </DialogDescription>\n        </DialogHeader>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"nome\">Nome Completo *</Label>\n            <Input\n              id=\"nome\"\n              ref={nomeRef}\n              value={formData.nome}\n              onChange={(e) => setFormData({ ...formData, nome: e.target.value })}\n              placeholder=\"Nome do paciente\"\n              required\n            />\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"telefone\">Telefone *</Label>\n              <Input\n                id=\"telefone\"\n                ref={telefoneRef}\n                value={formData.telefone}\n                onChange={(e) => setFormData({ ...formData, telefone: e.target.value })}\n                placeholder=\"(00) 00000-0000\"\n                required\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"email\">E-mail</Label>\n              <Input\n                id=\"email\"\n                type=\"email\"\n                value={formData.email}\n                onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                placeholder=\"email@exemplo.com\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"preferencia\">Prefer├¬ncia de Contato</Label>\n            <Select \n              value={formData.preferencia_contato} \n              onValueChange={(value) => setFormData({ ...formData, preferencia_contato: value as any })}\n            >\n              <SelectTrigger>\n                <SelectValue />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"whatsapp\">WhatsApp</SelectItem>\n                <SelectItem value=\"sms\">SMS</SelectItem>\n                <SelectItem value=\"email\">E-mail</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n\n          <div className=\"flex items-center justify-between\">\n            <Label htmlFor=\"lgpd\">Consentimento LGPD</Label>\n            <Switch\n              id=\"lgpd\"\n              checked={formData.consentimento_lgpd}\n              onCheckedChange={(checked) => setFormData({ ...formData, consentimento_lgpd: checked })}\n            />\n          </div>\n\n          <FlexibleDatePicker\n            label=\"Data de Nascimento\"\n            value={formData.data_nascimento}\n            onChange={(date) => setFormData({ ...formData, data_nascimento: date })}\n          />\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"plano\">Plano de Sa├║de</Label>\n              <Select \n                value={formData.plano_saude_id} \n                onValueChange={(value) => setFormData({ ...formData, plano_saude_id: value })}\n              >\n                <SelectTrigger>\n                  <SelectValue placeholder=\"Selecione o plano\" />\n                </SelectTrigger>\n                <SelectContent>\n                  {planosSaude.map((plano) => (\n                    <SelectItem key={plano.id} value={plano.id}>\n                      {plano.nome}\n                    </SelectItem>\n                  ))}\n                </SelectContent>\n              </Select>\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"carteirinha\">N├║mero da Carteirinha</Label>\n              <Input\n                id=\"carteirinha\"\n                value={formData.numero_carteirinha}\n                onChange={(e) => setFormData({ ...formData, numero_carteirinha: e.target.value })}\n                placeholder=\"N├║mero da carteirinha\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"notas\">Notas Internas</Label>\n            <Textarea\n              id=\"notas\"\n              value={formData.notas_internas}\n              onChange={(e) => setFormData({ ...formData, notas_internas: e.target.value })}\n              placeholder=\"Observa├º├Áes internas sobre o paciente...\"\n              rows={3}\n            />\n          </div>\n\n                <div className=\"flex justify-end gap-3 pt-4\">\n                  {hasChanges && (\n                    <Button\n                      type=\"button\"\n                      variant=\"outline\"\n                      onClick={() => {\n                        setFormData(initialData);\n                        setHasChanges(false);\n                      }}\n                    >\n                      Cancelar Altera├º├Áes\n                    </Button>\n                  )}\n                  <Button type=\"submit\" disabled={isLoading || !hasChanges}>\n                    {isLoading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n                    Salvar Altera├º├Áes\n                  </Button>\n                </div>\n        </form>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\EditProcedimentoDialog.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchProcedimento'. Either include it or remove the dependency array.","line":53,"column":6,"nodeType":"ArrayExpression","endLine":53,"endColumn":28,"suggestions":[{"desc":"Update the dependencies array to be: [fetchProcedimento, open, procedimentoId]","fix":{"range":[1339,1361],"text":"[fetchProcedimento, open, procedimentoId]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport {\n  Dialog,\n  DialogContent,\n  DialogHeader,\n  DialogTitle,\n  DialogDescription,\n} from \"@/components/ui/dialog\";\nimport { Button } from \"@/components/ui/button\";\nimport { Label } from \"@/components/ui/label\";\nimport { Input } from \"@/components/ui/input\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { Loader2 } from \"lucide-react\";\n\ninterface EditProcedimentoDialogProps {\n  procedimentoId: string;\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  onSuccess?: () => void;\n  children?: React.ReactNode;\n}\n\nexport function EditProcedimentoDialog({\n  procedimentoId,\n  open,\n  onOpenChange,\n  onSuccess,\n  children,\n}: EditProcedimentoDialogProps) {\n  const [isLoading, setIsLoading] = useState(false);\n  const [formData, setFormData] = useState({\n    nome: \"\",\n    duracao_minutos: \"\",\n    valor: \"\",\n    codigo_tuss: \"\",\n    descricao: \"\",\n    instrucoes_preparo: \"\",\n    instrucoes_pos: \"\",\n    anestesia_necessaria: false,\n    tipo_anestesia: \"\",\n    ativo: true,\n  });\n\n  const { toast } = useToast();\n\n  useEffect(() => {\n    if (open && procedimentoId) {\n      fetchProcedimento();\n    }\n  }, [open, procedimentoId]);\n\n  const fetchProcedimento = async () => {\n    try {\n      const { data, error } = await supabase\n        .from(\"procedimentos\")\n        .select(\"*\")\n        .eq(\"id\", procedimentoId)\n        .single();\n\n      if (error) throw error;\n\n      setFormData({\n        nome: data.nome || \"\",\n        duracao_minutos: data.duracao_minutos?.toString() || \"\",\n        valor: data.valor?.toString() || \"\",\n        codigo_tuss: data.codigo_tuss || \"\",\n        descricao: data.descricao || \"\",\n        instrucoes_preparo: data.instrucoes_preparo || \"\",\n        instrucoes_pos: data.instrucoes_pos || \"\",\n        anestesia_necessaria: data.anestesia_necessaria || false,\n        tipo_anestesia: data.tipo_anestesia || \"\",\n        ativo: data.ativo !== false,\n      });\n    } catch (error) {\n      console.error(\"Erro ao buscar procedimento:\", error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os dados do procedimento.\",\n        variant: \"destructive\",\n      });\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.nome || !formData.duracao_minutos) {\n      toast({\n        title: \"Campos obrigat├│rios\",\n        description: \"Nome e dura├º├úo s├úo obrigat├│rios.\",\n        variant: \"destructive\",\n      });\n      return;\n    }\n\n    try {\n      setIsLoading(true);\n\n      const { error } = await supabase\n        .from(\"procedimentos\")\n        .update({\n          nome: formData.nome.trim(),\n          duracao_minutos: parseInt(formData.duracao_minutos),\n          valor: formData.valor ? parseFloat(formData.valor) : null,\n          codigo_tuss: formData.codigo_tuss.trim() || null,\n          descricao: formData.descricao.trim() || null,\n          instrucoes_preparo: formData.instrucoes_preparo.trim() || null,\n          instrucoes_pos: formData.instrucoes_pos.trim() || null,\n          anestesia_necessaria: formData.anestesia_necessaria,\n          tipo_anestesia: formData.tipo_anestesia.trim() || null,\n          ativo: formData.ativo,\n          updated_at: new Date().toISOString(),\n        })\n        .eq(\"id\", procedimentoId);\n\n      if (error) throw error;\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Procedimento atualizado com sucesso.\",\n      });\n\n      onOpenChange(false);\n      if (onSuccess) onSuccess();\n    } catch (error) {\n      console.error(\"Erro ao atualizar procedimento:\", error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel atualizar o procedimento.\",\n        variant: \"destructive\",\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      {children}\n      <DialogContent className=\"max-w-2xl max-h-[90vh] overflow-y-auto\">\n        <DialogHeader>\n          <DialogTitle>Editar Procedimento</DialogTitle>\n          <DialogDescription>\n            Altere as informa├º├Áes do procedimento\n          </DialogDescription>\n        </DialogHeader>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-2 col-span-2\">\n              <Label htmlFor=\"nome\">Nome *</Label>\n              <Input\n                id=\"nome\"\n                value={formData.nome}\n                onChange={(e) =>\n                  setFormData((prev) => ({ ...prev, nome: e.target.value }))\n                }\n                required\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"codigo_tuss\">C├│digo TUSS</Label>\n              <Input\n                id=\"codigo_tuss\"\n                value={formData.codigo_tuss}\n                onChange={(e) =>\n                  setFormData((prev) => ({\n                    ...prev,\n                    codigo_tuss: e.target.value,\n                  }))\n                }\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"duracao\">Dura├º├úo (minutos) *</Label>\n              <Input\n                id=\"duracao\"\n                type=\"number\"\n                min=\"1\"\n                value={formData.duracao_minutos}\n                onChange={(e) =>\n                  setFormData((prev) => ({\n                    ...prev,\n                    duracao_minutos: e.target.value,\n                  }))\n                }\n                required\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"valor\">Valor (R$)</Label>\n              <Input\n                id=\"valor\"\n                type=\"number\"\n                step=\"0.01\"\n                min=\"0\"\n                value={formData.valor}\n                onChange={(e) =>\n                  setFormData((prev) => ({ ...prev, valor: e.target.value }))\n                }\n              />\n            </div>\n\n            <div className=\"space-y-2 col-span-2\">\n              <Label htmlFor=\"descricao\">Descri├º├úo</Label>\n              <Textarea\n                id=\"descricao\"\n                value={formData.descricao}\n                onChange={(e) =>\n                  setFormData((prev) => ({\n                    ...prev,\n                    descricao: e.target.value,\n                  }))\n                }\n                rows={2}\n              />\n            </div>\n\n            <div className=\"space-y-2 col-span-2\">\n              <Label htmlFor=\"instrucoes_preparo\">Instru├º├Áes de Preparo</Label>\n              <Textarea\n                id=\"instrucoes_preparo\"\n                value={formData.instrucoes_preparo}\n                onChange={(e) =>\n                  setFormData((prev) => ({\n                    ...prev,\n                    instrucoes_preparo: e.target.value,\n                  }))\n                }\n                rows={2}\n              />\n            </div>\n\n            <div className=\"space-y-2 col-span-2\">\n              <Label htmlFor=\"instrucoes_pos\">\n                Instru├º├Áes P├│s-Procedimento\n              </Label>\n              <Textarea\n                id=\"instrucoes_pos\"\n                value={formData.instrucoes_pos}\n                onChange={(e) =>\n                  setFormData((prev) => ({\n                    ...prev,\n                    instrucoes_pos: e.target.value,\n                  }))\n                }\n                rows={2}\n              />\n            </div>\n\n            <div className=\"flex items-center justify-between col-span-2\">\n              <Label htmlFor=\"anestesia_necessaria\">Anestesia Necess├íria</Label>\n              <Switch\n                id=\"anestesia_necessaria\"\n                checked={formData.anestesia_necessaria}\n                onCheckedChange={(checked) =>\n                  setFormData((prev) => ({\n                    ...prev,\n                    anestesia_necessaria: checked,\n                  }))\n                }\n              />\n            </div>\n\n            {formData.anestesia_necessaria && (\n              <div className=\"space-y-2 col-span-2\">\n                <Label htmlFor=\"tipo_anestesia\">Tipo de Anestesia</Label>\n                <Input\n                  id=\"tipo_anestesia\"\n                  value={formData.tipo_anestesia}\n                  onChange={(e) =>\n                    setFormData((prev) => ({\n                      ...prev,\n                      tipo_anestesia: e.target.value,\n                    }))\n                  }\n                  placeholder=\"Ex: Local, Seda├º├úo...\"\n                />\n              </div>\n            )}\n\n            <div className=\"flex items-center justify-between col-span-2\">\n              <Label htmlFor=\"ativo\">Ativo</Label>\n              <Switch\n                id=\"ativo\"\n                checked={formData.ativo}\n                onCheckedChange={(checked) =>\n                  setFormData((prev) => ({ ...prev, ativo: checked }))\n                }\n              />\n            </div>\n          </div>\n\n          <div className=\"flex justify-end gap-3 pt-4\">\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              onClick={() => onOpenChange(false)}\n            >\n              Cancelar\n            </Button>\n            <Button type=\"submit\" disabled={isLoading}>\n              {isLoading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n              Salvar Altera├º├Áes\n            </Button>\n          </div>\n        </form>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\EditProfessionalDialog.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchProfessional'. Either include it or remove the dependency array.","line":63,"column":6,"nodeType":"ArrayExpression","endLine":63,"endColumn":28,"suggestions":[{"desc":"Update the dependencies array to be: [fetchProfessional, open, professionalId]","fix":{"range":[1885,1907],"text":"[fetchProfessional, open, professionalId]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription } from \"@/components/ui/dialog\";\nimport { Button } from \"@/components/ui/button\";\nimport { Label } from \"@/components/ui/label\";\nimport { Input } from \"@/components/ui/input\";\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { FlexibleDatePicker } from \"@/components/ui/flexible-date-picker\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { Loader2, X } from \"lucide-react\";\nimport { format, parse } from \"date-fns\";\n\ninterface Especialidade {\n  id: string;\n  nome: string;\n  conselho?: string;\n}\n\ninterface TipoProfissional {\n  id: string;\n  nome: string;\n}\n\ninterface EditProfessionalDialogProps {\n  professionalId: string;\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  onSuccess?: () => void;\n}\n\nexport function EditProfessionalDialog({ \n  professionalId, \n  open, \n  onOpenChange, \n  onSuccess \n}: EditProfessionalDialogProps) {\n  const [isLoading, setIsLoading] = useState(false);\n  const [especialidades, setEspecialidades] = useState<Especialidade[]>([]);\n  const [tiposProfissional, setTiposProfissional] = useState<any[]>([]);\n  const [selectedEspecialidades, setSelectedEspecialidades] = useState<string[]>([]);\n  const [formData, setFormData] = useState({\n    nome: \"\",\n    email: \"\",\n    telefone: \"\",\n    cpf: \"\",\n    numero_registro: \"\",\n    uf_registro: \"\",\n    tipo_profissional_id: \"\",\n    data_nascimento: undefined as Date | undefined\n  });\n\n  const { toast } = useToast();\n\n  useEffect(() => {\n    if (open) {\n      fetchEspecialidades();\n      fetchTiposProfissional();\n      if (professionalId) {\n        fetchProfessional();\n      }\n    }\n  }, [open, professionalId]);\n\n  const fetchEspecialidades = async () => {\n    try {\n      const { data, error } = await supabase\n        .from('especialidades')\n        .select('id, nome, conselho')\n        .eq('ativo', true)\n        .order('nome');\n\n      if (error) throw error;\n      setEspecialidades(data || []);\n    } catch (error) {\n      console.error('Erro ao buscar especialidades:', error);\n    }\n  };\n\n  const fetchTiposProfissional = async () => {\n    try {\n      const { data, error } = await (supabase as any)\n        .from('tipos_profissional')\n        .select('id, nome')\n        .eq('ativo', true)\n        .order('nome');\n\n      if (error) throw error;\n      setTiposProfissional(data || []);\n    } catch (error) {\n      console.error('Erro ao buscar tipos de profissional:', error);\n    }\n  };\n\n  const fetchProfessional = async () => {\n    try {\n      const { data, error } = await (supabase as any)\n        .from('profiles')\n        .select('*')\n        .eq('id', professionalId)\n        .maybeSingle();\n\n      if (error) throw error;\n\n      if (data) {\n        // Converter data_nascimento de string para Date (parsing robusto)\n        let dataNascimento: Date | undefined = undefined;\n        if (data.data_nascimento) {\n          const [y, m, d] = (data.data_nascimento as string).split('-').map(Number);\n          const parsedDate = new Date(y, (m ?? 1) - 1, d ?? 1);\n          if (\n            !isNaN(parsedDate.getTime()) &&\n            parsedDate.getFullYear() === y &&\n            parsedDate.getMonth() === ((m ?? 1) - 1) &&\n            parsedDate.getDate() === (d ?? 1)\n          ) {\n            dataNascimento = parsedDate;\n          }\n        }\n\n        setFormData({\n          nome: data.nome || \"\",\n          email: data.email || \"\",\n          telefone: data.telefone || \"\",\n          cpf: data.cpf || \"\",\n          numero_registro: data.numero_registro || \"\",\n          uf_registro: data.uf_registro || \"\",\n          tipo_profissional_id: data.tipo_profissional_id || \"\",\n          data_nascimento: dataNascimento\n        });\n\n        // Buscar especialidades do profissional\n        const { data: espData, error: espError } = await (supabase as any)\n          .from('profissional_especialidades')\n          .select('especialidade_id')\n          .eq('profissional_id', professionalId);\n\n        if (espError) throw espError;\n        setSelectedEspecialidades(espData?.map((e: any) => e.especialidade_id) || []);\n      }\n    } catch (error) {\n      console.error('Erro ao buscar profissional:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os dados do profissional.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.nome) {\n      toast({\n        title: \"Campos obrigat├│rios\",\n        description: \"Nome ├® obrigat├│rio.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    try {\n      setIsLoading(true);\n\n      // Obter tenant_id\n      const { data: profile } = await supabase\n        .from('profiles')\n        .select('tenant_id')\n        .eq('id', professionalId)\n        .maybeSingle();\n\n      if (!profile?.tenant_id) throw new Error(\"Tenant n├úo encontrado\");\n\n      // Validar e formatar data de nascimento\n      let dataNascimentoFormatada = null;\n      if (formData.data_nascimento instanceof Date && !isNaN(formData.data_nascimento.getTime())) {\n        dataNascimentoFormatada = format(formData.data_nascimento, 'yyyy-MM-dd');\n      }\n\n      const { data: updated, error } = await (supabase as any)\n        .from('profiles')\n        .update({\n          nome: formData.nome,\n          telefone: formData.telefone || null,\n          cpf: formData.cpf || null,\n          numero_registro: formData.numero_registro || null,\n          uf_registro: formData.uf_registro || null,\n          tipo_profissional_id: formData.tipo_profissional_id ? formData.tipo_profissional_id : null,\n          data_nascimento: dataNascimentoFormatada,\n          updated_at: new Date().toISOString()\n        })\n        .eq('id', professionalId)\n        .select()\n        .maybeSingle();\n\n      if (error) throw error;\n      if (!updated) throw new Error('Nenhuma linha atualizada. Verifique permiss├Áes de grava├º├úo.');\n\n      // Atualizar especialidades\n      // Primeiro, remover todas as especialidades existentes\n      await (supabase as any)\n        .from('profissional_especialidades')\n        .delete()\n        .eq('profissional_id', professionalId);\n\n      // Inserir as novas especialidades\n      if (selectedEspecialidades.length > 0) {\n        const { error: espError } = await (supabase as any)\n          .from('profissional_especialidades')\n          .insert(\n            selectedEspecialidades.map(esp_id => ({\n              tenant_id: profile.tenant_id,\n              profissional_id: professionalId,\n              especialidade_id: esp_id\n            }))\n          );\n\n        if (espError) throw espError;\n      }\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Profissional atualizado com sucesso.\"\n      });\n\n      onOpenChange(false);\n\n      if (onSuccess) {\n        onSuccess();\n      }\n    } catch (error) {\n      console.error('Erro ao atualizar:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel atualizar o profissional.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      <DialogContent className=\"max-w-2xl max-h-[90vh] overflow-y-auto\">\n        <DialogHeader>\n          <DialogTitle className=\"text-xl\">Editar Profissional</DialogTitle>\n          <DialogDescription>\n            Atualize as informa├º├Áes do profissional de sa├║de\n          </DialogDescription>\n        </DialogHeader>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"nome\">Nome Completo *</Label>\n            <Input\n              id=\"nome\"\n              value={formData.nome}\n              onChange={(e) => setFormData({ ...formData, nome: e.target.value })}\n              placeholder=\"Nome do profissional\"\n              required\n            />\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"email\">E-mail</Label>\n              <Input\n                id=\"email\"\n                type=\"email\"\n                disabled\n                className=\"bg-muted cursor-not-allowed\"\n                value={formData.email}\n                placeholder=\"email@exemplo.com\"\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"telefone\">Telefone</Label>\n              <Input\n                id=\"telefone\"\n                value={formData.telefone}\n                onChange={(e) => setFormData({ ...formData, telefone: e.target.value })}\n                placeholder=\"(00) 00000-0000\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"tipo\">Tipo de Profissional</Label>\n            <Select \n              value={formData.tipo_profissional_id} \n              onValueChange={(value) => setFormData({ ...formData, tipo_profissional_id: value })}\n            >\n              <SelectTrigger>\n                <SelectValue placeholder=\"Selecione o tipo\" />\n              </SelectTrigger>\n              <SelectContent>\n                {tiposProfissional.map((tipo) => (\n                  <SelectItem key={tipo.id} value={tipo.id}>\n                    {tipo.nome}\n                  </SelectItem>\n                ))}\n              </SelectContent>\n            </Select>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"cpf\">CPF</Label>\n              <Input\n                id=\"cpf\"\n                value={formData.cpf}\n                onChange={(e) => setFormData({ ...formData, cpf: e.target.value })}\n                placeholder=\"000.000.000-00\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label>Especialidades</Label>\n            <Select\n              value=\"\"\n              onValueChange={(value) => {\n                if (!selectedEspecialidades.includes(value)) {\n                  setSelectedEspecialidades([...selectedEspecialidades, value]);\n                }\n              }}\n            >\n              <SelectTrigger>\n                <SelectValue placeholder=\"Adicionar especialidade\" />\n              </SelectTrigger>\n              <SelectContent>\n                {especialidades\n                  .filter(esp => !selectedEspecialidades.includes(esp.id))\n                  .map((esp) => (\n                    <SelectItem key={esp.id} value={esp.id}>\n                      {esp.nome} {esp.conselho && `(${esp.conselho})`}\n                    </SelectItem>\n                  ))}\n              </SelectContent>\n            </Select>\n            <div className=\"flex flex-wrap gap-2 mt-2\">\n              {selectedEspecialidades.map(espId => {\n                const esp = especialidades.find(e => e.id === espId);\n                return esp ? (\n                  <Badge key={espId} variant=\"secondary\" className=\"gap-1\">\n                    {esp.nome}\n                    <X\n                      className=\"h-3 w-3 cursor-pointer\"\n                      onClick={() => setSelectedEspecialidades(\n                        selectedEspecialidades.filter(id => id !== espId)\n                      )}\n                    />\n                  </Badge>\n                ) : null;\n              })}\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"numero_registro\">N├║mero de Registro</Label>\n              <Input\n                id=\"numero_registro\"\n                value={formData.numero_registro}\n                onChange={(e) => setFormData({ ...formData, numero_registro: e.target.value })}\n                placeholder=\"Ex: 123456\"\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"uf\">UF</Label>\n              <Input\n                id=\"uf\"\n                value={formData.uf_registro}\n                onChange={(e) => setFormData({ ...formData, uf_registro: e.target.value })}\n                placeholder=\"Ex: SP\"\n                maxLength={2}\n              />\n            </div>\n          </div>\n\n          <FlexibleDatePicker\n            label=\"Data de Nascimento\"\n            value={formData.data_nascimento}\n            onChange={(date) => setFormData({ ...formData, data_nascimento: date })}\n          />\n\n          <div className=\"flex justify-end gap-3 pt-4\">\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              onClick={() => onOpenChange(false)}\n              disabled={isLoading}\n            >\n              Cancelar\n            </Button>\n            <Button type=\"submit\" disabled={isLoading}>\n              {isLoading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n              Salvar Altera├º├Áes\n            </Button>\n          </div>\n        </form>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\EditServiceDialog.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchService'. Either include it or remove the dependency array.","line":39,"column":6,"nodeType":"ArrayExpression","endLine":39,"endColumn":23,"suggestions":[{"desc":"Update the dependencies array to be: [fetchService, open, serviceId]","fix":{"range":[1080,1097],"text":"[fetchService, open, serviceId]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription } from \"@/components/ui/dialog\";\nimport { Button } from \"@/components/ui/button\";\nimport { Label } from \"@/components/ui/label\";\nimport { Input } from \"@/components/ui/input\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { Loader2 } from \"lucide-react\";\n\ninterface EditServiceDialogProps {\n  serviceId: string;\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  onSuccess?: () => void;\n}\n\nexport function EditServiceDialog({ \n  serviceId, \n  open, \n  onOpenChange, \n  onSuccess \n}: EditServiceDialogProps) {\n  const [isLoading, setIsLoading] = useState(false);\n  const [formData, setFormData] = useState({\n    nome: \"\",\n    duracao_minutos: \"\",\n    preco: \"\",\n    confirmacao_24h: false,\n    ativo: true\n  });\n\n  const { toast } = useToast();\n\n  useEffect(() => {\n    if (open && serviceId) {\n      fetchService();\n    }\n  }, [open, serviceId]);\n\n  const fetchService = async () => {\n    try {\n      const { data, error } = await supabase\n        .from('servicos')\n        .select('*')\n        .eq('id', serviceId)\n        .single();\n\n      if (error) throw error;\n\n      setFormData({\n        nome: data.nome || \"\",\n        duracao_minutos: data.duracao_minutos?.toString() || \"\",\n        preco: data.preco?.toString() || \"\",\n        confirmacao_24h: data.confirmacao_24h || false,\n        ativo: data.ativo !== false\n      });\n    } catch (error) {\n      console.error('Erro ao buscar servi├ºo:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os dados do servi├ºo.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.nome || !formData.duracao_minutos) {\n      toast({\n        title: \"Campos obrigat├│rios\",\n        description: \"Nome e dura├º├úo s├úo obrigat├│rios.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    try {\n      setIsLoading(true);\n\n      const { error } = await supabase\n        .from('servicos')\n        .update({\n          nome: formData.nome.trim(),\n          duracao_minutos: parseInt(formData.duracao_minutos),\n          preco: formData.preco ? parseFloat(formData.preco) : null,\n          confirmacao_24h: formData.confirmacao_24h,\n          ativo: formData.ativo,\n          updated_at: new Date().toISOString()\n        })\n        .eq('id', serviceId);\n\n      if (error) throw error;\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Servi├ºo atualizado com sucesso.\"\n      });\n\n      onOpenChange(false);\n\n      if (onSuccess) {\n        onSuccess();\n      }\n    } catch (error) {\n      console.error('Erro ao atualizar:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel atualizar o servi├ºo.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      <DialogContent className=\"max-w-lg\">\n        <DialogHeader>\n          <DialogTitle className=\"text-xl\">Editar Servi├ºo</DialogTitle>\n          <DialogDescription>\n            Atualize as informa├º├Áes do servi├ºo\n          </DialogDescription>\n        </DialogHeader>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"nome\">Nome do Servi├ºo *</Label>\n            <Input\n              id=\"nome\"\n              value={formData.nome}\n              onChange={(e) => setFormData({ ...formData, nome: e.target.value })}\n              placeholder=\"Ex: Consulta, Procedimento, Exame\"\n              required\n            />\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"duracao\">Dura├º├úo (minutos) *</Label>\n              <Input\n                id=\"duracao\"\n                type=\"number\"\n                min=\"1\"\n                value={formData.duracao_minutos}\n                onChange={(e) => setFormData({ ...formData, duracao_minutos: e.target.value })}\n                placeholder=\"30\"\n                required\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"preco\">Pre├ºo (R$)</Label>\n              <Input\n                id=\"preco\"\n                type=\"number\"\n                step=\"0.01\"\n                min=\"0\"\n                value={formData.preco}\n                onChange={(e) => setFormData({ ...formData, preco: e.target.value })}\n                placeholder=\"150.00\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex items-center justify-between\">\n            <Label htmlFor=\"confirmacao\">Confirmar 24h antes?</Label>\n            <Switch\n              id=\"confirmacao\"\n              checked={formData.confirmacao_24h}\n              onCheckedChange={(checked) => setFormData({ ...formData, confirmacao_24h: checked })}\n            />\n          </div>\n\n          <div className=\"flex items-center justify-between\">\n            <Label htmlFor=\"ativo\">Servi├ºo ativo?</Label>\n            <Switch\n              id=\"ativo\"\n              checked={formData.ativo}\n              onCheckedChange={(checked) => setFormData({ ...formData, ativo: checked })}\n            />\n          </div>\n\n          <div className=\"flex justify-end gap-3 pt-4\">\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              onClick={() => onOpenChange(false)}\n              disabled={isLoading}\n            >\n              Cancelar\n            </Button>\n            <Button type=\"submit\" disabled={isLoading}>\n              {isLoading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n              Salvar Altera├º├Áes\n            </Button>\n          </div>\n        </form>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\MonthlyCalendar.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchMonthStats'. Either include it or remove the dependency array.","line":71,"column":6,"nodeType":"ArrayExpression","endLine":71,"endColumn":20,"suggestions":[{"desc":"Update the dependencies array to be: [currentMonth, fetchMonthStats]","fix":{"range":[2441,2455],"text":"[currentMonth, fetchMonthStats]"}}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'currentMonth'. Either include it or remove the dependency array.","line":78,"column":6,"nodeType":"ArrayExpression","endLine":78,"endColumn":20,"suggestions":[{"desc":"Update the dependencies array to be: [currentMonth, selectedDate]","fix":{"range":[2624,2638],"text":"[currentMonth, selectedDate]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { ChevronLeft, ChevronRight, Calendar as CalendarIcon } from \"lucide-react\";\nimport { format, startOfMonth, endOfMonth, eachDayOfInterval, isSameDay, isSameMonth, addMonths, subMonths, startOfWeek, endOfWeek } from \"date-fns\";\nimport { ptBR } from \"date-fns/locale\";\nimport { cn } from \"@/lib/utils\";\nimport { supabase } from \"@/integrations/supabase/client\";\n\ninterface DayStats {\n  date: Date;\n  appointmentCount: number;\n  maxCapacity: number; // Define capacidade m├íxima por dia (pode ser configur├ível)\n}\n\ninterface MonthlyCalendarProps {\n  selectedDate: Date;\n  onDateSelect: (date: Date) => void;\n  className?: string;\n}\n\nexport function MonthlyCalendar({ selectedDate, onDateSelect, className }: MonthlyCalendarProps) {\n  const [currentMonth, setCurrentMonth] = useState(selectedDate);\n  const [dayStats, setDayStats] = useState<DayStats[]>([]);\n  const [isLoading, setIsLoading] = useState(false);\n\n  const MAX_APPOINTMENTS_PER_DAY = 12; // Configur├ível\n\n  // Buscar estat├¡sticas do m├¬s\n  const fetchMonthStats = async () => {\n    try {\n      setIsLoading(true);\n      const monthStart = startOfMonth(currentMonth);\n      const monthEnd = endOfMonth(currentMonth);\n\n      const { data, error } = await supabase\n        .from('agenda')\n        .select('inicio, id')\n        .gte('inicio', monthStart.toISOString())\n        .lte('inicio', monthEnd.toISOString());\n\n      if (error) throw error;\n\n      // Agrupar por dia\n      const statsByDay = new Map<string, number>();\n      \n      (data || []).forEach((apt) => {\n        const aptDate = new Date(apt.inicio);\n        const dateKey = format(aptDate, 'yyyy-MM-dd');\n        statsByDay.set(dateKey, (statsByDay.get(dateKey) || 0) + 1);\n      });\n\n      // Criar array de estat├¡sticas\n      const daysInMonth = eachDayOfInterval({ start: monthStart, end: monthEnd });\n      const stats: DayStats[] = daysInMonth.map(day => ({\n        date: day,\n        appointmentCount: statsByDay.get(format(day, 'yyyy-MM-dd')) || 0,\n        maxCapacity: MAX_APPOINTMENTS_PER_DAY\n      }));\n\n      setDayStats(stats);\n    } catch (error) {\n      console.error('Erro ao buscar estat├¡sticas do m├¬s:', error);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchMonthStats();\n  }, [currentMonth]);\n\n  // Atualizar m├¬s quando selectedDate mudar\n  useEffect(() => {\n    if (!isSameMonth(selectedDate, currentMonth)) {\n      setCurrentMonth(selectedDate);\n    }\n  }, [selectedDate]);\n\n  const handlePreviousMonth = () => {\n    setCurrentMonth(prev => subMonths(prev, 1));\n  };\n\n  const handleNextMonth = () => {\n    setCurrentMonth(prev => addMonths(prev, 1));\n  };\n\n  const handleToday = () => {\n    const today = new Date();\n    setCurrentMonth(today);\n    onDateSelect(today);\n  };\n\n  // Obter cor baseado na quantidade de agendamentos\n  const getDayColor = (stats: DayStats) => {\n    if (stats.appointmentCount === 0) {\n      return \"bg-green-500/20 hover:bg-green-500/30 border-green-500/50\"; // Livre\n    } else if (stats.appointmentCount >= stats.maxCapacity) {\n      return \"bg-red-500/20 hover:bg-red-500/30 border-red-500/50\"; // Lotado\n    } else {\n      return \"bg-blue-500/20 hover:bg-blue-500/30 border-blue-500/50\"; // Com agendamentos\n    }\n  };\n\n  // Obter dias para renderizar (incluindo dias da semana anterior/pr├│xima)\n  const monthStart = startOfMonth(currentMonth);\n  const monthEnd = endOfMonth(currentMonth);\n  const calendarStart = startOfWeek(monthStart, { locale: ptBR });\n  const calendarEnd = endOfWeek(monthEnd, { locale: ptBR });\n  const calendarDays = eachDayOfInterval({ start: calendarStart, end: calendarEnd });\n\n  const weekDays = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'S├íb'];\n\n  return (\n    <Card className={cn(\"\", className)}>\n      <CardHeader className=\"pb-3\">\n        <div className=\"flex items-center justify-between\">\n          <CardTitle className=\"text-lg flex items-center gap-2\">\n            <CalendarIcon className=\"h-5 w-5 text-primary\" />\n            {format(currentMonth, \"MMMM yyyy\", { locale: ptBR })}\n          </CardTitle>\n          <div className=\"flex gap-1\">\n            <Button\n              variant=\"ghost\"\n              size=\"icon\"\n              className=\"h-8 w-8\"\n              onClick={handlePreviousMonth}\n            >\n              <ChevronLeft className=\"h-4 w-4\" />\n            </Button>\n            <Button\n              variant=\"ghost\"\n              size=\"icon\"\n              className=\"h-8 w-8\"\n              onClick={handleNextMonth}\n            >\n              <ChevronRight className=\"h-4 w-4\" />\n            </Button>\n          </div>\n        </div>\n        <Button\n          variant=\"outline\"\n          size=\"sm\"\n          onClick={handleToday}\n          className=\"w-full mt-2\"\n        >\n          Hoje\n        </Button>\n      </CardHeader>\n\n      <CardContent className=\"pt-0\">\n        {isLoading ? (\n          <div className=\"flex items-center justify-center py-8\">\n            <div className=\"animate-spin rounded-full h-8 w-8 border-b-2 border-primary\"></div>\n          </div>\n        ) : (\n          <>\n            {/* Cabe├ºalho dos dias da semana */}\n            <div className=\"grid grid-cols-7 gap-1 mb-2\">\n              {weekDays.map((day) => (\n                <div\n                  key={day}\n                  className=\"text-center text-xs font-semibold text-muted-foreground py-1\"\n                >\n                  {day}\n                </div>\n              ))}\n            </div>\n\n            {/* Grid de dias */}\n            <div className=\"grid grid-cols-7 gap-1\">\n              {calendarDays.map((day) => {\n                const stats = dayStats.find(s => isSameDay(s.date, day));\n                const isCurrentMonth = isSameMonth(day, currentMonth);\n                const isSelected = isSameDay(day, selectedDate);\n                const isToday = isSameDay(day, new Date());\n\n                return (\n                  <button\n                    key={day.toISOString()}\n                    onClick={() => onDateSelect(day)}\n                    disabled={!isCurrentMonth}\n                    className={cn(\n                      \"relative aspect-square rounded-md border transition-all\",\n                      \"flex flex-col items-center justify-center text-sm\",\n                      \"disabled:opacity-40 disabled:cursor-not-allowed\",\n                      isCurrentMonth && stats && getDayColor(stats),\n                      !isCurrentMonth && \"bg-muted/30 hover:bg-muted/50\",\n                      isSelected && \"ring-2 ring-primary ring-offset-2\",\n                      isToday && !isSelected && \"ring-1 ring-primary/50\",\n                      \"hover:scale-105 active:scale-95\"\n                    )}\n                  >\n                    <span className={cn(\n                      \"font-medium\",\n                      isCurrentMonth ? \"text-foreground\" : \"text-muted-foreground\",\n                      isToday && \"font-bold\"\n                    )}>\n                      {format(day, 'd')}\n                    </span>\n                    {stats && stats.appointmentCount > 0 && (\n                      <span className=\"text-[10px] font-semibold mt-0.5\">\n                        {stats.appointmentCount}\n                      </span>\n                    )}\n                  </button>\n                );\n              })}\n            </div>\n\n            {/* Legenda */}\n            <div className=\"mt-4 pt-4 border-t space-y-2\">\n              <p className=\"text-xs font-semibold text-muted-foreground mb-2\">Legenda:</p>\n              <div className=\"flex items-center gap-2 text-xs\">\n                <div className=\"h-4 w-4 rounded bg-green-500/20 border border-green-500/50\"></div>\n                <span className=\"text-muted-foreground\">Livre</span>\n              </div>\n              <div className=\"flex items-center gap-2 text-xs\">\n                <div className=\"h-4 w-4 rounded bg-blue-500/20 border border-blue-500/50\"></div>\n                <span className=\"text-muted-foreground\">Com agendamentos</span>\n              </div>\n              <div className=\"flex items-center gap-2 text-xs\">\n                <div className=\"h-4 w-4 rounded bg-red-500/20 border border-red-500/50\"></div>\n                <span className=\"text-muted-foreground\">Lotado ({MAX_APPOINTMENTS_PER_DAY}+)</span>\n              </div>\n            </div>\n          </>\n        )}\n      </CardContent>\n    </Card>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\NewAppointmentDialog.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchData'. Either include it or remove the dependency array.","line":89,"column":6,"nodeType":"ArrayExpression","endLine":89,"endColumn":12,"suggestions":[{"desc":"Update the dependencies array to be: [fetchData, open]","fix":{"range":[3692,3698],"text":"[fetchData, open]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger, DialogDescription } from \"@/components/ui/dialog\";\nimport { Button } from \"@/components/ui/button\";\nimport { Label } from \"@/components/ui/label\";\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\nimport { Input } from \"@/components/ui/input\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Calendar } from \"@/components/ui/calendar\";\nimport { Popover, PopoverContent, PopoverTrigger } from \"@/components/ui/popover\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { format, startOfDay, endOfDay } from \"date-fns\";\nimport { ptBR } from \"date-fns/locale\";\nimport { CalendarIcon, Loader2, AlertTriangle } from \"lucide-react\";\nimport { cn } from \"@/lib/utils\";\nimport { NewPatientDialog } from \"./NewPatientDialog\";\nimport { NewProfessionalDialog } from \"./NewProfessionalDialog\";\nimport { PatientCombobox } from \"./PatientCombobox\";\nimport { ProfessionalCombobox } from \"./ProfessionalCombobox\";\nimport { checkNewAppointmentConflict } from \"@/lib/scheduleConflicts\";\nimport { automationEngine } from \"@/domain/automations/automationEngine\";\nimport { noShowModel } from \"@/domain/analytics/noShowModel\";\n\ninterface NewAppointmentDialogProps {\n  children: React.ReactNode;\n  selectedDate?: Date;\n  selectedTime?: string;\n  onSuccess?: () => void;\n  open?: boolean;\n  onOpenChange?: (open: boolean) => void;\n}\n\nexport function NewAppointmentDialog({ children, selectedDate, selectedTime, onSuccess, open: controlledOpen, onOpenChange }: NewAppointmentDialogProps) {\n  const [internalOpen, setInternalOpen] = useState(false);\n  const open = controlledOpen !== undefined ? controlledOpen : internalOpen;\n  const setOpen = onOpenChange || setInternalOpen;\n  const [isLoading, setIsLoading] = useState(false);\n  const [isFetchingData, setIsFetchingData] = useState(true);\n  const [conflictWarning, setConflictWarning] = useState<{ show: boolean; minutes: number } | null>(null);\n  const [forceCreate, setForceCreate] = useState(false);\n\n  const [pacientes, setPacientes] = useState<any[]>([]);\n  const [profissionais, setProfissionais] = useState<any[]>([]);\n  const [servicos, setServicos] = useState<any[]>([]);\n  const [pacientesPacotes, setPacientesPacotes] = useState<any[]>([]);\n  const [existingAppointments, setExistingAppointments] = useState<any[]>([]);\n  const [profissionalEspecialidades, setProfissionalEspecialidades] = useState<any[]>([]);\n  const [planosSaude, setPlanosSaude] = useState<any[]>([]);\n  const [formasPagamento, setFormasPagamento] = useState<any[]>([]);\n  const [contasPix, setContasPix] = useState<any[]>([]);\n\n  const [formData, setFormData] = useState({\n    paciente_id: \"\",\n    profissional_id: \"\",\n    especialidade_id: \"\",\n    servico_id: \"\",\n    paciente_pacote_id: \"\",\n    data: selectedDate || new Date(),\n    hora_inicio: selectedTime || \"\",\n    sala: \"\",\n    notas: \"\",\n    tipo_atendimento: \"particular\",\n    plano_saude_id: \"\",\n    valor_consulta: \"\",\n    forma_pagamento_id: \"\",\n    conta_pix_id: \"\"\n  });\n\n  // Atualizar data e hora quando props mudarem\n  useEffect(() => {\n    if (selectedDate) {\n      setFormData(prev => ({ ...prev, data: selectedDate }));\n    }\n  }, [selectedDate]);\n\n  useEffect(() => {\n    if (selectedTime) {\n      setFormData(prev => ({ ...prev, hora_inicio: selectedTime }));\n    }\n  }, [selectedTime]);\n\n  const { toast } = useToast();\n\n  useEffect(() => {\n    if (open) {\n      fetchData();\n    }\n  }, [open]);\n\n  const fetchData = async () => {\n    try {\n      setIsFetchingData(true);\n\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) throw new Error(\"Usu├írio n├úo autenticado\");\n\n      const { data: profileData, error: profileError } = await supabase\n        .from('profiles')\n        .select('tenant_id')\n        .eq('id', user.id)\n        .single();\n\n      if (profileError) throw profileError;\n\n      const [pacientesRes, profissionaisRes, servicosRes, planosSaudeRes, formasPagamentoRes, contasPixRes] = await Promise.all([\n        supabase.from('pacientes').select('id, nome, telefone').eq('tenant_id', profileData.tenant_id).order('nome'),\n        supabase.from('profiles').select('id, nome, role').eq('tenant_id', profileData.tenant_id).order('nome'),\n        supabase.from('servicos').select('id, nome, duracao_minutos, preco').eq('tenant_id', profileData.tenant_id).eq('ativo', true).order('nome'),\n        supabase.from('planos_saude').select('id, nome').eq('tenant_id', profileData.tenant_id).eq('ativo', true).order('nome'),\n        supabase.from('formas_pagamento').select('id, nome, tipo').eq('tenant_id', profileData.tenant_id).eq('ativo', true).order('ordem'),\n        supabase.from('contas_pix').select('id, nome, chave_pix').eq('tenant_id', profileData.tenant_id).eq('ativo', true).order('nome')\n      ]);\n\n      if (pacientesRes.error) throw pacientesRes.error;\n      if (profissionaisRes.error) throw profissionaisRes.error;\n      if (servicosRes.error) throw servicosRes.error;\n      console.log('Procedimentos encontrados:', servicosRes.data);\n\n      // Filtrar apenas profissionais no frontend\n      const profissionaisFiltrados = (profissionaisRes.data || []).filter(\n        prof => prof.role === 'profissional' || prof.role === 'admin' || prof.role === 'admin_tenant'\n      );\n\n      setPacientes(pacientesRes.data || []);\n      setProfissionais(profissionaisFiltrados);\n      setServicos(servicosRes.data || []);\n      setPlanosSaude(planosSaudeRes.data || []);\n      setFormasPagamento(formasPagamentoRes.data || []);\n      setContasPix(contasPixRes.data || []);\n\n      // Buscar agendamentos existentes no dia selecionado\n      await fetchExistingAppointments(formData.data);\n    } catch (error) {\n      console.error('Erro ao buscar dados:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os dados necess├írios.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsFetchingData(false);\n    }\n  };\n\n  const fetchExistingAppointments = async (date: Date) => {\n    try {\n      const dayStart = startOfDay(date);\n      const dayEnd = endOfDay(date);\n\n      const { data, error } = await supabase\n        .from('agenda')\n        .select('id, inicio, fim, procedimentos:servico_id(duracao_minutos)')\n        .gte('inicio', dayStart.toISOString())\n        .lte('inicio', dayEnd.toISOString())\n        .order('inicio');\n\n      if (error) throw error;\n\n      const appointments = (data || []).map(apt => ({\n        id: apt.id,\n        inicio: apt.inicio,\n        duration: apt.procedimentos?.duracao_minutos || 30\n      }));\n\n      setExistingAppointments(appointments);\n    } catch (error) {\n      console.error('Erro ao buscar agendamentos:', error);\n    }\n  };\n\n  // Verificar conflitos quando hora ou servi├ºo mudam\n  useEffect(() => {\n    if (formData.hora_inicio && formData.servico_id && existingAppointments.length > 0) {\n      const servico = servicos.find(s => s.id === formData.servico_id);\n      if (!servico) return;\n\n      const [hours, minutes] = formData.hora_inicio.split(':');\n      const inicio = new Date(formData.data);\n      inicio.setHours(parseInt(hours), parseInt(minutes), 0, 0);\n\n      const conflict = checkNewAppointmentConflict(\n        inicio,\n        servico.duracao_minutos,\n        existingAppointments\n      );\n\n      if (conflict.hasConflict) {\n        setConflictWarning({ show: true, minutes: conflict.overlapMinutes });\n      } else {\n        setConflictWarning(null);\n      }\n    } else {\n      setConflictWarning(null);\n    }\n  }, [formData.hora_inicio, formData.servico_id, formData.data, existingAppointments, servicos]);\n\n  const fetchPacotesPaciente = async (pacienteId: string) => {\n    if (!pacienteId) {\n      setPacientesPacotes([]);\n      return;\n    }\n\n    try {\n      const { data, error } = await supabase\n        .from('pacientes_pacotes')\n        .select('*, pacotes(nome)')\n        .eq('paciente_id', pacienteId)\n        .eq('status', 'ativo')\n        .gt('sessoes_restantes', 0);\n\n      if (error) throw error;\n      setPacientesPacotes(data || []);\n    } catch (error) {\n      console.error('Erro ao buscar pacotes do paciente:', error);\n      setPacientesPacotes([]);\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.paciente_id || !formData.profissional_id || !formData.servico_id || !formData.hora_inicio) {\n      toast({\n        title: \"Campos obrigat├│rios\",\n        description: \"Por favor, preencha todos os campos obrigat├│rios.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    // Se h├í conflito e usu├írio n├úo confirmou, alertar\n    if (conflictWarning?.show && !forceCreate) {\n      toast({\n        title: \"Conflito de hor├írio\",\n        description: `H├í uma sobreposi├º├úo de ${conflictWarning.minutes} minutos. Clique em \"Criar Mesmo Assim\" para continuar.`,\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    try {\n      setIsLoading(true);\n\n      const servico = servicos.find(s => s.id === formData.servico_id);\n      if (!servico) throw new Error(\"Servi├ºo n├úo encontrado\");\n\n      const [hours, minutes] = formData.hora_inicio.split(':');\n      const inicio = new Date(formData.data);\n      inicio.setHours(parseInt(hours), parseInt(minutes), 0, 0);\n\n      const fim = new Date(inicio);\n      fim.setMinutes(inicio.getMinutes() + servico.duracao_minutos);\n\n      // Buscar tenant_id do usu├írio logado\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) throw new Error(\"Usu├írio n├úo autenticado\");\n\n      const { data: profile } = await supabase\n        .from('profiles')\n        .select('tenant_id')\n        .eq('id', user.id)\n        .maybeSingle();\n\n      if (!profile) {\n        toast({ title: \"Perfil n├úo encontrado\", description: \"Conclua seu cadastro em Configura├º├Áes.\", variant: \"destructive\" });\n        throw new Error(\"Perfil do usu├írio n├úo encontrado\");\n      }\n      if (!profile.tenant_id) {\n        toast({ title: \"Tenant n├úo encontrado\", description: \"Associe seu perfil a uma cl├¡nica em Configura├º├Áes.\", variant: \"destructive\" });\n        throw new Error(\"Tenant n├úo encontrado\");\n      }\n\n      // Buscar ordem m├íxima atual\n      const { data: maxOrdem } = await supabase\n        .from('agenda')\n        .select('ordem')\n        .eq('tenant_id', profile.tenant_id)\n        .order('ordem', { ascending: false, nullsFirst: false })\n        .limit(1)\n        .maybeSingle();\n\n      const novaOrdem = (maxOrdem?.ordem || 0) + 1;\n\n      // Calcular Score de Risco de No-Show\n      const riskAnalysis = await noShowModel.calcularScore({\n        paciente_id: formData.paciente_id,\n        data_agendamento: inicio,\n        data_criacao: new Date(),\n        origem: 'recep├º├úo', // ou pegar do contexto se for online\n        servico_preco: servico.preco || 0\n      });\n\n      const { data: agendaData, error } = await supabase\n        .from('agenda')\n        .insert([{\n          paciente_id: formData.paciente_id,\n          profissional_id: formData.profissional_id,\n          servico_id: formData.servico_id,\n          especialidade_id: formData.especialidade_id || null,\n          paciente_pacote_id: formData.paciente_pacote_id || null,\n          inicio: inicio.toISOString(),\n          fim: fim.toISOString(),\n          sala: formData.sala || null,\n          notas: formData.notas || null,\n          status: 'agendado',\n          tenant_id: profile.tenant_id,\n          origem: 'recep├º├úo',\n          ordem: novaOrdem,\n          tipo_atendimento: formData.tipo_atendimento,\n          plano_saude_id: formData.tipo_atendimento === 'plano' ? formData.plano_saude_id || null : null,\n          valor_consulta: formData.valor_consulta ? parseFloat(formData.valor_consulta) : null,\n          forma_pagamento_id: formData.tipo_atendimento === 'particular' ? formData.forma_pagamento_id || null : null,\n          conta_pix_id: formData.conta_pix_id || null,\n          no_show_score: riskAnalysis.score,\n          no_show_risk_level: riskAnalysis.level\n        }])\n        .select()\n        .single();\n\n      if (error) throw error;\n\n      // Se for atendimento particular com valor, criar lan├ºamento no caixa\n      if (formData.tipo_atendimento === 'particular' && formData.valor_consulta && agendaData) {\n        await supabase.from('caixa_diario').insert({\n          tenant_id: profile.tenant_id,\n          agendamento_id: agendaData.id,\n          paciente_id: formData.paciente_id,\n          profissional_id: formData.profissional_id,\n          data: format(formData.data, 'yyyy-MM-dd'),\n          tipo_lancamento: 'entrada',\n          valor: parseFloat(formData.valor_consulta),\n          forma_pagamento: formasPagamento.find(f => f.id === formData.forma_pagamento_id)?.nome || 'N├úo especificado',\n          conta_pix_id: formData.conta_pix_id || null,\n          descricao: `Consulta - ${servico.nome}`,\n          created_by: user.id\n        });\n      }\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Consulta cadastrada com sucesso.\"\n      });\n\n      // Trigger Automation\n      const paciente = pacientes.find(p => p.id === formData.paciente_id);\n      if (paciente && agendaData) {\n        automationEngine.processarEventoAutomacao({\n          tenant_id: profile.tenant_id,\n          event_type: 'onAppointmentCreated',\n          data: {\n            agendamento: agendaData,\n            paciente: paciente,\n            servico: servico\n          }\n        }).catch(err => console.error(\"Erro ao disparar automa├º├úo:\", err));\n      }\n\n      // Resetar formul├írio\n      setFormData({\n        paciente_id: \"\",\n        profissional_id: \"\",\n        especialidade_id: \"\",\n        servico_id: \"\",\n        paciente_pacote_id: \"\",\n        data: new Date(),\n        hora_inicio: \"\",\n        sala: \"\",\n        notas: \"\",\n        tipo_atendimento: \"particular\",\n        plano_saude_id: \"\",\n        valor_consulta: \"\",\n        forma_pagamento_id: \"\",\n        conta_pix_id: \"\"\n      });\n\n      // Fechar dialog e chamar callback com delay para evitar conflitos\n      setOpen(false);\n      setTimeout(() => {\n        if (onSuccess) onSuccess();\n      }, 150);\n    } catch (error) {\n      console.error('Erro ao cadastrar consulta:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel cadastrar a consulta.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={setOpen}>\n      <DialogTrigger asChild>\n        {children}\n      </DialogTrigger>\n      <DialogContent className=\"max-w-4xl max-h-[95vh] overflow-hidden flex flex-col\">\n        <DialogHeader className=\"flex-shrink-0\">\n          <DialogTitle className=\"text-xl\">Nova Consulta</DialogTitle>\n          <DialogDescription className=\"text-sm\">Preencha os campos para agendar uma nova consulta.</DialogDescription>\n        </DialogHeader>\n\n        {isFetchingData ? (\n          <div className=\"flex items-center justify-center py-8\">\n            <Loader2 className=\"h-8 w-8 animate-spin text-primary\" />\n          </div>\n        ) : (\n          <form onSubmit={handleSubmit} className=\"space-y-4 flex-1 overflow-y-auto\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <Label htmlFor=\"paciente\">Paciente *</Label>\n                  <NewPatientDialog onSuccess={(patientId) => {\n                    fetchData();\n                    setFormData({ ...formData, paciente_id: patientId });\n                  }} />\n                </div>\n                <PatientCombobox\n                  value={formData.paciente_id}\n                  onValueChange={(value) => {\n                    setFormData({ ...formData, paciente_id: value, paciente_pacote_id: \"\" });\n                    fetchPacotesPaciente(value);\n                  }}\n                  patients={pacientes}\n                />\n              </div>\n\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <Label htmlFor=\"profissional\">Profissional *</Label>\n                  <NewProfessionalDialog onSuccess={(professionalId) => {\n                    fetchData();\n                    setFormData({ ...formData, profissional_id: professionalId });\n                  }} />\n                </div>\n                <ProfessionalCombobox\n                  value={formData.profissional_id}\n                  onValueChange={(value) => setFormData({ ...formData, profissional_id: value })}\n                  professionals={profissionais}\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n              <div className=\"space-y-1.5\">\n                <Label htmlFor=\"servico\">Procedimento *</Label>\n                <Select\n                  value={formData.servico_id}\n                  onValueChange={(value) => setFormData({ ...formData, servico_id: value })}\n                >\n                  <SelectTrigger id=\"servico\">\n                    <SelectValue placeholder=\"Selecione o procedimento\" />\n                  </SelectTrigger>\n                  <SelectContent className=\"bg-background z-50\">\n                    {servicos.length === 0 ? (\n                      <div className=\"p-2 text-sm text-muted-foreground text-center\">\n                        Nenhum procedimento cadastrado\n                      </div>\n                    ) : (\n                      servicos.map((servico) => (\n                        <SelectItem key={servico.id} value={servico.id}>\n                          {servico.nome} - {servico.duracao_minutos}min\n                          {servico.preco && ` - R$ ${servico.preco}`}\n                        </SelectItem>\n                      ))\n                    )}\n                  </SelectContent>\n                </Select>\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <Label htmlFor=\"pacote\">Usar Pacote (Opcional)</Label>\n                <Select\n                  value={formData.paciente_pacote_id}\n                  onValueChange={(value) => setFormData({ ...formData, paciente_pacote_id: value === \"none\" ? \"\" : value })}\n                  disabled={!formData.paciente_id || pacientesPacotes.length === 0}\n                >\n                  <SelectTrigger id=\"pacote\">\n                    <SelectValue placeholder=\"Nenhum pacote\" />\n                  </SelectTrigger>\n                  <SelectContent className=\"bg-background z-50\">\n                    <SelectItem value=\"none\">N├úo usar pacote</SelectItem>\n                    {pacientesPacotes.map((pp) => (\n                      <SelectItem key={pp.id} value={pp.id}>\n                        {pp.pacotes?.nome} ({pp.sessoes_restantes} sess├Áes restantes)\n                      </SelectItem>\n                    ))}\n                  </SelectContent>\n                </Select>\n                {formData.paciente_id && pacientesPacotes.length === 0 && (\n                  <p className=\"text-xs text-muted-foreground\">\n                    Paciente sem pacotes ativos\n                  </p>\n                )}\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n              <div className=\"space-y-1.5\">\n                <Label>Data *</Label>\n                <Popover>\n                  <PopoverTrigger asChild>\n                    <Button\n                      variant=\"outline\"\n                      className={cn(\n                        \"w-full justify-start text-left font-normal\",\n                        !formData.data && \"text-muted-foreground\"\n                      )}\n                    >\n                      <CalendarIcon className=\"mr-2 h-4 w-4 flex-shrink-0\" />\n                      <span className=\"truncate\">\n                        {formData.data ? format(formData.data, \"dd/MM/yyyy\") : \"Selecione a data\"}\n                      </span>\n                    </Button>\n                  </PopoverTrigger>\n                  <PopoverContent className=\"w-auto p-0 bg-background z-50\" align=\"start\">\n                    <Calendar\n                      mode=\"single\"\n                      selected={formData.data}\n                      onSelect={(date) => date && setFormData({ ...formData, data: date })}\n                      initialFocus\n                      locale={ptBR}\n                      className={cn(\"p-3 pointer-events-auto\")}\n                    />\n                  </PopoverContent>\n                </Popover>\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <Label htmlFor=\"hora_inicio\">Hor├írio *</Label>\n                <Input\n                  id=\"hora_inicio\"\n                  type=\"time\"\n                  value={formData.hora_inicio}\n                  onChange={(e) => setFormData({ ...formData, hora_inicio: e.target.value })}\n                  className=\"w-full\"\n                />\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <Label htmlFor=\"sala\">Sala/Consult├│rio</Label>\n                <Input\n                  id=\"sala\"\n                  value={formData.sala}\n                  onChange={(e) => setFormData({ ...formData, sala: e.target.value })}\n                  placeholder=\"Ex: Consult├│rio 1\"\n                  className=\"w-full\"\n                />\n              </div>\n            </div>\n\n            {conflictWarning?.show && (\n              <Alert variant=\"destructive\" className=\"mt-4\">\n                <AlertTriangle className=\"h-4 w-4\" />\n                <AlertDescription>\n                  <p className=\"font-semibold\">Conflito de hor├írio detectado!</p>\n                  <p className=\"text-sm mt-1\">\n                    H├í uma sobreposi├º├úo de {conflictWarning.minutes} minutos com um agendamento anterior.\n                    Voc├¬ pode criar mesmo assim, mas recomendamos ajustar o hor├írio.\n                  </p>\n                </AlertDescription>\n              </Alert>\n            )}\n\n            <div className=\"grid grid-cols-2 gap-4\">\n              <div className=\"space-y-1.5\">\n                <Label htmlFor=\"tipo_atendimento\">Tipo de Atendimento *</Label>\n                <Select\n                  value={formData.tipo_atendimento}\n                  onValueChange={(value: \"plano\" | \"particular\") => {\n                    setFormData({ ...formData, tipo_atendimento: value, plano_saude_id: \"\", forma_pagamento_id: \"\", conta_pix_id: \"\" });\n                  }}\n                >\n                  <SelectTrigger id=\"tipo_atendimento\">\n                    <SelectValue />\n                  </SelectTrigger>\n                  <SelectContent className=\"bg-background z-50\">\n                    <SelectItem value=\"plano\">Plano de Sa├║de</SelectItem>\n                    <SelectItem value=\"particular\">Particular</SelectItem>\n                  </SelectContent>\n                </Select>\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <Label htmlFor=\"valor_consulta\">Valor da Consulta</Label>\n                <Input\n                  id=\"valor_consulta\"\n                  type=\"number\"\n                  step=\"0.01\"\n                  value={formData.valor_consulta}\n                  onChange={(e) => setFormData({ ...formData, valor_consulta: e.target.value })}\n                  placeholder=\"0.00\"\n                />\n              </div>\n            </div>\n\n            {formData.tipo_atendimento === 'plano' && (\n              <div className=\"space-y-1.5\">\n                <Label>Plano de Sa├║de *</Label>\n                <Select\n                  value={formData.plano_saude_id}\n                  onValueChange={(value) => setFormData({ ...formData, plano_saude_id: value })}\n                >\n                  <SelectTrigger>\n                    <SelectValue placeholder=\"Selecione o plano\" />\n                  </SelectTrigger>\n                  <SelectContent className=\"bg-background z-50\">\n                    {planosSaude.map((plano) => (\n                      <SelectItem key={plano.id} value={plano.id}>\n                        {plano.nome}\n                      </SelectItem>\n                    ))}\n                  </SelectContent>\n                </Select>\n              </div>\n            )}\n\n            {formData.tipo_atendimento === 'particular' && (\n              <>\n                <div className=\"space-y-1.5\">\n                  <Label>Forma de Pagamento</Label>\n                  <Select\n                    value={formData.forma_pagamento_id}\n                    onValueChange={(value) => {\n                      setFormData({ ...formData, forma_pagamento_id: value });\n                      const forma = formasPagamento.find(f => f.id === value);\n                      if (forma?.tipo !== 'pix') {\n                        setFormData(prev => ({ ...prev, conta_pix_id: \"\" }));\n                      }\n                    }}\n                  >\n                    <SelectTrigger>\n                      <SelectValue placeholder=\"Selecione\" />\n                    </SelectTrigger>\n                    <SelectContent className=\"bg-background z-50\">\n                      {formasPagamento.map((forma) => (\n                        <SelectItem key={forma.id} value={forma.id}>\n                          {forma.nome}\n                        </SelectItem>\n                      ))}\n                    </SelectContent>\n                  </Select>\n                </div>\n\n                {formasPagamento.find(f => f.id === formData.forma_pagamento_id)?.tipo === 'pix' && (\n                  <div className=\"space-y-1.5\">\n                    <Label>Conta PIX</Label>\n                    <Select\n                      value={formData.conta_pix_id}\n                      onValueChange={(value) => setFormData({ ...formData, conta_pix_id: value })}\n                    >\n                      <SelectTrigger>\n                        <SelectValue placeholder=\"Selecione a conta PIX\" />\n                      </SelectTrigger>\n                      <SelectContent className=\"bg-background z-50\">\n                        {contasPix.map((conta) => (\n                          <SelectItem key={conta.id} value={conta.id}>\n                            {conta.nome} - {conta.chave_pix}\n                          </SelectItem>\n                        ))}\n                      </SelectContent>\n                    </Select>\n                  </div>\n                )}\n              </>\n            )}\n\n            <div className=\"space-y-1.5\">\n              <Label htmlFor=\"notas\">Observa├º├Áes</Label>\n              <Textarea\n                id=\"notas\"\n                value={formData.notas}\n                onChange={(e) => setFormData({ ...formData, notas: e.target.value })}\n                placeholder=\"Notas adicionais sobre a consulta...\"\n                rows={2}\n                className=\"resize-none\"\n              />\n            </div>\n\n            <div className=\"flex justify-end gap-3 pt-2 flex-shrink-0 border-t mt-4\">\n              <Button\n                type=\"button\"\n                variant=\"outline\"\n                onClick={() => setOpen(false)}\n                disabled={isLoading}\n              >\n                Cancelar\n              </Button>\n              {conflictWarning?.show ? (\n                <>\n                  <Button\n                    type=\"submit\"\n                    disabled={isLoading || !forceCreate}\n                    variant=\"outline\"\n                  >\n                    {isLoading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n                    Cadastrar Consulta\n                  </Button>\n                  <Button\n                    type=\"button\"\n                    variant=\"destructive\"\n                    onClick={() => {\n                      setForceCreate(true);\n                      setTimeout(() => {\n                        const form = document.querySelector('form');\n                        form?.requestSubmit();\n                      }, 50);\n                    }}\n                    disabled={isLoading}\n                  >\n                    Criar Mesmo Assim\n                  </Button>\n                </>\n              ) : (\n                <Button type=\"submit\" disabled={isLoading}>\n                  {isLoading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n                  Cadastrar Consulta\n                </Button>\n              )}\n            </div>\n          </form>\n        )}\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\NewEspecialidadeDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\NewExameDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\NewExameProcedimentoDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\NewPatientDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\NewProcedimentoDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\NewProfessionalDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\NewServiceDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\NextDayPreview.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\PatientCombobox.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\ProfessionalCombobox.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\settings\\InviteMember.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\settings\\PendingInvitationsList.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\support\\SupportChatWidget.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'checkActiveTicket'. Either include it or remove the dependency array.","line":54,"column":8,"nodeType":"ArrayExpression","endLine":54,"endColumn":22,"suggestions":[{"desc":"Update the dependencies array to be: [checkActiveTicket, isOpen, user]","fix":{"range":[2079,2093],"text":"[checkActiveTicket, isOpen, user]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect, useRef } from 'react';\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { MessageCircle, X, Send, Loader2, User, Mail, Bot, Trash2 } from \"lucide-react\";\r\nimport { useAuth } from \"@/hooks/useAuth\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { toast } from \"sonner\";\r\n\r\ninterface Message {\r\n    id: string;\r\n    content: string;\r\n    sender: 'user' | 'agent' | 'system' | 'bot';\r\n    created_at: string;\r\n}\r\n\r\nexport function SupportChatWidget() {\r\n    const { user, profile } = useAuth();\r\n    const [isOpen, setIsOpen] = useState(false);\r\n    const [step, setStep] = useState<'initial' | 'chat'>('initial');\r\n    const [ticketId, setTicketId] = useState<string | null>(null);\r\n    const [messages, setMessages] = useState<Message[]>([]);\r\n    const [newMessage, setNewMessage] = useState('');\r\n    const [loading, setLoading] = useState(false);\r\n    const [isOnline, setIsOnline] = useState(true);\r\n    const [checkingStatus, setCheckingStatus] = useState(true);\r\n\r\n    // Guest form\r\n    const [guestName, setGuestName] = useState('');\r\n    const [guestEmail, setGuestEmail] = useState('');\r\n\r\n    const scrollRef = useRef<HTMLDivElement>(null);\r\n\r\n    useEffect(() => {\r\n        checkSupportStatus();\r\n        const interval = setInterval(checkSupportStatus, 60000); // Check every minute\r\n        return () => clearInterval(interval);\r\n    }, []);\r\n\r\n    useEffect(() => {\r\n        if (isOpen && user) {\r\n            setStep('chat');\r\n            // Optionally load active ticket for user\r\n            checkActiveTicket();\r\n        } else if (isOpen) {\r\n            // Check local storage for guest ticket\r\n            const savedTicket = localStorage.getItem('cleanflow_guest_ticket');\r\n            if (savedTicket) {\r\n                setTicketId(savedTicket);\r\n                setStep('chat');\r\n                loadMessages(savedTicket);\r\n            }\r\n        }\r\n    }, [isOpen, user]);\r\n\r\n    useEffect(() => {\r\n        if (scrollRef.current) {\r\n            scrollRef.current.scrollTop = scrollRef.current.scrollHeight;\r\n        }\r\n    }, [messages]);\r\n\r\n    const checkSupportStatus = async () => {\r\n        try {\r\n            const now = new Date();\r\n            const dayOfWeek = now.getDay(); // 0 = Sunday\r\n            const timeString = now.toTimeString().slice(0, 5); // HH:MM\r\n            const dateString = now.toISOString().split('T')[0]; // YYYY-MM-DD\r\n\r\n            // Check holidays\r\n            const { data: holiday } = await (supabase as any)\r\n                .from('support_holidays')\r\n                .select('id')\r\n                .eq('date', dateString)\r\n                .maybeSingle();\r\n\r\n            if (holiday) {\r\n                setIsOnline(false);\r\n                setCheckingStatus(false);\r\n                return;\r\n            }\r\n\r\n            // Check operating hours\r\n            const { data: hours } = await (supabase as any)\r\n                .from('support_operating_hours')\r\n                .select('*')\r\n                .eq('day_of_week', dayOfWeek)\r\n                .eq('is_active', true)\r\n                .maybeSingle();\r\n\r\n            if (hours) {\r\n                const start = hours.start_time.slice(0, 5);\r\n                const end = hours.end_time.slice(0, 5);\r\n                setIsOnline(timeString >= start && timeString <= end);\r\n            } else {\r\n                setIsOnline(false);\r\n            }\r\n        } catch (error) {\r\n            console.error('Error checking status:', error);\r\n            // Default to online if error to not block support\r\n            setIsOnline(true);\r\n        } finally {\r\n            setCheckingStatus(false);\r\n        }\r\n    };\r\n\r\n    const checkActiveTicket = async () => {\r\n        if (!user) return;\r\n        // Find most recent open ticket\r\n        const { data } = await supabase\r\n            .from('support_tickets')\r\n            .select('id')\r\n            .eq('user_id', user.id)\r\n            .neq('status', 'closed')\r\n            .neq('status', 'resolved')\r\n            .order('created_at', { ascending: false })\r\n            .limit(1)\r\n            .maybeSingle();\r\n\r\n        if (data) {\r\n            setTicketId(data.id);\r\n            loadMessages(data.id);\r\n        }\r\n    };\r\n\r\n    const loadMessages = async (tid: string) => {\r\n        const { data } = await supabase\r\n            .from('support_ticket_messages')\r\n            .select('*')\r\n            .eq('ticket_id', tid)\r\n            .order('created_at', { ascending: true });\r\n\r\n        if (data) {\r\n            setMessages(data.map((m: any) => ({\r\n                id: m.id,\r\n                content: m.mensagem,\r\n                sender: m.sender_type === 'agent' ? 'agent' : m.sender_type === 'bot' ? 'bot' : 'user',\r\n                created_at: m.created_at\r\n            })));\r\n        }\r\n    };\r\n\r\n    const handleStartChat = async (e: React.FormEvent) => {\r\n        e.preventDefault();\r\n        setLoading(true);\r\n\r\n        try {\r\n            let ticket;\r\n\r\n            if (user) {\r\n                // Logged in user - use direct insert\r\n                const { data, error } = await (supabase as any)\r\n                    .from('support_tickets')\r\n                    .insert({\r\n                        title: 'Chat Support',\r\n                        description: 'Chat started via widget',\r\n                        status: 'open',\r\n                        priority: 'medium',\r\n                        origem: 'widget',\r\n                        user_id: user.id,\r\n                        tenant_id: profile?.tenant_id || null\r\n                    })\r\n                    .select()\r\n                    .single();\r\n\r\n                if (error) throw error;\r\n                ticket = data;\r\n            } else {\r\n                // Guest - use RPC to bypass RLS select issues\r\n                const { data, error } = await supabase\r\n                    .rpc('create_guest_ticket', {\r\n                        p_name: guestName,\r\n                        p_email: guestEmail,\r\n                        p_title: 'Chat Support (Guest)',\r\n                        p_description: 'Chat started via widget'\r\n                    });\r\n\r\n                if (error) throw error;\r\n                // RPC returns jsonb, so we cast it\r\n                ticket = data as any;\r\n            }\r\n\r\n            setTicketId(ticket.id);\r\n            if (!user) {\r\n                localStorage.setItem('cleanflow_guest_ticket', ticket.id);\r\n            }\r\n\r\n            const protocol = ticket.id.slice(0, 8).toUpperCase();\r\n\r\n            const hour = new Date().getHours();\r\n            let greeting = 'Ol├í';\r\n            if (hour < 12) greeting = 'Bom dia';\r\n            else if (hour < 18) greeting = 'Boa tarde';\r\n            else greeting = 'Boa noite';\r\n\r\n            const welcomeMsg = isOnline\r\n                ? `${greeting}, ${user ? profile?.nome : guestName}! Sou o assistente virtual do CleanFlow. Seu protocolo de atendimento ├® #${protocol}. Como posso ajudar voc├¬ hoje?`\r\n                : `${greeting}, ${user ? profile?.nome : guestName}. Sou o assistente virtual do CleanFlow. Seu protocolo de atendimento ├® #${protocol}. Estamos fora do hor├írio de atendimento no momento, mas posso tentar tirar suas d├║vidas!`;\r\n\r\n            // Save welcome message to database\r\n            await supabase\r\n                .from('support_ticket_messages')\r\n                .insert({\r\n                    ticket_id: ticket.id,\r\n                    mensagem: welcomeMsg,\r\n                    sender_type: 'bot'\r\n                });\r\n\r\n            // Add welcome message to state\r\n            setMessages([{\r\n                id: 'welcome',\r\n                content: welcomeMsg,\r\n                sender: 'bot',\r\n                created_at: new Date().toISOString()\r\n            }]);\r\n\r\n            setStep('chat');\r\n        } catch (error) {\r\n            console.error(error);\r\n            toast.error('Erro ao iniciar chat');\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const handleSendMessage = async (e: React.FormEvent) => {\r\n        e.preventDefault();\r\n        if (!newMessage.trim() || !ticketId) return;\r\n\r\n        const msgContent = newMessage;\r\n        setNewMessage('');\r\n\r\n        // Optimistic update\r\n        const tempId = Math.random().toString();\r\n        setMessages(prev => [...prev, {\r\n            id: tempId,\r\n            content: msgContent,\r\n            sender: 'user',\r\n            created_at: new Date().toISOString()\r\n        }]);\r\n\r\n        try {\r\n            // Save user message\r\n            await supabase\r\n                .from('support_ticket_messages')\r\n                .insert({\r\n                    ticket_id: ticketId,\r\n                    mensagem: msgContent,\r\n                    user_id: user?.id || null,\r\n                    sender_type: 'user'\r\n                });\r\n\r\n            // Try bot response\r\n            const { data: botResponse } = await (supabase as any)\r\n                .rpc('search_knowledge_base', { search_query: msgContent });\r\n\r\n            const threshold = 0.6; // Stricter threshold\r\n\r\n            if (botResponse && botResponse.length > 0 && botResponse[0].similarity > threshold) {\r\n                const answer = botResponse[0].answer;\r\n\r\n                // Add bot delay for realism\r\n                setTimeout(async () => {\r\n                    setMessages(prev => [...prev, {\r\n                        id: Math.random().toString(),\r\n                        content: answer,\r\n                        sender: 'bot',\r\n                        created_at: new Date().toISOString()\r\n                    }]);\r\n\r\n                    await supabase\r\n                        .from('support_ticket_messages')\r\n                        .insert({\r\n                            ticket_id: ticketId,\r\n                            mensagem: answer,\r\n                            sender_type: 'bot'\r\n                        });\r\n                }, 1000);\r\n            } else {\r\n                // Fallback: Bot doesn't know\r\n                // 1. Log for training\r\n                await (supabase as any).rpc('log_unanswered_question', {\r\n                    p_question: msgContent,\r\n                    p_ticket_id: ticketId\r\n                });\r\n\r\n                const fallbackMsg = \"Desculpe, n├úo consegui encontrar uma resposta precisa para sua d├║vida. \\n\\nO assunto exige interven├º├úo humana. Um ticket de atendimento foi aberto e nossa equipe de suporte retornar├í via e-mail em breve.\";\r\n                const followUpMsg = \"Agradecemos pelo contato! Continuo ├á disposi├º├úo caso precise de ajuda com outros assuntos.\";\r\n\r\n                setTimeout(async () => {\r\n                    // First message\r\n                    setMessages(prev => [...prev, {\r\n                        id: Math.random().toString(),\r\n                        content: fallbackMsg,\r\n                        sender: 'bot',\r\n                        created_at: new Date().toISOString()\r\n                    }]);\r\n\r\n                    await supabase\r\n                        .from('support_ticket_messages')\r\n                        .insert({\r\n                            ticket_id: ticketId,\r\n                            mensagem: fallbackMsg,\r\n                            sender_type: 'bot'\r\n                        });\r\n\r\n                    // Second message (Follow up)\r\n                    setTimeout(async () => {\r\n                        setMessages(prev => [...prev, {\r\n                            id: Math.random().toString(),\r\n                            content: followUpMsg,\r\n                            sender: 'bot',\r\n                            created_at: new Date().toISOString()\r\n                        }]);\r\n\r\n                        await supabase\r\n                            .from('support_ticket_messages')\r\n                            .insert({\r\n                                ticket_id: ticketId,\r\n                                mensagem: followUpMsg,\r\n                                sender_type: 'bot'\r\n                            });\r\n                    }, 1500);\r\n\r\n                }, 1000);\r\n            }\r\n\r\n        } catch (error) {\r\n            console.error(error);\r\n            toast.error('Erro ao enviar mensagem');\r\n        }\r\n    };\r\n\r\n    const handleReset = () => {\r\n        setTicketId(null);\r\n        setMessages([]);\r\n        setStep('initial');\r\n        localStorage.removeItem('cleanflow_guest_ticket');\r\n    };\r\n\r\n    return (\r\n        <div className=\"fixed bottom-6 right-6 z-[100] flex flex-col items-end gap-4\">\r\n            {isOpen && (\r\n                <Card className=\"w-[350px] h-[500px] shadow-2xl border-blue-500/20 flex flex-col overflow-hidden animate-in slide-in-from-bottom-10 fade-in duration-300\">\r\n                    <CardHeader className={`p-4 shrink-0 flex flex-row items-center justify-between transition-colors ${isOnline ? 'bg-gradient-to-r from-blue-600 to-cyan-600' : 'bg-slate-700'\r\n                        } text-white`}>\r\n                        <div>\r\n                            <CardTitle className=\"text-base flex items-center gap-2\">\r\n                                <MessageCircle className=\"h-5 w-5\" />\r\n                                Suporte CleanFlow\r\n                            </CardTitle>\r\n                            <div className=\"flex items-center gap-2 mt-1\">\r\n                                <span className={`w-2 h-2 rounded-full ${isOnline ? 'bg-green-400 animate-pulse' : 'bg-red-400'}`} />\r\n                                <p className=\"text-xs text-blue-100 opacity-90\">\r\n                                    {checkingStatus ? 'Verificando...' : isOnline ? 'Online agora' : 'Fora do hor├írio'}\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"flex gap-1\">\r\n                            {step === 'chat' && (\r\n                                <Button variant=\"ghost\" size=\"icon\" className=\"text-white hover:bg-white/20 h-8 w-8\" onClick={handleReset} title=\"Nova Conversa\">\r\n                                    <Trash2 className=\"h-4 w-4\" />\r\n                                </Button>\r\n                            )}\r\n                            <Button variant=\"ghost\" size=\"icon\" className=\"text-white hover:bg-white/20 h-8 w-8\" onClick={() => setIsOpen(false)}>\r\n                                <X className=\"h-4 w-4\" />\r\n                            </Button>\r\n                        </div>\r\n                    </CardHeader>\r\n\r\n                    <CardContent className=\"flex-1 p-0 flex flex-col overflow-hidden bg-slate-50 dark:bg-slate-900\">\r\n                        {step === 'initial' ? (\r\n                            <div className=\"p-6 flex flex-col h-full justify-center space-y-6\">\r\n                                <div className=\"text-center space-y-2\">\r\n                                    <div className=\"w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center mx-auto text-blue-600\">\r\n                                        <MessageCircle className=\"h-6 w-6\" />\r\n                                    </div>\r\n                                    <h3 className=\"font-semibold\">Ol├í! Como podemos te chamar?</h3>\r\n                                    <p className=\"text-sm text-muted-foreground\">Preencha seus dados para iniciarmos o atendimento.</p>\r\n                                </div>\r\n\r\n                                <form onSubmit={handleStartChat} className=\"space-y-4\">\r\n                                    <div className=\"space-y-2\">\r\n                                        <div className=\"relative\">\r\n                                            <User className=\"absolute left-3 top-3 h-4 w-4 text-muted-foreground\" />\r\n                                            <Input\r\n                                                placeholder=\"Seu nome\"\r\n                                                className=\"pl-9\"\r\n                                                value={guestName}\r\n                                                onChange={e => setGuestName(e.target.value)}\r\n                                                required\r\n                                            />\r\n                                        </div>\r\n                                        <div className=\"relative\">\r\n                                            <Mail className=\"absolute left-3 top-3 h-4 w-4 text-muted-foreground\" />\r\n                                            <Input\r\n                                                type=\"email\"\r\n                                                placeholder=\"Seu e-mail\"\r\n                                                className=\"pl-9\"\r\n                                                value={guestEmail}\r\n                                                onChange={e => setGuestEmail(e.target.value)}\r\n                                                required\r\n                                            />\r\n                                        </div>\r\n                                    </div>\r\n                                    <Button type=\"submit\" className=\"w-full bg-blue-600 hover:bg-blue-700\" disabled={loading}>\r\n                                        {loading ? <Loader2 className=\"h-4 w-4 animate-spin\" /> : 'Iniciar Chat'}\r\n                                    </Button>\r\n                                </form>\r\n                            </div>\r\n                        ) : (\r\n                            <>\r\n                                <div className=\"flex-1 overflow-y-auto p-4 space-y-4\" ref={scrollRef}>\r\n          