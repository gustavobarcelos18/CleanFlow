array to be: [fetchPatients]","fix":{"range":[1982,1984],"text":"[fetchPatients]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\r\nimport React, { useState, useEffect } from \"react\";\r\nimport { MainLayout } from \"@/components/layout/MainLayout\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport {\r\n  Plus,\r\n  Search,\r\n  Filter,\r\n  Phone,\r\n  Mail,\r\n  MessageSquare,\r\n  AlertTriangle,\r\n  User,\r\n  Loader2,\r\n  Trash2\r\n} from \"lucide-react\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { NewPatientDialog } from \"@/components/schedule/NewPatientDialog\";\r\nimport { EditPatientDialog } from \"@/components/schedule/EditPatientDialog\";\r\nimport { VincularPacoteDialog } from \"@/components/pacotes/VincularPacoteDialog\";\r\nimport { useToast } from \"@/hooks/use-toast\";\r\nimport { useTerminology } from \"@/stores/useSegmentStore\";\r\n\r\ninterface Patient {\r\n  id: string;\r\n  nome: string;\r\n  telefone: string;\r\n  email: string | null;\r\n  preferencia_contato: \"whatsapp\" | \"sms\" | \"email\";\r\n  historico_faltas: number;\r\n  risco_no_show: number;\r\n  created_at: string;\r\n}\r\n\r\nconst Pacientes = () => {\r\n  const t = useTerminology();\r\n  const [patients, setPatients] = useState<Patient[]>([]);\r\n  const [isLoading, setIsLoading] = useState(true);\r\n  const [searchTerm, setSearchTerm] = useState(\"\");\r\n  const [editingId, setEditingId] = useState<string | null>(null);\r\n  const { toast } = useToast();\r\n\r\n  const fetchPatients = async () => {\r\n    try {\r\n      setIsLoading(true);\r\n      const { data, error } = await supabase\r\n        .from('pacientes')\r\n        .select('*')\r\n        .order('nome');\r\n\r\n      if (error) throw error;\r\n      setPatients(data || []);\r\n    } catch (error) {\r\n      console.error('Erro ao buscar pacientes:', error);\r\n      toast({\r\n        title: \"Erro\",\r\n        description: \"N├úo foi poss├¡vel carregar os pacientes.\",\r\n        variant: \"destructive\"\r\n      });\r\n    } finally {\r\n      setIsLoading(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    fetchPatients();\r\n  }, []);\r\n\r\n  const getRiskLevel = (risco: number): \"low\" | \"medium\" | \"high\" => {\r\n    if (risco <= 30) return \"low\";\r\n    if (risco <= 70) return \"medium\";\r\n    return \"high\";\r\n  };\r\n\r\n  const getRiskBadge = (level: \"low\" | \"medium\" | \"high\") => {\r\n    const config = {\r\n      low: { label: \"Baixo\", variant: \"default\" as const, color: \"text-success\" },\r\n      medium: { label: \"M├®dio\", variant: \"secondary\" as const, color: \"text-warning\" },\r\n      high: { label: \"Alto\", variant: \"destructive\" as const, color: \"text-destructive\" }\r\n    };\r\n    return config[level as keyof typeof config];\r\n  };\r\n\r\n  const filteredPatients = patients.filter(p =>\r\n    p.nome.toLowerCase().includes(searchTerm.toLowerCase()) ||\r\n    p.telefone.includes(searchTerm) ||\r\n    (p.email && p.email.toLowerCase().includes(searchTerm.toLowerCase()))\r\n  );\r\n\r\n  return (\r\n    <MainLayout>\r\n      <div className=\"space-y-6\">\r\n        <div className=\"flex items-center justify-between\">\r\n          <div>\r\n            <h1 className=\"text-3xl font-bold text-foreground\">{t.client_label}s</h1>\r\n            <p className=\"text-muted-foreground\">\r\n              Gerenciar cadastro e hist├│rico de {t.client_label.toLowerCase()}s ({patients.length})\r\n            </p>\r\n          </div>\r\n          <NewPatientDialog onSuccess={() => fetchPatients()} />\r\n        </div>\r\n\r\n        <div className=\"flex gap-3\">\r\n          <div className=\"relative flex-1\">\r\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground\" />\r\n            <Input\r\n              placeholder={`Buscar por nome, telefone ou e-mail...`}\r\n              value={searchTerm}\r\n              onChange={(e) => setSearchTerm(e.target.value)}\r\n              className=\"pl-10\"\r\n            />\r\n          </div>\r\n        </div>\r\n\r\n        {isLoading ? (\r\n          <div className=\"flex items-center justify-center py-12\">\r\n            <Loader2 className=\"h-8 w-8 animate-spin text-primary\" />\r\n          </div>\r\n        ) : filteredPatients.length === 0 ? (\r\n          <div className=\"text-center py-12\">\r\n            <User className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\r\n            <h3 className=\"text-lg font-semibold mb-2\">\r\n              {searchTerm ? `Nenhum ${t.client_label.toLowerCase()} encontrado` : `Nenhum ${t.client_label.toLowerCase()} cadastrado`}\r\n            </h3>\r\n            <p className=\"text-muted-foreground mb-4\">\r\n              {searchTerm ? \"Tente uma busca diferente\" : `Comece adicionando seu primeiro ${t.client_label.toLowerCase()}`}\r\n            </p>\r\n          </div>\r\n        ) : (\r\n          <div className=\"grid gap-4\">\r\n            {filteredPatients.map((patient) => {\r\n              const riskLevel = getRiskLevel(patient.risco_no_show);\r\n              const riskConfig = getRiskBadge(riskLevel);\r\n\r\n              return (\r\n                <div key={patient.id} className=\"p-6 bg-card border border-border rounded-lg hover:bg-card-hover transition-colors\">\r\n                  <div className=\"flex items-start justify-between mb-4\">\r\n                    <div className=\"flex items-center gap-4\">\r\n                      <div className=\"p-3 bg-primary-light rounded-full\">\r\n                        <User className=\"h-6 w-6 text-primary\" />\r\n                      </div>\r\n                      <div>\r\n                        <h3 className=\"text-lg font-semibold text-foreground\">{patient.nome}</h3>\r\n                        <p className=\"text-sm text-muted-foreground\">\r\n                          Cadastrado em {new Date(patient.created_at).toLocaleDateString('pt-BR')}\r\n                        </p>\r\n                      </div>\r\n                    </div>\r\n                    <div className=\"flex items-center gap-2\">\r\n                      <Badge variant={riskConfig.variant}>\r\n                        <AlertTriangle className=\"h-3 w-3 mr-1\" />\r\n                        Risco {riskConfig.label}\r\n                      </Badge>\r\n                      {patient.historico_faltas > 0 && (\r\n                        <Badge variant=\"destructive\">\r\n                          {patient.historico_faltas} faltas\r\n                        </Badge>\r\n                      )}\r\n                    </div>\r\n                  </div>\r\n\r\n                  <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-4\">\r\n                    <div className=\"flex items-center gap-2\">\r\n                      <Phone className=\"h-4 w-4 text-muted-foreground\" />\r\n                      <span className=\"text-sm\">{patient.telefone}</span>\r\n                    </div>\r\n                    <div className=\"flex items-center gap-2\">\r\n                      <Mail className=\"h-4 w-4 text-muted-foreground\" />\r\n                      <span className=\"text-sm\">{patient.email || \"N├úo informado\"}</span>\r\n                    </div>\r\n                    <div className=\"flex items-center gap-2\">\r\n                      <MessageSquare className=\"h-4 w-4 text-muted-foreground\" />\r\n                      <span className=\"text-sm capitalize\">Prefere {patient.preferencia_contato}</span>\r\n                    </div>\r\n                  </div>\r\n\r\n                  <div className=\"flex gap-2 flex-wrap\">\r\n                    <Button\r\n                      size=\"sm\"\r\n                      variant=\"outline\"\r\n                      onClick={() => setEditingId(patient.id)}\r\n                    >\r\n                      Editar\r\n                    </Button>\r\n                    <VincularPacoteDialog\r\n                      pacienteId={patient.id}\r\n                      pacienteNome={patient.nome}\r\n                      onSuccess={() => fetchPatients()}\r\n                    />\r\n                    <Button\r\n                      size=\"sm\"\r\n                      variant=\"outline\"\r\n                      onClick={async () => {\r\n                        const { validatePacienteDelete } = await import('@/lib/deleteValidation');\r\n                        const validation = await validatePacienteDelete(patient.id);\r\n\r\n                        if (!validation.canDelete) {\r\n                          toast({\r\n                            title: \"N├úo ├® poss├¡vel excluir\",\r\n                            description: validation.message,\r\n                            variant: \"destructive\",\r\n                            duration: 10000\r\n                          });\r\n                          return;\r\n                        }\r\n\r\n                        if (!confirm(`Tem certeza que deseja excluir o ${t.client_label.toLowerCase()} ${patient.nome}?`)) return;\r\n\r\n                        try {\r\n                          const { error } = await supabase\r\n                            .from('pacientes')\r\n                            .delete()\r\n                            .eq('id', patient.id);\r\n\r\n                          if (error) throw error;\r\n\r\n                          setPatients(prev => prev.filter(p => p.id !== patient.id));\r\n\r\n                          toast({\r\n                            title: `${t.client_label} exclu├¡do`,\r\n                            description: `O ${t.client_label.toLowerCase()} foi removido com sucesso.`\r\n                          });\r\n                        } catch (error) {\r\n                          console.error('Erro ao excluir:', error);\r\n                          toast({\r\n                            title: \"Erro\",\r\n                            description: `N├úo foi poss├¡vel excluir o ${t.client_label.toLowerCase()}.`,\r\n                            variant: \"destructive\"\r\n                          });\r\n                        }\r\n                      }}\r\n                      className=\"text-destructive hover:text-destructive\"\r\n                    >\r\n                      <Trash2 className=\"h-4 w-4 mr-2\" />\r\n                      Excluir\r\n                    </Button>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })}\r\n          </div>\r\n        )}\r\n      </div>\r\n\r\n      {editingId && (\r\n        <EditPatientDialog\r\n          patientId={editingId}\r\n          open={!!editingId}\r\n          onOpenChange={(open) => !open && setEditingId(null)}\r\n          onSuccess={() => fetchPatients()}\r\n        />\r\n      )}\r\n    </MainLayout>\r\n  );\r\n};\r\n\r\nexport default Pacientes;","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Pacotes.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchPacotes'. Either include it or remove the dependency array.","line":68,"column":6,"nodeType":"ArrayExpression","endLine":68,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [fetchPacotes]","fix":{"range":[1913,1915],"text":"[fetchPacotes]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { MainLayout } from \"@/components/layout/MainLayout\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card } from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { Input } from \"@/components/ui/input\";\nimport { \n  Edit, \n  Trash2, \n  Package,\n  Loader2,\n  DollarSign,\n  Calendar as CalendarIcon,\n  Users,\n  Search\n} from \"lucide-react\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { NewPacoteDialog } from \"@/components/pacotes/NewPacoteDialog\";\nimport { EditPacoteDialog } from \"@/components/pacotes/EditPacoteDialog\";\n\ninterface Pacote {\n  id: string;\n  nome: string;\n  descricao: string | null;\n  numero_sessoes: number;\n  preco: number;\n  validade_dias: number;\n  renovacao_automatica: boolean;\n  desconto_renovacao: number;\n  ativo: boolean;\n  servico_id: string | null;\n  procedimentos?: { nome: string };\n}\n\nconst Pacotes = () => {\n  const [pacotes, setPacotes] = useState<Pacote[]>([]);\n  const [isLoading, setIsLoading] = useState(true);\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [editingId, setEditingId] = useState<string | null>(null);\n  const { toast } = useToast();\n\n  const fetchPacotes = async () => {\n    try {\n      setIsLoading(true);\n      const { data, error } = await supabase\n        .from('pacotes')\n        .select('*, procedimentos:servico_id(nome)')\n        .order('nome');\n\n      if (error) throw error;\n      setPacotes(data || []);\n    } catch (error) {\n      console.error('Erro ao buscar pacotes:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os pacotes.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchPacotes();\n  }, []);\n\n  const togglePacoteStatus = async (pacoteId: string, currentStatus: boolean) => {\n    try {\n      const { error } = await supabase\n        .from('pacotes')\n        .update({ ativo: !currentStatus })\n        .eq('id', pacoteId);\n\n      if (error) throw error;\n\n      setPacotes(prev => prev.map(pacote => \n        pacote.id === pacoteId \n          ? { ...pacote, ativo: !currentStatus }\n          : pacote\n      ));\n\n      toast({\n        title: \"Status atualizado\",\n        description: `Pacote ${!currentStatus ? \"ativado\" : \"desativado\"} com sucesso.`\n      });\n    } catch (error) {\n      console.error('Erro ao atualizar status:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel atualizar o status do pacote.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const deletePacote = async (pacoteId: string) => {\n    // Importar valida├º├úo\n    const { validatePacoteDelete } = await import('@/lib/deleteValidation');\n    \n    // Validar antes de excluir\n    const validation = await validatePacoteDelete(pacoteId);\n    \n    if (!validation.canDelete) {\n      toast({\n        title: \"N├úo ├® poss├¡vel excluir\",\n        description: validation.message,\n        variant: \"destructive\",\n        duration: 10000\n      });\n      return;\n    }\n\n    if (!confirm(\"Tem certeza que deseja excluir este pacote? Esta a├º├úo n├úo pode ser desfeita.\")) return;\n\n    try {\n      const { error } = await supabase\n        .from('pacotes')\n        .delete()\n        .eq('id', pacoteId);\n\n      if (error) throw error;\n\n      setPacotes(prev => prev.filter(pacote => pacote.id !== pacoteId));\n      \n      toast({\n        title: \"Pacote exclu├¡do\",\n        description: \"O pacote foi removido com sucesso.\"\n      });\n    } catch (error) {\n      console.error('Erro ao excluir pacote:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel excluir o pacote.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const filteredPacotes = pacotes.filter(p => \n    p.nome.toLowerCase().includes(searchTerm.toLowerCase()) ||\n    (p.descricao && p.descricao.toLowerCase().includes(searchTerm.toLowerCase()))\n  );\n\n  const activePacotes = filteredPacotes.filter(p => p.ativo);\n  const totalRevenue = filteredPacotes.reduce((acc, p) => acc + p.preco, 0);\n\n  return (\n    <MainLayout>\n      <div className=\"space-y-6\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h1 className=\"text-3xl font-bold text-foreground\">Pacotes de Tratamentos</h1>\n            <p className=\"text-muted-foreground\">\n              Gerencie pacotes de sess├Áes para tratamentos est├®ticos e de beleza ({pacotes.length})\n            </p>\n          </div>\n          {!isLoading && pacotes.length > 0 && (\n            <NewPacoteDialog onSuccess={() => fetchPacotes()} />\n          )}\n        </div>\n\n        <div className=\"relative\">\n          <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground\" />\n          <Input\n            placeholder=\"Buscar pacotes...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"pl-10\"\n          />\n        </div>\n\n        {/* Estat├¡sticas dos Pacotes */}\n        {!isLoading && filteredPacotes.length > 0 && (\n          <Card className=\"p-6\">\n            <h3 className=\"text-lg font-semibold mb-4\">Estat├¡sticas dos Pacotes</h3>\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n              <div className=\"text-center\">\n                <p className=\"text-2xl font-bold text-primary\">{activePacotes.length}</p>\n                <p className=\"text-sm text-muted-foreground\">Pacotes Ativos</p>\n              </div>\n              <div className=\"text-center\">\n                <p className=\"text-2xl font-bold text-success\">R$ {totalRevenue.toFixed(0)}</p>\n                <p className=\"text-sm text-muted-foreground\">Receita Total</p>\n              </div>\n              <div className=\"text-center\">\n                <p className=\"text-2xl font-bold text-muted-foreground\">{pacotes.length}</p>\n                <p className=\"text-sm text-muted-foreground\">Total de Pacotes</p>\n              </div>\n            </div>\n          </Card>\n        )}\n\n        {/* Lista de Pacotes */}\n        {isLoading ? (\n          <div className=\"flex items-center justify-center py-12\">\n            <Loader2 className=\"h-8 w-8 animate-spin text-primary\" />\n          </div>\n        ) : filteredPacotes.length === 0 ? (\n          <div className=\"text-center py-12\">\n            <Package className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n            <h3 className=\"text-lg font-semibold mb-2\">\n              {searchTerm ? \"Nenhum pacote encontrado\" : \"Nenhum pacote cadastrado\"}\n            </h3>\n            <p className=\"text-muted-foreground mb-4\">\n              {searchTerm ? \"Tente uma busca diferente\" : \"Crie pacotes de tratamentos para oferecer aos seus clientes\"}\n            </p>\n            {!searchTerm && <NewPacoteDialog onSuccess={() => fetchPacotes()} />}\n          </div>\n        ) : (\n          <div className=\"grid gap-4\">\n            {filteredPacotes.map((pacote) => (\n              <Card key={pacote.id} className=\"p-6\">\n                <div className=\"flex items-start justify-between mb-4\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"p-2 bg-primary-light rounded-lg\">\n                      <Package className=\"h-5 w-5 text-primary\" />\n                    </div>\n                    <div>\n                      <h3 className=\"text-lg font-semibold text-foreground\">{pacote.nome}</h3>\n                      {pacote.descricao && (\n                        <p className=\"text-sm text-muted-foreground mt-1\">{pacote.descricao}</p>\n                      )}\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <Badge variant={pacote.ativo ? \"default\" : \"secondary\"}>\n                      {pacote.ativo ? \"Ativo\" : \"Inativo\"}\n                    </Badge>\n                    <Switch\n                      checked={pacote.ativo}\n                      onCheckedChange={() => togglePacoteStatus(pacote.id, pacote.ativo)}\n                    />\n                  </div>\n                </div>\n\n                <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 mb-4\">\n                  <div>\n                    <p className=\"text-xs text-muted-foreground mb-1\">Sess├Áes</p>\n                    <div className=\"flex items-center gap-2\">\n                      <Users className=\"h-4 w-4 text-primary\" />\n                      <span className=\"text-sm font-medium\">{pacote.numero_sessoes} sess├Áes</span>\n                    </div>\n                  </div>\n                  <div>\n                    <p className=\"text-xs text-muted-foreground mb-1\">Pre├ºo</p>\n                    <div className=\"flex items-center gap-2\">\n                      <DollarSign className=\"h-4 w-4 text-success\" />\n                      <span className=\"text-sm font-medium\">R$ {pacote.preco.toFixed(2)}</span>\n                    </div>\n                  </div>\n                  <div>\n                    <p className=\"text-xs text-muted-foreground mb-1\">Validade</p>\n                    <div className=\"flex items-center gap-2\">\n                      <CalendarIcon className=\"h-4 w-4 text-warning\" />\n                      <span className=\"text-sm font-medium\">{pacote.validade_dias} dias</span>\n                    </div>\n                  </div>\n                  {pacote.renovacao_automatica && (\n                    <div>\n                      <p className=\"text-xs text-muted-foreground mb-1\">Renova├º├úo</p>\n                      <Badge variant=\"outline\" className=\"text-xs\">\n                        Autom├ítica {pacote.desconto_renovacao > 0 && `(-${pacote.desconto_renovacao}%)`}\n                      </Badge>\n                    </div>\n                  )}\n                </div>\n\n                {pacote.procedimentos && (\n                  <div className=\"mb-4\">\n                    <p className=\"text-xs text-muted-foreground mb-1\">Procedimento vinculado</p>\n                    <Badge variant=\"secondary\">{pacote.procedimentos.nome}</Badge>\n                  </div>\n                )}\n\n                <div className=\"flex gap-2\">\n                  <Button \n                    size=\"sm\" \n                    variant=\"outline\"\n                    onClick={() => setEditingId(pacote.id)}\n                  >\n                    <Edit className=\"h-4 w-4 mr-2\" />\n                    Editar\n                  </Button>\n                  <Button\n                    size=\"sm\" \n                    variant=\"outline\" \n                    onClick={() => deletePacote(pacote.id)}\n                    className=\"text-destructive hover:text-destructive\"\n                  >\n                    <Trash2 className=\"h-4 w-4 mr-2\" />\n                    Excluir\n                  </Button>\n                </div>\n              </Card>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {editingId && (\n        <EditPacoteDialog\n          pacoteId={editingId}\n          open={!!editingId}\n          onOpenChange={(open) => !open && setEditingId(null)}\n          onSuccess={() => fetchPacotes()}\n        />\n      )}\n    </MainLayout>\n  );\n};\n\nexport default Pacotes;","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\PatientLogin.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\PatientPortal.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"m