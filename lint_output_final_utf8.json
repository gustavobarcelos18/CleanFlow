n                      onChange={(e) => setFilterAlerta({ ...filterAlerta, search: e.target.value })}\r\n                      className=\"pl-10\"\r\n                    />\r\n                  </div>\r\n                  <Input\r\n                    placeholder=\"Filtrar por tipo...\"\r\n                    value={filterAlerta.tipo}\r\n                    onChange={(e) => setFilterAlerta({ ...filterAlerta, tipo: e.target.value })}\r\n                  />\r\n                  <select\r\n                    className=\"flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm\"\r\n                    value={filterAlerta.prioridade}\r\n                    onChange={(e) => setFilterAlerta({ ...filterAlerta, prioridade: e.target.value })}\r\n                  >\r\n                    <option value=\"\">Todas prioridades</option>\r\n                    <option value=\"baixa\">Baixa</option>\r\n                    <option value=\"media\">M├®dia</option>\r\n                    <option value=\"alta\">Alta</option>\r\n                    <option value=\"critica\">Cr├¡tica</option>\r\n                  </select>\r\n                </div>\r\n                <div className=\"rounded-md border\">\r\n                  <Table>\r\n                    <TableHeader>\r\n                      <TableRow>\r\n                        <TableHead>Data</TableHead>\r\n                        <TableHead>Tipo</TableHead>\r\n                        <TableHead>T├¡tulo</TableHead>\r\n                        <TableHead>Paciente</TableHead>\r\n                        <TableHead>Prioridade</TableHead>\r\n                        <TableHead>Status</TableHead>\r\n                      </TableRow>\r\n                    </TableHeader>\r\n                    <TableBody>\r\n                      {alertas.filter(a => {\r\n                        const matchSearch = !filterAlerta.search || a.titulo?.toLowerCase().includes(filterAlerta.search.toLowerCase()) || a.pacientes?.nome?.toLowerCase().includes(filterAlerta.search.toLowerCase());\r\n                        const matchTipo = !filterAlerta.tipo || a.tipo === filterAlerta.tipo;\r\n                        const matchPrioridade = !filterAlerta.prioridade || a.prioridade === filterAlerta.prioridade;\r\n                        return matchSearch && matchTipo && matchPrioridade;\r\n                      }).map((alerta) => (\r\n                        <TableRow key={alerta.id}>\r\n                          <TableCell>\r\n                            {format(new Date(alerta.created_at), \"dd/MM/yyyy HH:mm\", { locale: ptBR })}\r\n                          </TableCell>\r\n                          <TableCell>\r\n                            <Badge variant=\"outline\">{alerta.tipo}</Badge>\r\n                          </TableCell>\r\n                          <TableCell>{alerta.titulo}</TableCell>\r\n                          <TableCell>{alerta.pacientes?.nome || '-'}</TableCell>\r\n                          <TableCell>{getPrioridadeBadge(alerta.prioridade)}</TableCell>\r\n                          <TableCell>\r\n                            {alerta.resolvido ? (\r\n                              <Badge variant=\"success\">Resolvido</Badge>\r\n                            ) : (\r\n                              <Badge variant=\"warning\">Pendente</Badge>\r\n                            )}\r\n                          </TableCell>\r\n                        </TableRow>\r\n                      ))}\r\n                    </TableBody>\r\n                  </Table>\r\n                </div>\r\n              </CardContent>\r\n            </Card>\r\n          </TabsContent>\r\n\r\n          {/* Relat├│rio de Mensagens */}\r\n          <TabsContent value=\"mensagens\">\r\n            <Card>\r\n              <CardHeader>\r\n                <div className=\"flex items-center justify-between\">\r\n                  <div>\r\n                    <CardTitle>Relat├│rio de Mensagens</CardTitle>\r\n                    <CardDescription>\r\n                      {mensagens.filter(m => {\r\n                        const matchSearch = !filterMensagem.search || m.destinatario?.toLowerCase().includes(filterMensagem.search.toLowerCase());\r\n                        const matchCanal = !filterMensagem.canal || m.canal === filterMensagem.canal;\r\n                        const matchStatus = !filterMensagem.status || m.status === filterMensagem.status;\r\n                        return matchSearch && matchCanal && matchStatus;\r\n                      }).length} mensagens encontradas\r\n                    </CardDescription>\r\n                  </div>\r\n                  <div className=\"flex gap-2\">\r\n                    <Button onClick={() => exportToCSV(\r\n                      mensagens.filter(m => {\r\n                        const matchSearch = !filterMensagem.search || m.destinatario?.toLowerCase().includes(filterMensagem.search.toLowerCase());\r\n                        const matchCanal = !filterMensagem.canal || m.canal === filterMensagem.canal;\r\n                        const matchStatus = !filterMensagem.status || m.status === filterMensagem.status;\r\n                        return matchSearch && matchCanal && matchStatus;\r\n                      }), 'mensagens')}>\r\n                      <Download className=\"h-4 w-4 mr-2\" />\r\n                      Exportar CSV\r\n                    </Button>\r\n                    <Button variant=\"destructive\" onClick={() => exportToPDF(\r\n                      mensagens.filter(m => {\r\n                        const matchSearch = !filterMensagem.search || m.destinatario?.toLowerCase().includes(filterMensagem.search.toLowerCase());\r\n                        const matchCanal = !filterMensagem.canal || m.canal === filterMensagem.canal;\r\n                        const matchStatus = !filterMensagem.status || m.status === filterMensagem.status;\r\n                        return matchSearch && matchCanal && matchStatus;\r\n                      }).map(m => ({\r\n                        data: format(new Date(m.created_at), \"dd/MM/yyyy HH:mm\", { locale: ptBR }),\r\n                        canal: m.canal,\r\n                        destinatario: m.destinatario,\r\n                        status: m.status,\r\n                        template: m.template_usado || '-'\r\n                      })),\r\n                      'mensagens',\r\n                      ['data', 'canal', 'destinatario', 'status', 'template'],\r\n                      ['Data', 'Canal', 'Destinat├írio', 'Status', 'Template']\r\n                    )}>\r\n                      <FileDown className=\"h-4 w-4 mr-2\" />\r\n                      Exportar PDF\r\n                    </Button>\r\n                  </div>\r\n                </div>\r\n              </CardHeader>\r\n              <CardContent>\r\n                <div className=\"mb-4 grid grid-cols-1 md:grid-cols-3 gap-4\">\r\n                  <div className=\"relative\">\r\n                    <Search className=\"absolute left-3 top-3 h-4 w-4 text-muted-foreground\" />\r\n                    <Input\r\n                      placeholder=\"Buscar destinat├írio...\"\r\n                      value={filterMensagem.search}\r\n                      onChange={(e) => setFilterMensagem({ ...filterMensagem, search: e.target.value })}\r\n                      className=\"pl-10\"\r\n                    />\r\n                  </div>\r\n                  <select\r\n                    className=\"flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm\"\r\n                    value={filterMensagem.canal}\r\n                    onChange={(e) => setFilterMensagem({ ...filterMensagem, canal: e.target.value })}\r\n                  >\r\n                    <option value=\"\">Todos canais</option>\r\n                    <option value=\"whatsapp\">WhatsApp</option>\r\n                    <option value=\"sms\">SMS</option>\r\n                    <option value=\"email\">Email</option>\r\n                  </select>\r\n                  <select\r\n                    className=\"flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm\"\r\n                    value={filterMensagem.status}\r\n                    onChange={(e) => setFilterMensagem({ ...filterMensagem, status: e.target.value })}\r\n                  >\r\n                    <option value=\"\">Todos status</option>\r\n                    <option value=\"enviado\">Enviado</option>\r\n                    <option value=\"pendente\">Pendente</option>\r\n                    <option value=\"falhou\">Falhou</option>\r\n                  </select>\r\n                </div>\r\n                <div className=\"rounded-md border\">\r\n                  <Table>\r\n                    <TableHeader>\r\n                      <TableRow>\r\n                        <TableHead>Data</TableHead>\r\n                        <TableHead>Canal</TableHead>\r\n                        <TableHead>Destinat├írio</TableHead>\r\n                        <TableHead>Status</TableHead>\r\n                        <TableHead>Template</TableHead>\r\n                      </TableRow>\r\n                    </TableHeader>\r\n                    <TableBody>\r\n                      {mensagens.filter(m => {\r\n                        const matchSearch = !filterMensagem.search || m.destinatario?.toLowerCase().includes(filterMensagem.search.toLowerCase());\r\n                        const matchCanal = !filterMensagem.canal || m.canal === filterMensagem.canal;\r\n                        const matchStatus = !filterMensagem.status || m.status === filterMensagem.status;\r\n                        return matchSearch && matchCanal && matchStatus;\r\n                      }).map((msg) => (\r\n                        <TableRow key={msg.id}>\r\n                          <TableCell>\r\n                            {format(new Date(msg.created_at), \"dd/MM/yyyy HH:mm\", { locale: ptBR })}\r\n                          </TableCell>\r\n                          <TableCell>\r\n                            <Badge variant=\"outline\">{msg.canal}</Badge>\r\n                          </TableCell>\r\n                          <TableCell>{msg.destinatario}</TableCell>\r\n                          <TableCell>\r\n                            {msg.status === 'enviado' && <Badge variant=\"success\">Enviado</Badge>}\r\n                            {msg.status === 'pendente' && <Badge variant=\"warning\">Pendente</Badge>}\r\n                            {msg.status === 'falhou' && <Badge variant=\"destructive\">Falhou</Badge>}\r\n                          </TableCell>\r\n                          <TableCell>{msg.template_usado || '-'}</TableCell>\r\n                        </TableRow>\r\n                      ))}\r\n                    </TableBody>\r\n                  </Table>\r\n                </div>\r\n              </CardContent>\r\n            </Card>\r\n          </TabsContent>\r\n        </Tabs>\r\n      </div>\r\n    </MainLayout>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Servicos.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchServices'. Either include it or remove the dependency array.","line":64,"column":6,"nodeType":"ArrayExpression","endLine":64,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [fetchServices]","fix":{"range":[1765,1767],"text":"[fetchServices]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { MainLayout } from \"@/components/layout/MainLayout\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card } from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { Input } from \"@/components/ui/input\";\nimport { \n  Edit, \n  Trash2, \n  Clock, \n  DollarSign,\n  Settings,\n  Loader2,\n  CheckCircle2,\n  Search\n} from \"lucide-react\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { NewServiceDialog } from \"@/components/schedule/NewServiceDialog\";\nimport { EditServiceDialog } from \"@/components/schedule/EditServiceDialog\";\n\ninterface Service {\n  id: string;\n  nome: string;\n  duracao_minutos: number;\n  preco: number | null;\n  ativo: boolean;\n  confirmacao_24h: boolean;\n  created_at: string;\n}\n\nconst Servicos = () => {\n  const [services, setServices] = useState<Service[]>([]);\n  const [isLoading, setIsLoading] = useState(true);\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [editingId, setEditingId] = useState<string | null>(null);\n  const { toast } = useToast();\n\n  const fetchServices = async () => {\n    try {\n      setIsLoading(true);\n      const { data, error } = await supabase\n        .from('servicos')\n        .select('*')\n        .order('nome');\n\n      if (error) throw error;\n      setServices(data || []);\n    } catch (error) {\n      console.error('Erro ao buscar servi├ºos:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os servi├ºos.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchServices();\n  }, []);\n\n  const toggleServiceStatus = async (serviceId: string, currentStatus: boolean) => {\n    try {\n      const { error } = await supabase\n        .from('servicos')\n        .update({ ativo: !currentStatus })\n        .eq('id', serviceId);\n\n      if (error) throw error;\n\n      setServices(prev => prev.map(service => \n        service.id === serviceId \n          ? { ...service, ativo: !currentStatus }\n          : service\n      ));\n\n      toast({\n        title: \"Status atualizado\",\n        description: `Servi├ºo ${!currentStatus ? \"ativado\" : \"desativado\"} com sucesso.`\n      });\n    } catch (error) {\n      console.error('Erro ao atualizar status:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel atualizar o status do servi├ºo.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const deleteService = async (serviceId: string) => {\n    // Importar valida├º├úo\n    const { validateServicoDelete } = await import('@/lib/deleteValidation');\n    \n    // Validar antes de excluir\n    const validation = await validateServicoDelete(serviceId);\n    \n    if (!validation.canDelete) {\n      toast({\n        title: \"N├úo ├® poss├¡vel excluir\",\n        description: validation.message,\n        variant: \"destructive\",\n        duration: 10000\n      });\n      return;\n    }\n\n    if (!confirm(\"Tem certeza que deseja excluir este servi├ºo?\")) return;\n\n    try {\n      const { error } = await supabase\n        .from('servicos')\n        .delete()\n        .eq('id', serviceId);\n\n      if (error) throw error;\n\n      setServices(prev => prev.filter(service => service.id !== serviceId));\n      \n      toast({\n        title: \"Servi├ºo exclu├¡do\",\n        description: \"O servi├ºo foi removido com sucesso.\"\n      });\n    } catch (error) {\n      console.error('Erro ao excluir servi├ºo:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel excluir o servi├ºo.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const filteredServices = services.filter(s => \n    s.nome.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  const activeServices = filteredServices.filter(s => s.ativo);\n  const avgDuration = filteredServices.length > 0 \n    ? Math.round(filteredServices.reduce((acc, s) => acc + s.duracao_minutos, 0) / filteredServices.length) \n    : 0;\n  const totalRevenue = filteredServices.filter(s => s.preco).reduce((acc, s) => acc + (s.preco || 0), 0);\n\n  return (\n    <MainLayout>\n      <div className=\"space-y-6\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h1 className=\"text-3xl font-bold text-foreground\">Servi├ºos da Cl├¡nica</h1>\n            <p className=\"text-muted-foreground\">\n              Gerencie os servi├ºos oferecidos e configura├º├Áes de agendamento ({services.length})\n            </p>\n          </div>\n          {!isLoading && services.length > 0 && (\n            <NewServiceDialog onSuccess={() => fetchServices()} />\n          )}\n        </div>\n\n        <div className=\"relative\">\n          <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground\" />\n          <Input\n            placeholder=\"Buscar servi├ºos...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"pl-10\"\n          />\n        </div>\n\n        {/* Estat├¡sticas dos Servi├ºos */}\n        {!isLoading && filteredServices.length > 0 && (\n          <Card className=\"p-6\">\n            <h3 className=\"text-lg font-semibold mb-4\">Estat├¡sticas dos Servi├ºos</h3>\n            <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n              <div className=\"text-center\">\n                <p className=\"text-2xl font-bold text-primary\">{activeServices.length}</p>\n                <p className=\"text-sm text-muted-foreground\">Servi├ºos Ativos</p>\n              </div>\n              <div className=\"text-center\">\n                <p className=\"text-2xl font-bold text-success\">{avgDuration} min</p>\n                <p className=\"text-sm text-muted-foreground\">Dura├º├úo M├®dia</p>\n              </div>\n              <div className=\"text-center\">\n                <p className=\"text-2xl font-bold text-warning\">R$ {totalRevenue.toFixed(0)}</p>\n                <p className=\"text-sm text-muted-foreground\">Receita Potencial</p>\n              </div>\n              <div className=\"text-center\">\n                <p className=\"text-2xl font-bold text-muted-foreground\">{services.length}</p>\n                <p className=\"text-sm text-muted-foreground\">Total de Servi├ºos</p>\n              </div>\n            </div>\n          </Card>\n        )}\n\n        {/* Lista de Servi├ºos */}\n        {isLoading ? (\n          <div className=\"flex items-center justify-center py-12\">\n            <Loader2 className=\"h-8 w-8 animate-spin text-primary\" />\n          </div>\n        ) : filteredServices.length === 0 ? (\n          <div className=\"text-center py-12\">\n            <Settings className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n            <h3 className=\"text-lg font-semibold mb-2\">\n              {searchTerm ? \"Nenhum servi├ºo encontrado\" : \"Nenhum servi├ºo cadastrado\"}\n            </h3>\n            <p className=\"text-muted-foreground mb-4\">\n              {searchTerm ? \"Tente uma busca diferente\" : \"Comece adicionando os servi├ºos m├®dicos e exames oferecidos\"}\n            </p>\n            {!searchTerm && <NewServiceDialog onSuccess={() => fetchServices()} />}\n          </div>\n        ) : (\n          <div className=\"grid gap-4\">\n            {filteredServices.map((service) => (\n              <Card key={service.id} className=\"p-6\">\n                <div className=\"flex items-start justify-between mb-4\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"p-2 bg-primary-light rounded-lg\">\n                      <Settings className=\"h-5 w-5 text-primary\" />\n                    </div>\n                    <div>\n                      <h3 className=\"text-lg font-semibold text-foreground\">{service.nome}</h3>\n                      {service.confirmacao_24h && (\n                        <div className=\"flex items-center gap-1 mt-1\">\n                          <CheckCircle2 className=\"h-3 w-3 text-success\" />\n                          <p className=\"text-xs text-muted-foreground\">Confirma├º├úo 24h antes</p>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <Badge variant={service.ativo ? \"default\" : \"secondary\"}>\n                      {service.ativo ? \"Ativo\" : \"Inativo\"}\n                    </Badge>\n                    <Switch\n                      checked={service.ativo}\n                      onCheckedChange={() => toggleServiceStatus(service.id, service.ativo)}\n                    />\n                  </div>\n                </div>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-4\">\n                  <div className=\"flex items-center gap-2\">\n                    <Clock className=\"h-4 w-4 text-muted-foreground\" />\n                    <span className=\"text-sm\">{service.duracao_minutos} minutos</span>\n                  </div>\n                  {service.preco && service.preco > 0 && (\n                    <div className=\"flex items-center gap-2\">\n                      <DollarSign className=\"h-4 w-4 text-muted-foreground\" />\n                      <span className=\"text-sm\">R$ {service.preco.toFixed(2)}</span>\n                    </div>\n                  )}\n                  <div className=\"text-xs text-muted-foreground\">\n                    Criado em {new Date(service.created_at).toLocaleDateString('pt-BR')}\n                  </div>\n                </div>\n\n                <div className=\"flex gap-2\">\n                  <Button \n                    size=\"sm\" \n                    variant=\"outline\"\n                    onClick={() => setEditingId(service.id)}\n                  >\n                    <Edit className=\"h-4 w-4 mr-2\" />\n                    Editar\n                  </Button>\n                  <Button\n                    size=\"sm\" \n                    variant=\"outline\" \n                    onClick={() => deleteService(service.id)}\n                    className=\"text-destructive hover:text-destructive\"\n                  >\n                    <Trash2 className=\"h-4 w-4 mr-2\" />\n                    Excluir\n                  </Button>\n                </div>\n              </Card>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {editingId && (\n        <EditServiceDialog\n          serviceId={editingId}\n          open={!!editingId}\n          onOpenChange={(open) => !open && setEditingId(null)}\n          onSuccess={() => fetchServices()}\n        />\n      )}\n    </MainLayout>\n  );\n};\n\nexport default Servicos;","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Signup.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\SupportTickets.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadTickets'. Either include it or remove the dependency array.","line":39,"column":8,"nodeType":"ArrayExpression","endLine":39,"endColumn":28,"suggestions":[{"desc":"Update the dependencies array to be: [loadTickets, profile?.tenant_id]","fix":{"range":[1477,1497],"text":"[loadTickets, profile?.tenant_id]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\nimport { MainLayout } from \"@/components/layout/MainLayout\";\r\nimport { Card, CardContent, CardHeader, CardTitle, CardDescription } from \"@/components/ui/card\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport { Textarea } from \"@/components/ui/textarea\";\r\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\r\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from \"@/components/ui/dialog\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useAuth } from \"@/hooks/useAuth\";\r\nimport { toast } from \"sonner\";\r\nimport {\r\n    Plus, MessageSquare, Clock, CheckCircle2, XCircle,\r\n    AlertCircle, HelpCircle, Bug, Lightbulb, DollarSign\r\n} from \"lucide-react\";\r\n\r\ninterface SupportTicket {\r\n    id: string;\r\n    titulo: string;\r\n    descricao: string;\r\n    categoria: string;\r\n    prioridade: string;\r\n    status: string;\r\n    created_at: string;\r\n    updated_at: string;\r\n}\r\n\r\nexport default function SupportTickets() {\r\n    const { profile } = useAuth();\r\n    const [tickets, setTickets] = useState<SupportTicket[]>([]);\r\n    const [loading, setLoading] = useState(true);\r\n\r\n    useEffect(() => {\r\n        if (profile?.tenant_id) {\r\n            loadTickets();\r\n        }\r\n    }, [profile?.tenant_id]);\r\n\r\n    const loadTickets = async () => {\r\n        try {\r\n            setLoading(true);\r\n            const { data, error } = await supabase\r\n                .from('support_tickets')\r\n                .select('*')\r\n                .eq('tenant_id', profile.tenant_id)\r\n                .order('created_at', { ascending: false });\r\n\r\n            if (error) throw error;\r\n            setTickets(data || []);\r\n        } catch (error) {\r\n            console.error('Erro ao carregar chamados:', error);\r\n            toast.error('Erro ao carregar chamados');\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const handleCreateTicket = async (data: Partial<SupportTicket>) => {\r\n        try {\r\n            const { error } = await supabase\r\n                .from('support_tickets')\r\n                .insert({\r\n                    tenant_id: profile.tenant_id,\r\n                    usuario_id: profile.id,\r\n                    ...data\r\n                });\r\n\r\n            if (error) throw error;\r\n\r\n            toast.success('Chamado aberto com sucesso!');\r\n            loadTickets();\r\n        } catch (error) {\r\n            toast.error('Erro ao abrir chamado');\r\n        }\r\n    };\r\n\r\n    const getStatusBadge = (status: string) => {\r\n        const variants: Record<string, { variant: any; icon: any; label: string }> = {\r\n            aberto: { variant: 'default', icon: Clock, label: 'Aberto' },\r\n            em_andamento: { variant: 'secondary', icon: MessageSquare, label: 'Em Andamento' },\r\n            aguardando_cliente: { variant: 'outline', icon: AlertCircle, label: 'Aguardando' },\r\n            resolvido: { variant: 'default', icon: CheckCircle2, label: 'Resolvido' },\r\n            fechado: { variant: 'secondary', icon: XCircle, label: 'Fechado' }\r\n        };\r\n\r\n        const config = variants[status] || variants.aberto;\r\n        const Icon = config.icon;\r\n\r\n        return (\r\n            <Badge variant={config.variant as any}>\r\n                <Icon className=\"h-3 w-3 mr-1\" />\r\n                {config.label}\r\n            </Badge>\r\n        );\r\n    };\r\n\r\n    const getPrioridadeBadge = (prioridade: string) => {\r\n        const colors: Record<string, string> = {\r\n            baixa: 'bg-gray-100 text-gray-800',\r\n            media: 'bg-blue-100 text-blue-800',\r\n            alta: 'bg-orange-100 text-orange-800',\r\n            urgente: 'bg-red-100 text-red-800'\r\n        };\r\n\r\n        return (\r\n            <Badge className={colors[prioridade] || colors.media}>\r\n                {prioridade.toUpperCase()}\r\n            </Badge>\r\n        );\r\n    };\r\n\r\n    const getCategoriaIcon = (categoria: string) => {\r\n        const icons: Record<string, any> = {\r\n            tecnico: Bug,\r\n            financeiro: DollarSign,\r\n            duvida: HelpCircle,\r\n            sugestao: Lightbulb,\r\n            bug: AlertCircle\r\n        };\r\n\r\n        const Icon = icons[categoria] || HelpCircle;\r\n        return <Icon className=\"h-5 w-5\" />;\r\n    };\r\n\r\n    return (\r\n        <MainLayout>\r\n            <div className=\"container mx-auto p-6 space-y-6\">\r\n                {/* Header */}\r\n                <div className=\"flex items-center justify-between\">\r\n                    <div>\r\n                        <h1 className=\"text-2xl font-bold tracking-tight\">Suporte T├®cnico</h1>\r\n                        <p className=\"text-muted-foreground\">Abra chamados e acompanhe o atendimento</p>\r\n                    </div>\r\n                    <NovoTicketDialog onCreate={handleCreateTicket} />\r\n                </div>\r\n\r\n                {/* Lista de Chamados */}\r\n                <div className=\"grid gap-4\">\r\n                    {loading ? (\r\n                        <div className=\"text-center py-8\">Carregando...</div>\r\n                    ) : tickets.length === 0 ? (\r\n                        <Card>\r\n                            <CardContent className=\"py-12 text-center\">\r\n                                <MessageSquare className=\"h-12 w-12 mx-auto mb-4 text-muted-foreground opacity-50\" />\r\n                                <p className=\"text-muted-foreground\">Nenhum chamado aberto</p>\r\n                                <p className=\"text-sm text-muted-foreground mt-2\">\r\n                                    Clique em \"Novo Chamado\" para abrir um ticket de suporte\r\n                                </p>\r\n                            </CardContent>\r\n                        </Card>\r\n                    ) : (\r\n                        tickets.map((ticket) => (\r\n                            <Card key={ticket.id} className=\"hover:shadow-md transition-shadow\">\r\n                                <CardContent className=\"p-6\">\r\n                                    <div className=\"flex items-start justify-between\">\r\n                                        <div className=\"flex-1\">\r\n                                            <div className=\"flex items-center gap-3 mb-2\">\r\n                                                {getCategoriaIcon(ticket.categoria)}\r\n                                                <h3 className=\"font-semibold text-lg\">{ticket.titulo}</h3>\r\n                                            </div>\r\n                                            <p className=\"text-muted-foreground mb-4\">{ticket.descricao}</p>\r\n                                            <div className=\"flex items-center gap-3\">\r\n                                                {getStatusBadge(ticket.status)}\r\n                                                {getPrioridadeBadge(ticket.prioridade)}\r\n                                                <span className=\"text-sm text-muted-foreground\">\r\n                                                    {new Date(ticket.created_at).toLocaleDateString('pt-BR')}\r\n                                                </span>\r\n                                            </div>\r\n                                        </div>\r\n                                        <Button variant=\"outline\" size=\"sm\">\r\n                                            Ver Detalhes\r\n                                        </Button>\r\n                                    </div>\r\n                                </CardContent>\r\n                            </Card>\r\n                        ))\r\n                    )}\r\n                </div>\r\n            </div>\r\n        </MainLayout>\r\n    );\r\n}\r\n\r\nfunction NovoTicketDialog({ onCreate }: { onCreate: (data: Partial<SupportTicket>) => void }) {\r\n    const [open, setOpen] = useState(false);\r\n    const [titulo, setTitulo] = useState('');\r\n    const [descricao, setDescricao] = useState('');\r\n    const [categoria, setCategoria] = useState('tecnico');\r\n    const [prioridade, setPrioridade] = useState('media');\r\n\r\n    const handleSubmit = (e: React.FormEvent) => {\r\n        e.preventDefault();\r\n        onCreate({\r\n            titulo,\r\n            descricao,\r\n            categoria,\r\n            prioridade\r\n        });\r\n        setOpen(false);\r\n        setTitulo('');\r\n        setDescricao('');\r\n        setCategoria('tecnico');\r\n        setPrioridade('media');\r\n    };\r\n\r\n    return (\r\n        <Dialog open={open} onOpenChange={setOpen}>\r\n            <DialogTrigger asChild>\r\n                <Button>\r\n                    <Plus className=\"mr-2 h-4 w-4\" /> Novo Chamado\r\n                </Button>\r\n            </DialogTrigger>\r\n            <DialogContent className=\"max-w-2xl\">\r\n                <DialogHeader>\r\n                    <DialogTitle>Abrir Chamado de Suporte</DialogTitle>\r\n                </DialogHeader>\r\n                <form onSubmit={handleSubmit} className=\"space-y-4\">\r\n                    <div>\r\n                        <Label>T├¡tulo</Label>\r\n                        <Input\r\n                            placeholder=\"Descreva resumidamente o problema\"\r\n                            value={titulo}\r\n                            onChange={e => setTitulo(e.target.value)}\r\n                            required\r\n                        />\r\n                    </div>\r\n\r\n                    <div>\r\n                        <Label>Descri├º├úo Detalhada</Label>\r\n                        <Textarea\r\n                            placeholder=\"Descreva o problema em detalhes, incluindo passos para reproduzir se aplic├ível\"\r\n                            value={descricao}\r\n                            onChange={e => setDescricao(e.target.value)}\r\n                            rows={5}\r\n                            required\r\n                        />\r\n                    </div>\r\n\r\n                    <div className=\"grid grid-cols-2 gap-4\">\r\n                        <div>\r\n                            <Label>Categoria</Label>\r\n                            <Select value={categoria} onValueChange={setCategoria}>\r\n                                <SelectTrigger>\r\n                                    <SelectValue />\r\n                                </SelectTrigger>\r\n                                <SelectContent>\r\n                                    <SelectItem value=\"tecnico\">\r\n                                        <div className=\"flex items-center gap-2\">\r\n                                            <Bug className=\"h-4 w-4\" />\r\n                                            Problema T├®cnico\r\n                                        </div>\r\n                                    </SelectItem>\r\n                                    <SelectItem value=\"financeiro\">\r\n                                        <div className=\"flex items-center gap-2\">\r\n                                            <DollarSign className=\"h-4 w-4\" />\r\n                                            Financeiro\r\n                                        </div>\r\n                                    </SelectItem>\r\n                                    <SelectItem value=\"duvida\">\r\n                                        <div className=\"flex items-center gap-2\">\r\n                                            <HelpCircle className=\"h-4 w-4\" />\r\n                                            D├║vida\r\n                                        </div>\r\n                                    </SelectItem>\r\n                                    <SelectItem value=\"sugestao\">\r\n                                        <div className=\"flex items-center gap-2\">\r\n                                            <Lightbulb className=\"h-4 w-4\" />\r\n                                            Sugest├úo\r\n                                        </div>\r\n                                    </SelectItem>\r\n                                    <SelectItem value=\"bug\">\r\n                                        <div className=\"flex items-center gap-2\">\r\n                                            <AlertCircle className=\"h-4 w-4\" />\r\n                                            Bug/Erro\r\n                                        </div>\r\n                                    </SelectItem>\r\n                                </SelectContent>\r\n                            </Select>\r\n                        </div>\r\n\r\n                        <div>\r\n                            <Label>Prioridade</Label>\r\n                            <Select value={prioridade} onValueChange={setPrioridade}>\r\n                                <SelectTrigger>\r\n                                    <SelectValue />\r\n                                </SelectTrigger>\r\n                                <SelectContent>\r\n                                    <SelectItem value=\"baixa\">Baixa</SelectItem>\r\n                                    <SelectItem value=\"media\">M├®dia</SelectItem>\r\n                                    <SelectItem value=\"alta\">Alta</SelectItem>\r\n                                    <SelectItem value=\"urgente\">Urgente</SelectItem>\r\n                                </SelectContent>\r\n                            </Select>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div className=\"bg-blue-50 dark:bg-blue-950/30 p-4 rounded-lg\">\r\n                        <p className=\"text-sm text-blue-800 dark:text-blue-200\">\r\n                            <strong>Dica:</strong> Quanto mais detalhes voc├¬ fornecer, mais r├ípido conseguiremos resolver seu problema.\r\n                        </p>\r\n                    </div>\r\n\r\n                    <div className=\"flex gap-2 justify-end\">\r\n                        <Button type=\"button\" variant=\"outline\" onClick={() => setOpen(false)}>\r\n                            Cancelar\r\n                        </Button>\r\n                        <Button type=\"submit\">\r\n                            Abrir Chamado\r\n                        </Button>\r\n                    </div>\r\n                </form>\r\n            </DialogContent>\r\n        </Dialog>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\TiposProfissional.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchTipos'. Either include it or remove the dependency array.","line":77,"column":6,"nodeType":"ArrayExpression","endLine":77,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [fetchTipos]","fix":{"range":[3233,3235],"text":"[fetchTipos]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\nimport { MainLayout } from \"@/components/layout/MainLayout\";\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from \"@/components/ui/dialog\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport {\n  Plus, Pencil, Trash2, Stethoscope, Syringe, Heart, Activity,\n  Pill, TestTube, Microscope, Eye, Ear, Brain, Bone, HeartPulse,\n  Users, User, UserCog, Clipboard, FileText, ClipboardList,\n  Phone, Calendar, Settings, Shield, Sparkles\n} from \"lucide-react\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { cn } from \"@/lib/utils\";\n\ninterface TipoProfissional {\n  id: string;\n  nome: string;\n  descricao: string | null;\n  acesso_prontuarios: boolean;\n  cor: string;\n  icone: string;\n  ativo: boolean;\n}\n\n// ├ìcones dispon├¡veis para tipos de profissional\nconst HEALTH_ICONS = [\n  { name: \"Stethoscope\", icon: Stethoscope, label: \"Estetosc├│pio\" },\n  { name: \"Syringe\", icon: Syringe, label: \"Seringa\" },\n  { name: \"Heart\", icon: Heart, label: \"Cora├º├úo\" },\n  { name: \"Activity\", icon: Activity, label: \"Atividade\" },\n  { name: \"Pill\", icon: Pill, label: \"P├¡lula\" },\n  { name: \"TestTube\", icon: TestTube, label: \"Tubo de Ensaio\" },\n  { name: \"Microscope\", icon: Microscope, label: \"Microsc├│pio\" },\n  { name: \"Eye\", icon: Eye, label: \"Olho\" },\n  { name: \"Ear\", icon: Ear, label: \"Ouvido\" },\n  { name: \"Brain\", icon: Brain, label: \"C├®rebro\" },\n  { name: \"Bone\", icon: Bone, label: \"Osso\" },\n  { name: \"HeartPulse\", icon: HeartPulse, label: \"Batimento Card├¡aco\" },\n  { name: \"Users\", icon: Users, label: \"Equipe\" },\n  { name: \"User\", icon: User, label: \"Usu├írio\" },\n  { name: \"UserCog\", icon: UserCog, label: \"Usu├írio Config\" },\n  { name: \"Clipboard\", icon: Clipboard, label: \"Prancheta\" },\n  { name: \"FileText\", icon: FileText, label: \"Documento\" },\n  { name: \"ClipboardList\", icon: ClipboardList, label: \"Lista\" },\n  { name: \"Phone\", icon: Phone, label: \"Telefone\" },\n  { name: \"Calendar\", icon: Calendar, label: \"Calend├írio\" },\n  { name: \"Settings\", icon: Settings, label: \"Configura├º├Áes\" },\n  { name: \"Shield\", icon: Shield, label: \"Escudo\" },\n  { name: \"Sparkles\", icon: Sparkles, label: \"Estrelas\" },\n];\n\nexport default function TiposProfissional() {\n  const [tipos, setTipos] = useState<any[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [dialogOpen, setDialogOpen] = useState(false);\n  const [editingTipo, setEditingTipo] = useState<TipoProfissional | null>(null);\n  const [initialFormData, setInitialFormData] = useState({\n    nome: \"\",\n    descricao: \"\",\n    acesso_prontuarios: false,\n    cor: \"#6366f1\",\n    icone: \"User\",\n    ativo: true\n  });\n  const [formData, setFormData] = useState(initialFormData);\n  const [hasChanges, setHasChanges] = useState(false);\n  const { toast } = useToast();\n\n  useEffect(() => {\n    fetchTipos();\n  }, []);\n\n  useEffect(() => {\n    const changed = JSON.stringify(formData) !== JSON.stringify(initialFormData);\n    setHasChanges(changed);\n  }, [formData, initialFormData]);\n\n  const fetchTipos = async () => {\n    try {\n      const { data, error } = await supabase\n        .from(\"tipos_profissional\")\n        .select(\"*\")\n        .order(\"nome\");\n\n      if (error) throw error;\n      setTipos(data || []);\n    } catch (error) {\n      console.error(\"Erro ao buscar tipos:\", error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os tipos de profissional.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.nome.trim()) {\n      toast({\n        title: \"Erro\",\n        description: \"O nome ├® obrigat├│rio.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) throw new Error(\"Usu├írio n├úo autenticado\");\n\n      const { data: profile } = await supabase\n        .from(\"profiles\")\n        .select(\"tenant_id\")\n        .eq(\"id\", user.id)\n        .single();\n\n      if (!profile?.tenant_id) throw new Error(\"Tenant n├úo encontrado\");\n\n      if (editingTipo) {\n        const { error } = await supabase\n          .from(\"tipos_profissional\")\n          .update({\n            nome: formData.nome.trim(),\n            descricao: formData.descricao.trim() || null,\n            acesso_prontuarios: formData.acesso_prontuarios,\n            cor: formData.cor,\n            icone: formData.icone,\n            ativo: formData.ativo\n          })\n          .eq(\"id\", editingTipo.id);\n\n        if (error) throw error;\n\n        toast({\n          title: \"Sucesso!\",\n          description: \"Tipo de profissional atualizado.\"\n        });\n      } else {\n        const { error } = await (supabase as any)\n          .from(\"tipos_profissional\")\n          .insert({\n            tenant_id: profile.tenant_id,\n            nome: formData.nome.trim(),\n            descricao: formData.descricao.trim() || null,\n            acesso_prontuarios: formData.acesso_prontuarios,\n            cor: formData.cor,\n            icone: formData.icone,\n            ativo: formData.ativo\n          });\n\n        if (error) throw error;\n\n        toast({\n          title: \"Sucesso!\",\n          description: \"Tipo de profissional criado.\"\n        });\n      }\n\n      setDialogOpen(false);\n      resetForm();\n      fetchTipos();\n    } catch (error: any) {\n      console.error(\"Erro ao salvar:\", error);\n      toast({\n        title: \"Erro\",\n        description: error.message || \"N├úo foi poss├¡vel salvar o tipo de profissional.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const handleEdit = (tipo: TipoProfissional) => {\n    const data = {\n      nome: tipo.nome,\n      descricao: tipo.descricao || \"\",\n      acesso_prontuarios: tipo.acesso_prontuarios,\n      cor: tipo.cor,\n      icone: tipo.icone,\n      ativo: tipo.ativo\n    };\n    setFormData(data);\n    setInitialFormData(data);\n    setEditingTipo(tipo);\n    setDialogOpen(true);\n  };\n\n  const handleDelete = async (id: string) => {\n    if (!confirm(\"Tem certeza que deseja excluir este tipo de profissional?\")) return;\n\n    try {\n      const { error } = await (supabase as any)\n        .from(\"tipos_profissional\")\n        .delete()\n        .eq(\"id\", id);\n\n      if (error) throw error;\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Tipo de profissional exclu├¡do.\"\n      });\n\n      fetchTipos();\n    } catch (error: any) {\n      console.error(\"Erro ao excluir:\", error);\n      toast({\n        title: \"Erro\",\n        description: error.message || \"N├úo foi poss├¡vel excluir o tipo de profissional.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const resetForm = () => {\n    const defaultData = {\n      nome: \"\",\n      descricao: \"\",\n      acesso_prontuarios: false,\n      cor: \"#6366f1\",\n      icone: \"User\",\n      ativo: true\n    };\n    setFormData(defaultData);\n    setInitialFormData(defaultData);\n    setEditingTipo(null);\n  };\n\n  return (\n    <MainLayout>\n      <div className=\"space-y-6\">\n        <div className=\"flex justify-between items-center\">\n          <div>\n            <h1 className=\"text-3xl font-bold\">Tipos de Profissional</h1>\n            <p className=\"text-muted-foreground\">\n              Gerencie os tipos de profissionais e suas permiss├Áes\n            </p>\n          </div>\n\n          <Dialog open={dialogOpen} onOpenChange={(open) => {\n            setDialogOpen(open);\n            if (!open) resetForm();\n          }}>\n            <DialogTrigger asChild>\n              <Button>\n                <Plus className=\"h-4 w-4 mr-2\" />\n                Novo Tipo\n              </Button>\n            </DialogTrigger>\n            <DialogContent className=\"max-w-2xl max-h-[90vh] overflow-y-auto\">\n              <DialogHeader className=\"pb-3\">\n                <DialogTitle>\n                  {editingTipo ? \"Editar\" : \"Novo\"} Tipo de Profissional\n                </DialogTitle>\n              </DialogHeader>\n\n              <form onSubmit={handleSubmit} className=\"space-y-3\">\n                <div className=\"space-y-1.5\">\n                  <Label htmlFor=\"nome\">Nome *</Label>\n                  <Input\n                    id=\"nome\"\n                    value={formData.nome}\n                    onChange={(e) => setFormData({ ...formData, nome: e.target.value })}\n                    placeholder=\"Ex: M├®dico, Fisioterapeuta, Recepcionista\"\n                    required\n                  />\n                </div>\n\n                <div className=\"space-y-1.5\">\n                  <Label htmlFor=\"descricao\">Descri├º├úo</Label>\n                  <Textarea\n                    id=\"descricao\"\n                    value={formData.descricao}\n                    onChange={(e) => setFormData({ ...formData, descricao: e.target.value })}\n                    placeholder=\"Descri├º├úo do tipo de profissional\"\n                    rows={2}\n                    className=\"resize-none\"\n                  />\n                </div>\n\n                <div className=\"space-y-1.5\">\n                  <Label htmlFor=\"cor\">Cor</Label>\n                  <Input\n                    id=\"cor\"\n                    type=\"color\"\n                    value={formData.cor}\n                    onChange={(e) => setFormData({ ...formData, cor: e.target.value })}\n                    className=\"h-10\"\n                  />\n                </div>\n\n                <div className=\"space-y-1.5\">\n                  <Label>Selecione um ├ìcone *</Label>\n                  <div className=\"grid grid-cols-8 gap-2 p-2 border rounded-lg max-h-[120px] overflow-y-auto\">\n                    {HEALTH_ICONS.map(({ name, icon: IconComponent, label }) => (\n                      <button\n                        key={name}\n                        type=\"button\"\n                        onClick={() => setFormData({ ...formData, icone: name })}\n                        className={cn(\n                          \"flex flex-col items-center justify-center p-1.5 rounded-lg border-2 transition-all hover:bg-accent\",\n                          formData.icone === name\n                            ? \"border-primary bg-primary/10\"\n                            : \"border-border\"\n                        )}\n                        title={label}\n                      >\n                        <IconComponent className=\"h-4 w-4\" />\n                        <span className=\"text-[8px] mt-0.5 text-center line-clamp-1\">{label}</span>\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                <div className=\"flex items-center justify-between p-3 border rounded-lg\">\n                  <div className=\"space-y-0.5\">\n                    <Label className=\"text-sm\">Acesso a Prontu├írios</Label>\n                    <p className=\"text-xs text-muted-foreground\">\n                      Permite que este tipo de profissional acesse prontu├írios de pacientes\n                    </p>\n                  </div>\n                  <Switch\n                    checked={formData.acesso_prontuarios}\n                    onCheckedChange={(checked) =>\n                      setFormData({ ...formData, acesso_prontuarios: checked })\n                    }\n                  />\n                </div>\n\n                <div className=\"flex items-center justify-between p-3 border rounded-lg\">\n                  <div className=\"space-y-0.5\">\n                    <Label className=\"text-sm\">Ativo</Label>\n                    <p className=\"text-xs text-muted-foreground\">\n                      Define se este tipo est├í dispon├¡vel para uso\n                    </p>\n                  </div>\n                  <Switch\n                    checked={formData.ativo}\n                    onCheckedChange={(checked) =>\n                      setFormData({ ...formData, ativo: checked })\n                    }\n                  />\n                </div>\n\n                <div className=\"flex justify-end gap-3 pt-3\">\n                  {hasChanges && (\n                    <Button\n                      type=\"button\"\n                      variant=\"outline\"\n                      onClick={() => {\n                        setFormData(initialFormData);\n                        setHasChanges(false);\n                      }}\n                    >\n                      Cancelar\n                    </Button>\n                  )}\n                  <Button type=\"submit\" disabled={!hasChanges || !formData.nome.trim()}>\n                    {editingTipo ? \"Atualizar\" : \"Criar\"}\n                  </Button>\n                </div>\n              </form>\n            </DialogContent>\n          </Dialog>\n        </div>\n\n        {loading ? (\n          <div className=\"text-center py-12\">Carregando...</div>\n        ) : tipos.length === 0 ? (\n          <Card>\n            <CardContent className=\"py-12 text-center\">\n              <p className=\"text-muted-foreground\">\n                Nenhum tipo de profissional cadastrado\n              </p>\n            </CardContent>\n          </Card>\n        ) : (\n          <div className=\"grid gap-4 md:grid-cols-2 lg:grid-cols-3\">\n            {tipos.map((tipo) => {\n              const IconData = HEALTH_ICONS.find(i => i.name === tipo.icone);\n              const IconComponent = IconData?.icon || User;\n\n              return (\n                <Card key={tipo.id}>\n                  <CardHeader>\n                    <div className=\"flex justify-between items-start\">\n                      <div className=\"flex items-center gap-3\">\n                        <div\n                          className=\"w-10 h-10 rounded-lg flex items-center justify-center\"\n                          style={{ backgroundColor: tipo.cor + \"20\" }}\n                        >\n                          <IconComponent className=\"h-5 w-5\" style={{ color: tipo.cor }} />\n                        </div>\n                        <div>\n                          <CardTitle className=\"text-lg\">{tipo.nome}</CardTitle>\n                          {!tipo.ativo && (\n                            <Badge variant=\"secondary\" className=\"mt-1\">\n                              Inativo\n                            </Badge>\n                          )}\n                        </div>\n                      </div>\n                      <div className=\"flex gap-1\">\n                        <Button\n                          variant=\"ghost\"\n                          size=\"sm\"\n                          onClick={() => handleEdit(tipo)}\n                        >\n                          <Pencil className=\"h-4 w-4\" />\n                        </Button>\n                        <Button\n                          variant=\"ghost\"\n                          size=\"sm\"\n                          onClick={() => handleDelete(tipo.id)}\n                        >\n                          <Trash2 className=\"h-4 w-4\" />\n                        </Button>\n                      </div>\n                    </div>\n                    {tipo.descricao && (\n                      <CardDescription className=\"mt-2\">\n                        {tipo.descricao}\n                      </CardDescription>\n                    )}\n                  </CardHeader>\n                  <CardContent>\n                    <div className=\"flex items-center gap-2\">\n                      {tipo.acesso_prontuarios ? (\n                        <Badge variant=\"default\">Acessa Prontu├írios</Badge>\n                      ) : (\n                        <Badge variant=\"outline\">Sem Acesso a Prontu├írios</Badge>\n                      )}\n                    </div>\n                  </CardContent>\n                </Card>\n              );\n            })}\n          </div>\n        )}\n      </div>\n    </MainLayout>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\Unidades.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\WhatsAppDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\AdminAlarmesLembretes.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadAlarmes'. Either include it or remove the dependency array.","line":57,"column":8,"nodeType":"ArrayExpression","endLine":57,"endColumn":10,"suggestions":[{"desc":"Update the dependencies array to be: [loadAlarmes]","fix":{"range":[2057,2059],"text":"[loadAlarmes]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\nimport { AdminLayout } from \"@/components/layout/AdminLayout\";\r\nimport { Card, CardContent } from \"@/components/ui/card\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport { Textarea } from \"@/components/ui/textarea\";\r\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\r\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from \"@/components/ui/dialog\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Calendar } from \"@/components/ui/calendar\";\r\nimport { RadioGroup, RadioGroupItem } from \"@/components/ui/radio-group\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useAuth } from \"@/hooks/useAuth\";\r\nimport { toast } from \"sonner\";\r\nimport {\r\n    Plus, Bell, Clock, CheckCircle2, AlertCircle, Calendar as CalendarIcon,\r\n    Trash2, Users, Building2, UserCog\r\n} from \"lucide-react\";\r\nimport { format } from \"date-fns\";\r\nimport { ptBR } from \"date-fns/locale\";\r\n\r\ninterface Alarme {\r\n    id: string;\r\n    titulo: string;\r\n    descricao: string;\r\n    tipo: 'alarme' | 'lembrete' | 'tarefa';\r\n    prioridade: 'baixa' | 'media' | 'alta' | 'urgente';\r\n    data_hora: string;\r\n    concluido: boolean;\r\n    ativo: boolean;\r\n    canal_notificacao: string;\r\n    usuario_id?: string;\r\n    tenant_id?: string;\r\n    support_user_id?: string;\r\n    usuario?: {\r\n        nome: string;\r\n    };\r\n    support_user?: {\r\n        nome: string;\r\n    };\r\n    tenant?: {\r\n        nome_fantasia: string;\r\n    };\r\n}\r\n\r\nexport default function AdminAlarmesLembretes() {\r\n    const { profile } = useAuth();\r\n    const [alarmes, setAlarmes] = useState<Alarme[]>([]);\r\n    const [loading, setLoading] = useState(true);\r\n    const [supportUsers, setSupportUsers] = useState<any[]>([]);\r\n    const [tenants, setTenants] = useState<any[]>([]);\r\n\r\n    useEffect(() => {\r\n        loadData();\r\n        loadAlarmes();\r\n    }, []);\r\n\r\n    const loadData = async () => {\r\n        try {\r\n            // Load Support Users\r\n            const { data: support } = await supabase\r\n                .from('usuarios_suporte' as any)\r\n                .select('id, nome, auth_user_id')\r\n                .eq('status', 'ativo');\r\n            setSupportUsers(support || []);\r\n\r\n            // Load Tenants\r\n            const { data: tenantList } = await supabase\r\n                .from('tenants' as any)\r\n                .select('id, nome, nome_fantasia')\r\n                .eq('status', 'ativo');\r\n            setTenants(tenantList || []);\r\n        } catch (error) {\r\n            console.error('Erro ao carregar dados:', error);\r\n        }\r\n    };\r\n\r\n    const loadAlarmes = async () => {\r\n        try {\r\n            setLoading(true);\r\n            let query = supabase\r\n                .from('alarmes_lembretes')\r\n                .select(`\r\n                    *,\r\n                    usuario:profiles!alarmes_lembretes_usuario_id_fkey(nome),\r\n                    support_user:usuarios_suporte(nome),\r\n                    tenant:tenants(nome_fantasia)\r\n                `)\r\n                .order('data_hora', { ascending: true });\r\n\r\n            // If user is tenant-bound, filter by tenant. If support/admin, show all or filter differently.\r\n            if (profile?.tenant_id) {\r\n                query = query.eq('tenant_id', profile.tenant_id);\r\n            }\r\n\r\n            const { data, error } = await query;\r\n\r\n            if (error) throw error;\r\n            setAlarmes(data as any || []);\r\n        } catch (error) {\r\n            console.error('Erro ao carregar alarmes:', error);\r\n            toast.error('Erro ao carregar alarmes');\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const handleCriarAlarme = async (data: Partial<Alarme>) => {\r\n        try {\r\n            const { error } = await supabase\r\n                .from('alarmes_lembretes')\r\n                .insert(data);\r\n\r\n            if (error) throw error;\r\n\r\n            toast.success('Alarme criado com sucesso!');\r\n            loadAlarmes();\r\n        } catch (error) {\r\n            console.error('Erro ao criar alarme:', error);\r\n            toast.error('Erro ao criar alarme');\r\n        }\r\n    };\r\n\r\n    const handleExcluir = async (id: string) => {\r\n        try {\r\n            const { error } = await supabase\r\n                .from('alarmes_lembretes')\r\n                .delete()\r\n                .eq('id', id);\r\n\r\n            if (error) throw error;\r\n\r\n            toast.success('Alarme exclu├¡do!');\r\n            loadAlarmes();\r\n        } catch (error) {\r\n            toast.error('Erro ao excluir alarme');\r\n        }\r\n    };\r\n\r\n    const getTipoBadge = (tipo: string) => {\r\n        const configs = {\r\n            alarme: { color: 'bg-red-100 text-red-800', icon: AlertCircle, label: 'Alarme' },\r\n            lembrete: { color: 'bg-blue-100 text-blue-800', icon: Bell, label: 'Lembrete' },\r\n            tarefa: { color: 'bg-green-100 text-green-800', icon: CheckCircle2, label: 'Tarefa' }\r\n        };\r\n\r\n        const config = configs[tipo as keyof typeof configs] || configs.lembrete;\r\n        const Icon = config.icon;\r\n\r\n        return (\r\n            <Badge className={config.color}>\r\n                <Icon className=\"h-3 w-3 mr-1\" />\r\n                {config.label}\r\n            </Badge>\r\n        );\r\n    };\r\n\r\n    const getPrioridadeBadge = (prioridade: string) => {\r\n        const colors = {\r\n            baixa: 'bg-gray-100 text-gray-800',\r\n            media: 'bg-yellow-100 text-yellow-800',\r\n            alta: 'bg-orange-100 text-orange-800',\r\n            urgente: 'bg-red-100 text-red-800'\r\n        };\r\n\r\n        return (\r\n            <Badge className={colors[prioridade as keyof typeof colors] || colors.media}>\r\n                {prioridade.toUpperCase()}\r\n            </Badge>\r\n        );\r\n    };\r\n\r\n    return (\r\n        <AdminLayout>\r\n            <div className=\"p-6 space-y-6\">\r\n                <div className=\"flex items-center justify-between\">\r\n                    <div>\r\n                        <h1 className=\"text-2xl font-bold tracking-tight\">Gest├úo de Alarmes - Admin</h1>\r\n                        <p className=\"text-muted-foreground\">Gerencie alarmes e lembretes de toda a equipe</p>\r\n                    </div>\r\n                    <NovoAlarmeAdminDialog\r\n                        onCreate={handleCriarAlarme}\r\n                        supportUsers={supportUsers}\r\n                        tenants={tenants}\r\n                    />\r\n                </div>\r\n\r\n                <div className=\"space-y-3\">\r\n                    {loading ? (\r\n                        <div className=\"text-center py-8\">Carregando...</div>\r\n                    ) : alarmes.length === 0 ? (\r\n                        <Card>\r\n                            <CardContent className=\"py-12 text-center\">\r\n                                <Bell className=\"h-12 w-12 mx-auto mb-4 text-muted-foreground opacity-50\" />\r\n                                <p className=\"text-muted-foreground\">Nenhum alarme encontrado</p>\r\n                            </CardContent>\r\n                        </Card>\r\n                    ) : (\r\n                        alarmes.map((alarme) => (\r\n                            <Card key={alarme.id}>\r\n                                <CardContent className=\"p-4\">\r\n                                    <div className=\"flex items-start justify-between\">\r\n                                        <div className=\"flex-1\">\r\n                                            <div className=\"flex items-center gap-2 mb-2\">\r\n                                                <h3 className=\"font-semibold\">{alarme.titulo}</h3>\r\n                                                {getTipoBadge(alarme.tipo)}\r\n                                                {getPrioridadeBadge(alarme.prioridade)}\r\n                                            </div>\r\n\r\n                                            {alarme.descricao && (\r\n                                                <p className=\"text-sm text-muted-foreground mb-2\">{alarme.descricao}</p>\r\n                                            )}\r\n\r\n                                            <div className=\"flex items-center gap-4 text-sm text-muted-foreground\">\r\n                                                <span className=\"flex items-center gap-1\">\r\n                                                    <CalendarIcon className=\"h-4 w-4\" />\r\n                                                    {format(new Date(alarme.data_hora), \"dd/MM/yyyy '├ás' HH:mm\", { locale: ptBR })}\r\n                                                </span>\r\n\r\n                                                {/* Display assigned user/tenant */}\r\n                                                {alarme.usuario && (\r\n                                                    <span className=\"flex items-center gap-1\" title=\"Usu├írio da Cl├¡nica\">\r\n                                                        <Users className=\"h-4 w-4\" />\r\n                                                        {alarme.usuario.nome}\r\n                                                    </span>\r\n                                                )}\r\n                                                {alarme.support_user && (\r\n                                                    <span className=\"flex items-center gap-1 text-blue-600\" title=\"Usu├írio de Suporte\">\r\n                                                        <UserCog className=\"h-4 w-4\" />\r\n                                                        {alarme.support_user.nome}\r\n                                                    </span>\r\n                                                )}\r\n                                                {alarme.tenant && !alarme.usuario && (\r\n                                                    <span className=\"flex items-center gap-1 text-purple-600\" title=\"Cl├¡nica\">\r\n                                                        <Building2 className=\"h-4 w-4\" />\r\n                                                        {alarme.tenant.nome_fantasia}\r\n                                                    </span>\r\n                                                )}\r\n                                            </div>\r\n                                        </div>\r\n\r\n                                        <Button\r\n                                            size=\"sm\"\r\n                                            variant=\"ghost\"\r\n                                            onClick={() => handleExcluir(alarme.id)}\r\n                                        >\r\n                                            <Trash2 className=\"h-4 w-4\" />\r\n                                        </Button>\r\n                                    </div>\r\n                                </CardContent>\r\n                            </Card>\r\n                        ))\r\n                    )}\r\n                </div>\r\n            </div>\r\n        </AdminLayout>\r\n    );\r\n}\r\n\r\nfunction NovoAlarmeAdminDialog({ onCreate, supportUsers, tenants }: { onCreate: (data: any) => void; supportUsers: any[]; tenants: any[] }) {\r\n    const [open, setOpen] = useState(false);\r\n    const [titulo, setTitulo] = useState('');\r\n    const [descricao, setDescricao] = useState('');\r\n    const [tipo, setTipo] = useState('lembrete');\r\n    const [prioridade, setPrioridade] = useState('media');\r\n    const [data, setData] = useState<Date | undefined>(new Date());\r\n    const [hora, setHora] = useState('09:00');\r\n    const [canal, setCanal] = useState('sistema');\r\n\r\n    const [targetType, setTargetType] = useState<'support' | 'tenant'>('support');\r\n    const [selectedId, setSelectedId] = useState('');\r\n\r\n    const handleSubmit = (e: React.FormEvent) => {\r\n        e.preventDefault();\r\n\r\n        if (!data || !selectedId) {\r\n            toast.error('Preencha todos os campos obrigat├│rios');\r\n            return;\r\n        }\r\n\r\n        const [horas, minutos] = hora.split(':');\r\n        const dataHora = new Date(data);\r\n        dataHora.setHours(parseInt(horas), parseInt(minutos));\r\n\r\n        const payload: any = {\r\n            titulo,\r\n            descricao,\r\n            tipo,\r\n            prioridade,\r\n            data_hora: dataHora.toISOString(),\r\n            canal_notificacao: canal,\r\n        };\r\n\r\n        if (targetType === 'support') {\r\n            payload.support_user_id = selectedId;\r\n            payload.usuario_id = null;\r\n            payload.tenant_id = null;\r\n        } else {\r\n            payload.tenant_id = selectedId;\r\n            payload.usuario_id = null;\r\n            payload.support_user_id = null;\r\n        }\r\n\r\n        onCreate(payload);\r\n        setOpen(false);\r\n        resetForm();\r\n    };\r\n\r\n    const resetForm = () => {\r\n        setTitulo('');\r\n        setDescricao('');\r\n        setSelectedId('');\r\n        setTargetType('support');\r\n    };\r\n\r\n    return (\r\n        <Dialog open={open} onOpenChange={setOpen}>\r\n            <DialogTrigger asChild>\r\n                <Button>\r\n                    <Plus className=\"mr-2 h-4 w-4\" /> Novo Alarme\r\n                </Button>\r\n            </DialogTrigger>\r\n            <DialogContent className=\"max-w-2xl\">\r\n                <DialogHeader>\r\n                    <DialogTitle>Criar Alarme</DialogTitle>\r\n                </DialogHeader>\r\n                <form onSubmit={handleSubmit} className=\"space-y-4\">\r\n                    <div className=\"space-y-3\">\r\n                        <Label>Destino do Alarme</Label>\r\n                        <RadioGroup\r\n                            value={targetType}\r\n                            onValueChange={(v) => {\r\n                                setTargetType(v as 'support' | 'tenant');\r\n                                setSelectedId('');\r\n                            }}\r\n                            className=\"flex gap-4\"\r\n                        >\r\n                            <div className=\"flex items-center space-x-2\">\r\n                                <RadioGroupItem value=\"support\" id=\"r-support\" />\r\n                                <Label htmlFor=\"r-support\" className=\"cursor-pointer\">Equipe de Suporte</Label>\r\n                            </div>\r\n                            <div className=\"flex items-center space-x-2\">\r\n                                <RadioGroupItem value=\"tenant\" id=\"r-tenant\" />\r\n                                <Label htmlFor=\"r-tenant\" className=\"cursor-pointer\">Tenant (Cl├¡nica)</Label>\r\n                            </div>\r\n                        </RadioGroup>\r\n                    </div>\r\n\r\n                    <div>\r\n                        <Label>{targetType === 'support' ? 'Usu├írio de Suporte' : 'Selecione o Tenant'}</Label>\r\n                        <Select value={selectedId} onValueChange={setSelectedId}>\r\n                            <SelectTrigger>\r\n                                <SelectValue placeholder={targetType === 'support' ? \"Selecione um usu├írio...\" : \"Selecione uma cl├¡nica...\"} />\r\n                            </SelectTrigger>\r\n                            <SelectContent>\r\n                                {targetType === 'support' ? (\r\n                                    supportUsers.map(u => (\r\n                                        <SelectItem key={u.id} value={u.id}>\r\n                                            {u.nome}\r\n                                        </SelectItem>\r\n                                    ))\r\n                                ) : (\r\n                                    tenants.map(t => (\r\n                                        <SelectItem key={t.id} value={t.id}>\r\n                                            {t.nome_fantasia || t.nome}\r\n                                        </SelectItem>\r\n                                    ))\r\n                                )}\r\n                            </SelectContent>\r\n                        </Select>\r\n                    </div>\r\n\r\n                    <div>\r\n                        <Label>T├¡tulo</Label>\r\n                        <Input\r\n                            placeholder=\"Ex: Ligar para paciente\"\r\n                            value={titulo}\r\n                            onChange={e => setTitulo(e.target.value)}\r\n                            required\r\n                        />\r\n                    </div>\r\n\r\n                    <div>\r\n                        <Label>Descri├º├úo</Label>\r\n                        <Textarea\r\n                            placeholder=\"Detalhes adicionais...\"\r\n                            value={descricao}\r\n                            onChange={e => setDescricao(e.target.value)}\r\n                            rows={3}\r\n                        />\r\n                    </div>\r\n\r\n                    <div className=\"grid grid-cols-2 gap-4\">\r\n                        <div>\r\n                            <Label>Tipo</Label>\r\n                            <Select value={tipo} onValueChange={setTipo}>\r\n                                <SelectTrigger>\r\n                                    <SelectValue />\r\n                                </SelectTrigger>\r\n                                <SelectContent>\r\n                                    <SelectItem value=\"alarme\">Alarme (Urgente)</SelectItem>\r\n                                    <SelectItem value=\"lembrete\">Lembrete</SelectItem>\r\n                                    <SelectItem value=\"tarefa\">Tarefa</SelectItem>\r\n                                </SelectContent>\r\n                            </Select>\r\n                        </div>\r\n\r\n                        <div>\r\n                            <Label>Prioridade</Label>\r\n                            <Select value={prioridade} onValueChange={setPrioridade}>\r\n                                <SelectTrigger>\r\n                                    <SelectValue />\r\n                                </SelectTrigger>\r\n                                <SelectContent>\r\n                                    <SelectItem value=\"baixa\">Baixa</SelectItem>\r\n                                    <SelectItem value=\"media\">M├®dia</SelectItem>\r\n                                    <SelectItem value=\"alta\">Alta</SelectItem>\r\n                                    <SelectItem value=\"urgente\">Urgente</SelectItem>\r\n                                </SelectContent>\r\n                            </Select>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div className=\"grid grid-cols-2 gap-4\">\r\n                        <div>\r\n                            <Label>Data</Label>\r\n                            <Calendar\r\n                                mode=\"single\"\r\n                                selected={data}\r\n                                onSelect={setData}\r\n                                locale={ptBR}\r\n                                className=\"rounded-md border\"\r\n                            />\r\n                        </div>\r\n\r\n                        <div className=\"space-y-4\">\r\n                            <div>\r\n                                <Label>Hora</Label>\r\n                                <Input\r\n                                    type=\"time\"\r\n                                    value={hora}\r\n                                    onChange={e => setHora(e.target.value)}\r\n                                    required\r\n                                />\r\n                            </div>\r\n\r\n                            <div>\r\n                                <Label>Canal de Notifica├º├úo</Label>\r\n                                <Select value={canal} onValueChange={setCanal}>\r\n                                    <SelectTrigger>\r\n                                        <SelectValue />\r\n                                    </SelectTrigger>\r\n                                    <SelectContent>\r\n                                        <SelectItem value=\"sistema\">Sistema</SelectItem>\r\n                                        <SelectItem value=\"email\">E-mail</SelectItem>\r\n                                        <SelectItem value=\"whatsapp\">WhatsApp</SelectItem>\r\n                                        <SelectItem value=\"todos\">Todos</SelectItem>\r\n                                    </SelectContent>\r\n                                </Select>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div className=\"flex gap-2 justify-end\">\r\n                        <Button type=\"button\" variant=\"outline\" onClick={() => setOpen(false)}>\r\n                            Cancelar\r\n                        </Button>\r\n                        <Button type=\"submit\">\r\n                            Criar Alarme\r\n                        </Button>\r\n                    </div>\r\n                </form>\r\n            </DialogContent>\r\n        </Dialog>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\AutomationsFlowBuilder.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadTenants'. Either include it or remove the dependency array.","line":35,"column":8,"nodeType":"ArrayExpression","endLine":35,"endColumn":10,"suggestions":[{"desc":"Update the dependencies array to be: [loadTenants]","fix":{"range":[1820,1822],"text":"[loadTenants]"}}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadFlows'. Either include it or remove the dependency array.","line":39,"column":8,"nodeType":"ArrayExpression","endLine":39,"endColumn":41,"suggestions":[{"desc":"Update the dependencies array to be: [selectedTenantId, filterSegment, loadFlows]","fix":{"range":[1880,1913],"text":"[selectedTenantId, filterSegment, loadFlows]"}}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadNodes'. Either include it or remove the dependency array.","line":330,"column":8,"nodeType":"ArrayExpression","endLine":330,"endColumn":17,"suggestions":[{"desc":"Update the dependencies array to be: [flow.id, loadNodes]","fix":{"range":[15854,15863],"text":"[flow.id, loadNodes]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\nimport { Card, CardContent, CardHeader, CardTitle, CardDescription } from \"@/components/ui/card\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\r\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from \"@/components/ui/dialog\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Switch } from \"@/components/ui/switch\";\r\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useAuth } from \"@/hooks/useAuth\";\r\nimport { toast } from \"sonner\";\r\nimport {\r\n    Plus, Play, GitBranch, MessageSquare, Mail, Smartphone,\r\n    Trash2, Save, ArrowRight, Activity, Settings, CheckCircle2,\r\n    AlertTriangle, Clock, UserPlus, ListPlus\r\n} from \"lucide-react\";\r\nimport { AutomationFlow, AutomationNode, NodeType, ActionType, ConditionType } from \"@/domain/automations/types\";\r\nimport { AdminLayout } from \"@/components/layout/AdminLayout\";\r\n\r\nexport default function AutomationsFlowBuilder() {\r\n    const { profile } = useAuth();\r\n    const [flows, setFlows] = useState<AutomationFlow[]>([]);\r\n    const [selectedFlow, setSelectedFlow] = useState<AutomationFlow | null>(null);\r\n    const [loading, setLoading] = useState(false);\r\n\r\n    // Admin context\r\n    const [tenants, setTenants] = useState<{ id: string, nome: string }[]>([]);\r\n    const [selectedTenantId, setSelectedTenantId] = useState<string | null>(null);\r\n    const [filterSegment, setFilterSegment] = useState<string>('todos');\r\n\r\n    useEffect(() => {\r\n        loadTenants();\r\n    }, []);\r\n\r\n    useEffect(() => {\r\n        loadFlows();\r\n    }, [selectedTenantId, filterSegment]);\r\n\r\n    const loadTenants = async () => {\r\n        const { data } = await supabase\r\n            .from('tenants')\r\n            .select('id, nome')\r\n            .order('nome');\r\n        setTenants(data || []);\r\n\r\n        // Se tiver profile com tenant (n├úo admin), seleciona auto\r\n        if (profile?.tenant_id) {\r\n            setSelectedTenantId(profile.tenant_id);\r\n        }\r\n    };\r\n\r\n    const loadFlows = async () => {\r\n        try {\r\n            setLoading(true);\r\n            let query = supabase\r\n                .from('automations_flows')\r\n                .select('*')\r\n                .order('created_at', { ascending: false });\r\n\r\n            if (selectedTenantId) {\r\n                // Se tem tenant selecionado, busca do tenant E globais\r\n                query = query.or(`tenant_id.eq.${selectedTenantId},is_global.eq.true`);\r\n            } else {\r\n                // Se n├úo tem tenant (modo geral), busca apenas globais\r\n                query = query.eq('is_global', true);\r\n                if (filterSegment !== 'todos') {\r\n                    query = query.eq('segmento', filterSegment);\r\n                }\r\n            }\r\n\r\n            const { data, error } = await query;\r\n\r\n            if (error) throw error;\r\n\r\n            // Filtragem em mem├│ria para o caso complexo (Tenant + Global filtrado)\r\n            let filteredData = data || [];\r\n            if (selectedTenantId && filterSegment !== 'todos') {\r\n                filteredData = filteredData.filter(flow => {\r\n                    // Mant├®m se for do tenant\r\n                    if (flow.tenant_id === selectedTenantId) return true;\r\n                    // Se for global, verifica o segmento\r\n                    if (flow.is_global) return flow.segmento === filterSegment;\r\n                    return false;\r\n                });\r\n            }\r\n\r\n            setFlows(filteredData);\r\n        } catch (error) {\r\n            console.error('Erro ao carregar fluxos:', error);\r\n            toast.error('Erro ao carregar automa├º├Áes');\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const handleCreateFlow = async (nome: string, descricao: string, isGlobal: boolean, segmento: string) => {\r\n        if (!isGlobal && !selectedTenantId) {\r\n            toast.error('Selecione uma cl├¡nica primeiro ou crie uma automa├º├úo global');\r\n            return;\r\n        }\r\n\r\n        try {\r\n            const { data, error } = await supabase\r\n                .from('automations_flows')\r\n                .insert({\r\n                    tenant_id: isGlobal ? null : selectedTenantId,\r\n                    nome,\r\n                    descricao,\r\n                    ativo: false,\r\n                    is_global: isGlobal,\r\n                    segmento: isGlobal ? segmento : null\r\n                })\r\n                .select()\r\n                .single();\r\n\r\n            if (error) throw error;\r\n\r\n            setFlows([data, ...flows]);\r\n            setSelectedFlow(data);\r\n            toast.success('Fluxo criado com sucesso');\r\n        } catch (error) {\r\n            console.error(error);\r\n            toast.error('Erro ao criar fluxo');\r\n        }\r\n    };\r\n\r\n    const handleToggleActive = async (flow: AutomationFlow) => {\r\n        try {\r\n            const { error } = await supabase\r\n                .from('automations_flows')\r\n                .update({ ativo: !flow.ativo })\r\n                .eq('id', flow.id);\r\n\r\n            if (error) throw error;\r\n\r\n            setFlows(flows.map(f => f.id === flow.id ? { ...f, ativo: !f.ativo } : f));\r\n            if (selectedFlow?.id === flow.id) {\r\n                setSelectedFlow({ ...selectedFlow, ativo: !flow.ativo });\r\n            }\r\n            toast.success(`Fluxo ${!flow.ativo ? 'ativado' : 'desativado'}`);\r\n        } catch (error) {\r\n            toast.error('Erro ao atualizar status');\r\n        }\r\n    };\r\n\r\n    return (\r\n        <AdminLayout>\r\n            <div className=\"container mx-auto p-6 h-[calc(100vh-4rem)] flex flex-col\">\r\n                <div className=\"flex items-center justify-between mb-6\">\r\n                    <div>\r\n                        <h1 className=\"text-2xl font-bold tracking-tight\">Automa├º├Áes Omnichannel</h1>\r\n                        <p className=\"text-muted-foreground\">Crie fluxos de comunica├º├úo autom├íticos para seus pacientes.</p>\r\n                    </div>\r\n\r\n                    <div className=\"flex items-center gap-4\">\r\n                        {/* Filtro de Segmento */}\r\n                        <Select value={filterSegment} onValueChange={setFilterSegment}>\r\n                            <SelectTrigger className=\"w-[180px]\">\r\n                                <SelectValue placeholder=\"Filtrar Segmento\" />\r\n                            </SelectTrigger>\r\n                            <SelectContent>\r\n                                <SelectItem value=\"todos\">Todos os Segmentos</SelectItem>\r\n                                <SelectItem value=\"geral\">Geral</SelectItem>\r\n                                <SelectItem value=\"saude\">Sa├║de</SelectItem>\r\n                                <SelectItem value=\"beleza\">Beleza</SelectItem>\r\n                                <SelectItem value=\"juridico\">Jur├¡dico</SelectItem>\r\n                                <SelectItem value=\"automotivo\">Automotivo</SelectItem>\r\n                            </SelectContent>\r\n                        </Select>\r\n\r\n                        <Select value={selectedTenantId || ''} onValueChange={setSelectedTenantId}>\r\n                            <SelectTrigger className=\"w-[250px]\">\r\n                                <SelectValue placeholder=\"Selecione a Cl├¡nica (ou Global)\" />\r\n                            </SelectTrigger>\r\n                            <SelectContent>\r\n                                <SelectItem value=\"\">-- Apenas Globais --</SelectItem>\r\n                                {tenants.map(t => (\r\n                                    <SelectItem key={t.id} value={t.id}>{t.nome}</SelectItem>\r\n                                ))}\r\n                            </SelectContent>\r\n                        </Select>\r\n\r\n                        <NewFlowDialog onCreate={handleCreateFlow} disabled={false} />\r\n                    </div>\r\n                </div>\r\n\r\n                <div className=\"flex gap-6 flex-1 overflow-hidden\">\r\n                    {/* Sidebar Lista de Fluxos */}\r\n                    <div className=\"w-80 border-r pr-6 flex flex-col gap-4 overflow-y-auto\">\r\n                        {loading ? (\r\n                            <div className=\"text-center py-8 text-muted-foreground\">Carregando...</div>\r\n                        ) : flows.length === 0 ? (\r\n                            <div className=\"text-center py-8 text-muted-foreground\">Nenhum fluxo encontrado</div>\r\n                        ) : (\r\n                            flows.map(flow => (\r\n                                <Card\r\n                                    key={flow.id}\r\n                                    className={`cursor-pointer transition-colors hover:bg-accent ${selectedFlow?.id === flow.id ? 'border-primary bg-accent/50' : ''}`}\r\n                                    onClick={() => setSelectedFlow(flow)}\r\n                                >\r\n                                    <CardHeader className=\"p-4 space-y-2\">\r\n                                        <div className=\"flex items-center justify-between\">\r\n                                            <CardTitle className=\"text-sm font-medium leading-none truncate pr-2\">\r\n                                                {flow.nome}\r\n                                            </CardTitle>\r\n                                            <div className=\"flex gap-1 items-center\">\r\n                                                {flow.is_global && (\r\n                                                    <Badge variant=\"secondary\" className=\"text-[10px] h-5 px-1 bg-blue-100 text-blue-700 hover:bg-blue-100\">\r\n                                                        Global\r\n                                                    </Badge>\r\n                                                )}\r\n                                                <div onClick={(e) => e.stopPropagation()}>\r\n                                                    <Switch\r\n                                                        checked={flow.ativo}\r\n                                                        onCheckedChange={() => handleToggleActive(flow)}\r\n                                                        className=\"scale-75\"\r\n                                                    />\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                        <CardDescription className=\"text-xs line-clamp-2\">\r\n                                            {flow.descricao || 'Sem descri├º├úo'}\r\n                                        </CardDescription>\r\n                                        {flow.is_global && flow.segmento && (\r\n                                            <div className=\"pt-1\">\r\n                                                <Badge variant=\"outline\" className=\"text-[10px] h-5 px-1\">\r\n                                                    {flow.segmento.charAt(0).toUpperCase() + flow.segmento.slice(1)}\r\n                                                </Badge>\r\n                                            </div>\r\n                                        )}\r\n                                    </CardHeader>\r\n                                </Card>\r\n                            ))\r\n                        )}\r\n                    </div>\r\n\r\n                    {/* Editor Area */}\r\n                    <div className=\"flex-1 bg-slate-50 dark:bg-slate-900 rounded-lg border overflow-hidden flex flex-col\">\r\n                        {selectedFlow ? (\r\n                            <FlowEditor flow={selectedFlow} key={selectedFlow.id} />\r\n                        ) : (\r\n                            <div className=\"flex items-center justify-center h-full text-muted-foreground\">\r\n                                Selecione ou crie um fluxo para come├ºar\r\n                            </div>\r\n                        )}\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </AdminLayout>\r\n    );\r\n}\r\n\r\nfunction NewFlowDialog({ onCreate, disabled }: { onCreate: (nome: string, desc: string, isGlobal: boolean, segmento: string) => void, disabled?: boolean }) {\r\n    const [open, setOpen] = useState(false);\r\n    const [nome, setNome] = useState('');\r\n    const [desc, setDesc] = useState('');\r\n    const [isGlobal, setIsGlobal] = useState(false);\r\n    const [segmento, setSegmento] = useState('geral');\r\n\r\n    const handleSubmit = (e: React.FormEvent) => {\r\n        e.preventDefault();\r\n        onCreate(nome, desc, isGlobal, segmento);\r\n        setOpen(false);\r\n        setNome('');\r\n        setDesc('');\r\n        setIsGlobal(false);\r\n        setSegmento('geral');\r\n    };\r\n\r\n    return (\r\n        <Dialog open={open} onOpenChange={setOpen}>\r\n            <DialogTrigger asChild>\r\n                <Button disabled={disabled && !isGlobal}><Plus className=\"mr-2 h-4 w-4\" /> Nova Automa├º├úo</Button>\r\n            </DialogTrigger>\r\n            <DialogContent>\r\n                <DialogHeader>\r\n                    <DialogTitle>Criar Nova Automa├º├úo</DialogTitle>\r\n                </DialogHeader>\r\n                <form onSubmit={handleSubmit} className=\"space-y-4\">\r\n                    <div>\r\n                        <Label>Nome do Fluxo</Label>\r\n                        <Input value={nome} onChange={e => setNome(e.target.value)} required placeholder=\"Ex: Lembrete de Consulta\" />\r\n                    </div>\r\n                    <div>\r\n                        <Label>Descri├º├úo</Label>\r\n                        <Input value={desc} onChange={e => setDesc(e.target.value)} placeholder=\"Opcional\" />\r\n                    </div>\r\n\r\n                    <div className=\"flex items-center space-x-2\">\r\n                        <Switch id=\"global-mode\" checked={isGlobal} onCheckedChange={setIsGlobal} />\r\n                        <Label htmlFor=\"global-mode\">Automa├º├úo Global (Todos os Tenants)</Label>\r\n                    </div>\r\n\r\n                    {isGlobal && (\r\n                        <div>\r\n                            <Label>Segmento de Atividade</Label>\r\n                            <Select value={segmento} onValueChange={setSegmento}>\r\n                                <SelectTrigger>\r\n                                    <SelectValue placeholder=\"Selecione o segmento\" />\r\n                                </SelectTrigger>\r\n                                <SelectContent>\r\n                                    <SelectItem value=\"geral\">Geral (Todos)</SelectItem>\r\n                                    <SelectItem value=\"saude\">Sa├║de (Cl├¡nicas)</SelectItem>\r\n                                    <SelectItem value=\"beleza\">Beleza (Sal├Áes/Spas)</SelectItem>\r\n                                    <SelectItem value=\"juridico\">Jur├¡dico (Advocacia)</SelectItem>\r\n                                    <SelectItem value=\"automotivo\">Automotivo (Oficinas)</SelectItem>\r\n                                </SelectContent>\r\n                            </Select>\r\n                            <p className=\"text-xs text-muted-foreground mt-1\">\r\n                                Esta automa├º├úo ser├í aplicada apenas para tenants deste segmento.\r\n                            </p>\r\n                        </div>\r\n                    )}\r\n\r\n                    <Button type=\"submit\" className=\"w-full\">Criar</Button>\r\n                </form>\r\n            </DialogContent>\r\n        </Dialog>\r\n    );\r\n}\r\n\r\nfunction FlowEditor({ flow }: { flow: AutomationFlow }) {\r\n    const [nodes, setNodes] = useState<AutomationNode[]>([]);\r\n    const [loading, setLoading] = useState(true);\r\n\r\n    useEffect(() => {\r\n        loadNodes();\r\n    }, [flow.id]);\r\n\r\n    const loadNodes = async () => {\r\n        setLoading(true);\r\n        const { data } = await supabase\r\n            .from('automations_nodes')\r\n            .select('*')\r\n            .eq('flow_id', flow.id)\r\n            .order('ordem');\r\n        setNodes(data || []);\r\n        setLoading(false);\r\n    };\r\n\r\n    const addNode = async (type: NodeType, config: any) => {\r\n        const ordem = nodes.length;\r\n        const { data, error } = await supabase\r\n            .from('automations_nodes')\r\n            .insert({\r\n                flow_id: flow.id,\r\n                tipo: type,\r\n                config_json: config,\r\n                ordem\r\n            })\r\n            .select()\r\n            .single();\r\n\r\n        if (!error && data) {\r\n            setNodes([...nodes, data]);\r\n\r\n            // Auto-connect edge if not first node\r\n            if (nodes.length > 0) {\r\n                const lastNode = nodes[nodes.length - 1];\r\n                await supabase.from('automations_edges').insert({\r\n                    flow_id: flow.id,\r\n                    from_node_id: lastNode.id,\r\n                    to_node_id: data.id\r\n                });\r\n            }\r\n        }\r\n    };\r\n\r\n    const deleteNode = async (id: string) => {\r\n        await supabase.from('automations_nodes').delete().eq('id', id);\r\n        loadNodes(); // Reload to fix edges/order\r\n    };\r\n\r\n    if (loading) return <div className=\"p-8\">Carregando editor...</div>;\r\n\r\n    return (\r\n        <div className=\"flex flex-col h-full\">\r\n            <div className=\"p-4 border-b bg-white dark:bg-slate-950 flex justify-between items-center\">\r\n                <div>\r\n                    <h2 className=\"font-semibold\">{flow.nome}</h2>\r\n                    <p className=\"text-xs text-muted-foreground\">Editor de Sequ├¬ncia</p>\r\n                </div>\r\n                <div className=\"flex gap-2\">\r\n                    {/* Actions bar */}\r\n                </div>\r\n            </div>\r\n\r\n            <div className=\"flex-1 overflow-y-auto p-8 space-y-6\">\r\n                {nodes.length === 0 && (\r\n                    <div className=\"text-center py-12 border-2 border-dashed rounded-xl bg-slate-50 dark:bg-slate-900/50\">\r\n                        <Play className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\r\n                        <h3 className=\"text-lg font-medium\">Comece seu fluxo</h3>\r\n                        <p className=\"text-muted-foreground mb-6\">Adicione um gatilho para iniciar esta automa├º├úo.</p>\r\n                        <AddNodeButton onAdd={addNode} isFirst={true} />\r\n                    </div>\r\n                )}\r\n\r\n                {nodes.map((node, index) => (\r\n                    <div key={node.id} className=\"relative\">\r\n                        {/* Connecting Line */}\r\n                        {index > 0 && (\r\n                            <div className=\"absolute -top-6 left-1/2 w-0.5 h-6 bg-slate-300 dark:bg-slate-700 -translate-x-1/2\" />\r\n                        )}\r\n\r\n                        <NodeCard node={node} onDelete={() => deleteNode(node.id)} />\r\n\r\n                        {/* Add Button between nodes? No, just at end for MVP sequence */}\r\n                    </div>\r\n                ))}\r\n\r\n                {nodes.length > 0 && (\r\n                    <div className=\"flex justify-center pt-4\">\r\n                        <AddNodeButton onAdd={addNode} isFirst={false} />\r\n                    </div>\r\n                )}\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n\r\nfunction NodeCard({ node, onDelete }: { node: AutomationNode, onDelete: () => void }) {\r\n    const icons = {\r\n        trigger: Play,\r\n        condition: GitBranch,\r\n        action: MessageSquare\r\n    };\r\n    const Icon = icons[node.tipo];\r\n\r\n    const getConfigLabel = () => {\r\n        const c = node.config_json;\r\n        if (node.tipo === 'trigger') return `Quando: ${c.event}`;\r\n        if (node.tipo === 'action') return `A├º├úo: ${c.action_type} (${c.message_type || 'operacional'})`;\r\n        if (node.tipo === 'condition') return `Se: ${c.condition_type}`;\r\n        return 'Configura├º├úo';\r\n    };\r\n\r\n    return (\r\n        <Card className=\"w-full max-w-md mx-auto relative group hover:shadow-md transition-all\">\r\n            <CardContent className=\"p-4 flex items-center gap-4\">\r\n                <div className={`p-2 rounded-lg ${node.tipo === 'trigger' ? 'bg-blue-100 text-blue-600' :\r\n                    node.tipo === 'condition' ? 'bg-amber-100 text-amber-600' :\r\n                        'bg-green-100 text-green-600'\r\n                    }`}>\r\n                    <Icon className=\"h-5 w-5\" />\r\n                </div>\r\n                <div className=\"flex-1\">\r\n                    <div className=\"text-xs font-bold uppercase text-muted-foreground tracking-wider mb-0.5\">\r\n                        {node.tipo === 'trigger' ? 'Gatilho' : node.tipo === 'condition' ? 'Condi├º├úo' : 'A├º├úo'}\r\n                    </div>\r\n                    <div className=\"font-medium\">{getConfigLabel()}</div>\r\n                </div>\r\n                <Button variant=\"ghost\" size=\"icon\" className=\"opacity-0 group-hover:opacity-100 text-destructive\" onClick={onDelete}>\r\n                    <Trash2 className=\"h-4 w-4\" />\r\n                </Button>\r\n            </CardContent>\r\n        </Card>\r\n    );\r\n}\r\n\r\nfunction AddNodeButton({ onAdd, isFirst }: { onAdd: (type: NodeType, config: any) => void, isFirst: boolean }) {\r\n    return (\r\n        <Dialog>\r\n            <DialogTrigger asChild>\r\n                <Button variant={isFirst ? \"default\" : \"outline\"} className=\"gap-2\">\r\n                    <Plus className=\"h-4 w-4\" />\r\n                    {isFirst ? \"Adicionar Gatilho Inicial\" : \"Adicionar Passo\"}\r\n                </Button>\r\n            </DialogTrigger>\r\n            <DialogContent>\r\n                <DialogHeader>\r\n                    <DialogTitle>Adicionar Novo Passo</DialogTitle>\r\n                </DialogHeader>\r\n                <div className=\"grid gap-4 py-4\">\r\n                    {isFirst ? (\r\n                        <div className=\"grid grid-cols-1 gap-2\">\r\n                            <Button variant=\"outline\" className=\"justify-start h-auto py-3\" onClick={() => onAdd('trigger', { event: 'onAppointmentCreated' })}>\r\n                                <Play className=\"mr-2 h-4 w-4\" /> Agendamento Criado\r\n                            </Button>\r\n                            <Button variant=\"outline\" className=\"justify-start h-auto py-3\" onClick={() => onAdd('trigger', { event: 'onAppointmentConfirmed' })}>\r\n                                <CheckCircle2 className=\"mr-2 h-4 w-4\" /> Agendamento Confirmado\r\n                            </Button>\r\n                            <Button variant=\"outline\" className=\"justify-start h-auto py-3\" onClick={() => onAdd('trigger', { event: 'onAppointmentCancelled' })}>\r\n                                <AlertTriangle className=\"mr-2 h-4 w-4\" /> Agendamento Cancelado\r\n                            </Button>\r\n                            <Button variant=\"outline\" className=\"justify-start h-auto py-3\" onClick={() => onAdd('trigger', { event: 'onAppointmentNotConfirmed' })}>\r\n                                <Clock className=\"mr-2 h-4 w-4\" /> Cliente N├úo Confirmou (D-1)\r\n                            </Button>\r\n                            <Button variant=\"outline\" className=\"justify-start h-auto py-3\" onClick={() => onAdd('trigger', { event: 'onInvoiceDue' })}>\r\n                                <Smartphone className=\"mr-2 h-4 w-4\" /> Fatura Vencendo\r\n                            </Button>\r\n                        </div>\r\n                    ) : (\r\n                        <Tabs defaultValue=\"action\">\r\n                            <TabsList className=\"grid w-full grid-cols-2\">\r\n                                <TabsTrigger value=\"action\">A├º├úo</TabsTrigger>\r\n                                <TabsTrigger value=\"condition\">Condi├º├úo</TabsTrigger>\r\n                            </TabsList>\r\n                            <TabsContent value=\"action\" className=\"space-y-2\">\r\n                                <Button variant=\"outline\" className=\"w-full justify-start\" onClick={() => onAdd('action', { action_type: 'send_whatsapp', message_type: 'operacional', template: 'Ol├í {{paciente_nome}}, seu agendamento est├í confirmado!' })}>\r\n                                    <MessageSquare className=\"mr-2 h-4 w-4\" /> Enviar WhatsApp\r\n                                </Button>\r\n                                <Button variant=\"outline\" className=\"w-full justify-start\" onClick={() => onAdd('action', { action_type: 'send_email', template: 'Lembrete de consulta' })}>\r\n                                    <Mail className=\"mr-2 h-4 w-4\" /> Enviar E-mail\r\n                                </Button>\r\n                                <Button variant=\"outline\" className=\"w-full justify-start\" onClick={() => onAdd('action', { action_type: 'buscar_encaixe', expira_minutos: 30 })}>\r\n                                    <UserPlus className=\"mr-2 h-4 w-4\" /> Buscar Encaixe Autom├ítico\r\n                                </Button>\r\n                                <Button variant=\"outline\" className=\"w-full justify-start\" onClick={() => onAdd('action', { action_type: 'add_lista_espera' })}>\r\n                                    <ListPlus className=\"mr-2 h-4 w-4\" /> Adicionar ├á Lista de Espera\r\n                                </Button>\r\n                            </TabsContent>\r\n                            <TabsContent value=\"condition\" className=\"space-y-2\">\r\n                                <Button variant=\"outline\" className=\"w-full justify-start\" onClick={() => onAdd('condition', { condition_type: 'check_risk_noshow', threshold: 70 })}>\r\n                                    <GitBranch className=\"mr-2 h-4 w-4\" /> Risco de No-Show Alto\r\n                                </Button>\r\n                                <Button variant=\"outline\" className=\"w-full justify-start\" onClick={() => onAdd('condition', { condition_type: 'check_unit' })}>\r\n                                    <Settings className=\"mr-2 h-4 w-4\" /> Verificar Unidade\r\n                                </Button>\r\n                            </TabsContent>\r\n                        </Tabs>\r\n                    )}\r\n                </div>\r\n            </DialogContent>\r\n        </Dialog>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\ChangePassword.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\Coupons.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\Dashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\GovernancaTenant.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\Index.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'checkAccess'. Either include it or remove the dependency array.","line":43,"column":6,"nodeType":"ArrayExpression","endLine":43,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [checkAccess]","fix":{"range":[2045,2047],"text":"[checkAccess]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useState } from \"react\";\nimport { useNavigate } from \"react-router-dom\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { AdminLayout } from \"@/components/layout/AdminLayout\";\nimport { Card } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { TicketList } from \"@/components/admin/TicketList\";\nimport { ActionLogs } from \"@/components/admin/ActionLogs\";\nimport { TenantManagement } from \"@/components/admin/TenantManagement\";\nimport { PlanManagement } from \"@/components/admin/PlanManagement\";\nimport { SupportTeamManagement } from \"@/components/admin/SupportTeamManagement\";\nimport { SupportPermissionsManagement } from \"@/components/admin/SupportPermissionsManagement\";\nimport { MacroManager } from \"@/components/admin/MacroManager\";\nimport { AdminWhatsAppManagement } from \"@/components/admin/AdminWhatsAppManagement\";\nimport { IntegrationsConfig } from \"@/components/admin/IntegrationsConfig\";\nimport { Ticket, Activity, Users, Package, UserCog, Shield, FileText, BarChart3, MessageSquare, Settings } from \"lucide-react\";\nimport { toast } from \"sonner\";\nimport { ChatNotificationBell } from \"@/components/admin/ChatNotificationBell\";\nimport { DashboardCards } from \"@/components/admin/DashboardCards\";\nimport { MyQueueList } from \"@/components/admin/MyQueueList\";\nimport { DashboardFilters } from \"@/components/admin/DashboardFilters\";\nimport { AdminThemeToggle } from \"@/components/admin/AdminThemeToggle\";\nimport { useKeyboardShortcuts } from \"@/hooks/useKeyboardShortcuts\";\n\nconst AdminIndex = () => {\n  const navigate = useNavigate();\n  const [hasAccess, setHasAccess] = useState(false);\n  const [loading, setLoading] = useState(true);\n  const [stats, setStats] = useState({\n    openTickets: 0,\n    inProgressTickets: 0,\n    totalTenants: 0,\n    activePlans: 0,\n  });\n\n  // Keyboard shortcuts\n  useKeyboardShortcuts();\n\n  useEffect(() => {\n    checkAccess();\n    loadStats();\n  }, []);\n\n  const checkAccess = async () => {\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n\n      if (!user) {\n        toast.error(\"Voc├¬ precisa estar logado para acessar esta p├ígina\");\n        navigate(\"/login\");\n        return;\n      }\n\n      const { data: systemUser, error } = await supabase\n        .from(\"system_users\")\n        .select(\"system_role, active\")\n        .eq(\"id\", user.id)\n        .maybeSingle();\n\n      if (error) {\n        console.error(\"Error checking access:\", error);\n        toast.error(\"Erro ao verificar permiss├Áes\");\n        navigate(\"/\");\n        return;\n      }\n\n      if (!systemUser) {\n        toast.error(\"Acesso negado: voc├¬ n├úo ├® um usu├írio de suporte\");\n        navigate(\"/\");\n        return;\n      }\n\n      if (!systemUser.active) {\n        toast.error(\"Acesso negado: sua conta de suporte est├í inativa\");\n        navigate(\"/\");\n        return;\n      }\n\n      if (!['master', 'support', 'support_basic', 'support_intermediate'].includes(systemUser.system_role)) {\n        toast.error(\"Acesso negado: permiss├Áes insuficientes\");\n        navigate(\"/\");\n        return;\n      }\n\n      setHasAccess(true);\n    } catch (error) {\n      console.error(\"Error checking access:\", error);\n      toast.error(\"Erro ao verificar acesso\");\n      navigate(\"/\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const loadStats = async () => {\n    try {\n      const [ticketsOpen, ticketsProgress, tenants, plans] = await Promise.all([\n        supabase.from(\"support_tickets\").select(\"id\", { count: \"exact\" }).eq(\"status\", \"open\"),\n        supabase.from(\"support_tickets\").select(\"id\", { count: \"exact\" }).eq(\"status\", \"in_progress\"),\n        supabase.from(\"tenants\").select(\"id\", { count: \"exact\" }),\n        supabase.from(\"subscriptions\").select(\"id\", { count: \"exact\" }).eq(\"status\", \"active\"),\n      ]);\n\n      setStats({\n        openTickets: ticketsOpen.count || 0,\n        inProgressTickets: ticketsProgress.count || 0,\n        totalTenants: tenants.count || 0,\n        activePlans: plans.count || 0,\n      });\n    } catch (error) {\n      console.error(\"Error loading stats:\", error);\n    }\n  };\n\n  if (loading) {\n    return <div className=\"flex items-center justify-center min-h-screen\">Carregando...</div>;\n  }\n\n  if (!hasAccess) {\n    return null;\n  }\n\n  return (\n    <AdminLayout>\n      <div className=\"p-8\">\n        <div className=\"max-w-7xl mx-auto\">\n          <header className=\"mb-8\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <h1 className=\"text-4xl font-bold text-foreground mb-2\">Painel de Suporte</h1>\n                <p className=\"text-muted-foreground\">Gerencie tickets, usu├írios e configura├º├Áes do sistema</p>\n              </div>\n            </div>\n          </header>\n\n          <DashboardCards />\n\n          <DashboardFilters />\n\n          <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8\">\n            <div className=\"lg:col-span-1\">\n              <MyQueueList />\n            </div>\n\n            <div className=\"lg:col-span-2\">\n              <Card className=\"p-6\">\n                <h3 className=\"text-lg font-semibold mb-4\">Estat├¡sticas Gerais</h3>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  <div>\n                    <p className=\"text-sm text-muted-foreground\">Tickets Abertos</p>\n                    <p className=\"text-2xl font-bold\">{stats.openTickets}</p>\n                  </div>\n                  <div>\n                    <p className=\"text-sm text-muted-foreground\">Em Progresso</p>\n                    <p className=\"text-2xl font-bold\">{stats.inProgressTickets}</p>\n                  </div>\n                  <div>\n                    <p className=\"text-sm text-muted-foreground\">Total de Tenants</p>\n                    <p className=\"text-2xl font-bold\">{stats.totalTenants}</p>\n                  </div>\n                  <div>\n                    <p className=\"text-sm text-muted-foreground\">Planos Ativos</p>\n                    <p className=\"text-2xl font-bold\">{stats.activePlans}</p>\n                  </div>\n                </div>\n              </Card>\n            </div>\n          </div>\n\n          <Tabs defaultValue=\"tickets\" className=\"space-y-4\">\n            <TabsList className=\"grid grid-cols-9 w-full\">\n              <TabsTrigger value=\"tickets\">Tickets</TabsTrigger>\n              <TabsTrigger value=\"macros\">Macros</TabsTrigger>\n              <TabsTrigger value=\"logs\">Logs</TabsTrigger>\n              <TabsTrigger value=\"tenants\">Tenants</TabsTrigger>\n              <TabsTrigger value=\"plans\">Planos</TabsTrigger>\n              <TabsTrigger value=\"team\">Equipe</TabsTrigger>\n              <TabsTrigger value=\"permissions\">Permiss├Áes</TabsTrigger>\n              <TabsTrigger value=\"whatsapp\">\n                <MessageSquare className=\"h-4 w-4 mr-2\" />\n                WhatsApp\n              </TabsTrigger>\n              <TabsTrigger value=\"integrations\">\n                <Settings className=\"h-4 w-4 mr-2\" />\n                Integra├º├Áes\n              </TabsTrigger>\n            </TabsList>\n\n            <TabsContent value=\"tickets\">\n              <TicketList onStatsUpdate={loadStats} />\n            </TabsContent>\n\n            <TabsContent value=\"macros\">\n              <MacroManager />\n            </TabsContent>\n\n            <TabsContent value=\"logs\">\n              <ActionLogs />\n            </TabsContent>\n\n            <TabsContent value=\"tenants\">\n              <TenantManagement />\n            </TabsContent>\n\n            <TabsContent value=\"plans\">\n              <PlanManagement />\n            </TabsContent>\n\n            <TabsContent value=\"team\">\n              <SupportTeamManagement />\n            </TabsContent>\n\n            <TabsContent value=\"permissions\">\n              <SupportPermissionsManagement />\n            </TabsContent>\n\n            <TabsContent value=\"whatsapp\">\n              <AdminWhatsAppManagement />\n            </TabsContent>\n\n            <TabsContent value=\"integrations\">\n              <IntegrationsConfig />\n            </TabsContent>\n          </Tabs>\n        </div>\n      </div>\n    </AdminLayout>\n  );\n};\n\nexport default AdminIndex;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\IntegracoesApi.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadKeys'. Either include it or remove the dependency array.","line":51,"column":8,"nodeType":"ArrayExpression","endLine":51,"endColumn":18,"suggestions":[{"desc":"Update the dependencies array to be: [loadKeys, tenantId]","fix":{"range":[2256,2266],"text":"[loadKeys, tenantId]"}}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadWebhooks'. Either include it or remove the dependency array.","line":186,"column":8,"nodeType":"ArrayExpression","endLine":186,"endColumn":18,"suggestions":[{"desc":"Update the dependencies array to be: [loadWebhooks, tenantId]","fix":{"range":[8385,8395],"text":"[loadWebhooks, tenantId]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\nimport { Card, CardContent, CardHeader, CardTitle, CardDescription } from \"@/components/ui/card\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";\r\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from \"@/components/ui/dialog\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Switch } from \"@/components/ui/switch\";\r\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useAuth } from \"@/hooks/useAuth\";\r\nimport { toast } from \"sonner\";\r\nimport { Key, Webhook, Plus, Copy, Trash2, RefreshCw, Eye, EyeOff } from \"lucide-react\";\r\n\r\nexport default function IntegracoesApi() {\r\n    const { profile } = useAuth();\r\n\r\n    return (\r\n        <div className=\"container mx-auto p-6 space-y-8\">\r\n            <div>\r\n                <h1 className=\"text-3xl font-bold tracking-tight\">Integra├º├Áes & API</h1>\r\n                <p className=\"text-muted-foreground\">Gerencie chaves de API e Webhooks para integrar com sistemas externos.</p>\r\n            </div>\r\n\r\n            <Tabs defaultValue=\"apikeys\" className=\"space-y-4\">\r\n                <TabsList>\r\n                    <TabsTrigger value=\"apikeys\">Chaves de API</TabsTrigger>\r\n                    <TabsTrigger value=\"webhooks\">Webhooks</TabsTrigger>\r\n                </TabsList>\r\n\r\n                <TabsContent value=\"apikeys\">\r\n                    <ApiKeysManager tenantId={profile?.tenant_id} />\r\n                </TabsContent>\r\n\r\n                <TabsContent value=\"webhooks\">\r\n                    <WebhooksManager tenantId={profile?.tenant_id} />\r\n                </TabsContent>\r\n            </Tabs>\r\n        </div>\r\n    );\r\n}\r\n\r\nfunction ApiKeysManager({ tenantId }: { tenantId: string }) {\r\n    const [keys, setKeys] = useState<any[]>([]);\r\n    const [loading, setLoading] = useState(true);\r\n    const [newKey, setNewKey] = useState<string | null>(null);\r\n\r\n    useEffect(() => {\r\n        if (tenantId) loadKeys();\r\n    }, [tenantId]);\r\n\r\n    const loadKeys = async () => {\r\n        setLoading(true);\r\n        const { data } = await supabase\r\n            .from('api_keys')\r\n            .select('*')\r\n            .eq('tenant_id', tenantId)\r\n            .order('created_at', { ascending: false });\r\n        setKeys(data || []);\r\n        setLoading(false);\r\n    };\r\n\r\n    const handleCreateKey = async (nome: string) => {\r\n        try {\r\n            // Gerar chave no cliente (apenas para demonstra├º├úo, idealmente backend retornaria)\r\n            // Formato: sk_live_RANDOM\r\n            const randomPart = Array.from(crypto.getRandomValues(new Uint8Array(24)))\r\n                .map(b => b.toString(16).padStart(2, '0')).join('');\r\n            const rawKey = `sk_live_${randomPart}`;\r\n\r\n            // Hash SHA-256\r\n            const encoder = new TextEncoder();\r\n            const data = encoder.encode(rawKey);\r\n            const hashBuffer = await crypto.subtle.digest('SHA-256', data);\r\n            const hashArray = Array.from(new Uint8Array(hashBuffer));\r\n            const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');\r\n\r\n            const { data: keyData, error } = await supabase.from('api_keys').insert({\r\n                tenant_id: tenantId,\r\n                nome,\r\n                chave_hash: hashHex,\r\n                prefixo: `sk_live_...${randomPart.slice(-4)}`\r\n            }).select().single();\r\n\r\n            if (error) throw error;\r\n\r\n            // Log de auditoria\r\n            await supabase.from('system_logs').insert({\r\n                tenant_id: tenantId,\r\n                event_type: 'api_key_created',\r\n                details: { key_id: keyData.id, key_name: nome }\r\n            });\r\n\r\n            setNewKey(rawKey); // Mostrar chave completa UMA VEZ\r\n            loadKeys();\r\n            toast.success(\"Chave de API criada com sucesso!\");\r\n        } catch (error) {\r\n            console.error(error);\r\n            toast.error(\"Erro ao criar chave.\");\r\n        }\r\n    };\r\n\r\n    const handleRevoke = async (id: string) => {\r\n        await supabase.from('api_keys').delete().eq('id', id);\r\n        loadKeys();\r\n        toast.success(\"Chave revogada.\");\r\n    };\r\n\r\n    return (\r\n        <Card>\r\n            <CardHeader className=\"flex flex-row items-center justify-between\">\r\n                <div>\r\n                    <CardTitle>Chaves de API</CardTitle>\r\n                    <CardDescription>Use estas chaves para autenticar requisi├º├Áes ├á nossa API p├║blica.</CardDescription>\r\n                </div>\r\n                <NewKeyDialog onCreate={handleCreateKey} />\r\n            </CardHeader>\r\n            <CardContent>\r\n                {newKey && (\r\n                    <div className=\"mb-6 p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 rounded-lg\">\r\n                        <h4 className=\"font-semibold text-green-800 dark:text-green-300 mb-2\">Nova Chave Gerada</h4>\r\n                        <p className=\"text-sm text-green-700 dark:text-green-400 mb-3\">\r\n                            Copie esta chave agora. Voc├¬ n├úo poder├í v├¬-la novamente.\r\n                        </p>\r\n                        <div className=\"flex items-center gap-2\">\r\n                            <code className=\"bg-white dark:bg-slate-950 p-2 rounded border flex-1 font-mono text-sm break-all\">\r\n                                {newKey}\r\n                            </code>\r\n                            <Button size=\"icon\" variant=\"outline\" onClick={() => {\r\n                                navigator.clipboard.writeText(newKey);\r\n                                toast.success(\"Copiado!\");\r\n                            }}>\r\n                                <Copy className=\"h-4 w-4\" />\r\n                            </Button>\r\n                        </div>\r\n                    </div>\r\n                )}\r\n\r\n                <Table>\r\n                    <TableHeader>\r\n                        <TableRow>\r\n                            <TableHead>Nome</TableHead>\r\n                            <TableHead>Prefixo</TableHead>\r\n                            <TableHead>Criado em</TableHead>\r\n                            <TableHead>├Ültimo uso</TableHead>\r\n                            <TableHead className=\"text-right\">A├º├Áes</TableHead>\r\n                        </TableRow>\r\n                    </TableHeader>\r\n                    <TableBody>\r\n                        {keys.map(key => (\r\n                            <TableRow key={key.id}>\r\n                                <TableCell className=\"font-medium\">{key.nome}</TableCell>\r\n                                <TableCell className=\"font-mono text-xs\">{key.prefixo}</TableCell>\r\n                                <TableCell>{new Date(key.created_at).toLocaleDateString()}</TableCell>\r\n                                <TableCell>\r\n                                    {key.last_used_at ? new Date(key.last_used_at).toLocaleString() : '-'}\r\n                                </TableCell>\r\n                                <TableCell className=\"text-right\">\r\n                                    <Button variant=\"ghost\" size=\"icon\" className=\"text-destructive\" onClick={() => handleRevoke(key.id)}>\r\n                                        <Trash2 className=\"h-4 w-4\" />\r\n                                    </Button>\r\n                                </TableCell>\r\n                            </TableRow>\r\n                        ))}\r\n                        {keys.length === 0 && !loading && (\r\n                            <TableRow>\r\n                                <TableCell colSpan={5} className=\"text-center text-muted-foreground py-8\">\r\n                                    Nenhuma chave de API ativa.\r\n                                </TableCell>\r\n                            </TableRow>\r\n                        )}\r\n                    </TableBody>\r\n                </Table>\r\n            </CardContent>\r\n        </Card>\r\n    );\r\n}\r\n\r\nfunction WebhooksManager({ tenantId }: { tenantId: string }) {\r\n    const [webhooks, setWebhooks] = useState<any[]>([]);\r\n    const [loading, setLoading] = useState(true);\r\n\r\n    useEffect(() => {\r\n        if (tenantId) loadWebhooks();\r\n    }, [tenantId]);\r\n\r\n    const loadWebhooks = async () => {\r\n        setLoading(true);\r\n        const { data } = await supabase\r\n            .from('webhook_subscriptions')\r\n            .select('*')\r\n            .eq('tenant_id', tenantId)\r\n            .order('created_at', { ascending: false });\r\n        setWebhooks(data || []);\r\n        setLoading(false);\r\n    };\r\n\r\n    const handleCreateWebhook = async (url: string, events: string[]) => {\r\n        try {\r\n            // Gerar segredo aleat├│rio\r\n            const secret = Array.from(crypto.getRandomValues(new Uint8Array(32)))\r\n                .map(b => b.toString(16).padStart(2, '0')).join('');\r\n\r\n            const { data: webhookData, error } = await supabase.from('webhook_subscriptions').insert({\r\n                tenant_id: tenantId,\r\n                url,\r\n                event_types: events,\r\n                segredo: secret\r\n            }).select().single();\r\n\r\n            if (error) throw error;\r\n\r\n            // Log de auditoria\r\n            await supabase.from('system_logs').insert({\r\n                tenant_id: tenantId,\r\n                event_type: 'webhook_created',\r\n                details: { webhook_id: webhookData.id, url, events }\r\n            });\r\n\r\n            loadWebhooks();\r\n            toast.success(\"Webhook criado com sucesso!\");\r\n        } catch (error) {\r\n            toast.error(\"Erro ao criar webhook.\");\r\n        }\r\n    };\r\n\r\n    const handleDelete = async (id: string) => {\r\n        await supabase.from('webhook_subscriptions').delete().eq('id', id);\r\n        loadWebhooks();\r\n        toast.success(\"Webhook removido.\");\r\n    };\r\n\r\n    return (\r\n        <Card>\r\n            <CardHeader className=\"flex flex-row items-center justify-between\">\r\n                <div>\r\n                    <CardTitle>Webhooks</CardTitle>\r\n                    <CardDescription>Receba notifica├º├Áes em tempo real sobre eventos do sistema.</CardDescription>\r\n                </div>\r\n                <NewWebhookDialog onCreate={handleCreateWebhook} />\r\n            </CardHeader>\r\n            <CardContent>\r\n                <Table>\r\n                    <TableHeader>\r\n                        <TableRow>\r\n                            <TableHead>URL</TableHead>\r\n                            <TableHead>Eventos</TableHead>\r\n                            <TableHead>Status</TableHead>\r\n                            <TableHead>Segredo</TableHead>\r\n                            <TableHead className=\"text-right\">A├º├Áes</TableHead>\r\n                        </TableRow>\r\n                    </TableHeader>\r\n                    <TableBody>\r\n                        {webhooks.map(wh => (\r\n                            <TableRow key={wh.id}>\r\n                                <TableCell className=\"font-mono text-xs max-w-[200px] truncate\" title={wh.url}>\r\n                                    {wh.url}\r\n                                </TableCell>\r\n                                <TableCell>\r\n                                    <div className=\"flex flex-wrap gap-1\">\r\n                                        {wh.event_types.map((ev: string) => (\r\n                                            <Badge key={ev} variant=\"secondary\" className=\"text-[10px]\">{ev}</Badge>\r\n                                        ))}\r\n                                    </div>\r\n                                </TableCell>\r\n                                <TableCell>\r\n                                    <Badge variant={wh.ativo ? \"default\" : \"secondary\"}>\r\n                                        {wh.ativo ? \"Ativo\" : \"Inativo\"}\r\n                                    </Badge>\r\n                                </TableCell>\r\n                                <TableCell>\r\n                                    <div className=\"flex items-center gap-2\">\r\n                                        <code className=\"text-xs bg-muted p-1 rounded\">\r\n                                            {wh.segredo.slice(0, 8)}...\r\n                                        </code>\r\n                                        <Button size=\"icon\" variant=\"ghost\" className=\"h-6 w-6\" onClick={() => {\r\n                                            navigator.clipboard.writeText(wh.segredo);\r\n                                            toast.success(\"Segredo copiado!\");\r\n                                        }}>\r\n                                            <Copy className=\"h-3 w-3\" />\r\n                                        </Button>\r\n                                    </div>\r\n                                </TableCell>\r\n                                <TableCell className=\"text-right\">\r\n                                    <Button variant=\"ghost\" size=\"icon\" className=\"text-destructive\" onClick={() => handleDelete(wh.id)}>\r\n                                        <Trash2 className=\"h-4 w-4\" />\r\n                                    </Button>\r\n                                </TableCell>\r\n                            </TableRow>\r\n                        ))}\r\n                        {webhooks.length === 0 && !loading && (\r\n                            <TableRow>\r\n                                <TableCell colSpan={5} className=\"text-center text-muted-foreground py-8\">\r\n                                    Nenhum webhook configurado.\r\n                                </TableCell>\r\n                            </TableRow>\r\n                        )}\r\n                    </TableBody>\r\n                </Table>\r\n            </CardContent>\r\n        </Card>\r\n    );\r\n}\r\n\r\nfunction NewKeyDialog({ onCreate }: { onCreate: (nome: string) => void }) {\r\n    const [open, setOpen] = useState(false);\r\n    const [nome, setNome] = useState('');\r\n\r\n    const handleSubmit = (e: React.FormEvent) => {\r\n        e.preventDefault();\r\n        onCreate(nome);\r\n        setOpen(false);\r\n        setNome('');\r\n    };\r\n\r\n    return (\r\n        <Dialog open={open} onOpenChange={setOpen}>\r\n            <DialogTrigger asChild>\r\n                <Button><Plus className=\"mr-2 h-4 w-4\" /> Nova Chave</Button>\r\n            </DialogTrigger>\r\n            <DialogContent>\r\n                <DialogHeader>\r\n                    <DialogTitle>Criar Chave de API</DialogTitle>\r\n                </DialogHeader>\r\n                <form onSubmit={handleSubmit} className=\"space-y-4\">\r\n                    <div>\r\n                        <Label>Nome da Chave</Label>\r\n                        <Input value={nome} onChange={e => setNome(e.target.value)} placeholder=\"Ex: Integra├º├úo CRM\" required />\r\n                    </div>\r\n                    <Button type=\"submit\" className=\"w-full\">Gerar Chave</Button>\r\n                </form>\r\n            </DialogContent>\r\n        </Dialog>\r\n    );\r\n}\r\n\r\nfunction NewWebhookDialog({ onCreate }: { onCreate: (url: string, events: string[]) => void }) {\r\n    const [open, setOpen] = useState(false);\r\n    const [url, setUrl] = useState('');\r\n    const [selectedEvents, setSelectedEvents] = useState<string[]>([]);\r\n\r\n    const availableEvents = [\r\n        'appointment.created',\r\n        'appointment.updated',\r\n        'appointment.no_show',\r\n        'invoice.paid'\r\n    ];\r\n\r\n    const handleSubmit = (e: React.FormEvent) => {\r\n        e.preventDefault();\r\n        if (selectedEvents.length === 0) {\r\n            toast.error(\"Selecione pelo menos um evento\");\r\n            return;\r\n        }\r\n        onCreate(url, selectedEvents);\r\n        setOpen(false);\r\n        setUrl('');\r\n        setSelectedEvents([]);\r\n    };\r\n\r\n    const toggleEvent = (ev: string) => {\r\n        if (selectedEvents.includes(ev)) {\r\n            setSelectedEvents(selectedEvents.filter(e => e !== ev));\r\n        } else {\r\n            setSelectedEvents([...selectedEvents, ev]);\r\n        }\r\n    };\r\n\r\n    return (\r\n        <Dialog open={open} onOpenChange={setOpen}>\r\n            <DialogTrigger asChild>\r\n                <Button><Plus className=\"mr-2 h-4 w-4\" /> Novo Webhook</Button>\r\n            </DialogTrigger>\r\n            <DialogContent>\r\n                <DialogHeader>\r\n                    <DialogTitle>Adicionar Webhook</DialogTitle>\r\n                </DialogHeader>\r\n                <form onSubmit={handleSubmit} className=\"space-y-4\">\r\n                    <div>\r\n                        <Label>URL de Destino</Label>\r\n                        <Input value={url} onChange={e => setUrl(e.target.value)} placeholder=\"https://api.seusistema.com/webhook\" required type=\"url\" />\r\n                    </div>\r\n                    <div>\r\n                        <Label className=\"mb-2 block\">Eventos</Label>\r\n                        <div className=\"space-y-2\">\r\n                            {availableEvents.map(ev => (\r\n                                <div key={ev} className=\"flex items-center space-x-2\">\r\n                                    <Switch\r\n                                        id={ev}\r\n                                        checked={selectedEvents.includes(ev)}\r\n                                        onCheckedChange={() => toggleEvent(ev)}\r\n                                    />\r\n                                    <Label htmlFor={ev} className=\"font-normal cursor-pointer\">{ev}</Label>\r\n                                </div>\r\n                            ))}\r\n                        </div>\r\n                    </div>\r\n                    <Button type=\"submit\" className=\"w-full\">Salvar Webhook</Button>\r\n                </form>\r\n            </DialogContent>\r\n        </Dialog>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\Integrations.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\ListaEsperaManager.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadData'. Either include it or remove the dependency array.","line":50,"column":6,"nodeType":"ArrayExpression","endLine":50,"endColumn":26,"suggestions":[{"desc":"Update the dependencies array to be: [loadData, profile?.tenant_id]","fix":{"range":[1483,1503],"text":"[loadData, profile?.tenant_id]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\r\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport {\r\n  Select,\r\n  SelectContent,\r\n  SelectItem,\r\n  SelectTrigger,\r\n  SelectValue,\r\n} from \"@/components/ui/select\";\r\nimport {\r\n  Dialog,\r\n  DialogContent,\r\n  DialogHeader,\r\n  DialogTitle,\r\n  DialogTrigger,\r\n} from \"@/components/ui/dialog\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useAuth } from \"@/hooks/useAuth\";\r\nimport { toast } from \"sonner\";\r\nimport {\r\n  Plus,\r\n  UserPlus,\r\n  Clock,\r\n  AlertCircle,\r\n  CheckCircle2,\r\n  XCircle,\r\n  TrendingUp,\r\n  Users,\r\n  Calendar,\r\n  BarChart3,\r\n} from \"lucide-react\";\r\nimport { EncaixeAutomaticoService } from \"@/domain/encaixe/EncaixeAutomaticoService\";\r\nimport { ListaEspera, EncaixeAnalytics } from \"@/domain/encaixe/types\";\r\n\r\nexport default function ListaEsperaManager() {\r\n  const { profile } = useAuth();\r\n  const [listaEspera, setListaEspera] = useState<ListaEspera[]>([]);\r\n  const [analytics, setAnalytics] = useState<EncaixeAnalytics | null>(null);\r\n  const [loading, setLoading] = useState(true);\r\n\r\n  useEffect(() => {\r\n    if (profile?.tenant_id) {\r\n      loadData();\r\n    }\r\n  }, [profile?.tenant_id]);\r\n\r\n  const loadData = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      // Carregar lista de espera\r\n      const { data: lista, error: listaError } = await supabase\r\n        .from(\"lista_espera\")\r\n        .select(\r\n          `\r\n          *,\r\n          pacientes(id, nome, telefone),\r\n          profiles(nome),\r\n          servicos(nome)\r\n        `,\r\n        )\r\n        .eq(\"tenant_id\", profile.tenant_id)\r\n        .eq(\"ativo\", true)\r\n        .order(\"prioridade\", { ascending: false })\r\n        .order(\"created_at\", { ascending: true });\r\n\r\n      if (listaError) throw listaError;\r\n      setListaEspera(lista || []);\r\n\r\n      // Carregar analytics\r\n      const analyticsData = await EncaixeAutomaticoService.obterAnalytics(\r\n        profile.tenant_id,\r\n      );\r\n      setAnalytics(analyticsData);\r\n    } catch (error) {\r\n      console.error(\"Erro ao carregar dados:\", error);\r\n      toast.error(\"Erro ao carregar lista de espera\");\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  const handleAdicionarListaEspera = async (\r\n    pacienteId: string,\r\n    dados: Partial<ListaEspera>,\r\n  ) => {\r\n    try {\r\n      await EncaixeAutomaticoService.adicionarListaEspera({\r\n        tenant_id: profile.tenant_id,\r\n        paciente_id: pacienteId,\r\n        ...dados,\r\n      });\r\n\r\n      toast.success(\"Paciente adicionado ├á lista de espera\");\r\n      loadData();\r\n    } catch (error) {\r\n      toast.error(\"Erro ao adicionar ├á lista de espera\");\r\n    }\r\n  };\r\n\r\n  const handleRemoverListaEspera = async (id: string) => {\r\n    try {\r\n      await supabase.from(\"lista_espera\").update({ ativo: false }).eq(\"id\", id);\r\n\r\n      toast.success(\"Removido da lista de espera\");\r\n      loadData();\r\n    } catch (error) {\r\n      toast.error(\"Erro ao remover da lista\");\r\n    }\r\n  };\r\n\r\n  const getPrioridadeBadge = (prioridade: number) => {\r\n    switch (prioridade) {\r\n      case 2:\r\n        return <Badge variant=\"destructive\">Urgente</Badge>;\r\n      case 1:\r\n        return <Badge variant=\"default\">Alta</Badge>;\r\n      default:\r\n        return <Badge variant=\"secondary\">Normal</Badge>;\r\n    }\r\n  };\r\n\r\n  const getTempoEspera = (createdAt: string) => {\r\n    const diff = Date.now() - new Date(createdAt).getTime();\r\n    const dias = Math.floor(diff / (1000 * 60 * 60 * 24));\r\n    const horas = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));\r\n\r\n    if (dias > 0) return `${dias}d ${horas}h`;\r\n    return `${horas}h`;\r\n  };\r\n\r\n  return (\r\n    <div className=\"container mx-auto p-6 space-y-6\">\r\n      {/* Header */}\r\n      <div className=\"flex items-center justify-between\">\r\n        <div>\r\n          <h1 className=\"text-2xl font-bold tracking-tight\">Lista de Espera</h1>\r\n          <p className=\"text-muted-foreground\">\r\n            Gerencie pacientes aguardando encaixe autom├ítico\r\n          </p>\r\n        </div>\r\n        <NovoListaEsperaDialog onAdd={handleAdicionarListaEspera} />\r\n      </div>\r\n\r\n      {/* Analytics Cards */}\r\n      {analytics && (\r\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\r\n          <Card>\r\n            <CardContent className=\"p-6\">\r\n              <div className=\"flex items-center justify-between\">\r\n                <div>\r\n                  <p className=\"text-sm text-muted-foreground\">Na Lista</p>\r\n                  <p className=\"text-2xl font-bold\">\r\n                    {analytics.lista_espera_ativos}\r\n                  </p>\r\n                </div>\r\n                <Users className=\"h-8 w-8 text-blue-500\" />\r\n              </div>\r\n            </CardContent>\r\n          </Card>\r\n\r\n          <Card>\r\n            <CardContent className=\"p-6\">\r\n              <div className=\"flex items-center justify-between\">\r\n                <div>\r\n                  <p className=\"text-sm text-muted-foreground\">\r\n                    Taxa de Aceita├º├úo\r\n                  </p>\r\n                  <p className=\"text-2xl font-bold\">\r\n                    {analytics.taxa_aceitacao_pct}%\r\n                  </p>\r\n                </div>\r\n                <TrendingUp className=\"h-8 w-8 text-green-500\" />\r\n              </div>\r\n            </CardContent>\r\n          </Card>\r\n\r\n          <Card>\r\n            <CardContent className=\"p-6\">\r\n              <div className=\"flex items-center justify-between\">\r\n                <div>\r\n                  <p className=\"text-sm text-muted-foreground\">\r\n                    Ofertas Aceitas\r\n                  </p>\r\n                  <p className=\"text-2xl font-bold\">\r\n                    {analytics.ofertas_aceitas}\r\n                  </p>\r\n                </div>\r\n                <CheckCircle2 className=\"h-8 w-8 text-green-500\" />\r\n              </div>\r\n            </CardContent>\r\n          </Card>\r\n\r\n          <Card>\r\n            <CardContent className=\"p-6\">\r\n              <div className=\"flex items-center justify-between\">\r\n                <div>\r\n                  <p className=\"text-sm text-muted-foreground\">\r\n                    Tempo M├®dio Resposta\r\n                  </p>\r\n                  <p className=\"text-2xl font-bold\">\r\n                    {Math.round(analytics.tempo_medio_resposta_min || 0)}min\r\n                  </p>\r\n                </div>\r\n                <Clock className=\"h-8 w-8 text-orange-500\" />\r\n              </div>\r\n            </CardContent>\r\n          </Card>\r\n        </div>\r\n      )}\r\n\r\n      {/* Lista de Espera */}\r\n      <Card>\r\n        <CardHeader>\r\n          <CardTitle>Pacientes Aguardando</CardTitle>\r\n        </CardHeader>\r\n        <CardContent>\r\n          {loading ? (\r\n            <div className=\"text-center py-8\">Carregando...</div>\r\n          ) : listaEspera.length === 0 ? (\r\n            <div className=\"text-center py-12 text-muted-foreground\">\r\n              <UserPlus className=\"h-12 w-12 mx-auto mb-4 opacity-50\" />\r\n              <p>Nenhum paciente na lista de espera</p>\r\n            </div>\r\n          ) : (\r\n            <div className=\"space-y-3\">\r\n              {listaEspera.map((item: any) => (\r\n                <div\r\n                  key={item.id}\r\n                  className=\"flex items-center justify-between p-4 border rounded-lg hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors\"\r\n                >\r\n                  <div className=\"flex-1\">\r\n                    <div className=\"flex items-center gap-3 mb-2\">\r\n                      <h3 className=\"font-semibold\">{item.pacientes?.nome}</h3>\r\n                      {getPrioridadeBadge(item.prioridade)}\r\n                      <Badge variant=\"outline\">\r\n                        <Clock className=\"h-3 w-3 mr-1\" />\r\n                        {getTempoEspera(item.created_at)}\r\n                      </Badge>\r\n                    </div>\r\n                    <div className=\"text-sm text-muted-foreground space-y-1\">\r\n                      <p>­ƒô× {item.pacientes?.telefone}</p>\r\n                      {item.profiles && (\r\n                        <p>­ƒæ¿ÔÇìÔÜò´©Å Profissional: {item.profiles.nome}</p>\r\n                      )}\r\n                      {item.servicos && <p>­ƒöº Servi├ºo: {item.servicos.nome}</p>}\r\n                      {item.periodo_preferencial && (\r\n                        <p>­ƒòÉ Per├¡odo: {item.periodo_preferencial}</p>\r\n                      )}\r\n                      {item.observacoes && (\r\n                        <p className=\"text-xs\">­ƒÆ¼ {item.observacoes}</p>\r\n                      )}\r\n                    </div>\r\n                  </div>\r\n                  <Button\r\n                    variant=\"ghost\"\r\n                    size=\"sm\"\r\n                    onClick={() => handleRemoverListaEspera(item.id)}\r\n                  >\r\n                    <XCircle className=\"h-4 w-4\" />\r\n                  </Button>\r\n                </div>\r\n              ))}\r\n            </div>\r\n          )}\r\n        </CardContent>\r\n      </Card>\r\n    </div>\r\n  );\r\n}\r\n\r\nfunction NovoListaEsperaDialog({\r\n  onAdd,\r\n}: {\r\n  onAdd: (pacienteId: string, dados: any) => void;\r\n}) {\r\n  const [open, setOpen] = useState(false);\r\n  const [pacienteId, setPacienteId] = useState(\"\");\r\n  const [prioridade, setPrioridade] = useState(\"0\");\r\n  const [periodo, setPeriodo] = useState(\"qualquer\");\r\n  const [observacoes, setObservacoes] = useState(\"\");\r\n\r\n  const handleSubmit = (e: React.FormEvent) => {\r\n    e.preventDefault();\r\n    onAdd(pacienteId, {\r\n      prioridade: parseInt(prioridade),\r\n      periodo_preferencial: periodo,\r\n      observacoes,\r\n    });\r\n    setOpen(false);\r\n    setPacienteId(\"\");\r\n    setPrioridade(\"0\");\r\n    setPeriodo(\"qualquer\");\r\n    setObservacoes(\"\");\r\n  };\r\n\r\n  return (\r\n    <Dialog open={open} onOpenChange={setOpen}>\r\n      <DialogTrigger asChild>\r\n        <Button>\r\n          <Plus className=\"mr-2 h-4 w-4\" /> Adicionar ├á Lista\r\n        </Button>\r\n      </DialogTrigger>\r\n      <DialogContent>\r\n        <DialogHeader>\r\n          <DialogTitle>Adicionar ├á Lista de Espera</DialogTitle>\r\n        </DialogHeader>\r\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\r\n          <div>\r\n            <Label>Paciente</Label>\r\n            <Input\r\n              placeholder=\"ID do paciente\"\r\n              value={pacienteId}\r\n              onChange={(e) => setPacienteId(e.target.value)}\r\n              required\r\n            />\r\n          </div>\r\n          <div>\r\n            <Label>Prioridade</Label>\r\n            <Select value={prioridade} onValueChange={setPrioridade}>\r\n              <SelectTrigger>\r\n                <SelectValue />\r\n              </SelectTrigger>\r\n              <SelectContent>\r\n                <SelectItem value=\"0\">Normal</SelectItem>\r\n                <SelectItem value=\"1\">Alta</SelectItem>\r\n                <SelectItem value=\"2\">Urgente</SelectItem>\r\n              </SelectContent>\r\n            </Select>\r\n          </div>\r\n          <div>\r\n            <Label>Per├¡odo Preferencial</Label>\r\n            <Select value={periodo} onValueChange={setPeriodo}>\r\n              <SelectTrigger>\r\n                <SelectValue />\r\n              </SelectTrigger>\r\n              <SelectContent>\r\n                <SelectItem value=\"qualquer\">Qualquer</SelectItem>\r\n                <SelectItem value=\"manha\">Manh├ú</SelectItem>\r\n                <SelectItem value=\"tarde\">Tarde</SelectItem>\r\n                <SelectItem value=\"noite\">Noite</SelectItem>\r\n              </SelectContent>\r\n            </Select>\r\n          </div>\r\n          <div>\r\n            <Label>Observa├º├Áes</Label>\r\n            <Input\r\n              placeholder=\"Observa├º├Áes opcionais\"\r\n              value={observacoes}\r\n              onChange={(e) => setObservacoes(e.target.value)}\r\n            />\r\n          </div>\r\n          <Button type=\"submit\" className=\"w-full\">\r\n            Adicionar\r\n          </Button>\r\n        </form>\r\n      </DialogContent>\r\n    </Dialog>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\Login.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'checkExistingAuth' and 'checkSupportUserAndRedirect'. Either include them or remove the dependency array.","line":33,"column":6,"nodeType":"ArrayExpression","endLine":33,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [checkExistingAuth, checkSupportUserAndRedirect]","fix":{"range":[1358,1360],"text":"[checkExistingAuth, checkSupportUserAndRedirect]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\nimport { useNavigate } from \"react-router-dom\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Checkbox } from \"@/components/ui/checkbox\";\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { toast } from \"sonner\";\nimport { Shield, Loader2, Eye, EyeOff } from \"lucide-react\";\nimport { Separator } from \"@/components/ui/separator\";\n\nexport default function AdminLogin() {\n  const navigate = useNavigate();\n  const [email, setEmail] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [rememberMe, setRememberMe] = useState(false);\n  const [loading, setLoading] = useState(false);\n  const [checkingAuth, setCheckingAuth] = useState(true);\n  const [showPassword, setShowPassword] = useState(false);\n\n  useEffect(() => {\n    checkExistingAuth();\n\n    // Listen for auth state changes (OAuth callback)\n    const { data: { subscription } } = supabase.auth.onAuthStateChange(async (event, session) => {\n      if (event === 'SIGNED_IN' && session?.user) {\n        await checkSupportUserAndRedirect(session.user.id);\n      }\n    });\n\n    return () => subscription.unsubscribe();\n  }, []);\n\n  const checkSupportUserAndRedirect = async (userId: string) => {\n    try {\n      const { data: supportUser, error } = await (supabase\n        .from(\"system_users\" as any)\n        .select(\"*\")\n        .eq(\"id\", userId)\n        .maybeSingle() as any);\n\n      if (error) {\n        console.error(\"Error fetching support user:\", error);\n        return;\n      }\n\n      if (!supportUser) {\n        // If user doesn't have support permissions, sign them out\n        await supabase.auth.signOut();\n        toast.error(\"Acesso negado: voc├¬ n├úo tem permiss├Áes de suporte\");\n        return;\n      }\n\n      if (!supportUser.active) {\n        await logAuthEvent(supportUser.id, \"login_falha\", \"Conta de suporte inativa\");\n        await supabase.auth.signOut();\n        toast.error(\"Acesso negado: sua conta est├í inativa\");\n        return;\n      }\n\n      // Log successful login\n      await logAuthEvent(supportUser.id, \"login_sucesso\", \"Login OAuth realizado com sucesso\");\n\n      toast.success(\"Login realizado com sucesso!\");\n      navigate(\"/admin\");\n    } catch (error) {\n      console.error(\"Error in checkSupportUserAndRedirect:\", error);\n    }\n  };\n\n  const checkExistingAuth = async () => {\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n\n      if (user) {\n        await checkSupportUserAndRedirect(user.id);\n        return;\n      }\n    } catch (error) {\n      console.error(\"Error checking auth:\", error);\n    } finally {\n      setCheckingAuth(false);\n    }\n  };\n\n  const logAuthEvent = async (\n    usuarioId: string | null,\n    tipoEvento: string,\n    descricao: string | null = null\n  ) => {\n    try {\n      await (supabase.rpc(\"log_admin_auth_event\" as any, {\n        p_usuario_id: usuarioId,\n        p_tipo_evento: tipoEvento,\n        p_descricao: descricao,\n        p_ip_address: null,\n        p_user_agent: navigator.userAgent,\n        p_metadata: {}\n      }) as any);\n    } catch (error) {\n      console.error(\"Error logging auth event:\", error);\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoading(true);\n\n    try {\n      const { data: authData, error: authError } = await supabase.auth.signInWithPassword({\n        email,\n        password,\n      });\n\n      if (authError) {\n        await logAuthEvent(null, \"login_falha\", `Falha de autentica├º├úo: ${authError.message}`);\n        toast.error(\"Erro ao fazer login: \" + authError.message);\n        return;\n      }\n\n      if (!authData.user) {\n        await logAuthEvent(null, \"login_falha\", \"Usu├írio n├úo encontrado\");\n        toast.error(\"Erro ao fazer login\");\n        return;\n      }\n\n      // Check if user is a support user\n      const { data: supportUser, error: supportError } = await (supabase\n        .from(\"system_users\" as any)\n        .select(\"*\")\n        .eq(\"id\", authData.user.id)\n        .maybeSingle() as any);\n\n      if (supportError) {\n        console.error(\"Error fetching support user:\", supportError);\n        await supabase.auth.signOut();\n        toast.error(\"Erro ao verificar permiss├Áes\");\n        return;\n      }\n\n      if (!supportUser) {\n        await logAuthEvent(null, \"login_falha\", \"Usu├írio n├úo ├® um usu├írio de suporte\");\n        await supabase.auth.signOut();\n        toast.error(\"Acesso negado: voc├¬ n├úo tem permiss├Áes de suporte\");\n        return;\n      }\n\n      if (!supportUser.active) {\n        await logAuthEvent(supportUser.id, \"login_falha\", \"Conta de suporte inativa ou suspensa\");\n        await supabase.auth.signOut();\n        toast.error(\"Acesso negado: sua conta est├í inativa\");\n        return;\n      }\n\n      // Log successful login\n      await logAuthEvent(supportUser.id, \"login_sucesso\", \"Login realizado com sucesso\");\n\n      toast.success(\"Login realizado com sucesso!\");\n      navigate(\"/admin\");\n      return;\n\n\n    } catch (error) {\n      console.error(\"Error during login:\", error);\n      await logAuthEvent(null, \"login_falha\", \"Erro inesperado durante login\");\n      toast.error(\"Erro ao fazer login\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleGoogleLogin = async () => {\n    try {\n      setLoading(true);\n      const { error } = await supabase.auth.signInWithOAuth({\n        provider: 'google',\n        options: {\n          redirectTo: `${window.location.origin}/admin`\n        }\n      });\n\n      if (error) {\n        toast.error(\"Erro ao fazer login com Google: \" + error.message);\n        setLoading(false);\n      }\n      // Don't set loading to false here, as user will be redirected\n    } catch (error) {\n      console.error(\"Error during Google login:\", error);\n      toast.error(\"Erro ao fazer login com Google\");\n      setLoading(false);\n    }\n  };\n\n  if (checkingAuth) {\n    return (\n      <div className=\"min-h-screen flex items-center justify-center bg-background\">\n        <Loader2 className=\"h-8 w-8 animate-spin text-primary\" />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen flex items-center justify-center bg-background p-4\">\n      <Card className=\"w-full max-w-md\">\n        <CardHeader className=\"space-y-1 text-center\">\n          <div className=\"flex justify-center mb-4\">\n            <div className=\"h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center\">\n              <Shield className=\"h-6 w-6 text-primary\" />\n            </div>\n          </div>\n          <CardTitle className=\"text-2xl font-bold\">CleanFlow Admin</CardTitle>\n          <CardDescription>\n            Fa├ºa login para acessar o painel administrativo\n          </CardDescription>\n        </CardHeader>\n        <CardContent>\n          <form onSubmit={handleSubmit} className=\"space-y-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"email\">E-mail</Label>\n              <Input\n                id=\"email\"\n                type=\"email\"\n                placeholder=\"seu@email.com\"\n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                required\n                disabled={loading}\n              />\n            </div>\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"password\">Senha</Label>\n              <div className=\"relative\">\n                <Input\n                  id=\"password\"\n                  type={showPassword ? \"text\" : \"password\"}\n                  placeholder=\"ÔÇóÔÇóÔÇóÔÇóÔÇóÔÇóÔÇóÔÇó\"\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  required\n                  disabled={loading}\n                  className=\"pr-10\"\n                />\n                <button\n                  type=\"button\"\n                  onClick={() => setShowPassword(!showPassword)}\n                  className=\"absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors focus:outline-none\"\n                  aria-label={showPassword ? \"Ocultar senha\" : \"Mostrar senha\"}\n                  disabled={loading}\n                >\n                  {showPassword ? (\n                    <EyeOff className=\"h-4 w-4\" />\n                  ) : (\n                    <Eye className=\"h-4 w-4\" />\n                  )}\n                </button>\n              </div>\n            </div>\n            <div className=\"flex items-center space-x-2\">\n              <Checkbox\n                id=\"remember\"\n                checked={rememberMe}\n                onCheckedChange={(checked) => setRememberMe(checked as boolean)}\n                disabled={loading}\n              />\n              <label\n                htmlFor=\"remember\"\n                className=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70\"\n              >\n                Lembrar de mim\n              </label>\n            </div>\n            <Button type=\"submit\" className=\"w-full\" disabled={loading}>\n              {loading ? (\n                <>\n                  <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n                  Entrando...\n                </>\n              ) : (\n                \"Entrar\"\n              )}\n            </Button>\n\n            <div className=\"relative my-4\">\n              <div className=\"absolute inset-0 flex items-center\">\n                <Separator className=\"w-full\" />\n              </div>\n              <div className=\"relative flex justify-center text-xs uppercase\">\n                <span className=\"bg-background px-2 text-muted-foreground\">\n                  Ou continue com\n                </span>\n              </div>\n            </div>\n\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              className=\"w-full\"\n              onClick={handleGoogleLogin}\n              disabled={loading}\n            >\n              <svg className=\"mr-2 h-4 w-4\" viewBox=\"0 0 24 24\">\n                <path\n                  fill=\"currentColor\"\n                  d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"\n                />\n                <path\n                  fill=\"currentColor\"\n                  d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"\n                />\n                <path\n                  fill=\"currentColor\"\n                  d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"\n                />\n                <path\n                  fill=\"currentColor\"\n                  d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"\n                />\n              </svg>\n              {loading ? \"Entrando...\" : \"Entrar com Google\"}\n            </Button>\n          </form>\n        </CardContent>\n      </Card>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\MultiUnitDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\Observability.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\OrgGovernance.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadData'. Either include it or remove the dependency array.","line":45,"column":8,"nodeType":"ArrayExpression","endLine":45,"endColumn":45,"suggestions":[{"desc":"Update the dependencies array to be: [profile?.organization_id, canAccess, loadData]","fix":{"range":[1882,1919],"text":"[profile?.organization_id, canAccess, loadData]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\nimport { Card, CardContent, CardHeader, CardTitle, CardDescription } from \"@/components/ui/card\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useAuth } from \"@/hooks/useAuth\";\r\nimport { useOrganizationContext } from \"@/hooks/useOrganizationContext\";\r\nimport { Building2, Settings, TrendingUp, Users, AlertTriangle, ShieldAlert } from \"lucide-react\";\r\nimport { toast } from \"sonner\";\r\nimport { OrgSettingsForm } from \"@/components/organization/OrgSettingsForm\";\r\nimport { UnitSettingsDialog } from \"@/components/organization/UnitSettingsDialog\";\r\n\r\ninterface Unit {\r\n    id: string;\r\n    organization_id: string;\r\n    nome: string;\r\n    created_at: string;\r\n}\r\n\r\ninterface UnitAnalytics {\r\n    unit_id: string;\r\n    unit_name: string;\r\n    taxa_ocupacao_mensal_estimada: number;\r\n    taxa_no_show: number;\r\n    total_agendamentos: number;\r\n}\r\n\r\nexport default function OrgGovernance() {\r\n    const { profile } = useAuth();\r\n    const { isOrgAdmin, hasRole, isMaster } = useOrganizationContext();\r\n    const [units, setUnits] = useState<Unit[]>([]);\r\n    const [analytics, setAnalytics] = useState<UnitAnalytics[]>([]);\r\n    const [loading, setLoading] = useState(true);\r\n    const [selectedUnitId, setSelectedUnitId] = useState<string | null>(null);\r\n    const [unitSettingsOpen, setUnitSettingsOpen] = useState(false);\r\n\r\n    const canAccess = isOrgAdmin || hasRole(['org_finance']) || isMaster;\r\n\r\n    useEffect(() => {\r\n        if (profile?.organization_id && canAccess) {\r\n            loadData();\r\n        }\r\n    }, [profile?.organization_id, canAccess]);\r\n\r\n    const loadData = async () => {\r\n        setLoading(true);\r\n        try {\r\n            // Carregar unidades\r\n            const { data: unitsData } = await (supabase as any)\r\n                .from('units')\r\n                .select('*')\r\n                .eq('organization_id', profile?.organization_id);\r\n            setUnits((unitsData as any) || []);\r\n\r\n            // Carregar analytics consolidados\r\n            const { data: analyticsData } = await (supabase as any)\r\n                .from('view_org_analytics')\r\n                .select('*')\r\n                .eq('organization_id', profile?.organization_id);\r\n            setAnalytics((analyticsData as any) || []);\r\n\r\n        } catch (error) {\r\n            console.error(error);\r\n            toast.error(\"Erro ao carregar dados da organiza├º├úo.\");\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const handleConfigureUnit = (unitId: string) => {\r\n        setSelectedUnitId(unitId);\r\n        setUnitSettingsOpen(true);\r\n    };\r\n\r\n    if (!canAccess) {\r\n        return (\r\n            <div className=\"container mx-auto p-6 flex flex-col items-center justify-center h-[50vh] space-y-4\">\r\n                <ShieldAlert className=\"h-16 w-16 text-destructive\" />\r\n                <h1 className=\"text-2xl font-bold\">Acesso Negado</h1>\r\n                <p className=\"text-muted-foreground\">Voc├¬ n├úo tem permiss├úo para acessar esta p├ígina.</p>\r\n            </div>\r\n        );\r\n    }\r\n\r\n    return (\r\n        <div className=\"container mx-auto p-6 space-y-8\">\r\n            <div>\r\n                <h1 className=\"text-3xl font-bold tracking-tight\">Governan├ºa da Organiza├º├úo</h1>\r\n                <p className=\"text-muted-foreground\">Gerencie suas unidades e visualize o desempenho consolidado.</p>\r\n            </div>\r\n\r\n            {/* KPIs Consolidados */}\r\n            <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\r\n                <KPICard\r\n                    title=\"Total de Unidades\"\r\n                    value={units.length.toString()}\r\n                    icon={Building2}\r\n                />\r\n                <KPICard\r\n                    title=\"Ocupa├º├úo M├®dia\"\r\n                    value={`${(analytics.reduce((acc, curr) => acc + Number(curr.taxa_ocupacao_mensal_estimada || 0), 0) / (analytics.length || 1)).toFixed(1)}%`}\r\n                    icon={TrendingUp}\r\n                />\r\n                <KPICard\r\n                    title=\"Taxa de No-Show Global\"\r\n                    value={`${(analytics.reduce((acc, curr) => acc + Number(curr.taxa_no_show || 0), 0) / (analytics.length || 1)).toFixed(1)}%`}\r\n                    icon={AlertTriangle}\r\n                    trend=\"down\"\r\n                />\r\n                <KPICard\r\n                    title=\"Total de Agendamentos\"\r\n                    value={analytics.reduce((acc, curr) => acc + Number(curr.total_agendamentos || 0), 0).toString()}\r\n                    icon={Users}\r\n                />\r\n            </div>\r\n\r\n            <Tabs defaultValue=\"units\" className=\"space-y-4\">\r\n                <TabsList>\r\n                    <TabsTrigger value=\"units\">Unidades</TabsTrigger>\r\n                    <TabsTrigger value=\"settings\">Configura├º├Áes Globais</TabsTrigger>\r\n                </TabsList>\r\n\r\n                <TabsContent value=\"units\">\r\n                    <Card>\r\n                        <CardHeader>\r\n                            <CardTitle>Desempenho por Unidade</CardTitle>\r\n                            <CardDescription>Vis├úo detalhada de cada unidade da rede.</CardDescription>\r\n                        </CardHeader>\r\n                        <CardContent>\r\n                            <Table>\r\n                                <TableHeader>\r\n                                    <TableRow>\r\n                                        <TableHead>Unidade</TableHead>\r\n                                        <TableHead>Ocupa├º├úo</TableHead>\r\n                                        <TableHead>No-Show</TableHead>\r\n                                        <TableHead>Agendamentos</TableHead>\r\n                                        <TableHead className=\"text-right\">A├º├Áes</TableHead>\r\n                                    </TableRow>\r\n                                </TableHeader>\r\n                                <TableBody>\r\n                                    {analytics.map(unit => (\r\n                                        <TableRow key={unit.unit_id}>\r\n                                            <TableCell className=\"font-medium\">{unit.unit_name}</TableCell>\r\n                                            <TableCell>\r\n                                                <Badge variant={Number(unit.taxa_ocupacao_mensal_estimada) > 70 ? \"default\" : \"secondary\"}>\r\n                                                    {unit.taxa_ocupacao_mensal_estimada}%\r\n                                                </Badge>\r\n                                            </TableCell>\r\n                                            <TableCell>{unit.taxa_no_show}%</TableCell>\r\n                                            <TableCell>{unit.total_agendamentos}</TableCell>\r\n                                            <TableCell className=\"text-right\">\r\n                                                <Button\r\n                                                    variant=\"outline\"\r\n                                                    size=\"sm\"\r\n                                                    onClick={() => handleConfigureUnit(unit.unit_id)}\r\n                                                >\r\n                                                    <Settings className=\"mr-2 h-4 w-4\" /> Configurar\r\n                                                </Button>\r\n                                            </TableCell>\r\n                                        </TableRow>\r\n                                    ))}\r\n                                    {analytics.length === 0 && !loading && (\r\n                                        <TableRow>\r\n                                            <TableCell colSpan={5} className=\"text-center text-muted-foreground py-8\">\r\n                                                Nenhuma unidade encontrada ou sem dados recentes.\r\n                                            </TableCell>\r\n                                        </TableRow>\r\n                                    )}\r\n                                </TableBody>\r\n                            </Table>\r\n                        </CardContent>\r\n                    </Card>\r\n                </TabsContent>\r\n\r\n                <TabsContent value=\"settings\">\r\n                    {profile?.organization_id && (\r\n                        <OrgSettingsForm organizationId={profile.organization_id} />\r\n                    )}\r\n                </TabsContent>\r\n            </Tabs>\r\n\r\n            <UnitSettingsDialog\r\n                open={unitSettingsOpen}\r\n                onOpenChange={setUnitSettingsOpen}\r\n                unitId={selectedUnitId}\r\n                organizationId={profile?.organization_id || ''}\r\n            />\r\n        </div>\r\n    );\r\n}\r\n\r\ninterface KPICardProps {\r\n    title: string;\r\n    value: string;\r\n    icon: React.ComponentType<{ className?: string }>;\r\n    trend?: 'up' | 'down';\r\n}\r\n\r\nfunction KPICard({ title, value, icon: Icon, trend }: KPICardProps) {\r\n    return (\r\n        <Card>\r\n            <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\r\n                <CardTitle className=\"text-sm font-medium\">{title}</CardTitle>\r\n                <Icon className=\"h-4 w-4 text-muted-foreground\" />\r\n            </CardHeader>\r\n            <CardContent>\r\n                <div className=\"text-2xl font-bold\">{value}</div>\r\n            </CardContent>\r\n        </Card>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\Planos.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\Plugins.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadPlugins'. Either include it or remove the dependency array.","line":40,"column":8,"nodeType":"ArrayExpression","endLine":40,"endColumn":28,"suggestions":[{"desc":"Update the dependencies array to be: [loadPlugins, profile?.tenant_id]","fix":{"range":[1729,1749],"text":"[loadPlugins, profile?.tenant_id]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\nimport { Card, CardContent, CardHeader, CardTitle, CardDescription, CardFooter } from \"@/components/ui/card\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Switch } from \"@/components/ui/switch\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger, DialogFooter } from \"@/components/ui/dialog\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport { Textarea } from \"@/components/ui/textarea\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useAuth } from \"@/hooks/useAuth\";\r\nimport { toast } from \"sonner\";\r\nimport { Puzzle, Settings, Play } from \"lucide-react\";\r\nimport { AdminLayout } from \"@/components/layout/AdminLayout\";\r\n\r\n// Lista de plugins dispon├¡veis (mockada do frontend, deve bater com o backend)\r\nconst SYSTEM_PLUGINS = [\r\n    {\r\n        key: 'email-contador',\r\n        name: 'Notificar Contador',\r\n        description: 'Envia e-mail autom├ítico quando faturas s├úo pagas.',\r\n        hooks: ['onInvoicePaid'],\r\n        defaultConfig: { email_contador: 'contador@exemplo.com' }\r\n    },\r\n    {\r\n        key: 'webhook-erp',\r\n        name: 'Integra├º├úo ERP',\r\n        description: 'Envia dados de novos agendamentos para endpoint externo.',\r\n        hooks: ['onAppointmentCreated'],\r\n        defaultConfig: { erp_url: 'https://api.erp.com/v1/events', api_key: '' }\r\n    }\r\n];\r\n\r\nexport default function PluginsManager() {\r\n    const { profile } = useAuth();\r\n    const [activePlugins, setActivePlugins] = useState<any[]>([]);\r\n    const [loading, setLoading] = useState(true);\r\n\r\n    useEffect(() => {\r\n        if (profile?.tenant_id) loadPlugins();\r\n    }, [profile?.tenant_id]);\r\n\r\n    const loadPlugins = async () => {\r\n        setLoading(true);\r\n        const { data } = await supabase\r\n            .from('plugins_registry')\r\n            .select('*')\r\n            .eq('tenant_id', profile?.tenant_id);\r\n        setActivePlugins(data || []);\r\n        setLoading(false);\r\n    };\r\n\r\n    const handleTogglePlugin = async (pluginKey: string, enabled: boolean) => {\r\n        const existing = activePlugins.find(p => p.nome === pluginKey);\r\n\r\n        if (enabled) {\r\n            if (!existing) {\r\n                // Ativar novo (criar registro)\r\n                const sysPlugin = SYSTEM_PLUGINS.find(p => p.key === pluginKey);\r\n                if (!sysPlugin) return;\r\n\r\n                const { error } = await supabase.from('plugins_registry').insert({\r\n                    tenant_id: profile?.tenant_id,\r\n                    nome: pluginKey,\r\n                    hooks: sysPlugin.hooks,\r\n                    config_json: sysPlugin.defaultConfig,\r\n                    ativo: true\r\n                });\r\n                if (error) toast.error(\"Erro ao ativar plugin\");\r\n                else toast.success(\"Plugin ativado\");\r\n            } else {\r\n                // Reativar\r\n                await supabase.from('plugins_registry').update({ ativo: true }).eq('id', existing.id);\r\n                toast.success(\"Plugin ativado\");\r\n            }\r\n        } else {\r\n            if (existing) {\r\n                // Desativar\r\n                await supabase.from('plugins_registry').update({ ativo: false }).eq('id', existing.id);\r\n                toast.success(\"Plugin desativado\");\r\n            }\r\n        }\r\n        loadPlugins();\r\n    };\r\n\r\n    const handleSaveConfig = async (id: string, config: string) => {\r\n        try {\r\n            const json = JSON.parse(config);\r\n            const { error } = await supabase\r\n                .from('plugins_registry')\r\n                .update({ config_json: json })\r\n                .eq('id', id);\r\n\r\n            if (error) throw error;\r\n            toast.success(\"Configura├º├úo salva!\");\r\n            loadPlugins();\r\n        } catch (e) {\r\n            toast.error(\"JSON inv├ílido\");\r\n        }\r\n    };\r\n\r\n    return (\r\n        <AdminLayout>\r\n            <div className=\"container mx-auto p-6 space-y-8\">\r\n                <div>\r\n                    <h1 className=\"text-3xl font-bold tracking-tight\">Loja de Plugins</h1>\r\n                    <p className=\"text-muted-foreground\">Estenda as funcionalidades do sistema com integra├º├Áes prontas.</p>\r\n                </div>\r\n\r\n                <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\r\n                    {SYSTEM_PLUGINS.map(plugin => {\r\n                        const active = activePlugins.find(p => p.nome === plugin.key);\r\n                        const isEnabled = active?.ativo || false;\r\n\r\n                        return (\r\n                            <Card key={plugin.key} className={isEnabled ? \"border-primary/50 bg-primary/5\" : \"\"}>\r\n                                <CardHeader>\r\n                                    <div className=\"flex justify-between items-start\">\r\n                                        <div className=\"p-2 bg-muted rounded-full\">\r\n                                            <Puzzle className=\"h-6 w-6 text-primary\" />\r\n                                        </div>\r\n                                        <Switch\r\n                                            checked={isEnabled}\r\n                                            onCheckedChange={(checked) => handleTogglePlugin(plugin.key, checked)}\r\n                                        />\r\n                                    </div>\r\n                                    <CardTitle className=\"mt-4\">{plugin.name}</CardTitle>\r\n                                    <CardDescription>{plugin.description}</CardDescription>\r\n                                </CardHeader>\r\n                                <CardContent>\r\n                                    <div className=\"flex flex-wrap gap-2 mb-4\">\r\n                                        {plugin.hooks.map(hook => (\r\n                                            <Badge key={hook} variant=\"secondary\" className=\"text-[10px]\">{hook}</Badge>\r\n                                        ))}\r\n                                    </div>\r\n                                </CardContent>\r\n                                <CardFooter>\r\n                                    {isEnabled && active && (\r\n                                        <ConfigDialog\r\n                                            pluginName={plugin.name}\r\n                                            initialConfig={JSON.stringify(active.config_json, null, 2)}\r\n                                            onSave={(cfg) => handleSaveConfig(active.id, cfg)}\r\n                                        />\r\n                                    )}\r\n                                </CardFooter>\r\n                            </Card>\r\n                        );\r\n                    })}\r\n                </div>\r\n            </div>\r\n        </AdminLayout>\r\n    );\r\n}\r\n\r\nfunction ConfigDialog({ pluginName, initialConfig, onSave }: { pluginName: string, initialConfig: string, onSave: (c: string) => void }) {\r\n    const [config, setConfig] = useState(initialConfig);\r\n    const [open, setOpen] = useState(false);\r\n\r\n    return (\r\n        <Dialog open={open} onOpenChange={setOpen}>\r\n            <DialogTrigger asChild>\r\n                <Button variant=\"outline\" className=\"w-full\">\r\n                    <Settings className=\"mr-2 h-4 w-4\" /> Configurar\r\n                </Button>\r\n            </DialogTrigger>\r\n            <DialogContent>\r\n                <DialogHeader>\r\n                    <DialogTitle>Configurar {pluginName}</DialogTitle>\r\n                </DialogHeader>\r\n                <div className=\"space-y-4\">\r\n                    <Label>Configura├º├úo (JSON)</Label>\r\n                    <Textarea\r\n                        value={config}\r\n                        onChange={e => setConfig(e.target.value)}\r\n                        className=\"font-mono h-[200px]\"\r\n                    />\r\n                </div>\r\n                <DialogFooter>\r\n                    <Button onClick={() => { onSave(config); setOpen(false); }}>Salvar Altera├º├Áes</Button>\r\n                </DialogFooter>\r\n            </DialogContent>\r\n        </Dialog>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\Providers.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\RecontratarProfissionalCsv.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\pages\\admin\\Reports.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadReportData'. Either include it or remove the dependency array.","line":42,"column":6,"nodeType":"ArrayExpression","endLine":42,"endColumn":14,"suggestions":[{"desc":"Update the dependencies array to be: [loadReportData, period]","fix":{"range":[1490,1498],"text":"[loadReportData, period]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useState } from \"react\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { Card } from \"@/components/ui/card\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\r\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\r\nimport { BarChart, Bar, LineChart, Line, PieChart, Pie, Cell, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from \"recharts\";\r\nimport { ArrowLeft, Download, TrendingUp, Clock, CheckCircle, AlertCircle } from \"lucide-react\";\r\nimport { toast } from \"sonner\";\r\nimport { AdminLayout } from \"@/components/layout/AdminLayout\";\r\n\r\nconst COLORS = ['#016CA5', '#25D366', '#FFB800', '#FF6B6B'];\r\n\r\ninterface ReportData {\r\n  ticketsByStatus: any[];\r\n  ticketsByPriority: any[];\r\n  ticketsByOrigin: any[];\r\n  ticketsTrend: any[];\r\n  slaMetrics: {\r\n    cumprido: number;\r\n    emRisco: number;\r\n    estourado: number;\r\n    total: number;\r\n  };\r\n  resolutionTime: {\r\n    avg: number;\r\n    min: number;\r\n    max: number;\r\n  };\r\n  teamPerformance: any[];\r\n}\r\n\r\nconst AdminReports = () => {\r\n  const navigate = useNavigate();\r\n  const [loading, setLoading] = useState(false);\r\n  const [period, setPeriod] = useState(\"30\");\r\n  const [reportData, setReportData] = useState<ReportData | null>(null);\r\n\r\n  useEffect(() => {\r\n    loadReportData();\r\n  }, [period]);\r\n\r\n  const loadReportData = async () => {\r\n    setLoading(true);\r\n    try {\r\n      const daysAgo = new Date();\r\n      daysAgo.setDate(daysAgo.getDate() - parseInt(period));\r\n\r\n      // Buscar tickets do per├¡odo\r\n      const { data: tickets, error } = await supabase\r\n        .from(\"support_tickets\")\r\n        .select(\"*\")\r\n        .gte(\"created_at\", daysAgo.toISOString());\r\n\r\n      if (error) throw error;\r\n\r\n      // Processar dados para os gr├íficos\r\n      const ticketsByStatus = processTicketsByStatus(tickets || []);\r\n      const ticketsByPriority = processTicketsByPriority(tickets || []);\r\n      const ticketsByOrigin = processTicketsByOrigin(tickets || []);\r\n      const ticketsTrend = processTicketsTrend(tickets || [], parseInt(period));\r\n      const slaMetrics = processSLAMetrics(tickets || []);\r\n      const resolutionTime = processResolutionTime(tickets || []);\r\n      const teamPerformance = await processTeamPerformance(tickets || []);\r\n\r\n      setReportData({\r\n        ticketsByStatus,\r\n        ticketsByPriority,\r\n        ticketsByOrigin,\r\n        ticketsTrend,\r\n        slaMetrics,\r\n        resolutionTime,\r\n        teamPerformance\r\n      });\r\n    } catch (error) {\r\n      console.error(\"Error loading report data:\", error);\r\n      toast.error(\"Erro ao carregar relat├│rios\");\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  const processTicketsByStatus = (tickets: any[]) => {\r\n    const statusCount: Record<string, number> = {};\r\n    tickets.forEach(ticket => {\r\n      statusCount[ticket.status] = (statusCount[ticket.status] || 0) + 1;\r\n    });\r\n\r\n    return Object.entries(statusCount).map(([status, count]) => ({\r\n      name: translateStatus(status),\r\n      value: count,\r\n      status\r\n    }));\r\n  };\r\n\r\n  const processTicketsByPriority = (tickets: any[]) => {\r\n    const priorityCount: Record<string, number> = {};\r\n    tickets.forEach(ticket => {\r\n      priorityCount[ticket.priority] = (priorityCount[ticket.priority] || 0) + 1;\r\n    });\r\n\r\n    return Object.entries(priorityCount).map(([priority, count]) => ({\r\n      name: translatePriority(priority),\r\n      value: count\r\n    }));\r\n  };\r\n\r\n  const processTicketsByOrigin = (tickets: any[]) => {\r\n    const originCount: Record<string, number> = {};\r\n    tickets.forEach(ticket => {\r\n      const origin = ticket.origem || 'manual';\r\n      originCount[origin] = (originCount[origin] || 0) + 1;\r\n    });\r\n\r\n    return Object.entries(originCount).map(([origin, count]) => ({\r\n      name: translateOrigin(origin),\r\n      value: count\r\n    }));\r\n  };\r\n\r\n  const processTicketsTrend = (tickets: any[], days: number) => {\r\n    const trend: Record<string, number> = {};\r\n\r\n    for (let i = days - 1; i >= 0; i--) {\r\n      const date = new Date();\r\n      date.setDate(date.getDate() - i);\r\n      const dateStr = date.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });\r\n      trend[dateStr] = 0;\r\n    }\r\n\r\n    tickets.forEach(ticket => {\r\n      const date = new Date(ticket.created_at);\r\n      const dateStr = date.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });\r\n      if (trend[dateStr] !== undefined) {\r\n        trend[dateStr]++;\r\n      }\r\n    });\r\n\r\n    return Object.entries(trend).map(([date, count]) => ({\r\n      date,\r\n      tickets: count\r\n    }));\r\n  };\r\n\r\n  const processSLAMetrics = (tickets: any[]) => {\r\n    let cumprido = 0;\r\n    let emRisco = 0;\r\n    let estourado = 0;\r\n\r\n    tickets.forEach(ticket => {\r\n      if (!ticket.sla || !ticket.sla.limite) return;\r\n\r\n      const now = new Date();\r\n      const limite = new Date(ticket.sla.limite);\r\n      const tempoRestante = limite.getTime() - now.getTime();\r\n\r\n      if (ticket.status === 'resolved' || ticket.status === 'closed') {\r\n        if (ticket.sla.atingido === false) {\r\n          cumprido++;\r\n        } else {\r\n          estourado++;\r\n        }\r\n      } else if (tempoRestante <= 0) {\r\n        estourado++;\r\n      } else {\r\n        const inicio = new Date(ticket.sla.inicio);\r\n        const tempoTotal = limite.getTime() - inicio.getTime();\r\n        const percentualGasto = ((tempoTotal - tempoRestante) / tempoTotal) * 100;\r\n\r\n        if (percentualGasto >= 80) {\r\n          emRisco++;\r\n        } else {\r\n          cumprido++;\r\n        }\r\n      }\r\n    });\r\n\r\n    return {\r\n      cumprido,\r\n      emRisco,\r\n      estourado,\r\n      total: tickets.length\r\n    };\r\n  };\r\n\r\n  const processResolutionTime = (tickets: any[]) => {\r\n    const resolvedTickets = tickets.filter(t => t.resolved_at);\r\n\r\n    if (resolvedTickets.length === 0) {\r\n      return { avg: 0, min: 0, max: 0 };\r\n    }\r\n\r\n    const times = resolvedTickets.map(ticket => {\r\n      const created = new Date(ticket.created_at);\r\n      const resolved = new Date(ticket.resolved_at);\r\n      return (resolved.getTime() - created.getTime()) / (1000 * 60 * 60); // horas\r\n    });\r\n\r\n    return {\r\n      avg: times.reduce((a, b) => a + b, 0) / times.length,\r\n      min: Math.min(...times),\r\n      max: Math.max(...times)\r\n    };\r\n  };\r\n\r\n  const processTeamPerformance = async (tickets: any[]) => {\r\n    const { data: supportUsers } = await supabase\r\n      .from(\"usuarios_suporte\")\r\n      .select(\"id, nome, auth_user_id\");\r\n\r\n    if (!supportUsers) return [];\r\n\r\n    const performance = supportUsers.map(user => {\r\n      const assignedTickets = tickets.filter(t => t.assigned_to === user.auth_user_id);\r\n      const resolvedTickets = assignedTickets.filter(t => t.status === 'resolved' || t.status === 'closed');\r\n\r\n      return {\r\n        name: user.nome,\r\n        atribuidos: assignedTickets.length,\r\n        resolvidos: resolvedTickets.length,\r\n        taxa: assignedTickets.length > 0\r\n          ? Math.round((resolvedTickets.length / assignedTickets.length) * 100)\r\n          : 0\r\n      };\r\n    }).filter(p => p.atribuidos > 0);\r\n\r\n    return performance;\r\n  };\r\n\r\n  const translateStatus = (status: string) => {\r\n    const translations: Record<string, string> = {\r\n      open: 'Aberto',\r\n      in_progress: 'Em Progresso',\r\n      waiting_customer: 'Aguardando Cliente',\r\n      resolved: 'Resolvido',\r\n      closed: 'Fechado'\r\n    };\r\n    return translations[status] || status;\r\n  };\r\n\r\n  const translatePriority = (priority: string) => {\r\n    const translations: Record<string, string> = {\r\n      urgent: 'Urgente',\r\n      high: 'Alta',\r\n      medium: 'M├®dia',\r\n      low: 'Baixa'\r\n    };\r\n    return translations[priority] || priority;\r\n  };\r\n\r\n  const translateOrigin = (origin: string) => {\r\n    const translations: Record<string, string> = {\r\n      chat: 'Chat',\r\n      email: 'Email',\r\n      whatsapp: 'WhatsApp',\r\n      manual: 'Manual'\r\n    };\r\n    return translations[origin] || origin;\r\n  };\r\n\r\n  const exportReport = async (format: 'csv' | 'pdf') => {\r\n    if (!reportData) return;\r\n\r\n    try {\r\n      const { data: { user } } = await supabase.auth.getUser();\r\n      if (!user) return;\r\n\r\n      if (format === 'csv') {\r\n        const csvContent = generateCSV();\r\n        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });\r\n        const link = document.createElement('a');\r\n        link.href = URL.createObjectURL(blob);\r\n        link.download = `relatorio-suporte-${new Date().toISOString().split('T')[0]}.csv`;\r\n        link.click();\r\n      } else {\r\n        await generatePDF();\r\n      }\r\n\r\n      // Registrar exporta├º├úo\r\n      // @ts-expect-error: o tipo 'registrar_exportacao' pode n├úo estar presente em Database['public']['Functions'] no types.ts\r\n      await supabase.rpc('registrar_exportacao', {\r\n        p_user_id: user.id,\r\n        p_export_type: 'support_report',\r\n        p_table_name: 'support_tickets',\r\n        p_filters: { period },\r\n        p_record_count: reportData.ticketsByStatus.reduce((sum, item) => sum + item.value, 0),\r\n        p_file_format: format\r\n      });\r\n\r\n      toast.success(`Relat├│rio exportado como ${format.toUpperCase()} com sucesso`);\r\n    } catch (error) {\r\n      console.error('Erro ao exportar:', error);\r\n      toast.error(\"Erro ao registrar exporta├º├úo\");\r\n    }\r\n  };\r\n\r\n  const generatePDF = async () => {\r\n    if (!reportData) return;\r\n    const { jsPDF } = await import(\"jspdf\");\r\n    const autoTable = (await import(\"jspdf-autotable\")).default;\r\n\r\n    const doc = new jsPDF();\r\n\r\n    // T├¡tulo\r\n    doc.setFontSize(18);\r\n    doc.text(\"Relat├│rio de Suporte CleanFlow\", 14, 22);\r\n\r\n    doc.setFontSize(11);\r\n    doc.setTextColor(100);\r\n    doc.text(`Per├¡odo: ├Ültimos ${period} dias`, 14, 30);\r\n    doc.text(`Gerado em: ${new Date().toLocaleString('pt-BR')}`, 14, 36);\r\n\r\n    let finalY = 45;\r\n\r\n    // M├®tricas SLA\r\n    doc.setFontSize(14);\r\n    doc.setTextColor(0);\r\n    doc.text(\"M├®tricas de SLA\", 14, finalY);\r\n    finalY += 6;\r\n\r\n    autoTable(doc, {\r\n      startY: finalY,\r\n      head: [['Status', 'Quantidade', 'Percentual']],\r\n      body: [\r\n        ['Cumprido', reportData.slaMetrics.cumprido, `${((reportData.slaMetrics.cumprido / reportData.slaMetrics.total) * 100).toFixed(1)}%`],\r\n        ['Em Risco', reportData.slaMetrics.emRisco, `${((reportData.slaMetrics.emRisco / reportData.slaMetrics.total) * 100).toFixed(1)}%`],\r\n        ['Estourado', reportData.slaMetrics.estourado, `${((reportData.slaMetrics.estourado / reportData.slaMetrics.total) * 100).toFixed(1)}%`],\r\n      ],\r\n    });\r\n\r\n    // @ts-expect-error: tipagem customizada do autoTable no jsPDF\r\n    finalY = doc.lastAutoTable.finalY + 15;\r\n\r\n    // Tickets por Status\r\n    doc.text(\"Tickets por Status\", 14, finalY);\r\n    finalY += 6;\r\n\r\n    autoTable(doc, {\r\n      startY: finalY,\r\n      head: [['Status', 'Quantidade']],\r\n      body: reportData.ticketsByStatus.map(item => [item.name, item.value]),\r\n    });\r\n\r\n    // @ts-expect-error: tipagem customizada do autoTable no jsPDF\r\n    finalY = doc.lastAutoTable.finalY + 15;\r\n\r\n    // Performance da Equipe\r\n    doc.text(\"Performance da Equipe\", 14, finalY);\r\n    finalY += 6;\r\n\r\n    autoTable(doc, {\r\n      startY: finalY,\r\n      head: [['Agente', 'Atribu├¡dos', 'Resolvidos', 'Taxa de Resolu├º├úo']],\r\n      body: reportData.teamPerformance.map(item => [\r\n        item.name,\r\n        item.atribuidos,\r\n        item.resolvidos,\r\n        `${item.taxa}%`\r\n      ]),\r\n    });\r\n\r\n    doc.save(`relatorio-suporte-${new Date().toISOString().split('T')[0]}.pdf`);\r\n  };\r\n\r\n  const generateCSV = () => {\r\n    if (!reportData) return '';\r\n\r\n    let csv = 'RELAT├ôRIO DE SUPORTE\\n\\n';\r\n    csv += `Per├¡odo: ├Ültimos ${period} dias\\n`;\r\n    csv += `Gerado em: ${new Date().toLocaleString('pt-BR')}\\n\\n`;\r\n\r\n    csv += 'M├ëTRICAS DE SLA\\n';\r\n    csv += 'Status,Quantidade,Percentual\\n';\r\n    csv += `Cumprido,${reportData.slaMetrics.cumprido},${((reportData.slaMetrics.cumprido / reportData.slaMetrics.total) * 100).toFixed(1)}%\\n`;\r\n    csv += `Em Risco,${reportData.slaMetrics.emRisco},${((reportData.slaMetrics.emRisco / reportData.slaMetrics.total) * 100).toFixed(1)}%\\n`;\r\n    csv += `Estourado,${reportData.slaMetrics.estourado},${((reportData.slaMetrics.estourado / reportData.slaMetrics.total) * 100).toFixed(1)}%\\n\\n`;\r\n\r\n    csv += 'TICKETS POR STATUS\\n';\r\n    csv += 'Status,Quantidade\\n';\r\n    reportData.ticketsByStatus.forEach(item => {\r\n      csv += `${item.name},${item.value}\\n`;\r\n    });\r\n\r\n    csv += '\\nPERFORMANCE DA EQUIPE\\n';\r\n    csv += 'Agente,Atribu├¡dos,Resolvidos,Taxa de Resolu├º├úo\\n';\r\n    reportData.teamPerformance.forEach(item => {\r\n      csv += `${item.name},${item.atribuidos},${item.resolvidos},${item.taxa}%\\n`;\r\n    });\r\n\r\n    return csv;\r\n  };\r\n\r\n  if (loading) {\r\n    return <div className=\"flex items-center justify-center min-h-screen\">Carregando...</div>;\r\n  }\r\n\r\n  return (\r\n    <AdminLayout>\r\n      <div className=\"space-y-6\">\r\n        <div className=\"flex items-center justify-between mb-8\">\r\n          <div className=\"flex items-center gap-4\">\r\n            <div>\r\n              <h1 className=\"text-3xl font-bold\">Relat├│rios de Suporte</h1>\r\n              <p className=\"text-muted-foreground\">An├ílises e m├®tricas do sistema de tickets</p>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"flex items-center gap-4\">\r\n            <Select value={period} onValueChange={setPeriod}>\r\n              <SelectTrigger className=\"w-40\">\r\n                <SelectValue />\r\n              </SelectTrigger>\r\n              <SelectContent>\r\n                <SelectItem value=\"7\">├Ültimos 7 dias</SelectItem>\r\n                <SelectItem value=\"15\">├Ültimos 15 dias</SelectItem>\r\n                <SelectItem value=\"30\">├Ültimos 30 dias</SelectItem>\r\n                <SelectItem value=\"60\">├Ültimos 60 dias</SelectItem>\r\n                <SelectItem value=\"90\">├Ültimos 90 dias</SelectItem>\r\n              </SelectContent>\r\n            </Select>\r\n\r\n            <Button onClick=