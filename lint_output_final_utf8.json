n    });\r\n    const [loading, setLoading] = useState(true);\r\n\r\n    // Apply theme immediately before paint\r\n    useLayoutEffect(() => {\r\n        const root = window.document.documentElement;\r\n        root.classList.remove('light', 'dark');\r\n        root.classList.add(theme);\r\n        // Also save to localStorage to ensure consistency\r\n        localStorage.setItem('admin-theme', theme);\r\n    }, [theme]);\r\n\r\n    useEffect(() => {\r\n        loadThemePreference();\r\n    }, []);\r\n\r\n    const loadThemePreference = async () => {\r\n        try {\r\n            const { data: { user } } = await supabase.auth.getUser();\r\n\r\n            if (!user) {\r\n                setLoading(false);\r\n                return;\r\n            }\r\n\r\n            const { data: systemUser, error } = await supabase\r\n                .from('system_users')\r\n                .select('theme_preference')\r\n                .eq('id', user.id)\r\n                .single();\r\n\r\n            if (!error && systemUser) {\r\n                const userTheme = (systemUser as any).theme_preference as Theme;\r\n                if (userTheme && userTheme !== theme) {\r\n                    setTheme(userTheme);\r\n                }\r\n            }\r\n        } catch (error) {\r\n            console.error('Erro ao carregar tema:', error);\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const toggleTheme = async () => {\r\n        const newTheme: Theme = theme === 'dark' ? 'light' : 'dark';\r\n        setTheme(newTheme);\r\n\r\n        try {\r\n            const { data: { user } } = await supabase.auth.getUser();\r\n            if (user) {\r\n                await supabase\r\n                    .from('system_users')\r\n                    .update({ theme_preference: newTheme } as any)\r\n                    .eq('id', user.id);\r\n            }\r\n            toast.success(`Tema ${newTheme === 'dark' ? 'escuro' : 'claro'} ativado`);\r\n        } catch (error) {\r\n            console.error('Erro ao salvar tema:', error);\r\n        }\r\n    };\r\n\r\n    return {\r\n        theme,\r\n        toggleTheme,\r\n        loading\r\n    };\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useAuth.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'refreshProfile'. Either include it or remove the dependency array.","line":108,"column":6,"nodeType":"ArrayExpression","endLine":108,"endColumn":16,"suggestions":[{"desc":"Update the dependencies array to be: [refreshProfile, user.id]","fix":{"range":[3252,3262],"text":"[refreshProfile, user.id]"}}]},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":150,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":150,"endColumn":24}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { createContext, useContext, useEffect, useState } from \"react\";\r\nimport { User, Session } from \"@supabase/supabase-js\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { useNavigate } from \"react-router-dom\";\r\n\r\ninterface AuthContextType {\r\n  user: User | null;\r\n  session: Session | null;\r\n  profile: any | null;\r\n  loading: boolean;\r\n  signIn: (email: string, password: string) => Promise<{ error: any }>;\r\n  signUp: (email: string, password: string, userData: any) => Promise<{ error: any }>;\r\n  signOut: () => Promise<void>;\r\n  refreshProfile: () => Promise<void>;\r\n}\r\n\r\nconst AuthContext = createContext<AuthContextType | undefined>(undefined);\r\n\r\nexport function AuthProvider({ children }: { children: React.ReactNode }) {\r\n  const [user, setUser] = useState<User | null>(null);\r\n  const [session, setSession] = useState<Session | null>(null);\r\n  const [profile, setProfile] = useState<any | null>(null);\r\n  const [loading, setLoading] = useState(true);\r\n  const navigate = useNavigate();\r\n\r\n  const fetchProfile = async (userId: string) => {\r\n    const { data } = await (supabase as any)\r\n      .from(\"profiles\")\r\n      .select(\"*, tenants(*)\")\r\n      .eq(\"id\", userId)\r\n      .single();\r\n    \r\n    if (data) {\r\n      setProfile(data);\r\n    }\r\n  };\r\n\r\n  const refreshProfile = async () => {\r\n    if (user?.id) {\r\n      await fetchProfile(user.id);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    // Set up auth state listener\r\n    const { data: { subscription } } = supabase.auth.onAuthStateChange(\r\n      async (event, session) => {\r\n        console.log('[useAuth] Auth state changed:', event, session?.user?.id);\r\n        setSession(session);\r\n        setUser(session?.user ?? null);\r\n        \r\n        if (session?.user) {\r\n          console.log('[useAuth] Session user found, fetching profile');\r\n          // Fetch profile data\r\n          setTimeout(async () => {\r\n            await fetchProfile(session.user.id);\r\n          }, 0);\r\n        } else {\r\n          console.log('[useAuth] No session user, clearing profile');\r\n          setProfile(null);\r\n        }\r\n      }\r\n    );\r\n\r\n    // Check for existing session\r\n    supabase.auth.getSession().then(({ data: { session } }) => {\r\n      console.log('[useAuth] Initial session check:', session?.user?.id);\r\n      setSession(session);\r\n      setUser(session?.user ?? null);\r\n      \r\n      if (session?.user) {\r\n        console.log('[useAuth] Initial session user found, fetching profile');\r\n        fetchProfile(session.user.id).then(() => {\r\n          setLoading(false);\r\n        });\r\n      } else {\r\n        console.log('[useAuth] No initial session user');\r\n        setLoading(false);\r\n      }\r\n    });\r\n\r\n    return () => subscription.unsubscribe();\r\n  }, []);\r\n\r\n  // Subscribe to profile changes\r\n  useEffect(() => {\r\n    if (!user?.id) return;\r\n\r\n    const channel = supabase\r\n      .channel('profile-changes')\r\n      .on(\r\n        'postgres_changes',\r\n        {\r\n          event: 'UPDATE',\r\n          schema: 'public',\r\n          table: 'profiles',\r\n          filter: `id=eq.${user.id}`\r\n        },\r\n        () => {\r\n          refreshProfile();\r\n        }\r\n      )\r\n      .subscribe();\r\n\r\n    return () => {\r\n      supabase.removeChannel(channel);\r\n    };\r\n  }, [user?.id]);\r\n\r\n  const signIn = async (email: string, password: string) => {\r\n    const { error } = await supabase.auth.signInWithPassword({\r\n      email,\r\n      password,\r\n    });\r\n    return { error };\r\n  };\r\n\r\n  const signUp = async (email: string, password: string, userData: any) => {\r\n    const { data, error } = await supabase.auth.signUp({\r\n      email,\r\n      password,\r\n      options: {\r\n        emailRedirectTo: `${window.location.origin}/`,\r\n      },\r\n    });\r\n\r\n    if (error) return { error };\r\n\r\n    // Create tenant and profile will be created via trigger or directly\r\n    return { error: null };\r\n  };\r\n\r\n  const signOut = async () => {\r\n    await supabase.auth.signOut();\r\n    setUser(null);\r\n    setSession(null);\r\n    setProfile(null);\r\n    navigate(\"/\");\r\n  };\r\n\r\n  return (\r\n    <AuthContext.Provider\r\n      value={{ user, session, profile, loading, signIn, signUp, signOut, refreshProfile }}\r\n    >\r\n      {children}\r\n    </AuthContext.Provider>\r\n  );\r\n}\r\n\r\nexport function useAuth() {\r\n  const context = useContext(AuthContext);\r\n  if (context === undefined) {\r\n    throw new Error(\"useAuth must be used within an AuthProvider\");\r\n  }\r\n  return context;\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useBilling.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'fetchBilling' and 'status'. Either include them or remove the dependency array.","line":82,"column":8,"nodeType":"ArrayExpression","endLine":82,"endColumn":28,"suggestions":[{"desc":"Update the dependencies array to be: [fetchBilling, profile.tenant_id, status]","fix":{"range":[2886,2906],"text":"[fetchBilling, profile.tenant_id, status]"}}]},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":91,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":91,"endColumn":27}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { createContext, useContext, useState, useEffect, ReactNode } from 'react';\r\nimport { supabase } from '@/integrations/supabase/client';\r\nimport { useAuth } from '@/hooks/useAuth';\r\nimport { toast } from 'sonner';\r\nimport { billingService } from '@/domain/billing/billingService';\r\n\r\ninterface BillingContextType {\r\n    status: string | null;\r\n    planCode: string | null;\r\n    loading: boolean;\r\n    refreshBilling: () => Promise<void>;\r\n}\r\n\r\nconst BillingContext = createContext<BillingContextType | undefined>(undefined);\r\n\r\nexport function BillingProvider({ children }: { children: ReactNode }) {\r\n    const { profile } = useAuth();\r\n    const [status, setStatus] = useState<string | null>(null);\r\n    const [planCode, setPlanCode] = useState<string | null>(null);\r\n    const [loading, setLoading] = useState(true);\r\n\r\n    const fetchBilling = async () => {\r\n        if (!profile?.tenant_id) {\r\n            setLoading(false);\r\n            return;\r\n        }\r\n\r\n        try {\r\n            const overview = await billingService.carregarAssinaturaAtual(profile.tenant_id);\r\n            const sub = overview.subscription;\r\n\r\n            if (sub) {\r\n                // Check if status changed from non-active to active to show toast\r\n                if (status && status !== 'active' && sub.status === 'active') {\r\n                    toast.success(\"Pagamento recebido! Sua assinatura est├í ativa.\");\r\n                }\r\n                setStatus(sub.status);\r\n                setPlanCode(sub.plan_id);\r\n            } else {\r\n                setStatus(null);\r\n                setPlanCode(null);\r\n            }\r\n        } catch (error) {\r\n            console.error('Error fetching billing:', error);\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        fetchBilling();\r\n\r\n        if (!profile?.tenant_id) return;\r\n\r\n        const channel = supabase\r\n            .channel('billing-updates')\r\n            .on(\r\n                'postgres_changes',\r\n                {\r\n                    event: 'UPDATE',\r\n                    schema: 'public',\r\n                    table: 'subscriptions', // Atualizado para nome em ingl├¬s\r\n                    filter: `tenant_id=eq.${profile.tenant_id}`\r\n                },\r\n                (payload) => {\r\n                    console.log('Billing update received:', payload);\r\n                    const newData = payload.new as any;\r\n\r\n                    if (status && status !== 'active' && newData.status === 'active') {\r\n                        toast.success(\"Pagamento recebido! Sua assinatura est├í ativa.\");\r\n                    }\r\n\r\n                    setStatus(newData.status);\r\n                    setPlanCode(newData.plan_id);\r\n                }\r\n            )\r\n            .subscribe();\r\n\r\n        return () => {\r\n            supabase.removeChannel(channel);\r\n        };\r\n    }, [profile?.tenant_id]);\r\n\r\n    return (\r\n        <BillingContext.Provider value={{ status, planCode, loading, refreshBilling: fetchBilling }}>\r\n            {children}\r\n        </BillingContext.Provider>\r\n    );\r\n}\r\n\r\nexport function useBilling() {\r\n    const context = useContext(BillingContext);\r\n    if (context === undefined) {\r\n        throw new Error('useBilling must be used within a BillingProvider');\r\n    }\r\n    return context;\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useDashboardPreferences.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'applyTheme'. Either include it or remove the dependency array.","line":27,"column":6,"nodeType":"ArrayExpression","endLine":27,"endColumn":13,"suggestions":[{"desc":"Update the dependencies array to be: [applyTheme, theme]","fix":{"range":[687,694],"text":"[applyTheme, theme]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useState } from \"react\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { toast } from \"sonner\";\n\nexport interface DashboardFilters {\n  tenant_id?: string;\n  priority?: string;\n  status?: string;\n}\n\nexport interface DashboardPreferences {\n  theme: 'claro' | 'escuro' | 'sistema';\n  filters: DashboardFilters;\n}\n\nexport const useDashboardPreferences = () => {\n  const [theme, setTheme] = useState<'claro' | 'escuro' | 'sistema'>('claro');\n  const [filters, setFilters] = useState<DashboardFilters>({});\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    loadPreferences();\n  }, []);\n\n  useEffect(() => {\n    applyTheme();\n  }, [theme]);\n\n  const loadPreferences = async () => {\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) return;\n\n      const { data } = await supabase\n        .from('support_dashboard_preferences')\n        .select('*')\n        .eq('support_user_id', user.id)\n        .maybeSingle();\n\n      if (data?.preferences) {\n        const prefs = data.preferences as any as DashboardPreferences;\n        setTheme(prefs.theme || 'claro');\n        setFilters(prefs.filters || {});\n      }\n    } catch (error) {\n      console.error('Error loading preferences:', error);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const applyTheme = () => {\n    const root = document.documentElement;\n    \n    if (theme === 'sistema') {\n      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;\n      root.classList.toggle('dark', prefersDark);\n    } else {\n      root.classList.toggle('dark', theme === 'escuro');\n    }\n  };\n\n  const updateTheme = async (newTheme: 'claro' | 'escuro' | 'sistema') => {\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) return;\n\n      setTheme(newTheme);\n\n      const preferences: DashboardPreferences = { theme: newTheme, filters };\n\n      await supabase\n        .from('support_dashboard_preferences')\n        .upsert({\n          support_user_id: user.id,\n          preferences: preferences as any\n        } as any);\n\n      // Log action\n      await supabase.from('support_actions_log').insert({\n        support_user_id: user.id,\n        action_type: 'dashboard_preferences_changed',\n        target_type: 'preferences',\n        description: `Tema alterado para ${newTheme}`,\n        metadata: { theme: newTheme } as any\n      } as any);\n\n      toast.success('Tema atualizado');\n    } catch (error) {\n      console.error('Error updating theme:', error);\n      toast.error('Erro ao atualizar tema');\n    }\n  };\n\n  const updateFilters = async (newFilters: DashboardFilters) => {\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) return;\n\n      setFilters(newFilters);\n\n      const preferences: DashboardPreferences = { theme, filters: newFilters };\n\n      await supabase\n        .from('support_dashboard_preferences')\n        .upsert({\n          support_user_id: user.id,\n          preferences: preferences as any\n        } as any);\n\n      // Log action\n      await supabase.from('support_actions_log').insert({\n        support_user_id: user.id,\n        action_type: 'dashboard_preferences_changed',\n        target_type: 'preferences',\n        description: 'Filtros do dashboard atualizados',\n        metadata: { filters: newFilters } as any\n      } as any);\n    } catch (error) {\n      console.error('Error updating filters:', error);\n      toast.error('Erro ao atualizar filtros');\n    }\n  };\n\n  return {\n    theme,\n    filters,\n    loading,\n    updateTheme,\n    updateFilters\n  };\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useDebounce.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useKeyboardShortcuts.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useOrganizationContext.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useCallback has a missing dependency: 'currentUnit'. Either include it or remove the dependency array.","line":125,"column":6,"nodeType":"ArrayExpression","endLine":125,"endColumn":42,"suggestions":[{"desc":"Update the dependencies array to be: [currentUnit, profile.organization_id, user.id]","fix":{"range":[3856,3892],"text":"[currentUnit, profile.organization_id, user.id]"}}]},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":173,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":173,"endColumn":39}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { createContext, useContext, useState, useEffect, useCallback, ReactNode } from 'react';\r\nimport { supabase } from '@/integrations/supabase/client';\r\nimport { useAuth } from '@/hooks/useAuth';\r\n\r\ninterface Organization {\r\n  id: string;\r\n  nome_fantasia: string;\r\n  razao_social: string | null;\r\n  documento: string | null;\r\n  moeda: string;\r\n  timezone: string;\r\n  status: string;\r\n}\r\n\r\ninterface Unit {\r\n  id: string;\r\n  organization_id: string;\r\n  nome_unidade: string;\r\n  codigo_interno: string | null;\r\n  razao_social: string | null;\r\n  documento: string | null;\r\n  is_matriz: boolean;\r\n  status: string;\r\n}\r\n\r\ninterface UserRole {\r\n  id: string;\r\n  organization_id: string;\r\n  unit_id: string | null;\r\n  role: 'org_admin' | 'org_finance' | 'unit_admin' | 'unit_finance' | 'atendimento' | 'leitura';\r\n}\r\n\r\ninterface OrganizationContextType {\r\n  organization: Organization | null;\r\n  units: Unit[];\r\n  currentUnit: Unit | null;\r\n  userRoles: UserRole[];\r\n  isLoading: boolean;\r\n  isMultiUnit: boolean;\r\n  setCurrentUnit: (unit: Unit | null) => void;\r\n  refreshData: () => Promise<void>;\r\n  hasRole: (roles: UserRole['role'][]) => boolean;\r\n  hasUnitAccess: (unitId: string) => boolean;\r\n  isOrgAdmin: boolean;\r\n  isUnitAdmin: boolean;\r\n  isMaster: boolean;\r\n}\r\n\r\nconst OrganizationContext = createContext<OrganizationContextType | undefined>(undefined);\r\n\r\nexport function OrganizationProvider({ children }: { children: ReactNode }) {\r\n  const { profile, user } = useAuth();\r\n  const [organization, setOrganization] = useState<Organization | null>(null);\r\n  const [units, setUnits] = useState<Unit[]>([]);\r\n  const [currentUnit, setCurrentUnit] = useState<Unit | null>(null);\r\n  const [userRoles, setUserRoles] = useState<UserRole[]>([]);\r\n  const [isMaster, setIsMaster] = useState(false);\r\n  const [isLoading, setIsLoading] = useState(true);\r\n\r\n  const fetchOrganizationData = useCallback(async () => {\r\n    if (!profile?.organization_id) {\r\n      setIsLoading(false);\r\n      return;\r\n    }\r\n\r\n    try {\r\n      setIsLoading(true);\r\n\r\n      // Fetch organization\r\n      const { data: orgData, error: orgError } = await supabase\r\n        .from('organizations')\r\n        .select('*')\r\n        .eq('id', profile.organization_id)\r\n        .maybeSingle();\r\n\r\n      if (orgError) throw orgError;\r\n      if (orgData) {\r\n        setOrganization(orgData as Organization);\r\n      }\r\n\r\n      // Fetch units\r\n      const { data: unitsData, error: unitsError } = await supabase\r\n        .from('units')\r\n        .select('*')\r\n        .eq('organization_id', profile.organization_id)\r\n        .eq('status', 'ativo')\r\n        .order('is_matriz', { ascending: false })\r\n        .order('nome_unidade');\r\n\r\n      if (unitsError) throw unitsError;\r\n      setUnits((unitsData as Unit[]) || []);\r\n\r\n      // Set default current unit (matriz or first)\r\n      if (unitsData && unitsData.length > 0 && !currentUnit) {\r\n        const matriz = unitsData.find((u: any) => u.is_matriz);\r\n        setCurrentUnit((matriz || unitsData[0]) as Unit);\r\n      }\r\n\r\n      // Fetch user roles\r\n      if (user?.id) {\r\n        const { data: rolesData, error: rolesError } = await supabase\r\n          .from('user_unit_roles')\r\n          .select('*')\r\n          .eq('user_id', user.id)\r\n          .eq('organization_id', profile.organization_id);\r\n\r\n        if (rolesError) throw rolesError;\r\n        setUserRoles((rolesData as UserRole[]) || []);\r\n\r\n        // Check if user is master/system_user\r\n        const { data: systemUserData } = await (supabase as any)\r\n          .from('system_users')\r\n          .select('id')\r\n          .eq('id', user.id)\r\n          .maybeSingle();\r\n\r\n        setIsMaster(!!systemUserData);\r\n      }\r\n\r\n    } catch (error) {\r\n      console.error('Erro ao buscar dados da organiza├º├úo:', error);\r\n    } finally {\r\n      setIsLoading(false);\r\n    }\r\n  }, [profile?.organization_id, user?.id]);\r\n\r\n  useEffect(() => {\r\n    fetchOrganizationData();\r\n  }, [fetchOrganizationData]);\r\n\r\n  // Check if user has any of the specified roles\r\n  const hasRole = useCallback((roles: UserRole['role'][]) => {\r\n    return userRoles.some(ur => roles.includes(ur.role));\r\n  }, [userRoles]);\r\n\r\n  // Check if user has access to a specific unit\r\n  const hasUnitAccess = useCallback((unitId: string) => {\r\n    // Org-level roles have access to all units\r\n    const hasOrgRole = userRoles.some(ur =>\r\n      ur.unit_id === null && ['org_admin', 'org_finance'].includes(ur.role)\r\n    );\r\n    if (hasOrgRole) return true;\r\n\r\n    // Check unit-specific access\r\n    return userRoles.some(ur => ur.unit_id === unitId);\r\n  }, [userRoles]);\r\n\r\n  const isMultiUnit = units.length > 1;\r\n  const isOrgAdmin = hasRole(['org_admin']);\r\n  const isUnitAdmin = hasRole(['org_admin', 'unit_admin']);\r\n\r\n  return (\r\n    <OrganizationContext.Provider value={{\r\n      organization,\r\n      units,\r\n      currentUnit,\r\n      userRoles,\r\n      isLoading,\r\n      isMultiUnit,\r\n      setCurrentUnit,\r\n      refreshData: fetchOrganizationData,\r\n      hasRole,\r\n      hasUnitAccess,\r\n      isOrgAdmin,\r\n      isUnitAdmin,\r\n      isMaster\r\n    }}>\r\n      {children}\r\n    </OrganizationContext.Provider>\r\n  );\r\n}\r\n\r\nexport function useOrganizationContext() {\r\n  const context = useContext(OrganizationContext);\r\n  if (context === undefined) {\r\n    throw new Error('useOrganizationContext must be used within an OrganizationProvider');\r\n  }\r\n  return context;\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\usePlanLimits.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useSidebarWidth.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadWidth'. Either include it or remove the dependency array.","line":13,"column":6,"nodeType":"ArrayExpression","endLine":13,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [loadWidth]","fix":{"range":[324,326],"text":"[loadWidth]"}}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'handleMouseMove' and 'handleMouseUp'. Either include them or remove the dependency array.","line":43,"column":6,"nodeType":"ArrayExpression","endLine":43,"endColumn":25,"suggestions":[{"desc":"Update the dependencies array to be: [handleMouseMove, handleMouseUp, isResizing, width]","fix":{"range":[1032,1051],"text":"[handleMouseMove, handleMouseUp, isResizing, width]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect } from \"react\";\nimport { useSidebarStore } from \"@/stores/useSidebarStore\";\n\nconst MIN_WIDTH = 200;\nconst MAX_WIDTH = 400;\n\nexport function useSidebarWidth() {\n  const { width, isResizing, setWidth, setIsResizing, loadWidth, saveWidth } =\n    useSidebarStore();\n\n  useEffect(() => {\n    loadWidth();\n  }, []);\n\n  const handleMouseDown = () => {\n    setIsResizing(true);\n  };\n\n  const handleMouseMove = (e: MouseEvent) => {\n    if (!isResizing) return;\n\n    const newWidth = Math.min(Math.max(e.clientX, MIN_WIDTH), MAX_WIDTH);\n    setWidth(newWidth);\n  };\n\n  const handleMouseUp = () => {\n    if (isResizing) {\n      setIsResizing(false);\n      saveWidth(width);\n    }\n  };\n\n  useEffect(() => {\n    if (isResizing) {\n      document.addEventListener(\"mousemove\", handleMouseMove);\n      document.addEventListener(\"mouseup\", handleMouseUp);\n\n      return () => {\n        document.removeEventListener(\"mousemove\", handleMouseMove);\n        document.removeEventListener(\"mouseup\", handleMouseUp);\n      };\n    }\n  }, [isResizing, width]);\n\n  return {\n    width,\n    isResizing,\n    handleMouseDown,\n    MIN_WIDTH,\n    MAX_WIDTH,\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useSupportChat.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'playNotificationSound'. Either include it or remove the dependency array.","line":72,"column":6,"nodeType":"ArrayExpression","endLine":72,"endColumn":33,"suggestions":[{"desc":"Update the dependencies array to be: [playNotificationSound, soundEnabled, soundVolume]","fix":{"range":[2062,2089],"text":"[playNotificationSound, soundEnabled, soundVolume]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useState } from \"react\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { toast } from \"sonner\";\r\n\r\nexport interface ChatSession {\r\n  id: string;\r\n  tenant_id: string;\r\n  client_name: string | null;\r\n  client_email: string | null;\r\n  client_phone: string | null;\r\n  status: 'waiting' | 'active' | 'resolved' | 'closed';\r\n  assigned_agent_id: string | null;\r\n  started_at: string;\r\n  accepted_at: string | null;\r\n  ended_at: string | null;\r\n  wait_time_seconds: number | null;\r\n  metadata: Record<string, any>;\r\n}\r\n\r\nexport interface ChatMessage {\r\n  id: string;\r\n  session_id: string;\r\n  sender_type: 'client' | 'agent' | 'system';\r\n  sender_id: string | null;\r\n  sender_name: string | null;\r\n  message: string;\r\n  attachments: any[];\r\n  created_at: string;\r\n}\r\n\r\nexport const useSupportChat = () => {\r\n  const [waitingSessions, setWaitingSessions] = useState<ChatSession[]>([]);\r\n  const [activeSessions, setActiveSessions] = useState<ChatSession[]>([]);\r\n  const [recentSessions, setRecentSessions] = useState<ChatSession[]>([]);\r\n  const [soundEnabled, setSoundEnabled] = useState(true);\r\n  const [soundVolume, setSoundVolume] = useState(80);\r\n\r\n  // Load agent preferences\r\n  useEffect(() => {\r\n    loadAgentPreferences();\r\n  }, []);\r\n\r\n  // Subscribe to chat sessions\r\n  useEffect(() => {\r\n    loadSessions();\r\n\r\n    const channel = supabase\r\n      .channel('support-chat-sessions')\r\n      .on(\r\n        'postgres_changes',\r\n        {\r\n          event: '*',\r\n          schema: 'public',\r\n          table: 'support_chat_sessions'\r\n        },\r\n        (payload) => {\r\n          console.log('Chat session change:', payload);\r\n          \r\n          if (payload.eventType === 'INSERT' && payload.new.status === 'waiting') {\r\n            playNotificationSound();\r\n            toast.info(`Novo chat aguardando: ${payload.new.client_name || 'Cliente'}`);\r\n          }\r\n          \r\n          loadSessions();\r\n        }\r\n      )\r\n      .subscribe();\r\n\r\n    return () => {\r\n      supabase.removeChannel(channel);\r\n    };\r\n  }, [soundEnabled, soundVolume]);\r\n\r\n  const loadAgentPreferences = async () => {\r\n    try {\r\n      const { data: { user } } = await supabase.auth.getUser();\r\n      if (!user) return;\r\n\r\n      const { data, error } = await supabase\r\n        .from('support_agent_preferences')\r\n        .select('*')\r\n        .eq('agent_id', user.id)\r\n        .maybeSingle();\r\n\r\n      if (error) throw error;\r\n\r\n      if (data) {\r\n        setSoundEnabled(data.sound_enabled);\r\n        setSoundVolume(data.sound_volume);\r\n      } else {\r\n        // Create default preferences\r\n        await supabase.from('support_agent_preferences').insert({\r\n          agent_id: user.id,\r\n          sound_enabled: true,\r\n          sound_volume: 80,\r\n          max_concurrent_chats: 3\r\n        });\r\n      }\r\n    } catch (error) {\r\n      console.error('Error loading agent preferences:', error);\r\n    }\r\n  };\r\n\r\n  const loadSessions = async () => {\r\n    try {\r\n      // Waiting sessions\r\n      const { data: waiting, error: waitingError } = await supabase\r\n        .from('support_chat_sessions')\r\n        .select('*')\r\n        .eq('status', 'waiting')\r\n        .order('started_at', { ascending: true });\r\n\r\n      if (waitingError) throw waitingError;\r\n      setWaitingSessions((waiting || []) as ChatSession[]);\r\n\r\n      // Active sessions for current agent\r\n      const { data: { user } } = await supabase.auth.getUser();\r\n      if (user) {\r\n        const { data: active, error: activeError } = await supabase\r\n          .from('support_chat_sessions')\r\n          .select('*')\r\n          .eq('status', 'active')\r\n          .eq('assigned_agent_id', user.id)\r\n          .order('accepted_at', { ascending: false });\r\n\r\n        if (activeError) throw activeError;\r\n        setActiveSessions((active || []) as ChatSession[]);\r\n      }\r\n\r\n      // Recent closed sessions\r\n      const { data: recent, error: recentError } = await supabase\r\n        .from('support_chat_sessions')\r\n        .select('*')\r\n        .in('status', ['resolved', 'closed'])\r\n        .order('ended_at', { ascending: false })\r\n        .limit(10);\r\n\r\n      if (recentError) throw recentError;\r\n      setRecentSessions((recent || []) as ChatSession[]);\r\n    } catch (error) {\r\n      console.error('Error loading sessions:', error);\r\n    }\r\n  };\r\n\r\n  const acceptChat = async (sessionId: string) => {\r\n    try {\r\n      const { data: { user } } = await supabase.auth.getUser();\r\n      if (!user) throw new Error('Usu├írio n├úo autenticado');\r\n\r\n      // Check current active chats\r\n      const { data: prefs } = await supabase\r\n        .from('support_agent_preferences')\r\n        .select('max_concurrent_chats')\r\n        .eq('agent_id', user.id)\r\n        .single();\r\n\r\n      const maxChats = prefs?.max_concurrent_chats || 3;\r\n\r\n      if (activeSessions.length >= maxChats) {\r\n        toast.error(`Voc├¬ j├í est├í atendendo ${maxChats} chats simultaneamente`);\r\n        return false;\r\n      }\r\n\r\n      const { error } = await supabase\r\n        .from('support_chat_sessions')\r\n        .update({\r\n          status: 'active',\r\n          assigned_agent_id: user.id,\r\n          accepted_at: new Date().toISOString()\r\n        })\r\n        .eq('id', sessionId);\r\n\r\n      if (error) throw error;\r\n\r\n      playAcceptSound();\r\n      toast.success('Chat aceito com sucesso!');\r\n      \r\n      // Log action\r\n      await supabase.from('support_actions_log').insert({\r\n        support_user_id: user.id,\r\n        action_type: 'chat_accepted',\r\n        target_type: 'chat_session',\r\n        target_id: sessionId,\r\n        description: 'Agente aceitou chat'\r\n      });\r\n\r\n      return true;\r\n    } catch (error) {\r\n      console.error('Error accepting chat:', error);\r\n      toast.error('Erro ao aceitar chat');\r\n      return false;\r\n    }\r\n  };\r\n\r\n  const sendMessage = async (sessionId: string, message: string) => {\r\n    try {\r\n      const { data: { user } } = await supabase.auth.getUser();\r\n      if (!user) throw new Error('Usu├írio n├úo autenticado');\r\n\r\n      const { error } = await supabase\r\n        .from('support_chat_messages')\r\n        .insert({\r\n          session_id: sessionId,\r\n          sender_type: 'agent',\r\n          sender_id: user.id,\r\n          message\r\n        });\r\n\r\n      if (error) throw error;\r\n      return true;\r\n    } catch (error) {\r\n      console.error('Error sending message:', error);\r\n      toast.error('Erro ao enviar mensagem');\r\n      return false;\r\n    }\r\n  };\r\n\r\n  const resolveChat = async (sessionId: string) => {\r\n    try {\r\n      const { error } = await supabase\r\n        .from('support_chat_sessions')\r\n        .update({\r\n          status: 'resolved',\r\n          ended_at: new Date().toISOString()\r\n        })\r\n        .eq('id', sessionId);\r\n\r\n      if (error) throw error;\r\n      toast.success('Chat resolvido!');\r\n      \r\n      const { data: { user } } = await supabase.auth.getUser();\r\n      if (user) {\r\n        await supabase.from('support_actions_log').insert({\r\n          support_user_id: user.id,\r\n          action_type: 'chat_resolved',\r\n          target_type: 'chat_session',\r\n          target_id: sessionId,\r\n          description: 'Chat marcado como resolvido'\r\n        });\r\n      }\r\n\r\n      return true;\r\n    } catch (error) {\r\n      console.error('Error resolving chat:', error);\r\n      toast.error('Erro ao resolver chat');\r\n      return false;\r\n    }\r\n  };\r\n\r\n  const elevateToTicket = async (sessionId: string) => {\r\n    try {\r\n      const { data: { user } } = await supabase.auth.getUser();\r\n      if (!user) throw new Error('Usu├írio n├úo autenticado');\r\n\r\n      // Get session and messages\r\n      const { data: session } = await supabase\r\n        .from('support_chat_sessions')\r\n        .select('*')\r\n        .eq('id', sessionId)\r\n        .single();\r\n\r\n      const { data: messages } = await supabase\r\n        .from('support_chat_messages')\r\n        .select('*')\r\n        .eq('session_id', sessionId)\r\n        .order('created_at', { ascending: true });\r\n\r\n      if (!session) throw new Error('Sess├úo n├úo encontrada');\r\n\r\n      // Create transcript\r\n      const transcript = messages?.map(m => \r\n        `[${new Date(m.created_at).toLocaleString()}] ${m.sender_type === 'agent' ? 'Agente' : 'Cliente'}: ${m.message}`\r\n      ).join('\\n\\n');\r\n\r\n      // Create ticket\r\n      const { data: ticket, error } = await supabase\r\n        .from('support_tickets')\r\n        .insert({\r\n          tenant_id: session.tenant_id,\r\n          user_id: user.id,\r\n          title: `Chat de ${session.client_name || 'Cliente'}`,\r\n          description: `Chat elevado a ticket\\n\\nCliente: ${session.client_name || 'N/A'}\\nEmail: ${session.client_email || 'N/A'}\\nTelefone: ${session.client_phone || 'N/A'}\\n\\n--- Hist├│rico do Chat ---\\n\\n${transcript}`,\r\n          priority: 'medium',\r\n          status: 'open',\r\n          origem: 'chat'\r\n        })\r\n        .select()\r\n        .single();\r\n\r\n      if (error) throw error;\r\n\r\n      // Update session\r\n      const currentMetadata = (session.metadata as Record<string, any>) || {};\r\n      await supabase\r\n        .from('support_chat_sessions')\r\n        .update({\r\n          status: 'closed',\r\n          ended_at: new Date().toISOString(),\r\n          metadata: { ...currentMetadata, elevated_ticket_id: ticket.id }\r\n        })\r\n        .eq('id', sessionId);\r\n\r\n      // Log action\r\n      await supabase.from('support_actions_log').insert({\r\n        support_user_id: user.id,\r\n        action_type: 'chat_elevated',\r\n        target_type: 'chat_session',\r\n        target_id: sessionId,\r\n        description: `Chat elevado ao ticket #${ticket.numero}`,\r\n        metadata: { ticket_id: ticket.id, ticket_numero: ticket.numero }\r\n      });\r\n\r\n      toast.success(`Chat elevado ao ticket #${ticket.numero}`);\r\n      return ticket;\r\n    } catch (error) {\r\n      console.error('Error elevating to ticket:', error);\r\n      toast.error('Erro ao elevar chat a ticket');\r\n      return null;\r\n    }\r\n  };\r\n\r\n  const updatePreferences = async (preferences: { sound_enabled?: boolean; sound_volume?: number; max_concurrent_chats?: number }) => {\r\n    try {\r\n      const { data: { user } } = await supabase.auth.getUser();\r\n      if (!user) return;\r\n\r\n      const { error } = await supabase\r\n        .from('support_agent_preferences')\r\n        .upsert({\r\n          agent_id: user.id,\r\n          ...preferences\r\n        });\r\n\r\n      if (error) throw error;\r\n\r\n      if (preferences.sound_enabled !== undefined) setSoundEnabled(preferences.sound_enabled);\r\n      if (preferences.sound_volume !== undefined) setSoundVolume(preferences.sound_volume);\r\n\r\n      toast.success('Prefer├¬ncias atualizadas');\r\n    } catch (error) {\r\n      console.error('Error updating preferences:', error);\r\n      toast.error('Erro ao atualizar prefer├¬ncias');\r\n    }\r\n  };\r\n\r\n  const playNotificationSound = () => {\r\n    if (!soundEnabled) return;\r\n    \r\n    const audio = new Audio('data:audio/wav;base64,UklGRnoGAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQoGAACBhYqFbF1fdJivrJBhNjVgodDbq2EcBj+a2/LDciUFLIHO8tiJNwgZaLvt559NEAxQp+PwtmMcBjiR1/LMeSwFJHfH8N2QQAoUXrTp66hVFApGn+DyvmwhBzGM0/PKdyoFJHjH8N6RQQMTX7Tp661VFA==');\r\n    audio.volume = soundVolume / 100;\r\n    audio.play().catch(e => console.error('Error playing sound:', e));\r\n  };\r\n\r\n  const playAcceptSound = () => {\r\n    if (!soundEnabled) return;\r\n    \r\n    const audio = new Audio('data:audio/wav;base64,UklGRnoGAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQoGAAB/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fn9/fg==');\r\n    audio.volume = soundVolume / 100;\r\n    audio.play().catch(e => console.error('Error playing sound:', e));\r\n  };\r\n\r\n  return {\r\n    waitingSessions,\r\n    activeSessions,\r\n    recentSessions,\r\n    soundEnabled,\r\n    soundVolume,\r\n    acceptChat,\r\n    sendMessage,\r\n    resolveChat,\r\n    elevateToTicket,\r\n    updatePreferences,\r\n    loadSessions\r\n  };\r\n};\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useTenantData.tsx","messages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":133,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":133,"endColumn":30}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, {\n  createContext,\n  useContext,\n  useState,\n  useEffect,\n  useCallback,\n  ReactNode,\n} from \"react\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { useAuth } from \"@/hooks/useAuth\";\nimport { useLocation } from \"react-router-dom\";\n\ninterface TenantData {\n  nome: string;\n  tipo: string;\n  cnpj: string | null;\n  razao_social: string | null;\n  nome_fantasia: string | null;\n  font_size: number;\n  cor_primaria: string | null;\n  cor_acao: string | null;\n}\n\ninterface TenantContextType {\n  tenantData: TenantData | null;\n  isLoading: boolean;\n  refreshTenantData: () => Promise<void>;\n  updateTenantData: (data: Partial<TenantData>) => void;\n  displayName: string;\n}\n\nconst TenantContext = createContext<TenantContextType | undefined>(undefined);\n\nexport function TenantProvider({ children }: { children: ReactNode }) {\n  const { profile } = useAuth();\n  const [tenantData, setTenantData] = useState<TenantData | null>(null);\n  const [isLoading, setIsLoading] = useState(true);\n  const location = useLocation();\n\n  const fetchTenantData = useCallback(async () => {\n    const impersonationId = localStorage.getItem(\n      \"support_impersonation_tenant_id\",\n    );\n    const targetTenantId = impersonationId || profile?.tenant_id;\n\n    if (!targetTenantId) {\n      setIsLoading(false);\n      return;\n    }\n\n    try {\n      setIsLoading(true);\n      const { data, error } = await supabase\n        .from(\"tenants\")\n        .select(\n          \"nome, tipo, cnpj, razao_social, nome_fantasia, font_size, cor_primaria, cor_acao\",\n        )\n        .eq(\"id\", targetTenantId)\n        .maybeSingle();\n\n      if (error) throw error;\n      if (data) {\n        setTenantData({\n          nome: data.nome,\n          tipo: data.tipo,\n          cnpj: data.cnpj,\n          razao_social: data.razao_social,\n          nome_fantasia: data.nome_fantasia,\n          font_size: data.font_size || 16,\n          cor_primaria: data.cor_primaria,\n          cor_acao: data.cor_acao,\n        });\n      }\n    } catch (error) {\n      console.error(\"Erro ao buscar dados do tenant:\", error);\n      setTenantData({\n        nome: \"Empresa\",\n        tipo: \"clinica\",\n        cnpj: null,\n        razao_social: null,\n        nome_fantasia: null,\n        font_size: 16,\n        cor_primaria: null,\n        cor_acao: null,\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  }, [profile?.tenant_id]);\n\n  useEffect(() => {\n    fetchTenantData();\n  }, [fetchTenantData]);\n\n  // Apply font size to document root, but NOT on the landing page\n  useEffect(() => {\n    const isLandingPage = location.pathname === \"/\";\n\n    if (tenantData?.font_size && !isLandingPage) {\n      document.documentElement.style.fontSize = `${tenantData.font_size}px`;\n    } else if (isLandingPage) {\n      // Reset to browser default on landing page\n      document.documentElement.style.fontSize = \"\";\n    }\n  }, [tenantData?.font_size, location.pathname]);\n\n  const updateTenantData = useCallback((data: Partial<TenantData>) => {\n    setTenantData((prev) => (prev ? { ...prev, ...data } : null));\n  }, []);\n\n  // Display name: prefer nome_fantasia, fallback to razao_social, then nome\n  const displayName =\n    tenantData?.nome_fantasia ||\n    tenantData?.razao_social ||\n    tenantData?.nome ||\n    \"Empresa\";\n\n  return (\n    <TenantContext.Provider\n      value={{\n        tenantData,\n        isLoading,\n        refreshTenantData: fetchTenantData,\n        updateTenantData,\n        displayName,\n      }}\n    >\n      {children}\n    </TenantContext.Provider>\n  );\n}\n\nexport function useTenantData() {\n  const context = useContext(TenantContext);\n  if (context === undefined) {\n    throw new Error(\"useTenantData must be used within a TenantProvider\");\n  }\n  return context;\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useTenantFeatures.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useTenantProfile.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useTour.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useUnitPermissions.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useUserRoles.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useWhatsAppNotifications.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'subscribeToNewMessages'. Either include it or remove the dependency array.","line":23,"column":6,"nodeType":"ArrayExpression","endLine":23,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [subscribeToNewMessages]","fix":{"range":[687,689],"text":"[subscribeToNewMessages]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useState, useRef } from \"react\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { toast } from \"sonner\";\n\ninterface WhatsAppNotification {\n  id: string;\n  conversation_id: string;\n  telefone: string;\n  paciente_nome?: string;\n  mensagem: string;\n  timestamp: string;\n}\n\nexport function useWhatsAppNotifications() {\n  const [unreadCount, setUnreadCount] = useState(0);\n  const [notifications, setNotifications] = useState<WhatsAppNotification[]>([]);\n  const [soundEnabled, setSoundEnabled] = useState(true);\n  const audioContextRef = useRef<AudioContext | null>(null);\n\n  useEffect(() => {\n    loadUnreadCount();\n    subscribeToNewMessages();\n  }, []);\n\n  const loadUnreadCount = async () => {\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) return;\n\n      const { data: profile } = await supabase\n        .from(\"profiles\")\n        .select(\"tenant_id\")\n        .eq(\"id\", user.id)\n        .single();\n\n      if (!profile?.tenant_id) return;\n\n      const { count, error } = await supabase\n        .from(\"whatsapp_messages\")\n        .select(\"id\", { count: \"exact\", head: true })\n        .eq(\"direcao\", \"entrada\")\n        .is(\"metadata->lido\", null);\n\n      if (error) throw error;\n      setUnreadCount(count || 0);\n    } catch (error) {\n      console.error(\"Erro ao carregar contador de n├úo lidas:\", error);\n    }\n  };\n\n  const subscribeToNewMessages = () => {\n    const channel = supabase\n      .channel(\"whatsapp-new-messages\")\n      .on(\n        \"postgres_changes\",\n        {\n          event: \"INSERT\",\n          schema: \"public\",\n          table: \"whatsapp_messages\",\n          filter: \"direcao=eq.entrada\",\n        },\n        async (payload) => {\n          const newMessage = payload.new as any;\n          \n          // Buscar dados da conversa\n          const { data: conversation } = await supabase\n            .from(\"whatsapp_conversations\")\n            .select(`\n              id,\n              telefone,\n              pacientes:paciente_id(nome)\n            `)\n            .eq(\"id\", newMessage.conversation_id)\n            .single();\n\n          if (conversation) {\n            const notification: WhatsAppNotification = {\n              id: newMessage.id,\n              conversation_id: newMessage.conversation_id,\n              telefone: conversation.telefone,\n              paciente_nome: conversation.pacientes?.nome,\n              mensagem: newMessage.conteudo,\n              timestamp: newMessage.timestamp,\n            };\n\n            setNotifications(prev => [notification, ...prev]);\n            setUnreadCount(prev => prev + 1);\n\n            // Tocar som\n            if (soundEnabled) {\n              playNotificationSound();\n            }\n\n            // Mostrar toast\n            toast.info(`Nova mensagem de ${notification.paciente_nome || notification.telefone}`, {\n              description: notification.mensagem.substring(0, 100),\n            });\n          }\n        }\n      )\n      .subscribe();\n\n    return () => {\n      supabase.removeChannel(channel);\n    };\n  };\n\n  const playNotificationSound = () => {\n    if (!audioContextRef.current) {\n      audioContextRef.current = new (window.AudioContext || (window as any).webkitAudioContext)();\n    }\n\n    const ctx = audioContextRef.current;\n    const oscillator = ctx.createOscillator();\n    const gainNode = ctx.createGain();\n\n    oscillator.connect(gainNode);\n    gainNode.connect(ctx.destination);\n\n    // Som de notifica├º├úo WhatsApp-like\n    oscillator.frequency.setValueAtTime(800, ctx.currentTime);\n    oscillator.frequency.setValueAtTime(600, ctx.currentTime + 0.1);\n\n    gainNode.gain.setValueAtTime(0.3, ctx.currentTime);\n    gainNode.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3);\n\n    oscillator.start(ctx.currentTime);\n    oscillator.stop(ctx.currentTime + 0.3);\n  };\n\n  const markAsRead = async (conversationId: string) => {\n    try {\n      // Atualizar metadata das mensagens para marcar como lidas\n      const { data: messages, error: fetchError } = await supabase\n        .from(\"whatsapp_messages\")\n        .select(\"id, metadata\")\n        .eq(\"conversation_id\", conversationId)\n        .eq(\"direcao\", \"entrada\");\n\n      if (fetchError) throw fetchError;\n\n      for (const msg of messages || []) {\n        await supabase\n          .from(\"whatsapp_messages\")\n          .update({\n            metadata: { ...(msg.metadata as any), lido: true, lido_em: new Date().toISOString() }\n          })\n          .eq(\"id\", msg.id);\n      }\n\n      setNotifications(prev => prev.filter(n => n.conversation_id !== conversationId));\n      loadUnreadCount();\n    } catch (error) {\n      console.error(\"Erro ao marcar como lida:\", error);\n    }\n  };\n\n  const clearNotification = (notificationId: string) => {\n    setNotifications(prev => prev.filter(n => n.id !== notificationId));\n  };\n\n  return {\n    unreadCount,\n    notifications,\n    soundEnabled,\n    setSoundEnabled,\n    markAsRead,\n    clearNotification,\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\hooks\\useWhatsAppPhoneNumbers.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\integra