c\\components\\landing\\TargetAudience.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\landing\\TechDetails.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\landing\\Testimonials.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\landing\\ValuePillars.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\landing\\WhatsAppButton.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\layout\\AdminLayout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\layout\\AlertsPopover.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchAlerts'. Either include it or remove the dependency array.","line":58,"column":6,"nodeType":"ArrayExpression","endLine":58,"endColumn":26,"suggestions":[{"desc":"Update the dependencies array to be: [fetchAlerts, profile?.tenant_id]","fix":{"range":[1516,1536],"text":"[fetchAlerts, profile?.tenant_id]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Bell, CheckCheck, AlertCircle, Clock, XCircle } from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { ScrollArea } from \"@/components/ui/scroll-area\";\nimport {\n  Popover,\n  PopoverContent,\n  PopoverTrigger,\n} from \"@/components/ui/popover\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { useAuth } from \"@/hooks/useAuth\";\nimport { toast } from \"@/hooks/use-toast\";\nimport { format } from \"date-fns\";\nimport { ptBR } from \"date-fns/locale\";\n\ninterface Alert {\n  id: string;\n  tipo: string;\n  prioridade: string;\n  titulo: string;\n  descricao: string;\n  created_at: string;\n  lido: boolean;\n  paciente_id: string;\n  agendamento_id: string | null;\n}\n\nexport function AlertsPopover() {\n  const { profile } = useAuth();\n  const [alerts, setAlerts] = useState<Alert[]>([]);\n  const [unreadCount, setUnreadCount] = useState(0);\n  const [isOpen, setIsOpen] = useState(false);\n\n  useEffect(() => {\n    fetchAlerts();\n    \n    // Subscribe to realtime updates\n    const channel = supabase\n      .channel('alertas-changes')\n      .on(\n        'postgres_changes',\n        {\n          event: '*',\n          schema: 'public',\n          table: 'alertas_risco',\n          filter: `tenant_id=eq.${profile?.tenant_id}`\n        },\n        () => {\n          fetchAlerts();\n        }\n      )\n      .subscribe();\n\n    return () => {\n      supabase.removeChannel(channel);\n    };\n  }, [profile?.tenant_id]);\n\n  const fetchAlerts = async () => {\n    if (!profile?.tenant_id) return;\n\n    try {\n      const { data, error } = await supabase\n        .from('alertas_risco')\n        .select('*')\n        .eq('tenant_id', profile.tenant_id)\n        .eq('resolvido', false)\n        .order('created_at', { ascending: false })\n        .limit(20);\n\n      if (error) throw error;\n\n      setAlerts(data || []);\n      setUnreadCount(data?.filter(a => !a.lido).length || 0);\n    } catch (error) {\n      console.error('Erro ao buscar alertas:', error);\n    }\n  };\n\n  const markAsRead = async (alertId: string) => {\n    try {\n      const { error } = await supabase\n        .from('alertas_risco')\n        .update({\n          lido: true,\n          lido_em: new Date().toISOString(),\n          lido_por: profile?.id\n        })\n        .eq('id', alertId);\n\n      if (error) throw error;\n\n      setAlerts(prev => \n        prev.map(a => a.id === alertId ? { ...a, lido: true } : a)\n      );\n      setUnreadCount(prev => Math.max(0, prev - 1));\n    } catch (error) {\n      console.error('Erro ao marcar alerta como lido:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel marcar o alerta como lido\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const markAllAsRead = async () => {\n    if (!profile?.tenant_id) return;\n\n    try {\n      const { error } = await supabase\n        .from('alertas_risco')\n        .update({\n          lido: true,\n          lido_em: new Date().toISOString(),\n          lido_por: profile?.id\n        })\n        .eq('tenant_id', profile.tenant_id)\n        .eq('lido', false)\n        .eq('resolvido', false);\n\n      if (error) throw error;\n\n      setAlerts(prev => prev.map(a => ({ ...a, lido: true })));\n      setUnreadCount(0);\n      \n      toast({\n        title: \"Sucesso\",\n        description: \"Todos os alertas foram marcados como lidos\"\n      });\n    } catch (error) {\n      console.error('Erro ao marcar todos como lidos:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel marcar todos os alertas como lidos\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const getAlertIcon = (tipo: string) => {\n    switch (tipo) {\n      case 'risco_no_show':\n        return <XCircle className=\"h-4 w-4 text-destructive\" />;\n      case 'confirmacao_pendente':\n        return <Clock className=\"h-4 w-4 text-warning\" />;\n      case 'atraso':\n        return <AlertCircle className=\"h-4 w-4 text-warning\" />;\n      default:\n        return <AlertCircle className=\"h-4 w-4 text-muted-foreground\" />;\n    }\n  };\n\n  const getPriorityColor = (prioridade: string) => {\n    switch (prioridade) {\n      case 'alta':\n        return 'border-l-destructive bg-destructive-light';\n      case 'media':\n        return 'border-l-warning bg-warning-light';\n      case 'baixa':\n        return 'border-l-success bg-success-light';\n      default:\n        return 'border-l-muted';\n    }\n  };\n\n  return (\n    <Popover open={isOpen} onOpenChange={setIsOpen}>\n      <PopoverTrigger asChild>\n        <Button variant=\"ghost\" size=\"icon\" className=\"relative\">\n          <Bell className=\"h-5 w-5\" />\n          {unreadCount > 0 && (\n            <Badge \n              variant=\"destructive\" \n              className=\"absolute -top-1 -right-1 h-5 w-5 p-0 flex items-center justify-center text-xs\"\n            >\n              {unreadCount > 9 ? '9+' : unreadCount}\n            </Badge>\n          )}\n        </Button>\n      </PopoverTrigger>\n      <PopoverContent className=\"w-96 p-0\" align=\"end\">\n        <div className=\"flex items-center justify-between p-4 border-b\">\n          <h3 className=\"font-semibold text-foreground\">Alertas</h3>\n          {unreadCount > 0 && (\n            <Button \n              variant=\"ghost\" \n              size=\"sm\" \n              onClick={markAllAsRead}\n              className=\"h-8 text-xs\"\n            >\n              <CheckCheck className=\"h-4 w-4 mr-1\" />\n              Marcar todos como lidos\n            </Button>\n          )}\n        </div>\n\n        <ScrollArea className=\"h-[400px]\">\n          {alerts.length === 0 ? (\n            <div className=\"flex flex-col items-center justify-center py-12 px-4 text-center\">\n              <Bell className=\"h-12 w-12 text-muted-foreground/50 mb-3\" />\n              <p className=\"text-sm text-muted-foreground\">\n                Nenhum alerta no momento\n              </p>\n            </div>\n          ) : (\n            <div className=\"divide-y\">\n              {alerts.map((alert) => (\n                <div\n                  key={alert.id}\n                  className={`p-4 border-l-4 transition-colors hover:bg-accent/50 ${\n                    !alert.lido ? 'bg-accent/20' : ''\n                  } ${getPriorityColor(alert.prioridade)}`}\n                >\n                  <div className=\"flex items-start gap-3\">\n                    <div className=\"mt-1\">{getAlertIcon(alert.tipo)}</div>\n                    <div className=\"flex-1 min-w-0\">\n                      <div className=\"flex items-start justify-between gap-2\">\n                        <h4 className=\"text-sm font-medium text-foreground\">\n                          {alert.titulo}\n                        </h4>\n                        {!alert.lido && (\n                          <Badge variant=\"secondary\" className=\"shrink-0 text-xs\">\n                            Novo\n                          </Badge>\n                        )}\n                      </div>\n                      <p className=\"text-xs text-muted-foreground mt-1\">\n                        {alert.descricao}\n                      </p>\n                      <div className=\"flex items-center justify-between mt-2\">\n                        <span className=\"text-xs text-muted-foreground\">\n                          {format(new Date(alert.created_at), \"dd/MM '├ás' HH:mm\", { locale: ptBR })}\n                        </span>\n                        {!alert.lido && (\n                          <Button\n                            variant=\"ghost\"\n                            size=\"sm\"\n                            onClick={() => markAsRead(alert.id)}\n                            className=\"h-6 text-xs\"\n                          >\n                            Marcar como lido\n                          </Button>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              ))}\n            </div>\n          )}\n        </ScrollArea>\n      </PopoverContent>\n    </Popover>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\layout\\CookieConsent.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\layout\\Header.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\layout\\MainLayout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\layout\\MobileLayout.tsx","messages":[{"ruleId":"react-hooks/rules-of-hooks","severity":2,"message":"React Hook \"useSidebarWidth\" is called conditionally. React Hooks must be called in the exact same order in every component render.","line":94,"column":26,"nodeType":"Identifier","endLine":94,"endColumn":41}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Sidebar } from \"./Sidebar\";\nimport { Header } from \"./Header\";\nimport { Button } from \"@/components/ui/button\";\nimport { Menu, AlertTriangle, LogOut } from \"lucide-react\";\nimport { cn } from \"@/lib/utils\";\nimport { Sheet, SheetContent, SheetTrigger } from \"@/components/ui/sheet\";\nimport { useIsMobile } from \"@/hooks/use-mobile\";\nimport { useAuth } from \"@/hooks/useAuth\";\nimport { useNavigate } from \"react-router-dom\";\nimport { useSidebarWidth } from \"@/hooks/useSidebarWidth\";\nimport { SupportChatWidget } from \"@/components/support/SupportChatWidget\";\n\ninterface MobileLayoutProps {\n  children: React.ReactNode;\n}\n\nexport function MobileLayout({ children }: MobileLayoutProps) {\n  const [sidebarOpen, setSidebarOpen] = useState(false);\n  const isMobile = useIsMobile();\n  const { profile, loading } = useAuth();\n  const navigate = useNavigate();\n  const { width } = useSidebarWidth();\n  const [impersonationId, setImpersonationId] = useState<string | null>(null);\n\n  useEffect(() => {\n    const id = localStorage.getItem(\"support_impersonation_tenant_id\");\n    setImpersonationId(id);\n  }, []);\n\n  // Redirect to signup if user has no tenant (first time OAuth users)\n  useEffect(() => {\n    if (!loading && profile && !profile.tenant_id && !impersonationId) {\n      navigate(\"/signup\");\n    }\n  }, [profile, loading, navigate, impersonationId]);\n\n  const handleExitImpersonation = () => {\n    localStorage.removeItem(\"support_impersonation_tenant_id\");\n    window.location.href = \"/admin/tenants\";\n  };\n\n  const ImpersonationBanner = () => (\n    <div className=\"bg-orange-600 text-white px-4 py-2 flex items-center justify-between shadow-md z-50 relative\">\n      <div className=\"flex items-center gap-2\">\n        <AlertTriangle className=\"h-4 w-4\" />\n        <span className=\"text-sm font-medium\">\n          Acessando como Suporte Administrativo\n        </span>\n      </div>\n      <Button\n        variant=\"secondary\"\n        size=\"sm\"\n        className=\"h-7 text-xs bg-white text-orange-600 hover:bg-orange-50 border-0\"\n        onClick={handleExitImpersonation}\n      >\n        <LogOut className=\"h-3 w-3 mr-1\" />\n        Sair do Acesso\n      </Button>\n    </div>\n  );\n\n  if (isMobile) {\n    return (\n      <div className=\"min-h-screen bg-background text-foreground\">\n        {impersonationId && <ImpersonationBanner />}\n        <div className=\"flex flex-col h-screen\">\n          {/* Mobile Header with Menu Button */}\n          <div className=\"flex items-center gap-2 p-4 bg-card border-b border-border\">\n            <Sheet open={sidebarOpen} onOpenChange={setSidebarOpen}>\n              <SheetTrigger asChild>\n                <Button variant=\"ghost\" size=\"icon\">\n                  <Menu className=\"h-6 w-6\" />\n                </Button>\n              </SheetTrigger>\n              <SheetContent side=\"left\" className=\"p-0 w-64\">\n                <Sidebar onLinkClick={() => setSidebarOpen(false)} />\n              </SheetContent>\n            </Sheet>\n            <div className=\"flex-1\">\n              <Header className=\"p-0 border-0\" />\n            </div>\n          </div>\n\n          {/* Main Content */}\n          <main className=\"flex-1 overflow-auto p-4\">{children}</main>\n        </div>\n        <SupportChatWidget />\n      </div>\n    );\n  }\n\n  // Desktop layout\n  const { isResizing } = useSidebarWidth();\n\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      {impersonationId && <ImpersonationBanner />}\n      <div className=\"flex\">\n        {/* Sidebar - z-40 para ficar acima do conte├║do */}\n        <div\n          className=\"fixed left-0 top-0 h-full z-40\"\n          style={{ top: impersonationId ? \"44px\" : \"0\" }}\n        >\n          <Sidebar />\n        </div>\n\n        {/* Main Content - z-0 para ficar abaixo do sidebar */}\n        <div\n          className={cn(\n            \"flex-1 relative z-0\",\n            !isResizing && \"transition-all duration-200 ease-out\",\n          )}\n          style={{ marginLeft: `${width}px` }}\n        >\n          <Header />\n          <main className=\"p-6\">{children}</main>\n        </div>\n      </div>\n      <SupportChatWidget />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\layout\\OrganizationUnitSelector.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\layout\\Sidebar.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useLayoutEffect has a missing dependency: 'sidebarScroll'. Either include it or remove the dependency array.","line":205,"column":6,"nodeType":"ArrayExpression","endLine":205,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [sidebarScroll]","fix":{"range":[4292,4294],"text":"[sidebarScroll]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useLayoutEffect, useRef } from \"react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { cn } from \"@/lib/utils\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Calendar,\n  Users,\n  MessageSquare,\n  BarChart3,\n  Settings,\n  Stethoscope,\n  Home,\n  ShoppingBag,\n  TestTube,\n  User,\n  ClipboardList,\n  Syringe,\n  GripVertical,\n  FileEdit,\n  DollarSign,\n  Building2,\n  HelpCircle,\n  Bell,\n} from \"lucide-react\";\nimport { useSidebarWidth } from \"@/hooks/useSidebarWidth\";\nimport { useTenantData } from \"@/hooks/useTenantData\";\nimport { useSidebarStore } from \"@/stores/useSidebarStore\";\n\ninterface SidebarProps {\n  className?: string;\n  onLinkClick?: () => void;\n}\n\n// 1. Opera├º├úo Principal\nconst coreItems = [\n  {\n    title: \"Hub Central\",\n    icon: Home,\n    href: \"/dashboard\",\n    color: \"text-medical-cyan\",\n  },\n  {\n    title: \"Vis├úo Geral\",\n    icon: BarChart3,\n    href: \"/visao-geral\",\n    color: \"text-medical-cyan\",\n  },\n  {\n    title: \"Agenda do Dia\",\n    icon: Calendar,\n    href: \"/agenda\",\n    color: \"text-medical-cyan\",\n  },\n  {\n    title: \"Atendimento\",\n    icon: FileEdit,\n    href: \"/atendimento\",\n    color: \"text-medical-cyan\",\n  },\n  {\n    title: \"FlowChat\",\n    icon: MessageSquare,\n    href: \"/flowchat\",\n    color: \"text-success\",\n  },\n];\n\n// 2. Cl├¡nico e Pacientes\nconst clinicalItems = [\n  {\n    title: \"Pacientes\",\n    icon: Users,\n    href: \"/pacientes\",\n    color: \"text-sidebar-foreground\",\n  },\n  {\n    title: \"Prontu├írios\",\n    icon: ClipboardList,\n    href: \"/prontuarios\",\n    color: \"text-sidebar-foreground\",\n  },\n  {\n    title: \"Exames\",\n    icon: TestTube,\n    href: \"/exames\",\n    color: \"text-sidebar-foreground\",\n  },\n];\n\n// 3. Financeiro e Comercial\nconst financialItems = [\n  {\n    title: \"Financeiro\",\n    icon: DollarSign,\n    href: \"/financeiro\",\n    color: \"text-sidebar-foreground\",\n  },\n  {\n    title: \"Caixa Di├írio\",\n    icon: ShoppingBag,\n    href: \"/caixa-diario\",\n    color: \"text-sidebar-foreground\",\n  },\n  {\n    title: \"Pacotes\",\n    icon: ShoppingBag,\n    href: \"/pacotes\",\n    color: \"text-sidebar-foreground\",\n  },\n  {\n    title: \"Procedimentos\",\n    icon: Syringe,\n    href: \"/procedimentos\",\n    color: \"text-sidebar-foreground\",\n  },\n  {\n    title: \"Planos de Sa├║de\",\n    icon: ClipboardList,\n    href: \"/planos-saude\",\n    color: \"text-sidebar-foreground\",\n  },\n];\n\n// 4. Gest├úo e Relat├│rios\nconst managementItems = [\n  {\n    title: \"Relat├│rios\",\n    icon: BarChart3,\n    href: \"/relatorios\",\n    color: \"text-sidebar-foreground\",\n  },\n  {\n    title: \"Profissionais\",\n    icon: Users,\n    href: \"/profissionais\",\n    color: \"text-sidebar-foreground\",\n  },\n  {\n    title: \"Unidades\",\n    icon: Building2,\n    href: \"/unidades\",\n    color: \"text-sidebar-foreground\",\n  },\n  {\n    title: \"Especialidades\",\n    icon: Stethoscope,\n    href: \"/especialidades\",\n    color: \"text-sidebar-foreground\",\n  },\n  {\n    title: \"Tipos de Profissional\",\n    icon: User,\n    href: \"/tipos-profissional\",\n    color: \"text-sidebar-foreground\",\n  },\n];\n\n// 5. Itens de Rodap├® (Ajustes e Conta)\nconst bottomItems = [\n  {\n    title: \"Alarmes\",\n    icon: Bell,\n    href: \"/alarmes-lembretes\",\n    color: \"text-warning\",\n  },\n  {\n    title: \"Central de Ajuda\",\n    icon: HelpCircle,\n    href: \"/support\",\n    color: \"text-sidebar-foreground\",\n  },\n  {\n    title: \"Configura├º├Áes\",\n    icon: Settings,\n    href: \"/configuracoes\",\n    color: \"text-sidebar-foreground\",\n  },\n  {\n    title: \"Perfil\",\n    icon: User,\n    href: \"/perfil\",\n    color: \"text-sidebar-foreground\",\n  },\n];\n\nconst sidebarSections = [\n  { label: \"Principal\", items: coreItems },\n  { label: \"Cl├¡nico\", items: clinicalItems },\n  { label: \"Financeiro\", items: financialItems },\n  { label: \"Gest├úo\", items: managementItems },\n];\n\nexport function Sidebar({ className, onLinkClick }: SidebarProps) {\n  const location = useLocation();\n  const { displayName, isLoading } = useTenantData();\n  const { width, isResizing, handleMouseDown } = useSidebarWidth();\n  const { sidebarScroll, setSidebarScroll } = useSidebarStore();\n  const scrollRef = useRef<HTMLDivElement>(null);\n\n  // Restore scroll position on mount\n  useLayoutEffect(() => {\n    if (scrollRef.current && sidebarScroll > 0) {\n      scrollRef.current.scrollTop = sidebarScroll;\n    }\n  }, []);\n\n  const handleScroll = (e: React.UIEvent<HTMLDivElement>) => {\n    setSidebarScroll(e.currentTarget.scrollTop);\n  };\n\n  const getTipoLabel = (tipo: string) => {\n    switch (tipo) {\n      case \"profissional\":\n        return \"Profissional Aut├┤nomo\";\n      case \"consultorio\":\n        return \"Consult├│rio\";\n      case \"clinica\":\n        return \"Cl├¡nica\";\n      default:\n        return \"Estabelecimento\";\n    }\n  };\n\n  return (\n    <div\n      className={cn(\n        \"bg-sidebar-background border-r border-sidebar-border h-full flex flex-col relative\",\n        className,\n      )}\n      style={{ width: `${width}px` }}\n    >\n      <div className=\"px-4 pr-6 border-b border-sidebar-border flex-shrink-0 h-20 flex items-center\">\n        <div className=\"flex items-center gap-3 w-full\">\n          <div className=\"p-2 bg-[#22D3EE] rounded-lg shadow-lg shadow-cyan-500/20 flex-shrink-0\">\n            <Stethoscope className=\"h-6 w-6 text-background\" />\n          </div>\n          <div className=\"min-w-0 flex-1\">\n            <h1 className=\"text-lg font-black text-sidebar-foreground tracking-tight leading-none truncate\">\n              CleanFlow\n            </h1>\n            <p className=\"text-[11px] text-sidebar-foreground font-bold leading-tight mt-0.5 truncate uppercase tracking-wider\">\n              {isLoading ? \"Carregando...\" : displayName}\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Navigation - scrolls vertically only */}\n      <div\n        ref={scrollRef}\n        onScroll={handleScroll}\n        className=\"flex-1 overflow-y-auto overflow-x-hidden sidebar-scroll min-w-0\"\n      >\n        <nav className=\"px-3 py-4 space-y-4\">\n          {sidebarSections.map((section) => (\n            <div key={section.label} className=\"space-y-1\">\n              <h3 className=\"px-2 text-[11px] font-bold uppercase tracking-widest text-sidebar-foreground mb-1\">\n                {section.label}\n              </h3>\n              <div className=\"space-y-1\">\n                {section.items.map((item) => {\n                  const Icon = item.icon;\n                  const isActive = location.pathname === item.href;\n\n                  return (\n                    <Button\n                      key={item.href}\n                      variant={isActive ? \"default\" : \"ghost\"}\n                      className={cn(\n                        \"w-full justify-start gap-3 h-10 transition-all duration-200 rounded-lg\",\n                        isActive\n                          ? \"bg-primary text-primary-foreground font-bold shadow-lg shadow-primary/30\"\n                          : \"hover:bg-sidebar-accent text-sidebar-foreground hover:text-sidebar-foreground font-medium\",\n                      )}\n                      asChild\n                    >\n                      <Link to={item.href} onClick={onLinkClick}>\n                        <Icon\n                          className={cn(\n                            \"h-5 w-5\",\n                            isActive ? \"text-primary-foreground\" : item.color,\n                          )}\n                        />\n                        <span className=\"flex-1 text-left text-[14px] font-semibold tracking-tight\">\n                          {item.title}\n                        </span>\n                      </Link>\n                    </Button>\n                  );\n                })}\n              </div>\n            </div>\n          ))}\n        </nav>\n      </div>\n\n      {/* Bottom Section - Settings/Profile */}\n      <div className=\"px-4 py-4 border-t border-sidebar-border space-y-1 flex-shrink-0\">\n        {bottomItems.map((item) => {\n          const Icon = item.icon;\n          const isActive = location.pathname === item.href;\n\n          return (\n            <Button\n              key={item.href}\n              variant=\"ghost\"\n              className={cn(\n                \"w-full justify-start gap-4 h-12 transition-all duration-200 rounded-lg\",\n                isActive\n                  ? \"bg-primary/10 text-primary font-bold\"\n                  : \"text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-foreground font-medium\",\n              )}\n              asChild\n            >\n              <Link to={item.href} onClick={onLinkClick}>\n                <Icon className=\"h-5 w-5\" />\n                <span className=\"flex-1 text-left text-[14px] tracking-tight\">\n                  {item.title}\n                </span>\n              </Link>\n            </Button>\n          );\n        })}\n      </div>\n\n      {/* Status indicator - Balanced */}\n      <div className=\"px-6 py-4 flex-shrink-0\">\n        <div className=\"flex items-center gap-3 px-1\">\n          <div className=\"w-2.5 h-2.5 bg-success rounded-full animate-pulse shadow-sm shadow-success/50\"></div>\n          <span className=\"text-[11px] font-black uppercase tracking-widest text-success\">\n            Sistema Ativo\n          </span>\n        </div>\n      </div>\n\n      {/* Resize Handle */}\n      <div\n        className={cn(\n          \"absolute top-0 right-0 w-0.5 h-full cursor-col-resize z-50 hover:bg-primary/50 transition-colors group\",\n          isResizing && \"bg-primary\",\n        )}\n        onMouseDown={handleMouseDown}\n      >\n        <div className=\"absolute top-1/2 right-0 -translate-y-1/2 translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity\">\n          <div className=\"bg-background border border-border rounded p-1 shadow-sm\">\n            <GripVertical className=\"h-4 w-4 text-sidebar-foreground\" />\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\legal\\LegalDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\notifications\\AlarmNotificationBell.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'checkForTriggeredAlarms' and 'loadAlarmes'. Either include them or remove the dependency array.","line":64,"column":8,"nodeType":"ArrayExpression","endLine":64,"endColumn":21,"suggestions":[{"desc":"Update the dependencies array to be: [checkForTriggeredAlarms, loadAlarmes, profile.id]","fix":{"range":[1968,1981],"text":"[checkForTriggeredAlarms, loadAlarmes, profile.id]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useState } from 'react';\r\nimport { supabase } from '@/integrations/supabase/client';\r\nimport { useAuth } from '@/hooks/useAuth';\r\nimport { Bell } from 'lucide-react';\r\nimport { Button } from '@/components/ui/button';\r\nimport {\r\n    Popover,\r\n    PopoverContent,\r\n    PopoverTrigger,\r\n} from '@/components/ui/popover';\r\nimport { Badge } from '@/components/ui/badge';\r\nimport { ScrollArea } from '@/components/ui/scroll-area';\r\nimport { format } from 'date-fns';\r\nimport { ptBR } from 'date-fns/locale';\r\nimport { toast } from 'sonner';\r\nimport { playNotificationSound, playUrgentNotificationSound } from '@/utils/notificationSound';\r\n\r\ninterface Alarme {\r\n    id: string;\r\n    titulo: string;\r\n    descricao: string;\r\n    tipo: 'alarme' | 'lembrete' | 'tarefa';\r\n    prioridade: 'baixa' | 'media' | 'alta' | 'urgente';\r\n    data_hora: string;\r\n    concluido: boolean;\r\n}\r\n\r\nexport function AlarmNotificationBell() {\r\n    const { profile } = useAuth();\r\n    const [alarmes, setAlarmes] = useState<Alarme[]>([]);\r\n    const [unreadCount, setUnreadCount] = useState(0);\r\n\r\n    useEffect(() => {\r\n        if (!profile?.id) return;\r\n\r\n        loadAlarmes();\r\n\r\n        // Verificar alarmes a cada minuto\r\n        const interval = setInterval(() => {\r\n            checkForTriggeredAlarms();\r\n        }, 60000); // 1 minuto\r\n\r\n        // Subscription em tempo real\r\n        const channel = supabase\r\n            .channel('alarmes_changes')\r\n            .on(\r\n                'postgres_changes',\r\n                {\r\n                    event: '*',\r\n                    schema: 'public',\r\n                    table: 'alarmes_lembretes',\r\n                    filter: `usuario_id=eq.${profile.id}`\r\n                },\r\n                () => {\r\n                    loadAlarmes();\r\n                }\r\n            )\r\n            .subscribe();\r\n\r\n        return () => {\r\n            clearInterval(interval);\r\n            channel.unsubscribe();\r\n        };\r\n    }, [profile?.id]);\r\n\r\n    const loadAlarmes = async () => {\r\n        if (!profile?.id) return;\r\n\r\n        try {\r\n            const now = new Date();\r\n            const { data, error } = await supabase\r\n                .from('alarmes_lembretes')\r\n                .select('*')\r\n                .eq('usuario_id', profile.id)\r\n                .eq('concluido', false)\r\n                .eq('ativo', true)\r\n                .lte('data_hora', now.toISOString())\r\n                .order('data_hora', { ascending: false })\r\n                .limit(10);\r\n\r\n            if (error) throw error;\r\n\r\n            setAlarmes(data || []);\r\n            setUnreadCount(data?.length || 0);\r\n        } catch (error) {\r\n            console.error('Erro ao carregar alarmes:', error);\r\n        }\r\n    };\r\n\r\n    const checkForTriggeredAlarms = async () => {\r\n        if (!profile?.id) return;\r\n\r\n        try {\r\n            const now = new Date();\r\n            const oneMinuteAgo = new Date(now.getTime() - 60000);\r\n\r\n            const { data, error } = await supabase\r\n                .from('alarmes_lembretes')\r\n                .select('*')\r\n                .eq('usuario_id', profile.id)\r\n                .eq('concluido', false)\r\n                .eq('ativo', true)\r\n                .gte('data_hora', oneMinuteAgo.toISOString())\r\n                .lte('data_hora', now.toISOString());\r\n\r\n            if (error) throw error;\r\n\r\n            // Se houver novos alarmes disparados\r\n            if (data && data.length > 0) {\r\n                data.forEach((alarme: any) => {\r\n                    // Som diferente para urgente\r\n                    if (alarme.prioridade === 'urgente') {\r\n                        playUrgentNotificationSound();\r\n                    } else {\r\n                        playNotificationSound();\r\n                    }\r\n                    showNotification(alarme);\r\n                });\r\n                loadAlarmes();\r\n            }\r\n        } catch (error) {\r\n            console.error('Erro ao verificar alarmes disparados:', error);\r\n        }\r\n    };\r\n\r\n    const showNotification = (alarme: Alarme) => {\r\n        const prioridadeEmoji = {\r\n            baixa: '­ƒôî',\r\n            media: 'ÔÜá´©Å',\r\n            alta: '­ƒöö',\r\n            urgente: '­ƒÜ¿'\r\n        };\r\n\r\n        toast.warning(\r\n            `${prioridadeEmoji[alarme.prioridade]} ${alarme.titulo}`,\r\n            {\r\n                description: alarme.descricao,\r\n                duration: 10000,\r\n                action: {\r\n                    label: 'Ver',\r\n                    onClick: () => window.location.href = '/alarmes-lembretes'\r\n                }\r\n            }\r\n        );\r\n    };\r\n\r\n    const marcarComoConcluido = async (id: string) => {\r\n        try {\r\n            const { error } = await supabase\r\n                .from('alarmes_lembretes')\r\n                .update({ concluido: true })\r\n                .eq('id', id);\r\n\r\n            if (error) throw error;\r\n\r\n            toast.success('Alarme marcado como conclu├¡do');\r\n            loadAlarmes();\r\n        } catch (error) {\r\n            console.error('Erro ao marcar alarme:', error);\r\n            toast.error('Erro ao marcar alarme como conclu├¡do');\r\n        }\r\n    };\r\n\r\n    const getPrioridadeColor = (prioridade: string) => {\r\n        const colors = {\r\n            baixa: 'bg-gray-100 text-gray-800',\r\n            media: 'bg-yellow-100 text-yellow-800',\r\n            alta: 'bg-orange-100 text-orange-800',\r\n            urgente: 'bg-red-100 text-red-800'\r\n        };\r\n        return colors[prioridade as keyof typeof colors] || colors.media;\r\n    };\r\n\r\n    return (\r\n        <Popover>\r\n            <PopoverTrigger asChild>\r\n                <Button variant=\"ghost\" size=\"icon\" className=\"relative\">\r\n                    <Bell className=\"h-5 w-5\" />\r\n                    {unreadCount > 0 && (\r\n                        <Badge\r\n                            variant=\"destructive\"\r\n                            className=\"absolute -top-1 -right-1 h-5 w-5 flex items-center justify-center p-0 text-xs\"\r\n                        >\r\n                            {unreadCount > 9 ? '9+' : unreadCount}\r\n                        </Badge>\r\n                    )}\r\n                </Button>\r\n            </PopoverTrigger>\r\n            <PopoverContent className=\"w-80\" align=\"end\">\r\n                <div className=\"space-y-4\">\r\n                    <div className=\"flex items-center justify-between\">\r\n                        <h4 className=\"font-semibold\">Alarmes Ativos</h4>\r\n                        {unreadCount > 0 && (\r\n                            <Badge variant=\"secondary\">{unreadCount}</Badge>\r\n                        )}\r\n                    </div>\r\n\r\n                    <ScrollArea className=\"h-[400px]\">\r\n                        {alarmes.length === 0 ? (\r\n                            <div className=\"text-center py-8 text-muted-foreground\">\r\n                                <Bell className=\"h-12 w-12 mx-auto mb-2 opacity-50\" />\r\n                                <p>Nenhum alarme ativo</p>\r\n                            </div>\r\n                        ) : (\r\n                            <div className=\"space-y-3\">\r\n                                {alarmes.map((alarme) => (\r\n                                    <div\r\n                                        key={alarme.id}\r\n                                        className=\"p-3 border rounded-lg space-y-2 hover:bg-accent transition-colors\"\r\n                                    >\r\n                                        <div className=\"flex items-start justify-between gap-2\">\r\n                                            <div className=\"flex-1\">\r\n                                                <h5 className=\"font-medium text-sm\">{alarme.titulo}</h5>\r\n                                                {alarme.descricao && (\r\n                                                    <p className=\"text-xs text-muted-foreground mt-1\">\r\n                                                        {alarme.descricao}\r\n                                                    </p>\r\n                                                )}\r\n                                            </div>\r\n                                            <Badge className={getPrioridadeColor(alarme.prioridade)}>\r\n                                                {alarme.prioridade}\r\n                                            </Badge>\r\n                                        </div>\r\n\r\n                                        <div className=\"flex items-center justify-between\">\r\n                                            <span className=\"text-xs text-muted-foreground\">\r\n                                                {format(new Date(alarme.data_hora), \"dd/MM/yyyy '├ás' HH:mm\", {\r\n                                                    locale: ptBR\r\n                                                })}\r\n                                            </span>\r\n                                            <Button\r\n                                                size=\"sm\"\r\n                                                variant=\"outline\"\r\n                                                onClick={() => marcarComoConcluido(alarme.id)}\r\n                                            >\r\n                                                Concluir\r\n                                            </Button>\r\n                                        </div>\r\n                                    </div>\r\n                                ))}\r\n                            </div>\r\n                        )}\r\n                    </ScrollArea>\r\n\r\n                    {alarmes.length > 0 && (\r\n                        <Button\r\n                            variant=\"outline\"\r\n                            className=\"w-full\"\r\n                            onClick={() => window.location.href = '/alarmes-lembretes'}\r\n                        >\r\n                            Ver Todos os Alarmes\r\n                        </Button>\r\n                    )}\r\n                </div>\r\n            </PopoverContent>\r\n        </Popover>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\onboarding\\OnboardingClinica.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\onboarding\\OnboardingConsultorio.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\onboarding\\OnboardingMultiUnidade.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\onboarding\\OnboardingMultiUnit.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\onboarding\\OnboardingProfessional.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\onboarding\\OnboardingSegmento.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\onboarding\\PlanSelection.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchPlans'. Either include it or remove the dependency array.","line":52,"column":8,"nodeType":"ArrayExpression","endLine":52,"endColumn":17,"suggestions":[{"desc":"Update the dependencies array to be: [edition, fetchPlans]","fix":{"range":[1985,1994],"text":"[edition, fetchPlans]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Card } from \"@/components/ui/card\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Slider } from \"@/components/ui/slider\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { Check, Loader2, ArrowLeft, Tag } from \"lucide-react\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { toast } from \"sonner\";\r\n\r\ninterface Plan {\r\n    id: string;\r\n    name: string;\r\n    slug: string;\r\n    description: string;\r\n    price_monthly: number;\r\n    stripe_price_id: string | null;\r\n    features: string[];\r\n    metadata: {\r\n        type: 'professional' | 'clinic' | 'multi_unit';\r\n        recommended?: boolean;\r\n        extra_seat_price?: number;\r\n    };\r\n}\r\n\r\ninterface PlanSelectionProps {\r\n    edition: 'solo' | 'company' | 'org';\r\n    onSelect: (selection: { planCode: string; price: number; priceId?: string; seats?: number; units?: number; couponCode?: string }) => void;\r\n    onBack: () => void;\r\n}\r\n\r\nexport function PlanSelection({ edition, onSelect, onBack }: PlanSelectionProps) {\r\n    const formatCurrency = (value: number) => {\r\n        return value.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\r\n    };\r\n    const [plans, setPlans] = useState<Plan[]>([]);\r\n    const [loading, setLoading] = useState(true);\r\n\r\n    // State for selections\r\n    const [selectedPlanId, setSelectedPlanId] = useState<string>(\"\");\r\n    const [companySeats, setCompanySeats] = useState(5);\r\n    const [orgUnits, setOrgUnits] = useState(2);\r\n\r\n    // Coupon state\r\n    const [couponCode, setCouponCode] = useState(\"\");\r\n    const [validatingCoupon, setValidatingCoupon] = useState(false);\r\n    const [appliedCoupon, setAppliedCoupon] = useState<{ code: string; type: 'percent' | 'fixed'; value: number } | null>(null);\r\n\r\n    useEffect(() => {\r\n        fetchPlans();\r\n    }, [edition]);\r\n\r\n    const fetchPlans = async () => {\r\n        setLoading(true);\r\n        try {\r\n            let typeFilter = '';\r\n            if (edition === 'solo') typeFilter = 'professional';\r\n            if (edition === 'company') typeFilter = 'clinic';\r\n            if (edition === 'org') typeFilter = 'multi_unit';\r\n\r\n            const { data, error } = await supabase\r\n                .from('plans')\r\n                .select('*')\r\n                .eq('active', true)\r\n                .order('price_monthly');\r\n\r\n            if (error) throw error;\r\n\r\n            if (data) {\r\n                const typedData = data as any[];\r\n                const filteredPlans = typedData.filter(p => p.metadata?.type === typeFilter);\r\n\r\n                setPlans(filteredPlans as Plan[]);\r\n\r\n                if (filteredPlans.length > 0) {\r\n                    if (edition === 'solo') {\r\n                        const recommended = filteredPlans.find(p => p.metadata?.recommended);\r\n                        setSelectedPlanId(recommended ? recommended.id : filteredPlans[0].id);\r\n                    } else {\r\n                        setSelectedPlanId(filteredPlans[0].id);\r\n                    }\r\n                }\r\n            }\r\n        } catch (error) {\r\n            console.error(\"Error fetching plans:\", error);\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const validateCoupon = async () => {\r\n        if (!couponCode.trim()) return;\r\n        setValidatingCoupon(true);\r\n\r\n        try {\r\n            const { data, error } = await supabase\r\n                .from('coupons')\r\n                .select('*')\r\n                .eq('code', couponCode.toUpperCase())\r\n                .eq('active', true)\r\n                .single();\r\n\r\n            if (error || !data) {\r\n                toast.error(\"Cupom inv├ílido ou expirado\");\r\n                setAppliedCoupon(null);\r\n                return;\r\n            }\r\n\r\n            // Check dates\r\n            const now = new Date();\r\n            if (data.start_date && new Date(data.start_date) > now) {\r\n                toast.error(\"Cupom ainda n├úo ├® v├ílido\");\r\n                return;\r\n            }\r\n            if (data.end_date && new Date(data.end_date) < now) {\r\n                toast.error(\"Cupom expirado\");\r\n                return;\r\n            }\r\n\r\n            // Check usage limit\r\n            if (data.usage_limit && data.times_redeemed >= data.usage_limit) {\r\n                toast.error(\"Limite de uso do cupom atingido\");\r\n                return;\r\n            }\r\n\r\n            setAppliedCoupon({\r\n                code: data.code,\r\n                type: data.discount_type as 'percent' | 'fixed',\r\n                value: data.value\r\n            });\r\n            toast.success(\"Cupom aplicado com sucesso!\");\r\n        } catch (error) {\r\n            console.error(\"Error validating coupon:\", error);\r\n            toast.error(\"Erro ao validar cupom\");\r\n        } finally {\r\n            setValidatingCoupon(false);\r\n        }\r\n    };\r\n\r\n    const calculateTotal = () => {\r\n        const plan = plans.find(p => p.id === selectedPlanId);\r\n        if (!plan) return 0;\r\n\r\n        let total = plan.price_monthly;\r\n\r\n        if (edition === 'company') {\r\n            const extraSeats = Math.max(0, companySeats - 5);\r\n            const extraPrice = plan.metadata?.extra_seat_price || 0;\r\n            total = plan.price_monthly + (extraSeats * extraPrice);\r\n        }\r\n\r\n        if (edition === 'org') {\r\n            const discount = orgUnits >= 2 ? 0.9 : 1;\r\n            total = plan.price_monthly * orgUnits * discount;\r\n        }\r\n\r\n        // Apply coupon\r\n        if (appliedCoupon) {\r\n            if (appliedCoupon.type === 'percent') {\r\n                total = total * (1 - appliedCoupon.value / 100);\r\n            } else {\r\n                total = Math.max(0, total - appliedCoupon.value);\r\n            }\r\n        }\r\n\r\n        return total;\r\n    };\r\n\r\n    const handleContinue = () => {\r\n        const plan = plans.find(p => p.id === selectedPlanId);\r\n        if (!plan) return;\r\n\r\n        onSelect({\r\n            planCode: plan.slug,\r\n            price: calculateTotal(),\r\n            priceId: plan.stripe_price_id || undefined,\r\n            seats: edition === 'company' ? companySeats : undefined,\r\n            units: edition === 'org' ? orgUnits : undefined,\r\n            couponCode: appliedCoupon?.code\r\n        });\r\n    };\r\n\r\n    if (loading) {\r\n        return <div className=\"flex justify-center p-12\"><Loader2 className=\"h-8 w-8 animate-spin text-primary\" /></div>;\r\n    }\r\n\r\n    return (\r\n        <div className=\"space-y-6 animate-in fade-in duration-500\">\r\n            <div className=\"flex items-center gap-4 mb-6\">\r\n                <Button variant=\"ghost\" size=\"icon\" onClick={onBack}>\r\n                    <ArrowLeft className=\"h-4 w-4\" />\r\n                </Button>\r\n                <div>\r\n                    <h2 className=\"text-2xl font-bold\">Escolha seu Plano</h2>\r\n                    <p className=\"text-muted-foreground\">Selecione o plano ideal para o seu neg├│cio</p>\r\n                </div>\r\n            </div>\r\n\r\n            <div className={`grid gap-6 ${edition === 'solo' ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1'}`}>\r\n                {plans.map((plan) => {\r\n                    const isSelected = selectedPlanId === plan.id;\r\n                    return (\r\n                        <Card\r\n                            key={plan.id}\r\n                            className={`p-6 cursor-pointer transition-all border-2 ${isSelected ? 'border-primary ring-2 ring-primary/20' : 'border-border hover:border-primary/50'}`}\r\n                            onClick={() => setSelectedPlanId(plan.id)}\r\n                        >\r\n                            <div className=\"flex justify-between items-start mb-4\">\r\n                                <div>\r\n                                    <h3 className=\"text-xl font-bold\">{plan.name}</h3>\r\n                                    <p className=\"text-sm text-muted-foreground mt-1\">{plan.description}</p>\r\n                                    {edition === 'company' && <Badge variant=\"secondary\" className=\"mt-2\">5 Profissionais Inclusos</Badge>}\r\n                                </div>\r\n                                <div className=\"text-right\">\r\n                                    <span className=\"text-2xl font-bold\">\r\n                                        {plan.price_monthly === 0 ? 'Gr├ítis' : `R$ ${formatCurrency(plan.price_monthly)}`}\r\n                                    </span>\r\n                                    {plan.price_monthly > 0 && <p className=\"text-xs text-muted-foreground\">/m├¬s</p>}\r\n                                </div>\r\n                            </div>\r\n\r\n                            <ul className=\"space-y-3 mb-6\">\r\n                                {plan.features && plan.features.map((feature, idx) => (\r\n                                    <li key={idx} className=\"flex items-center text-sm\">\r\n                                        <Check className=\"h-4 w-4 text-primary mr-2 flex-shrink-0\" />\r\n                                        {feature}\r\n                                    </li>\r\n                                ))}\r\n                            </ul>\r\n\r\n                            {edition === 'company' && isSelected && (\r\n                                <div className=\"mt-6 pt-6 border-t space-y-4\">\r\n                                    <div className=\"flex justify-between items-center\">\r\n                                        <Label>N├║mero de Profissionais</Label>\r\n                                        <span className=\"font-bold text-lg\">{companySeats}</span>\r\n                                    </div>\r\n                                    <Slider\r\n                                        value={[companySeats]}\r\n                                        min={1}\r\n                                        max={50}\r\n                                        step={1}\r\n                                        onValueChange={(vals) => setCompanySeats(vals[0])}\r\n                                    />\r\n                                    <div className=\"text-sm text-muted-foreground flex justify-between\">\r\n                                        <span>5 inclusos</span>\r\n                                        {companySeats > 5 && (\r\n                                            <span className=\"text-primary font-medium\">\r\n                                                +{companySeats - 5} extras (+ R$ {formatCurrency((companySeats - 5) * (plan.metadata?.extra_seat_price || 0))}/m├¬s)\r\n                                            </span>\r\n                                        )}\r\n                                    </div>\r\n                                </div>\r\n                            )}\r\n\r\n                            {edition === 'org' && isSelected && (\r\n                                <div className=\"mt-6 pt-6 border-t space-y-4\">\r\n                                    <div className=\"flex justify-between items-center\">\r\n                                        <Label>N├║mero de Unidades</Label>\r\n                                        <div className=\"flex items-center gap-2\">\r\n                                            <Button variant=\"outline\" size=\"sm\" onClick={(e) => { e.stopPropagation(); setOrgUnits(Math.max(2, orgUnits - 1)); }}>-</Button>\r\n                                            <span className=\"font-bold text-lg w-8 text-center\">{orgUnits}</span>\r\n                                            <Button variant=\"outline\" size=\"sm\" onClick={(e) => { e.stopPropagation(); setOrgUnits(orgUnits + 1); }}>+</Button>\r\n                                        </div>\r\n                                    </div>\r\n                                    {orgUnits >= 2 && (\r\n                                        <p className=\"text-sm text-green-600 font-medium flex items-center\">\r\n                                            <Check className=\"h-3 w-3 mr-1\" />\r\n                                            Desconto de 10% aplicado por m├║ltiplas unidades\r\n                                        </p>\r\n                                    )}\r\n                                </div>\r\n                            )}\r\n                        </Card>\r\n                    );\r\n                })}\r\n            </div>\r\n\r\n            <div className=\"flex flex-col gap-4 pt-6 border-t\">\r\n                {/* Coupon Section */}\r\n                <div className=\"flex items-end gap-2 max-w-sm\">\r\n                    <div className=\"flex-1 space-y-2\">\r\n                        <Label htmlFor=\"coupon\">Cupom de Desconto</Label>\r\n                        <div className=\"relative\">\r\n                            <Tag className=\"absolute left-2 top-2.5 h-4 w-4 text-muted-foreground\" />\r\n                            <Input\r\n                                id=\"coupon\"\r\n                                placeholder=\"C├│digo do cupom\"\r\n                                className=\"pl-8\"\r\n                                value={couponCode}\r\n                                onChange={(e) => setCouponCode(e.target.value)}\r\n                                disabled={!!appliedCoupon}\r\n                            />\r\n                        </div>\r\n                    </div>\r\n                    {appliedCoupon ? (\r\n                        <Button variant=\"outline\" onClick={() => { setAppliedCoupon(null); setCouponCode(\"\"); }}>\r\n                            Remover\r\n                        </Button>\r\n                    ) : (\r\n                        <Button variant=\"secondary\" onClick={validateCoupon} disabled={validatingCoupon || !couponCode}>\r\n                            {validatingCoupon ? <Loader2 className=\"h-4 w-4 animate-spin\" /> : \"Aplicar\"}\r\n                        </Button>\r\n                    )}\r\n                </div>\r\n\r\n                {appliedCoupon && (\r\n                    <div className=\"text-sm text-green-600 font-medium flex items-center\">\r\n                        <Check className=\"h-3 w-3 mr-1\" />\r\n                        Cupom {appliedCoupon.code} aplicado:\r\n                        {appliedCoupon.type === 'percent' ? ` ${appliedCoupon.value}% de desconto` : ` R$ ${appliedCoupon.value} de desconto`}\r\n                    </div>\r\n                )}\r\n\r\n                <div className=\"flex items-center justify-between mt-4\">\r\n                    <div className=\"text-lg\">\r\n                        Total estimado: <span className=\"font-bold text-2xl text-primary\">R$ {formatCurrency(calculateTotal())}</span>\r\n                        <span className=\"text-sm text-muted-foreground\">/m├¬s</span>\r\n                    </div>\r\n                    <Button size=\"lg\" onClick={handleContinue} disabled={!selectedPlanId}>\r\n                        Continuar\r\n                    </Button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\organization\\OrgSettingsForm.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadSettings'. Either include it or remove the dependency array.","line":36,"column":8,"nodeType":"ArrayExpression","endLine":36,"endColumn":24,"suggestions":[{"desc":"Update the dependencies array to be: [loadSettings, organizationId]","fix":{"range":[1228,1244],"text":"[loadSettings, organizationId]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\nimport { useForm } from \"react-hook-form\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport { Card, CardContent, CardHeader, CardTitle, CardDescription } from \"@/components/ui/card\";\r\nimport { Switch } from \"@/components/ui/switch\";\r\nimport { toast } from \"sonner\";\r\nimport { Loader2, Save } from \"lucide-react\";\r\n\r\ninterface OrgSettingsFormProps {\r\n    organizationId: string;\r\n}\r\n\r\nexport function OrgSettingsForm({ organizationId }: OrgSettingsFormProps) {\r\n    const [loading, setLoading] = useState(false);\r\n    const [saving, setSaving] = useState(false);\r\n\r\n    const { register, handleSubmit, setValue, watch } = useForm({\r\n        defaultValues: {\r\n            horarios_padrao: {\r\n                start: \"09:00\",\r\n                end: \"18:00\",\r\n                weekend: false\r\n            },\r\n            politica_cancelamento: {\r\n                antecedencia_horas: 24,\r\n                multa_percentual: 0\r\n            }\r\n        }\r\n    });\r\n\r\n    useEffect(() => {\r\n        loadSettings();\r\n    }, [organizationId]);\r\n\r\n    const loadSettings = async () => {\r\n        setLoading(true);\r\n        try {\r\n            const { data, error } = await supabase\r\n                .from('org_settings')\r\n                .select('*')\r\n                .eq('organization_id', organizationId)\r\n                .maybeSingle();\r\n\r\n            if (error) throw error;\r\n\r\n            if (data) {\r\n                if (data.horarios_padrao) setValue('horarios_padrao', data.horarios_padrao as any);\r\n                if (data.politica_cancelamento) setValue('politica_cancelamento', data.politica_cancelamento as any);\r\n            } else {\r\n                // Create default settings if not exists\r\n                const { error: insertError } = await supabase\r\n                    .from('org_settings')\r\n                    .insert({ organization_id: organizationId });\r\n\r\n                if (insertError) throw insertError;\r\n            }\r\n        } catch (error) {\r\n            console.error('Error loading org settings:', error);\r\n            toast.error(\"Erro ao carregar configura├º├Áes.\");\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const onSubmit = async (data: any) => {\r\n        setSaving(true);\r\n        try {\r\n            const { error } = await supabase\r\n                .from('org_settings')\r\n                .update({\r\n                    horarios_padrao: data.horarios_padrao,\r\n                    politica_cancelamento: data.politica_cancelamento,\r\n                    updated_at: new Date().toISOString()\r\n                })\r\n                .eq('organization_id', organizationId);\r\n\r\n            if (error) throw error;\r\n            toast.success(\"Configura├º├Áes salvas com sucesso!\");\r\n        } catch (error) {\r\n            console.error('Error saving org settings:', error);\r\n            toast.error(\"Erro ao salvar configura├º├Áes.\");\r\n        } finally {\r\n            setSaving(false);\r\n        }\r\n    };\r\n\r\n    if (loading) {\r\n        return <div className=\"flex justify-center p-8\"><Loader2 className=\"h-8 w-8 animate-spin text-muted-foreground\" /></div>;\r\n    }\r\n\r\n    return (\r\n        <form onSubmit={handleSubmit(onSubmit)} className=\"space-y-6\">\r\n            <Card>\r\n                <CardHeader>\r\n                    <CardTitle>Hor├írios de Funcionamento Padr├úo</CardTitle>\r\n                    <CardDescription>Estes hor├írios ser├úo aplicados a todas as novas unidades por padr├úo.</CardDescription>\r\n                </CardHeader>\r\n                <CardContent className=\"space-y-4\">\r\n                    <div className=\"grid grid-cols-2 gap-4\">\r\n                        <div className=\"space-y-2\">\r\n                            <Label>Abertura</Label>\r\n                            <Input type=\"time\" {...register(\"horarios_padrao.start\")} />\r\n                        </div>\r\n                        <div className=\"space-y-2\">\r\n                            <Label>Fechamento</Label>\r\n                            <Input type=\"time\" {...register(\"horarios_padrao.end\")} />\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"flex items-center space-x-2\">\r\n                        <Switch\r\n                            id=\"weekend\"\r\n                            checked={watch(\"horarios_padrao.weekend\")}\r\n                            onCheckedChange={(checked) => setValue(\"horarios_padrao.weekend\", checked)}\r\n                        />\r\n                        <Label htmlFor=\"weekend\">Funciona aos finais de semana?</Label>\r\n                    </div>\r\n                </CardContent>\r\n            </Card>\r\n\r\n            <Card>\r\n                <CardHeader>\r\n                    <CardTitle>Pol├¡tica de Cancelamento</CardTitle>\r\n                    <CardDescription>Regras para cancelamento de agendamentos.</CardDescription>\r\n                </CardHeader>\r\n                <CardContent className=\"space-y-4\">\r\n                    <div className=\"grid grid-cols-2 gap-4\">\r\n                        <div className=\"space-y-2\">\r\n                            <Label>Anteced├¬ncia M├¡nima (horas)</Label>\r\n                            <Input type=\"number\" {...register(\"politica_cancelamento.antecedencia_horas\")} />\r\n                        </div>\r\n                        <div className=\"space-y-2\">\r\n                            <Label>Multa por Cancelamento Tardio (%)</Label>\r\n                            <Input type=\"number\" {...register(\"politica_cancelamento.multa_percentual\")} />\r\n                        </div>\r\n                    </div>\r\n                </CardContent>\r\n            </Card>\r\n\r\n            <div className=\"flex justify-end\">\r\n                <Button type=\"submit\" disabled={saving}>\r\n                    {saving && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\r\n                    <Save className=\"mr-2 h-4 w-4\" />\r\n                    Salvar Configura├º├Áes Globais\r\n                </Button>\r\n            </div>\r\n        </form>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\organization\\OrganizationDashboard.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchMetrics'. Either include it or remove the dependency array.","line":45,"column":6,"nodeType":"ArrayExpression","endLine":45,"endColumn":40,"suggestions":[{"desc":"Update the dependencies array to be: [fetchMetrics, organization?.id, selectedPeriod]","fix":{"range":[1423,1457],"text":"[fetchMetrics, organization?.id, selectedPeriod]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';\nimport { \n  Building2, \n  Users, \n  Calendar, \n  DollarSign, \n  TrendingUp, \n  TrendingDown,\n  BarChart3,\n  PieChart,\n  Activity,\n  ArrowUpRight,\n  ArrowDownRight\n} from 'lucide-react';\nimport { useOrganizationContext } from '@/hooks/useOrganizationContext';\nimport { supabase } from '@/integrations/supabase/client';\n\ninterface UnitMetrics {\n  unit_id: string;\n  unit_name: string;\n  is_matriz: boolean;\n  appointments_count: number;\n  patients_count: number;\n  revenue: number;\n  occupancy_rate: number;\n  no_show_rate: number;\n}\n\nexport function OrganizationDashboard() {\n  const { organization, units, isOrgAdmin } = useOrganizationContext();\n  const [viewMode, setViewMode] = useState<'consolidated' | 'per_unit'>('consolidated');\n  const [selectedPeriod, setSelectedPeriod] = useState('month');\n  const [metrics, setMetrics] = useState<UnitMetrics[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    if (organization?.id) {\n      fetchMetrics();\n    }\n  }, [organization?.id, selectedPeriod]);\n\n  const fetchMetrics = async () => {\n    setLoading(true);\n    try {\n      // Buscar m├®tricas por unidade\n      const unitMetrics: UnitMetrics[] = [];\n      \n      for (const unit of units) {\n        // Contagem de agendamentos\n        const { count: appointmentsCount } = await supabase\n          .from('agenda')\n          .select('*', { count: 'exact', head: true })\n          .eq('unit_id', unit.id);\n\n        // Contagem de pacientes\n        const { count: patientsCount } = await supabase\n          .from('pacientes')\n          .select('*', { count: 'exact', head: true })\n          .eq('organization_id', organization?.id);\n\n        // Receita (soma do caixa di├írio)\n        const { data: revenueData } = await supabase\n          .from('caixa_diario')\n          .select('valor')\n          .eq('unit_id', unit.id)\n          .eq('tipo_lancamento', 'entrada');\n\n        const revenue = revenueData?.reduce((sum, r) => sum + (r.valor || 0), 0) || 0;\n\n        unitMetrics.push({\n          unit_id: unit.id,\n          unit_name: unit.nome_unidade,\n          is_matriz: unit.is_matriz,\n          appointments_count: appointmentsCount || 0,\n          patients_count: patientsCount || 0,\n          revenue,\n          occupancy_rate: Math.random() * 40 + 60, // Mock\n          no_show_rate: Math.random() * 15 + 5, // Mock\n        });\n      }\n\n      setMetrics(unitMetrics);\n    } catch (error) {\n      console.error('Error fetching metrics:', error);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const totalRevenue = metrics.reduce((sum, m) => sum + m.revenue, 0);\n  const totalAppointments = metrics.reduce((sum, m) => sum + m.appointments_count, 0);\n  const totalPatients = metrics.reduce((sum, m) => sum + m.patients_count, 0);\n  const avgOccupancy = metrics.length > 0 \n    ? metrics.reduce((sum, m) => sum + m.occupancy_rate, 0) / metrics.length \n    : 0;\n\n  if (!isOrgAdmin) {\n    return null;\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h2 className=\"text-2xl font-bold\">{organization?.nome_fantasia}</h2>\n          <p className=\"text-muted-foreground\">Dashboard da Organiza├º├úo</p>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <Select value={selectedPeriod} onValueChange={setSelectedPeriod}>\n            <SelectTrigger className=\"w-[180px]\">\n              <SelectValue placeholder=\"Per├¡odo\" />\n            </SelectTrigger>\n            <SelectContent>\n              <SelectItem value=\"today\">Hoje</SelectItem>\n              <SelectItem value=\"week\">Esta Semana</SelectItem>\n              <SelectItem value=\"month\">Este M├¬s</SelectItem>\n              <SelectItem value=\"quarter\">Este Trimestre</SelectItem>\n              <SelectItem value=\"year\">Este Ano</SelectItem>\n            </SelectContent>\n          </Select>\n          <Tabs value={viewMode} onValueChange={(v) => setViewMode(v as any)}>\n            <TabsList>\n              <TabsTrigger value=\"consolidated\">Consolidado</TabsTrigger>\n              <TabsTrigger value=\"per_unit\">Por Unidade</TabsTrigger>\n            </TabsList>\n          </Tabs>\n        </div>\n      </div>\n\n      {viewMode === 'consolidated' ? (\n        <>\n          {/* Cards de resumo consolidado */}\n          <div className=\"grid gap-4 md:grid-cols-2 lg:grid-cols-4\">\n            <Card>\n              <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n                <CardTitle className=\"text-sm font-medium\">Receita Total</CardTitle>\n                <DollarSign className=\"h-4 w-4 text-muted-foreground\" />\n              </CardHeader>\n              <CardContent>\n                <div className=\"text-2xl font-bold\">\n                  {totalRevenue.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}\n                </div>\n                <p className=\"text-xs text-muted-foreground flex items-center gap-1\">\n                  <ArrowUpRight className=\"h-3 w-3 text-green-500\" />\n                  +12.5% vs per├¡odo anterior\n                </p>\n              </CardContent>\n            </Card>\n            <Card>\n              <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n                <CardTitle className=\"text-sm font-medium\">Agendamentos</CardTitle>\n                <Calendar className=\"h-4 w-4 text-muted-foreground\" />\n              </CardHeader>\n              <CardContent>\n                <div className=\"text-2xl font-bold\">{totalAppointments}</div>\n                <p className=\"text-xs text-muted-foreground\">\n                  Em {units.length} unidades\n                </p>\n              </CardContent>\n            </Card>\n            <Card>\n              <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n                <CardTitle className=\"text-sm font-medium\">Pacientes Ativos</CardTitle>\n                <Users className=\"h-4 w-4 text-muted-foreground\" />\n              </CardHeader>\n              <CardContent>\n                <div className=\"text-2xl font-bold\">{totalPatients}</div>\n                <p className=\"text-xs text-muted-foreground flex items-center gap-1\">\n                  <ArrowUpRight className=\"h-3 w-3 text-green-500\" />\n                  +5.2% novos pacientes\n                </p>\n              </CardContent>\n            </Card>\n            <Card>\n              <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n                <CardTitle className=\"text-sm font-medium\">Ocupa├º├úo M├®dia</CardTitle>\n                <Activity className=\"h-4 w-4 text-muted-foreground\" />\n              </CardHeader>\n              <CardContent>\n                <div className=\"text-2xl font-bold\">{avgOccupancy.toFixed(1)}%</div>\n                <p className=\"text-xs text-muted-foreground\">\n                  Taxa de ocupa├º├úo das agendas\n                </p>\n              </CardContent>\n            </Card>\n          </div>\n\n          {/* Ranking de unidades */}\n          <Card>\n            <CardHeader>\n              <CardTitle>Ranking de Unidades</CardTitle>\n              <CardDescription>Desempenho comparativo entre unidades</CardDescription>\n            </CardHeader>\n            <CardContent>\n              <div className=\"space-y-4\">\n                {metrics\n                  .sort((a, b) => b.revenue - a.revenue)\n                  .map((unit, index) => (\n                    <div key={unit.unit_id} className=\"flex items-center gap-4\">\n                      <div className=\"flex items-center justify-center w-8 h-8 rounded-full bg-primary/10 text-primary font-bold\">\n                        {index + 1}\n                      </div>\n                      <div className=\"flex-1\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"font-medium\">{unit.unit_name}</span>\n                          {unit.is_matriz && <Badge variant=\"secondary\">Matriz</Badge>}\n                        </div>\n                        <div className=\"flex gap-4 text-sm text-muted-foreground\">\n                          <span>{unit.appointments_count} agendamentos</span>\n                          <span>{unit.occupancy_rate.toFixed(0)}% ocupa├º├úo</span>\n                        </div>\n                      </div>\n                      <div className=\"text-right\">\n                        <p className=\"font-semibold\">\n                          {unit.revenue.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}\n                        </p>\n                        <p className=\"text-sm text-muted-foreground\">\n                          {((unit.revenue / totalRevenue) * 100).toFixed(1)}% do total\n                        </p>\n                      </div>\n                    </div>\n                  ))}\n              </div>\n            </CardContent>\n          </Card>\n        </>\n      ) : (\n        /* Vis├úo por unidade */\n        <div className=\"grid gap-4 md:grid-cols-2 lg:grid-cols-3\">\n          {metrics.map(unit => (\n            <Card key={unit.unit_id}>\n              <CardHeader>\n                <div className=\"flex items-center justify-between\">\n                  <CardTitle className=\"flex items-center gap-2\">\n                    <Building2 className=\"h-5 w-5\" />\n                    {unit.unit_name}\n                  </CardTitle>\n                  {unit.is_matriz && <Badge>Matriz</Badge>}\n                </div>\n              </CardHeader>\n              <CardContent className=\"space-y-4\">\n                <div className=\"grid grid-cols-2 gap-4\">\n                  <div>\n                    <p className=\"text-sm text-muted-foreground\">Receita</p>\n                    <p className=\"text-xl font-bold\">\n                      {unit.revenue.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}\n                    </p>\n                  </div>\n                  <div>\n                    <p className=\"text-sm text-muted-foreground\">Agendamentos</p>\n                    <p className=\"text-xl font-bold\">{unit.appointments_count}</p>\n                  </div>\n                  <div>\n                    <p className=\"text-sm text-muted-foreground\">Ocupa├º├úo</p>\n                    <p className=\"text-xl font-bold flex items-center gap-1\">\n                      {unit.occupancy_rate.toFixed(0)}%\n                      {unit.occupancy_rate > 70 ? (\n                        <TrendingUp className=\"h-4 w-4 text-green-500\" />\n                      ) : (\n                        <TrendingDown className=\"h-4 w-4 text-red-500\" />\n                      )}\n                    </p>\n                  </div>\n                  <div>\n                    <p className=\"text-sm text-muted-foreground\">No-Show</p>\n                    <p className=\"text-xl font-bold text-destructive\">\n                      {unit.no_show_rate.toFixed(1)}%\n                    </p>\n                  </div>\n                </div>\n                <Button variant=\"outline\" className=\"w-full\">\n                  Ver Detalhes\n                </Button>\n              </CardContent>\n            </Card>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\organization\\UnitPolicyManager.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchPolicies'. Either include it or remove the dependency array.","line":83,"column":6,"nodeType":"ArrayExpression","endLine":83,"endColumn":24,"suggestions":[{"desc":"Update the dependencies array to be: [fetchPolicies, organization?.id]","fix":{"range":[2637,2655],"text":"[fetchPolicies, organization?.id]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Button } from '@/components/ui/button';\nimport { Switch } from '@/components/ui/switch';\nimport { Label } from '@/components/ui/label';\nimport { Badge } from '@/components/ui/badge';\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';\nimport { Textarea } from '@/components/ui/textarea';\nimport { \n  Shield, \n  Settings, \n  Users, \n  CreditCard, \n  MessageSquare,\n  Eye,\n  Edit,\n  Trash2,\n  Plus,\n  Building2,\n  Save,\n  AlertTriangle\n} from 'lucide-react';\nimport { toast } from 'sonner';\nimport { supabase } from '@/integrations/supabase/client';\nimport { useOrganizationContext } from '@/hooks/useOrganizationContext';\n\ninterface UnitPolicy {\n  id: string;\n  unit_id: string;\n  autonomy_level: 'full' | 'limited' | 'readonly';\n  can_edit_settings: boolean;\n  can_edit_services: boolean;\n  can_edit_prices: boolean;\n  can_edit_schedules: boolean;\n  can_edit_messaging: boolean;\n  can_edit_payment_methods: boolean;\n  can_create_patients: boolean;\n  can_edit_patients: boolean;\n  can_delete_patients: boolean;\n  can_create_appointments: boolean;\n  can_edit_appointments: boolean;\n  can_delete_appointments: boolean;\n  can_create_professionals: boolean;\n  can_edit_professionals: boolean;\n  can_delete_professionals: boolean;\n  can_view_financials: boolean;\n  can_create_transactions: boolean;\n  can_edit_transactions: boolean;\n  can_close_cash_register: boolean;\n  can_view_reports: boolean;\n  can_export_data: boolean;\n  can_send_messages: boolean;\n  can_edit_templates: boolean;\n  can_view_all_conversations: boolean;\n  inherit_services: boolean;\n  inherit_prices: boolean;\n  inherit_schedules: boolean;\n  inherit_messaging: boolean;\n  inherit_payment_methods: boolean;\n  notes: string | null;\n}\n\ninterface UnitWithPolicy {\n  id: string;\n  nome_unidade: string;\n  is_matriz: boolean;\n  policy?: UnitPolicy;\n}\n\nexport function UnitPolicyManager() {\n  const { organization, units, isOrgAdmin } = useOrganizationContext();\n  const [unitsWithPolicies, setUnitsWithPolicies] = useState<UnitWithPolicy[]>([]);\n  const [selectedUnit, setSelectedUnit] = useState<string | null>(null);\n  const [currentPolicy, setCurrentPolicy] = useState<Partial<UnitPolicy> | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [saving, setSaving] = useState(false);\n\n  useEffect(() => {\n    if (organization?.id) {\n      fetchPolicies();\n    }\n  }, [organization?.id]);\n\n  const fetchPolicies = async () => {\n    if (!organization?.id) return;\n    \n    try {\n      const { data: policies, error } = await supabase\n        .from('unit_policies')\n        .select('*')\n        .eq('organization_id', organization.id);\n\n      if (error) throw error;\n\n      const unitsData: UnitWithPolicy[] = units.map(unit => ({\n        id: unit.id,\n        nome_unidade: unit.nome_unidade,\n        is_matriz: unit.is_matriz,\n        policy: policies?.find(p => p.unit_id === unit.id) as UnitPolicy | undefined\n      }));\n\n      setUnitsWithPolicies(unitsData);\n      \n      if (unitsData.length > 0 && !selectedUnit) {\n        setSelectedUnit(unitsData[0].id);\n        setCurrentPolicy(unitsData[0].policy || getDefaultPolicy());\n      }\n    } catch (error) {\n      console.error('Error fetching policies:', error);\n      toast.error('Erro ao carregar pol├¡ticas');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const getDefaultPolicy = (): Partial<UnitPolicy> => ({\n    autonomy_level: 'limited',\n    can_edit_settings: false,\n    can_edit_services: false,\n    can_edit_prices: false,\n    can_edit_schedules: false,\n    can_edit_messaging: false,\n    can_edit_payment_methods: false,\n    can_create_patients: true,\n    can_edit_patients: true,\n    can_delete_patients: false,\n    can_create_appointments: true,\n    can_edit_appointments: true,\n    can_delete_appointments: false,\n    can_create_professionals: false,\n    can_edit_professionals: false,\n    can_delete_professionals: false,\n    can_view_financials: true,\n    can_create_transactions: true,\n    can_edit_transactions: false,\n    can_close_cash_register: true,\n    can_view_reports: true,\n    can_export_data: false,\n    can_send_messages: true,\n    can_edit_templates: false,\n    can_view_all_conversations: true,\n    inherit_services: true,\n    inherit_prices: true,\n    inherit_schedules: true,\n    inherit_messaging: true,\n    inherit_payment_methods: true,\n    notes: null\n  });\n\n  const handleSelectUnit = (unitId: string) => {\n    setSelectedUnit(unitId);\n    const unit = unitsWithPolicies.find(u => u.id === unitId);\n    setCurrentPolicy(unit?.policy || getDefaultPolicy());\n  };\n\n  const handleAutonomyChange = (level: 'full' | 'limited' | 'readonly') => {\n    if (!currentPolicy) return;\n\n    let updatedPolicy = { ...currentPolicy, autonomy_level: level };\n\n    if (level === 'full') {\n      // Habilita tudo\n      updatedPolicy = {\n        ...updatedPolicy,\n        can_edit_settings: true,\n        can_edit_services: true,\n        can_edit_prices: true,\n        can_edit_schedules: true,\n        can_edit_messaging: true,\n        can_edit_payment_methods: true,\n        can_create_patients: true,\n        can_edit_patients: true,\n        can_delete_patients: true,\n        can_create_appointments: true,\n        can_edit_appointments: true,\n        can_delete_appointments: true,\n        can_create_professionals: true,\n        can_edit_professionals: true,\n        can_delete_professionals: true,\n        can_view_financials: true,\n        can_create_transactions: true,\n        can_edit_transactions: true,\n        can_close_cash_register: true,\n        can_view_reports: true,\n        can_export_data: true,\n        can_send_messages: true,\n        can_edit_templates: true,\n        can_view_all_conversations: true,\n      };\n    } else if (level === 'readonly') {\n      // Desabilita tudo exceto visualiza├º├úo\n      updatedPolicy = {\n        ...updatedPolicy,\n        can_edit_settings: false,\n        can_edit_services: false,\n        can_edit_prices: false,\n        can_edit_schedules: false,\n        can_edit_messaging: false,\n        can_edit_payment_methods: false,\n        can_create_patients: false,\n        can_edit_patients: false,\n        can_delete_patients: false,\n        can_create_appointments: false,\n        can_edit_appointments: false,\n        can_delete_appointments: false,\n        can_create_professionals: false,\n        can_edit_professionals: false,\n        can_delete_professionals: false,\n        can_view_financials: true,\n        can_create_transactions: false,\n        can_edit_transactions: false,\n        can_close_cash_register: false,\n        can_view_reports: true,\n        can_export_data: false,\n        can_send_messages: false,\n        can_edit_templates: false,\n        can_view_all_conversations: true,\n      };\n    }\n\n    setCurrentPolicy(updatedPolicy);\n  };\n\n  const handleSave = async () => {\n    if (!selectedUnit || !currentPolicy || !organization?.id) return;\n\n    setSaving(true);\n    try {\n      const policyData = {\n        organization_id: organization.id,\n        unit_id: selectedUnit,\n        ...currentPolicy\n      };\n\n      const { error } = await supabase\n        .from('unit_policies')\n        .upsert(policyData, { onConflict: 'organization_id,unit_id' });\n\n      if (error) throw error;\n\n      toast.success('Pol├¡ticas salvas com sucesso');\n      fetchPolicies();\n    } catch (error) {\n      console.error('Error saving policy:', error);\n      toast.error('Erro ao salvar pol├¡ticas');\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const selectedUnitData = unitsWithPolicies.find(u => u.id === selectedUnit);\n\n  if (!isOrgAdmin) {\n    return (\n      <Card className=\"p-6\">\n        <div className=\"flex items-center gap-3 text-muted-foreground\">\n          <AlertTriangle className=\"h-5 w-5\" />\n          <span>Voc├¬ n├úo tem permiss├úo para gerenciar pol├¡ticas de unidades.</span>\n        </div>\n      </Card>\n    );\n  }\n\n  if (loading) {\n    return <div className=\"p-4\">Carregando...</div>;\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h2 className=\"text-2xl font-bold\">Pol├¡ticas de Unidades</h2>\n          <p className=\"text-muted-foreground\">\n            Defina o n├¡vel de autonomia e permiss├Áes de cada unidade\n          </p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-4 gap-6\">\n        {/* Lista de unidades */}\n        <Card className=\"lg:col-span-1\">\n          <CardHeader>\n            <CardTitle className=\"text-lg\">Unidades</CardTitle>\n          </CardHeader>\n          <CardContent className=\"p-0\">\n            <div className=\"space-y-1\">\n              {unitsWithPolicies.map(unit => (\n                <button\n                  key={unit.id}\n                  onClick={() => handleSelectUnit(unit.id)}\n                  className={`w-full p-3 text-left flex items-center gap-3 hover:bg-muted/50 transition-colors ${\n                    selectedUnit === unit.id ? 'bg-primary/10 border-l-2 border-primary' : ''\n                  }`}\n                >\n                  <Building2 className=\"h-4 w-4 text-muted-foreground\" />\n                  <div className=\"flex-1 min-w-0\">\n                    <p className=\"font-medium truncate\">{unit.nome_unidade}</p>\n                    {unit.is_matriz && (\n                      <Badge variant=\"secondary\" className=\"text-xs\">Matriz</Badge>\n                    )}\n                  </div>\n                </button>\n              ))}\n            </div>\n          </CardContent>\n        </Card>\n\n        {/* Editor de pol├¡ticas */}\n        <Card className=\"lg:col-span-3\">\n          {selectedUnitData && currentPolicy ? (\n            <>\n              <CardHeader>\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <CardTitle>{selectedUnitData.nome_unidade}</CardTitle>\n                    <CardDescription>\n                      Configure as permiss├Áes e autonomia desta unidade\n                    </CardDescription>\n                  </div>\n                  <Button onClick={handleSave} disabled={saving}>\n                    <Save className=\"h-4 w-4 mr-2\" />\n                    {saving ? 'Salvando...' : 'Salvar'}\n                  </Button>\n                </div>\n              </CardHeader>\n              <CardContent>\n                <Tabs defaultValue=\"autonomy\">\n                  <TabsList className=\"mb-4\">\n                    <TabsTrigger value=\"autonomy\">Autonomia</TabsTrigger>\n                    <TabsTrigger value=\"config\">Configura├º├Áes</TabsTrigger>\n                    <TabsTrigger value=\"data\">Dados</TabsTrigger>\n                    <TabsTrigger value=\"financial\">Financeiro</TabsTrigger>\n                    <TabsTrigger value=\"messaging\">Mensageria</TabsTrigger>\n                    <TabsTrigger value=\"inheritance\">Heran├ºa</TabsTrigger>\n                  </TabsList>\n\n                  <TabsContent value=\"autonomy\" className=\"space-y-4\">\n                    <div>\n                      <Label>N├¡vel de Autonomia</Label>\n                      <Select\n                        value={currentPolicy.autonomy_level}\n                        onValueChange={(v) => handleAutonomyChange(v as any)}\n                      >\n                        <SelectTrigger className=\"mt-2\">\n                          <SelectValue />\n                        </SelectTrigger>\n                        <SelectContent>\n                          <SelectItem value=\"full\">\n                            <div className=\"flex items-center gap-2\">\n                              <Shield className=\"h-4 w-4 text-green-500\" />\n                              Autonomia Total\n                            </div>\n                          </SelectItem>\n                          <SelectItem value=\"limited\">\n                            <div className=\"flex items-center gap-2\">\n                              <Shield className=\"h-4 w-4 text-yellow-500\" />\n                              Autonomia Limitada\n                            </div>\n                          </SelectItem>\n                          <SelectItem value=\"readonly\">\n                            <div className=\"flex items-center gap-2\">\n                              <Eye className=\"h-4 w-4 text-red-500\" />\n                              Somente Leitura\n                            </div>\n                          </SelectItem>\n                        </SelectContent>\n                      </Select>\n                      <p className=\"text-sm text-muted-foreground mt-2\">\n                        {currentPolicy.autonomy_level === 'full' && 'A unidade pode fazer qualquer altera├º├úo.'}\n                        {currentPolicy.autonomy_level === 'limited' && 'A unidade pode operar mas com restri├º├Áes de configura├º├úo.'}\n                        {currentPolicy.autonomy_level === 'readonly' && 'A unidade s├│ pode visualizar dados, sem altera├º├Áes.'}\n                      </p>\n                    </div>\n\n                    <div>\n                      <Label>Notas do Gestor</Label>\n                      <Textarea\n                        className=\"mt-2\"\n                        placeholder=\"Observa├º├Áes sobre esta unidade...\"\n                        value={currentPolicy.notes || ''}\n                        onChange={e => setCurrentPolicy({ ...currentPolicy, notes: e.target.value })}\n                      />\n                    </div>\n                  </TabsContent>\n\n                  <TabsContent value=\"config\" className=\"space-y-4\">\n                    <div className=\"grid gap-4\">\n                      <PermissionSwitch\n                        label=\"Editar Configura├º├Áes\"\n                        description=\"Alterar configura├º├Áes gerais da unidade\"\n                        checked={currentPolicy.can_edit_settings || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_edit_settings: v })}\n                        icon={<Settings className=\"h-4 w-4\" />}\n                      />\n                      <PermissionSwitch\n                        label=\"Editar Servi├ºos\"\n                        description=\"Criar e editar cat├ílogo de servi├ºos\"\n                        checked={currentPolicy.can_edit_services || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_edit_services: v })}\n                        icon={<Edit className=\"h-4 w-4\" />}\n                      />\n                      <PermissionSwitch\n                        label=\"Editar Pre├ºos\"\n                        description=\"Alterar valores de servi├ºos\"\n                        checked={currentPolicy.can_edit_prices || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_edit_prices: v })}\n                        icon={<CreditCard className=\"h-4 w-4\" />}\n                      />\n                      <PermissionSwitch\n                        label=\"Editar Hor├írios\"\n                        description=\"Configurar hor├írios de funcionamento\"\n                        checked={currentPolicy.can_edit_schedules || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_edit_schedules: v })}\n                        icon={<Settings className=\"h-4 w-4\" />}\n                      />\n                      <PermissionSwitch\n                        label=\"Editar Formas de Pagamento\"\n                        description=\"Configurar meios de pagamento aceitos\"\n                        checked={currentPolicy.can_edit_payment_methods || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_edit_payment_methods: v })}\n                        icon={<CreditCard className=\"h-4 w-4\" />}\n                      />\n                    </div>\n                  </TabsContent>\n\n                  <TabsContent value=\"data\" className=\"space-y-4\">\n                    <div className=\"grid gap-4\">\n                      <h4 className=\"font-medium flex items-center gap-2\">\n                        <Users className=\"h-4 w-4\" /> Pacientes/Clientes\n                      </h4>\n                      <div className=\"grid grid-cols-3 gap-4 pl-6\">\n                        <PermissionSwitch\n                          label=\"Criar\"\n                          checked={currentPolicy.can_create_patients || false}\n                          onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_create_patients: v })}\n                          icon={<Plus className=\"h-4 w-4\" />}\n                        />\n                        <PermissionSwitch\n                          label=\"Editar\"\n                          checked={currentPolicy.can_edit_patients || false}\n                          onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_edit_patients: v })}\n                          icon={<Edit className=\"h-4 w-4\" />}\n                        />\n                        <PermissionSwitch\n                          label=\"Excluir\"\n                          checked={currentPolicy.can_delete_patients || false}\n                          onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_delete_patients: v })}\n                          icon={<Trash2 className=\"h-4 w-4\" />}\n                        />\n                      </div>\n\n                      <h4 className=\"font-medium flex items-center gap-2 mt-4\">\n                        Agendamentos\n                      </h4>\n                      <div className=\"grid grid-cols-3 gap-4 pl-6\">\n                        <PermissionSwitch\n                          label=\"Criar\"\n                          checked={currentPolicy.can_create_appointments || false}\n                          onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_create_appointments: v })}\n                          icon={<Plus className=\"h-4 w-4\" />}\n                        />\n                        <PermissionSwitch\n                          label=\"Editar\"\n                          checked={currentPolicy.can_edit_appointments || false}\n                          onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_edit_appointments: v })}\n                          icon={<Edit className=\"h-4 w-4\" />}\n                        />\n                        <PermissionSwitch\n                          label=\"Excluir\"\n                          checked={currentPolicy.can_delete_appointments || false}\n                          onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_delete_appointments: v })}\n                          icon={<Trash2 className=\"h-4 w-4\" />}\n                        />\n                      </div>\n\n                      <h4 className=\"font-medium flex items-center gap-2 mt-4\">\n                        Profissionais\n                      </h4>\n                      <div className=\"grid grid-cols-3 gap-4 pl-6\">\n                        <PermissionSwitch\n                          label=\"Criar\"\n                          checked={currentPolicy.can_create_professionals || false}\n                          onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_create_professionals: v })}\n                          icon={<Plus className=\"h-4 w-4\" />}\n                        />\n                        <PermissionSwitch\n                          label=\"Editar\"\n                          checked={currentPolicy.can_edit_professionals || false}\n                          onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_edit_professionals: v })}\n                          icon={<Edit className=\"h-4 w-4\" />}\n                        />\n                        <PermissionSwitch\n                          label=\"Excluir\"\n                          checked={currentPolicy.can_delete_professionals || false}\n                          onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_delete_professionals: v })}\n                          icon={<Trash2 className=\"h-4 w-4\" />}\n                        />\n                      </div>\n                    </div>\n                  </TabsContent>\n\n                  <TabsContent value=\"financial\" className=\"space-y-4\">\n                    <div className=\"grid gap-4\">\n                      <PermissionSwitch\n                        label=\"Visualizar Financeiro\"\n                        description=\"Ver dados financeiros da unidade\"\n                        checked={currentPolicy.can_view_financials || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_view_financials: v })}\n                        icon={<Eye className=\"h-4 w-4\" />}\n                      />\n                      <PermissionSwitch\n                        label=\"Criar Lan├ºamentos\"\n                        description=\"Registrar entradas e sa├¡das\"\n                        checked={currentPolicy.can_create_transactions || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_create_transactions: v })}\n                        icon={<Plus className=\"h-4 w-4\" />}\n                      />\n                      <PermissionSwitch\n                        label=\"Editar Lan├ºamentos\"\n                        description=\"Alterar lan├ºamentos existentes\"\n                        checked={currentPolicy.can_edit_transactions || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_edit_transactions: v })}\n                        icon={<Edit className=\"h-4 w-4\" />}\n                      />\n                      <PermissionSwitch\n                        label=\"Fechar Caixa\"\n                        description=\"Realizar fechamento de caixa di├írio\"\n                        checked={currentPolicy.can_close_cash_register || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_close_cash_register: v })}\n                        icon={<CreditCard className=\"h-4 w-4\" />}\n                      />\n                      <PermissionSwitch\n                        label=\"Ver Relat├│rios\"\n                        description=\"Acessar relat├│rios financeiros\"\n                        checked={currentPolicy.can_view_reports || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_view_reports: v })}\n                        icon={<Eye className=\"h-4 w-4\" />}\n                      />\n                      <PermissionSwitch\n                        label=\"Exportar Dados\"\n                        description=\"Exportar dados para planilhas\"\n                        checked={currentPolicy.can_export_data || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_export_data: v })}\n                        icon={<Edit className=\"h-4 w-4\" />}\n                      />\n                    </div>\n                  </TabsContent>\n\n                  <TabsContent value=\"messaging\" className=\"space-y-4\">\n                    <div className=\"grid gap-4\">\n                      <PermissionSwitch\n                        label=\"Enviar Mensagens\"\n                        description=\"Enviar mensagens para clientes\"\n                        checked={currentPolicy.can_send_messages || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_send_messages: v })}\n                        icon={<MessageSquare className=\"h-4 w-4\" />}\n                      />\n                      <PermissionSwitch\n                        label=\"Editar Templates\"\n                        description=\"Criar e editar modelos de mensagem\"\n                        checked={currentPolicy.can_edit_templates || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_edit_templates: v })}\n                        icon={<Edit className=\"h-4 w-4\" />}\n                      />\n                      <PermissionSwitch\n                        label=\"Ver Todas as Conversas\"\n                        description=\"Visualizar conversas de todos os atendentes\"\n                        checked={currentPolicy.can_view_all_conversations || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_view_all_conversations: v })}\n                        icon={<Eye className=\"h-4 w-4\" />}\n                      />\n                      <PermissionSwitch\n                        label=\"Editar Mensageria\"\n                        description=\"Configurar canais de comunica├º├úo\"\n                        checked={currentPolicy.can_edit_messaging || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, can_edit_messaging: v })}\n                        icon={<Settings className=\"h-4 w-4\" />}\n                      />\n                    </div>\n                  </TabsContent>\n\n                  <TabsContent value=\"inheritance\" className=\"space-y-4\">\n                    <p className=\"text-sm text-muted-foreground mb-4\">\n                      Defina quais configura├º├Áes a unidade herdar├í da organiza├º├úo. \n                      Quando habilitado, a unidade usar├í as configura├º├Áes da matriz.\n                    </p>\n                    <div className=\"grid gap-4\">\n                      <PermissionSwitch\n                        label=\"Herdar Servi├ºos\"\n                        description=\"Usar cat├ílogo de servi├ºos da organiza├º├úo\"\n                        checked={currentPolicy.inherit_services || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, inherit_services: v })}\n                      />\n                      <PermissionSwitch\n                        label=\"Herdar Pre├ºos\"\n                        description=\"Usar tabela de pre├ºos da organiza├º├úo\"\n                        checked={currentPolicy.inherit_prices || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, inherit_prices: v })}\n                      />\n                      <PermissionSwitch\n                        label=\"Herdar Hor├írios\"\n                        description=\"Usar hor├írios de funcionamento da organiza├º├úo\"\n                        checked={currentPolicy.inherit_schedules || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, inherit_schedules: v })}\n                      />\n                      <PermissionSwitch\n                        label=\"Herdar Mensageria\"\n                        description=\"Usar configura├º├Áes de mensageria da organiza├º├úo\"\n                        checked={currentPolicy.inherit_messaging || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, inherit_messaging: v })}\n                      />\n                      <PermissionSwitch\n                        label=\"Herdar Formas de Pagamento\"\n                        description=\"Usar formas de pagamento da organiza├º├úo\"\n                        checked={currentPolicy.inherit_payment_methods || false}\n                        onCheckedChange={v => setCurrentPolicy({ ...currentPolicy, inherit_payment_methods: v })}\n                      />\n                    </div>\n                  </TabsContent>\n                </Tabs>\n              </CardContent>\n            </>\n          ) : (\n            <CardContent className=\"p-8 text-center text-muted-foreground\">\n              Selecione uma unidade para configurar suas pol├¡ticas\n            </CardContent>\n          )}\n        </Card>\n      </div>\n    </div>\n  );\n}\n\ninterface PermissionSwitchProps {\n  label: string;\n  description?: string;\n  checked: boolean;\n  onCheckedChange: (checked: boolean) => void;\n  icon?: React.ReactNode;\n}\n\nfunction PermissionSwitch({ label, description, checked, onCheckedChange, icon }: PermissionSwitchProps) {\n  return (\n    <div className=\"flex items-center justify-between p-3 rounded-lg border\">\n      <div className=\"flex items-center gap-3\">\n        {icon && <span className=\"text-muted-foreground\">{icon}</span>}\n        <div>\n          <p className=\"font-medium text-sm\">{label}</p>\n          {description && <p className=\"text-xs text-muted-foreground\">{description}</p>}\n        </div>\n      </div>\n      <Switch checked={checked} onCheckedChange={onCheckedChange} />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\organization\\UnitSettingsDialog.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadData'. Either include it or remove the dependency array.","line":41,"column":8,"nodeType":"ArrayExpression","endLine":41,"endColumn":38,"suggestions":[{"desc":"Update the dependencies array to be: [open, unitId, organizationId, loadData]","fix":{"range":[1635,1665],"text":"[open, unitId, organizationId, loadData]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\nimport { useForm } from \"react-hook-form\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from \"@/components/ui/dialog\";\r\nimport { Switch } from \"@/components/ui/switch\";\r\nimport { Separator } from \"@/components/ui/separator\";\r\nimport { toast } from \"sonner\";\r\nimport { Loader2 } from \"lucide-react\";\r\n\r\ninterface UnitSettingsDialogProps {\r\n    unitId: string | null;\r\n    organizationId: string;\r\n    open: boolean;\r\n    onOpenChange: (open: boolean) => void;\r\n}\r\n\r\nexport function UnitSettingsDialog({ unitId, organizationId, open, onOpenChange }: UnitSettingsDialogProps) {\r\n    const [loading, setLoading] = useState(false);\r\n    const [saving, setSaving] = useState(false);\r\n    const [orgSettings, setOrgSettings] = useState<any>(null);\r\n\r\n    const { register, handleSubmit, setValue, watch, reset } = useForm({\r\n        defaultValues: {\r\n            override_horarios: false,\r\n            horarios_customizados: { start: \"09:00\", end: \"18:00\", weekend: false },\r\n            override_politica: false,\r\n            politica_customizada: { antecedencia_horas: 24, multa_percentual: 0 }\r\n        }\r\n    });\r\n\r\n    const overrideHorarios = watch(\"override_horarios\");\r\n    const overridePolitica = watch(\"override_politica\");\r\n\r\n    useEffect(() => {\r\n        if (open && unitId && organizationId) {\r\n            loadData();\r\n        }\r\n    }, [open, unitId, organizationId]);\r\n\r\n    const loadData = async () => {\r\n        setLoading(true);\r\n        try {\r\n            // Load Org Settings for reference\r\n            const { data: orgData } = await supabase\r\n                .from('org_settings')\r\n                .select('*')\r\n                .eq('organization_id', organizationId)\r\n                .maybeSingle();\r\n            setOrgSettings(orgData || {});\r\n\r\n            // Load Unit Settings\r\n            const { data: unitData, error } = await supabase\r\n                .from('unit_settings')\r\n                .select('*')\r\n                .eq('unit_id', unitId)\r\n                .maybeSingle();\r\n\r\n            if (error) throw error;\r\n\r\n            if (unitData) {\r\n                setValue('override_horarios', unitData.override_horarios || false);\r\n                if (unitData.horarios_customizados) setValue('horarios_customizados', unitData.horarios_customizados as any);\r\n\r\n                setValue('override_politica', unitData.override_politica || false);\r\n                if (unitData.politica_customizada) setValue('politica_customizada', unitData.politica_customizada as any);\r\n            } else {\r\n                // Create if not exists\r\n                await supabase.from('unit_settings').insert({ unit_id: unitId, organization_id: organizationId });\r\n                reset();\r\n            }\r\n        } catch (error) {\r\n            console.error('Error loading settings:', error);\r\n            toast.error(\"Erro ao carregar configura├º├Áes.\");\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const onSubmit = async (data: any) => {\r\n        if (!unitId) return;\r\n        setSaving(true);\r\n        try {\r\n            const { error } = await supabase\r\n                .from('unit_settings')\r\n                .update({\r\n                    override_horarios: data.override_horarios,\r\n                    horarios_customizados: data.horarios_customizados,\r\n                    override_politica: data.override_politica,\r\n                    politica_customizada: data.politica_customizada,\r\n                    updated_at: new Date().toISOString()\r\n                })\r\n                .eq('unit_id', unitId);\r\n\r\n            if (error) throw error;\r\n            toast.success(\"Configura├º├Áes da unidade salvas!\");\r\n            onOpenChange(false);\r\n        } catch (error) {\r\n            console.error('Error saving unit settings:', error);\r\n            toast.error(\"Erro ao salvar configura├º├Áes.\");\r\n        } finally {\r\n            setSaving(false);\r\n        }\r\n    };\r\n\r\n    return (\r\n        <Dialog open={open} onOpenChange={onOpenChange}>\r\n            <DialogContent className=\"max-w-lg max-h-[90vh] overflow-y-auto\">\r\n                <DialogHeader>\r\n                    <DialogTitle>Configura├º├Áes da Unidade</DialogTitle>\r\n                </DialogHeader>\r\n\r\n                {loading ? (\r\n                    <div className=\"flex justify-center p-8\"><Loader2 className=\"h-8 w-8 animate-spin text-muted-foreground\" /></div>\r\n                ) : (\r\n                    <form onSubmit={handleSubmit(onSubmit)} className=\"space-y-6\">\r\n\r\n                        {/* Hor├írios */}\r\n                        <div className=\"space-y-4 border p-4 rounded-md\">\r\n                            <div className=\"flex items-center justify-between\">\r\n                                <Label className=\"text-base font-semibold\">Hor├írios de Funcionamento</Label>\r\n                                <div className=\"flex items-center space-x-2\">\r\n                                    <Switch\r\n                                        checked={overrideHorarios}\r\n                                        onCheckedChange={(c) => setValue(\"override_horarios\", c)}\r\n                                    />\r\n                                    <span className=\"text-sm text-muted-foreground\">Personalizar</span>\r\n                                </div>\r\n                            </div>\r\n\r\n                            {!overrideHorarios && orgSettings && (\r\n                                <div className=\"text-sm text-muted-foreground bg-muted p-2 rounded\">\r\n                                    Herdando da organiza├º├úo: {orgSettings.horarios_padrao?.start} - {orgSettings.horarios_padrao?.end}\r\n                                </div>\r\n                            )}\r\n\r\n                            {overrideHorarios && (\r\n                                <div className=\"grid grid-cols-2 gap-4 pt-2\">\r\n                                    <div className=\"space-y-2\">\r\n                                        <Label>Abertura</Label>\r\n                                        <Input type=\"time\" {...register(\"horarios_customizados.start\")} />\r\n                                    </div>\r\n                                    <div className=\"space-y-2\">\r\n                                        <Label>Fechamento</Label>\r\n                                        <Input type=\"time\" {...register(\"horarios_customizados.end\")} />\r\n                                    </div>\r\n                                </div>\r\n                            )}\r\n                        </div>\r\n\r\n                        {/* Pol├¡tica */}\r\n                        <div className=\"space-y-4 border p-4 rounded-md\">\r\n                            <div className=\"flex items-center justify-between\">\r\n                                <Label className=\"text-base font-semibold\">Pol├¡tica de Cancelamento</Label>\r\n                                <div className=\"flex items-center space-x-2\">\r\n                                    <Switch\r\n                                        checked={overridePolitica}\r\n                                        onCheckedChange={(c) => setValue(\"override_politica\", c)}\r\n                                    />\r\n                                    <span className=\"text-sm text-muted-foreground\">Personalizar</span>\r\n                                </div>\r\n                            </div>\r\n\r\n                            {!overridePolitica && orgSettings && (\r\n                                <div className=\"text-sm text-muted-foreground bg-muted p-2 rounded\">\r\n                                    Herdando da organiza├º├úo: {orgSettings.politica_cancelamento?.antecedencia_horas}h anteced├¬ncia\r\n                                </div>\r\n                            )}\r\n\r\n                            {overridePolitica && (\r\n                                <div className=\"grid grid-cols-2 gap-4 pt-2\">\r\n                                    <div className=\"space-y-2\">\r\n                                        <Label>Anteced├¬ncia (h)</Label>\r\n                                        <Input type=\"number\" {...register(\"politica_customizada.antecedencia_horas\")} />\r\n                                    </div>\r\n                                    <div className=\"space-y-2\">\r\n                                        <Label>Multa (%)</Label>\r\n                                        <Input type=\"number\" {...register(\"politica_customizada.multa_percentual\")} />\r\n                                    </div>\r\n                                </div>\r\n                            )}\r\n                        </div>\r\n\r\n                        <DialogFooter>\r\n                            <Button type=\"button\" variant=\"outline\" onClick={() => onOpenChange(false)}>Cancelar</Button>\r\n                            <Button type=\"submit\" disabled={saving}>\r\n                                {saving && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\r\n                                Salvar\r\n                            </Button>\r\n                        </DialogFooter>\r\n                    </form>\r\n                )}\r\n            </DialogContent>\r\n        </Dialog>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\pacotes\\EditPacoteDialog.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'fetchPacote' and 'fetchServices'. Either include them or remove the dependency array.","line":58,"column":6,"nodeType":"ArrayExpression","endLine":58,"endColumn":42,"suggestions":[{"desc":"Update the dependencies array to be: [fetchPacote, fetchServices, open, pacoteId, profile?.tenant_id]","fix":{"range":[1636,1672],"text":"[fetchPacote, fetchServices, open, pacoteId, profile?.tenant_id]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription } from \"@/components/ui/dialog\";\nimport { Button } from \"@/components/ui/button\";\nimport { Label } from \"@/components/ui/label\";\nimport { Input } from \"@/components/ui/input\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { Loader2 } from \"lucide-react\";\nimport { useAuth } from \"@/hooks/useAuth\";\n\ninterface Service {\n  id: string;\n  nome: string;\n}\n\ninterface EditPacoteDialogProps {\n  pacoteId: string;\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  onSuccess?: () => void;\n}\n\nexport function EditPacoteDialog({\n  pacoteId,\n  open,\n  onOpenChange,\n  onSuccess\n}: EditPacoteDialogProps) {\n  const [isLoading, setIsLoading] = useState(false);\n  const [services, setServices] = useState<Service[]>([]);\n  const { profile } = useAuth();\n  const [formData, setFormData] = useState({\n    nome: \"\",\n    descricao: \"\",\n    servico_id: \"\",\n    numero_sessoes: \"\",\n    preco: \"\",\n    validade_dias: \"90\",\n    renovacao_automatica: false,\n    desconto_renovacao: \"0\",\n    limiar_renovacao: \"2\",\n    oferta_renovacao_ativa: true,\n    ativo: true\n  });\n\n  const { toast } = useToast();\n\n  useEffect(() => {\n    if (open && profile?.tenant_id) {\n      fetchServices();\n      if (pacoteId) {\n        fetchPacote();\n      }\n    }\n  }, [open, pacoteId, profile?.tenant_id]);\n\n  const fetchServices = async () => {\n    try {\n      const { data, error } = await supabase\n        .from('servicos')\n        .select('id, nome')\n        .eq('tenant_id', profile.tenant_id)\n        .eq('ativo', true)\n        .order('nome');\n\n      if (error) throw error;\n      setServices(data || []);\n    } catch (error) {\n      console.error('Erro ao buscar procedimentos:', error);\n    }\n  };\n\n  const fetchPacote = async () => {\n    try {\n      const { data, error } = await supabase\n        .from('pacotes')\n        .select('*')\n        .eq('id', pacoteId)\n        .single();\n\n      if (error) throw error;\n\n      setFormData({\n        nome: data.nome || \"\",\n        descricao: data.descricao || \"\",\n        servico_id: data.servico_id || \"\",\n        numero_sessoes: data.numero_sessoes?.toString() || \"\",\n        preco: data.preco?.toString() || \"\",\n        validade_dias: data.validade_dias?.toString() || \"90\",\n        renovacao_automatica: data.renovacao_automatica || false,\n        desconto_renovacao: data.desconto_renovacao?.toString() || \"0\",\n        limiar_renovacao: data.limiar_renovacao?.toString() || \"2\",\n        oferta_renovacao_ativa: data.oferta_renovacao_ativa !== false,\n        ativo: data.ativo !== false\n      });\n    } catch (error) {\n      console.error('Erro ao buscar pacote:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os dados do pacote.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.nome || !formData.numero_sessoes || !formData.preco) {\n      toast({\n        title: \"Campos obrigat├│rios\",\n        description: \"Nome, n├║mero de sess├Áes e pre├ºo s├úo obrigat├│rios.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    try {\n      setIsLoading(true);\n\n      const { error } = await supabase\n        .from('pacotes')\n        .update({\n          nome: formData.nome.trim(),\n          descricao: formData.descricao.trim() || null,\n          servico_id: formData.servico_id || null,\n          numero_sessoes: parseInt(formData.numero_sessoes),\n          preco: parseFloat(formData.preco),\n          validade_dias: parseInt(formData.validade_dias),\n          renovacao_automatica: formData.renovacao_automatica,\n          desconto_renovacao: parseFloat(formData.desconto_renovacao),\n          limiar_renovacao: parseInt(formData.limiar_renovacao),\n          oferta_renovacao_ativa: formData.oferta_renovacao_ativa,\n          ativo: formData.ativo,\n          updated_at: new Date().toISOString()\n        })\n        .eq('id', pacoteId);\n\n      if (error) throw error;\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Pacote atualizado com sucesso.\"\n      });\n\n      onOpenChange(false);\n\n      if (onSuccess) {\n        onSuccess();\n      }\n    } catch (error) {\n      console.error('Erro ao atualizar:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel atualizar o pacote.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      <DialogContent className=\"max-w-2xl max-h-[90vh] overflow-y-auto\">\n        <DialogHeader>\n          <DialogTitle className=\"text-xl\">Editar Pacote</DialogTitle>\n          <DialogDescription>\n            Atualize as informa├º├Áes do pacote de tratamento\n          </DialogDescription>\n        </DialogHeader>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"nome\">Nome do Pacote *</Label>\n            <Input\n              id=\"nome\"\n              value={formData.nome}\n              onChange={(e) => setFormData({ ...formData, nome: e.target.value })}\n              placeholder=\"Ex: Pacote 10 Sess├Áes\"\n              required\n            />\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"descricao\">Descri├º├úo</Label>\n            <Textarea\n              id=\"descricao\"\n              value={formData.descricao}\n              onChange={(e) => setFormData({ ...formData, descricao: e.target.value })}\n              placeholder=\"Descri├º├úo do pacote...\"\n              rows={2}\n            />\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"servico\">Procedimento (Opcional)</Label>\n            <Select value={formData.servico_id} onValueChange={(value) => setFormData({ ...formData, servico_id: value })}>\n              <SelectTrigger>\n                <SelectValue placeholder=\"Selecione um procedimento\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"\">Nenhum procedimento espec├¡fico</SelectItem>\n                {services.map((service) => (\n                  <SelectItem key={service.id} value={service.id}>\n                    {service.nome}\n                  </SelectItem>\n                ))}\n              </SelectContent>\n            </Select>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"numero_sessoes\">N├║mero de Sess├Áes *</Label>\n              <Input\n                id=\"numero_sessoes\"\n                type=\"number\"\n                min=\"1\"\n                value={formData.numero_sessoes}\n                onChange={(e) => setFormData({ ...formData, numero_sessoes: e.target.value })}\n                placeholder=\"10\"\n                required\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"preco\">Pre├ºo (R$) *</Label>\n              <Input\n                id=\"preco\"\n                type=\"number\"\n                step=\"0.01\"\n                min=\"0\"\n                value={formData.preco}\n                onChange={(e) => setFormData({ ...formData, preco: e.target.value })}\n                placeholder=\"500.00\"\n                required\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"validade\">Validade (dias)</Label>\n            <Input\n              id=\"validade\"\n              type=\"number\"\n              min=\"1\"\n              value={formData.validade_dias}\n              onChange={(e) => setFormData({ ...formData, validade_dias: e.target.value })}\n              placeholder=\"90\"\n            />\n          </div>\n\n          <div className=\"flex items-center justify-between\">\n            <Label htmlFor=\"renovacao\">Renova├º├úo Autom├ítica</Label>\n            <Switch\n              id=\"renovacao\"\n              checked={formData.renovacao_automatica}\n              onCheckedChange={(checked) => setFormData({ ...formData, renovacao_automatica: checked })}\n            />\n          </div>\n\n          {formData.renovacao_automatica && (\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"desconto\">Desconto na Renova├º├úo (%)</Label>\n              <Input\n                id=\"desconto\"\n                type=\"number\"\n                step=\"0.01\"\n                min=\"0\"\n                max=\"100\"\n                value={formData.desconto_renovacao}\n                onChange={(e) => setFormData({ ...formData, desconto_renovacao: e.target.value })}\n                placeholder=\"10\"\n              />\n            </div>\n          )}\n\n          <div className=\"flex items-center justify-between\">\n            <Label htmlFor=\"oferta\">Oferecer Renova├º├úo Autom├ítica</Label>\n            <Switch\n              id=\"oferta\"\n              checked={formData.oferta_renovacao_ativa}\n              onCheckedChange={(checked) => setFormData({ ...formData, oferta_renovacao_ativa: checked })}\n            />\n          </div>\n\n          {formData.oferta_renovacao_ativa && (\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"limiar\">\n                Sess├Áes Restantes para Oferta de Renova├º├úo\n              </Label>\n              <Input\n                id=\"limiar\"\n                type=\"number\"\n                min=\"1\"\n                max=\"10\"\n                value={formData.limiar_renovacao}\n                onChange={(e) => setFormData({ ...formData, limiar_renovacao: e.target.value })}\n                placeholder=\"2\"\n              />\n              <p className=\"text-xs text-muted-foreground\">\n                Quando restarem este n├║mero de sess├Áes, o sistema oferecer├í renova├º├úo\n              </p>\n            </div>\n          )}\n\n          <div className=\"flex items-center justify-between\">\n            <Label htmlFor=\"ativo\">Pacote ativo?</Label>\n            <Switch\n              id=\"ativo\"\n              checked={formData.ativo}\n              onCheckedChange={(checked) => setFormData({ ...formData, ativo: checked })}\n            />\n          </div>\n\n          <div className=\"flex justify-end gap-3 pt-4\">\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              onClick={() => onOpenChange(false)}\n              disabled={isLoading}\n            >\n              Cancelar\n            </Button>\n            <Button type=\"submit\" disabled={isLoading}>\n              {isLoading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n              Salvar Altera├º├Áes\n            </Button>\n          </div>\n        </form>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\pacotes\\NewPacoteDialog.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchServicos'. Either include it or remove the dependency array.","line":44,"column":6,"nodeType":"ArrayExpression","endLine":44,"endColumn":32,"suggestions":[{"desc":"Update the dependencies array to be: [fetchServicos, open, profile?.tenant_id]","fix":{"range":[1495,1521],"text":"[fetchServicos, open, profile?.tenant_id]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger, DialogDescription } from \"@/components/ui/dialog\";\nimport { Button } from \"@/components/ui/button\";\nimport { Label } from \"@/components/ui/label\";\nimport { Input } from \"@/components/ui/input\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { Loader2, Plus } from \"lucide-react\";\nimport { useAuth } from \"@/hooks/useAuth\";\n\ninterface NewPacoteDialogProps {\n  children?: React.ReactNode;\n  onSuccess?: () => void;\n}\n\nexport function NewPacoteDialog({ children, onSuccess }: NewPacoteDialogProps) {\n  const [open, setOpen] = useState(false);\n  const [isLoading, setIsLoading] = useState(false);\n  const [servicos, setServicos] = useState<any[]>([]);\n  const { profile } = useAuth();\n\n  const [formData, setFormData] = useState({\n    nome: \"\",\n    descricao: \"\",\n    servico_id: \"\",\n    numero_sessoes: \"\",\n    preco: \"\",\n    validade_dias: \"90\",\n    renovacao_automatica: false,\n    desconto_renovacao: \"0\",\n    limiar_renovacao: \"2\",\n    oferta_renovacao_ativa: true\n  });\n\n  const { toast } = useToast();\n\n  useEffect(() => {\n    if (open && profile?.tenant_id) {\n      fetchServicos();\n    }\n  }, [open, profile?.tenant_id]);\n\n  const fetchServicos = async () => {\n    try {\n      const { data, error } = await supabase\n        .from('servicos')\n        .select('id, nome')\n        .eq('tenant_id', profile.tenant_id)\n        .eq('ativo', true)\n        .order('nome');\n\n      if (error) throw error;\n      setServicos(data || []);\n    } catch (error) {\n      console.error('Erro ao buscar procedimentos:', error);\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.nome || !formData.numero_sessoes || !formData.preco) {\n      toast({\n        title: \"Campos obrigat├│rios\",\n        description: \"Por favor, preencha todos os campos obrigat├│rios.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    // Valida├º├Áes adicionais\n    const numSessoes = parseInt(formData.numero_sessoes);\n    const preco = parseFloat(formData.preco);\n    const validadeDias = parseInt(formData.validade_dias);\n    const descontoRenovacao = parseFloat(formData.desconto_renovacao);\n\n    if (numSessoes <= 0) {\n      toast({\n        title: \"N├║mero de sess├Áes inv├ílido\",\n        description: \"O n├║mero de sess├Áes deve ser maior que zero.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    if (preco <= 0) {\n      toast({\n        title: \"Pre├ºo inv├ílido\",\n        description: \"O pre├ºo deve ser maior que zero.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    if (validadeDias <= 0) {\n      toast({\n        title: \"Validade inv├ílida\",\n        description: \"A validade deve ser maior que zero dias.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    if (descontoRenovacao < 0 || descontoRenovacao > 100) {\n      toast({\n        title: \"Desconto inv├ílido\",\n        description: \"O desconto deve estar entre 0% e 100%.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    try {\n      setIsLoading(true);\n\n      if (!profile?.tenant_id) throw new Error(\"Tenant n├úo encontrado\");\n\n      const { error } = await supabase\n        .from('pacotes')\n        .insert([{\n          tenant_id: profile.tenant_id,\n          nome: formData.nome.trim(),\n          descricao: formData.descricao?.trim() || null,\n          servico_id: formData.servico_id || null,\n          numero_sessoes: numSessoes,\n          preco: preco,\n          validade_dias: validadeDias,\n          renovacao_automatica: formData.renovacao_automatica,\n          desconto_renovacao: descontoRenovacao,\n          limiar_renovacao: parseInt(formData.limiar_renovacao),\n          oferta_renovacao_ativa: formData.oferta_renovacao_ativa,\n          ativo: true\n        }]);\n\n      if (error) {\n        if (error.code === '23505') {\n          throw new Error(\"J├í existe um pacote com este nome\");\n        }\n        throw error;\n      }\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Pacote criado com sucesso.\"\n      });\n\n      setOpen(false);\n      setFormData({\n        nome: \"\",\n        descricao: \"\",\n        servico_id: \"\",\n        numero_sessoes: \"\",\n        preco: \"\",\n        validade_dias: \"90\",\n        renovacao_automatica: false,\n        desconto_renovacao: \"0\",\n        limiar_renovacao: \"2\",\n        oferta_renovacao_ativa: true\n      });\n\n      if (onSuccess) onSuccess();\n    } catch (error) {\n      console.error('Erro ao criar pacote:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel criar o pacote.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={setOpen}>\n      <DialogTrigger asChild>\n        {children || (\n          <Button>\n            <Plus className=\"h-4 w-4 mr-2\" />\n            Novo Pacote\n          </Button>\n        )}\n      </DialogTrigger>\n      <DialogContent className=\"max-w-2xl max-h-[90vh] overflow-y-auto\">\n        <DialogHeader>\n          <DialogTitle className=\"text-2xl\">Novo Pacote de Tratamento</DialogTitle>\n          <DialogDescription>\n            Crie um pacote de sess├Áes para oferecer aos seus clientes\n          </DialogDescription>\n        </DialogHeader>\n\n        <form onSubmit={handleSubmit} className=\"space-y-6\">\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"nome\">Nome do Pacote *</Label>\n            <Input\n              id=\"nome\"\n              value={formData.nome}\n              onChange={(e) => setFormData({ ...formData, nome: e.target.value })}\n              placeholder=\"Ex: Pacote 10 Sess├Áes Depila├º├úo a Laser\"\n            />\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"descricao\">Descri├º├úo</Label>\n            <Textarea\n              id=\"descricao\"\n              value={formData.descricao}\n              onChange={(e) => setFormData({ ...formData, descricao: e.target.value })}\n              placeholder=\"Descreva os benef├¡cios e detalhes do pacote...\"\n              rows={3}\n            />\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"servico\">Procedimento Relacionado (Opcional)</Label>\n            <Select\n              value={formData.servico_id}\n              onValueChange={(value) => setFormData({ ...formData, servico_id: value === \"none\" ? \"\" : value })}\n            >\n              <SelectTrigger id=\"servico\">\n                <SelectValue placeholder=\"Selecione um procedimento\" />\n              </SelectTrigger>\n              <SelectContent className=\"bg-background z-50\">\n                <SelectItem value=\"none\">Nenhum procedimento espec├¡fico</SelectItem>\n                {servicos.map((servico) => (\n                  <SelectItem key={servico.id} value={servico.id}>\n                    {servico.nome}\n                  </SelectItem>\n                ))}\n              </SelectContent>\n            </Select>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"numero_sessoes\">N├║mero de Sess├Áes *</Label>\n              <Input\n                id=\"numero_sessoes\"\n                type=\"number\"\n                min=\"1\"\n                value={formData.numero_sessoes}\n                onChange={(e) => setFormData({ ...formData, numero_sessoes: e.target.value })}\n                placeholder=\"Ex: 10\"\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"preco\">Pre├ºo do Pacote (R$) *</Label>\n              <Input\n                id=\"preco\"\n                type=\"number\"\n                step=\"0.01\"\n                min=\"0\"\n                value={formData.preco}\n                onChange={(e) => setFormData({ ...formData, preco: e.target.value })}\n                placeholder=\"Ex: 1500.00\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"validade_dias\">Validade (dias)</Label>\n            <Input\n              id=\"validade_dias\"\n              type=\"number\"\n              min=\"1\"\n              value={formData.validade_dias}\n              onChange={(e) => setFormData({ ...formData, validade_dias: e.target.value })}\n              placeholder=\"Ex: 90\"\n            />\n            <p className=\"text-xs text-muted-foreground\">\n              Prazo para usar todas as sess├Áes do pacote\n            </p>\n          </div>\n\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"space-y-0.5\">\n                <Label htmlFor=\"renovacao_automatica\">Renova├º├úo Autom├ítica</Label>\n                <p className=\"text-xs text-muted-foreground\">\n                  Renovar automaticamente quando expirar\n                </p>\n              </div>\n              <Switch\n                id=\"renovacao_automatica\"\n                checked={formData.renovacao_automatica}\n                onCheckedChange={(checked) => setFormData({ ...formData, renovacao_automatica: checked })}\n              />\n            </div>\n\n            {formData.renovacao_automatica && (\n              <div className=\"space-y-2\">\n                <Label htmlFor=\"desconto_renovacao\">Desconto na Renova├º├úo (%)</Label>\n                <Input\n                  id=\"desconto_renovacao\"\n                  type=\"number\"\n                  step=\"0.01\"\n                  min=\"0\"\n                  max=\"100\"\n                  value={formData.desconto_renovacao}\n                  onChange={(e) => setFormData({ ...formData, desconto_renovacao: e.target.value })}\n                  placeholder=\"Ex: 10\"\n                />\n              </div>\n            )}\n\n            <div className=\"flex items-center justify-between\">\n              <div className=\"space-y-0.5\">\n                <Label htmlFor=\"oferta_renovacao_ativa\">Oferecer Renova├º├úo Autom├ítica</Label>\n                <p className=\"text-xs text-muted-foreground\">\n                  Notificar paciente quando pr├│ximo ao t├®rmino\n                </p>\n              </div>\n              <Switch\n                id=\"oferta_renovacao_ativa\"\n                checked={formData.oferta_renovacao_ativa}\n                onCheckedChange={(checked) => setFormData({ ...formData, oferta_renovacao_ativa: checked })}\n              />\n            </div>\n\n            {formData.oferta_renovacao_ativa && (\n              <div className=\"space-y-2\">\n                <Label htmlFor=\"limiar_renovacao\">\n                  Sess├Áes Restantes para Oferta de Renova├º├úo\n                </Label>\n                <Input\n                  id=\"limiar_renovacao\"\n                  type=\"number\"\n                  min=\"1\"\n                  max=\"10\"\n                  value={formData.limiar_renovacao}\n                  onChange={(e) => setFormData({ ...formData, limiar_renovacao: e.target.value })}\n                  placeholder=\"2\"\n                />\n                <p className=\"text-xs text-muted-foreground\">\n                  Quando restarem este n├║mero de sess├Áes, o sistema oferecer├í renova├º├úo\n                </p>\n              </div>\n            )}\n          </div>\n\n          <div className=\"flex justify-end gap-3 pt-4\">\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              onClick={() => setOpen(false)}\n              disabled={isLoading}\n            >\n              Cancelar\n            </Button>\n            <Button type=\"submit\" disabled={isLoading}>\n              {isLoading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n              Criar Pacote\n            </Button>\n          </div>\n        </form>\n      </DialogContent>\n    </Dialog>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\pacotes\\PackageUsageNotification.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\pacotes\\VincularPacoteDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\patient\\AgendamentoOnline.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'loadProfissionais' and 'loadServicos'. Either include them or remove the dependency array.","line":36,"column":8,"nodeType":"ArrayExpression","endLine":36,"endColumn":18,"suggestions":[{"desc":"Update the dependencies array to be: [loadProfissionais, loadServicos, tenantId]","fix":{"range":[1719,1729],"text":"[loadProfissionais, loadServicos, tenantId]"}}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadHorariosDisponiveis'. Either include it or remove the dependency array.","line":42,"column":8,"nodeType":"ArrayExpression","endLine":42,"endColumn":50,"suggestions":[{"desc":"Update the dependencies array to be: [profissionalSelecionado, dataSelecionada, loadHorariosDisponiveis]","fix":{"range":[1875,1917],"text":"[profissionalSelecionado, dataSelecionada, loadHorariosDisponiveis]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\nimport { Card, CardContent, CardHeader, CardTitle, CardDescription } from \"@/components/ui/card\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Label } from \"@/components/ui/label\";\r\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\r\nimport { Calendar } from \"@/components/ui/calendar\";\r\nimport { Textarea } from \"@/components/ui/textarea\";\r\nimport { supabase } from \"@/integrations/supabase/client\";\r\nimport { toast } from \"sonner\";\r\nimport { Calendar as CalendarIcon, Clock, User, CheckCircle2 } from \"lucide-react\";\r\nimport { format, addDays, setHours, setMinutes, isBefore, isAfter, startOfDay } from \"date-fns\";\r\nimport { ptBR } from \"date-fns/locale\";\r\n\r\ninterface AgendamentoOnlineProps {\r\n    pacienteId: string;\r\n    tenantId: string;\r\n}\r\n\r\nexport function AgendamentoOnline({ pacienteId, tenantId }: AgendamentoOnlineProps) {\r\n    const [step, setStep] = useState(1);\r\n    const [profissionais, setProfissionais] = useState<any[]>([]);\r\n    const [servicos, setServicos] = useState<any[]>([]);\r\n    const [horariosDisponiveis, setHorariosDisponiveis] = useState<any[]>([]);\r\n\r\n    const [profissionalSelecionado, setProfissionalSelecionado] = useState('');\r\n    const [servicoSelecionado, setServicoSelecionado] = useState('');\r\n    const [dataSelecionada, setDataSelecionada] = useState<Date | undefined>(undefined);\r\n    const [horarioSelecionado, setHorarioSelecionado] = useState('');\r\n    const [observacoes, setObservacoes] = useState('');\r\n\r\n    const [loading, setLoading] = useState(false);\r\n\r\n    useEffect(() => {\r\n        loadProfissionais();\r\n        loadServicos();\r\n    }, [tenantId]);\r\n\r\n    useEffect(() => {\r\n        if (profissionalSelecionado && dataSelecionada) {\r\n            loadHorariosDisponiveis();\r\n        }\r\n    }, [profissionalSelecionado, dataSelecionada]);\r\n\r\n    const loadProfissionais = async () => {\r\n        try {\r\n            const { data } = await supabase\r\n                .from('profiles')\r\n                .select('id, nome')\r\n                .eq('tenant_id', tenantId)\r\n                .eq('ativo', true);\r\n\r\n            setProfissionais(data || []);\r\n        } catch (error) {\r\n            console.error('Erro:', error);\r\n        }\r\n    };\r\n\r\n    const loadServicos = async () => {\r\n        try {\r\n            const { data } = await supabase\r\n                .from('servicos')\r\n                .select('*')\r\n                .eq('tenant_id', tenantId)\r\n                .eq('ativo', true);\r\n\r\n            setServicos(data || []);\r\n        } catch (error) {\r\n            console.error('Erro:', error);\r\n        }\r\n    };\r\n\r\n    const loadHorariosDisponiveis = async () => {\r\n        if (!profissionalSelecionado || !dataSelecionada) return;\r\n\r\n        try {\r\n            setLoading(true);\r\n\r\n            const dataInicio = startOfDay(dataSelecionada);\r\n            const dataFim = addDays(dataInicio, 1);\r\n\r\n            const { data: agendamentosExistentes } = await supabase\r\n                .from('agenda')\r\n                .select('inicio, fim')\r\n                .eq('profissional_id', profissionalSelecionado)\r\n                .gte('inicio', dataInicio.toISOString())\r\n                .lt('inicio', dataFim.toISOString())\r\n                .neq('status', 'cancelado');\r\n\r\n            const horarios: any[] = [];\r\n            const servicoDuracao = servicos.find(s => s.id === servicoSelecionado)?.duracao_minutos || 30;\r\n\r\n            for (let hora = 8; hora < 18; hora++) {\r\n                for (let minuto = 0; minuto < 60; minuto += 30) {\r\n                    const inicio = setMinutes(setHours(dataSelecionada, hora), minuto);\r\n                    const fim = new Date(inicio.getTime() + servicoDuracao * 60000);\r\n\r\n                    const conflito = agendamentosExistentes?.some(ag => {\r\n                        const agInicio = new Date(ag.inicio);\r\n                        const agFim = new Date(ag.fim);\r\n                        return (\r\n                            (inicio >= agInicio && inicio < agFim) ||\r\n                            (fim > agInicio && fim <= agFim) ||\r\n                            (inicio <= agInicio && fim >= agFim)\r\n                        );\r\n                    });\r\n\r\n                    if (!conflito && isBefore(new Date(), inicio)) {\r\n                        horarios.push({ inicio, fim });\r\n                    }\r\n                }\r\n            }\r\n\r\n            setHorariosDisponiveis(horarios);\r\n        } catch (error) {\r\n            toast.error('Erro ao carregar hor├írios');\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    const handleConfirmarAgendamento = async () => {\r\n        if (!profissionalSelecionado || !servicoSelecionado || !horarioSelecionado) {\r\n            toast.error('Preencha todos os campos');\r\n            return;\r\n        }\r\n\r\n        try {\r\n            setLoading(true);\r\n\r\n            const horario = horariosDisponiveis.find(h =>\r\n                h.inicio.toISOString() === horarioSelecionado\r\n            );\r\n\r\n            const { error } = await supabase\r\n                .from('agenda')\r\n                .insert({\r\n                    tenant_id: tenantId,\r\n                    paciente_id: pacienteId,\r\n                    profissional_id: profissionalSelecionado,\r\n                    servico_id: servicoSelecionado,\r\n                    inicio: horario.inicio.toISOString(),\r\n                    fim: horario.fim.toISOString(),\r\n                    status: 'agendado',\r\n                    confirmado: false,\r\n                    observacoes\r\n                });\r\n\r\n            if (error) throw error;\r\n\r\n            toast.success('Agendamento realizado!');\r\n            setStep(4);\r\n\r\n            setTimeout(() => {\r\n                setStep(1);\r\n                setProfissionalSelecionado('');\r\n                setServicoSelecionado('');\r\n                setDataSelecionada(undefined);\r\n                setHorarioSelecionado('');\r\n                setObservacoes('');\r\n            }, 3000);\r\n\r\n        } catch (error) {\r\n            toast.error('Erro ao agendar');\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    return (\r\n        <div className=\"space-y-6\">\r\n            {/* Progress */}\r\n            <div className=\"flex items-center justify-center gap-2\">\r\n                {[1, 2, 3].map((s) => (\r\n                    <React.Fragment key={s}>\r\n                        <div className={`flex items-center justify-center w-8 h-8 rounded-full ${step >= s ? 'bg-primary text-primary-foreground' : 'bg-muted'\r\n                            }`}>\r\n                            {s}\r\n                        </div>\r\n                        {s < 3 && <div className={`h-0.5 w-12 ${step > s ? 'bg-primary' : 'bg-muted'}`} />}\r\n                    </React.Fragment>\r\n                ))}\r\n            </div>\r\n\r\n            {/* Step 1: Profissional e Servi├ºo */}\r\n            {step === 1 && (\r\n                <Card>\r\n                    <CardHeader>\r\n                        <CardTitle className=\"flex items-center gap-2\">\r\n                            <User className=\"h-5 w-5\" />\r\n                            Escolha o Profissional\r\n                        </CardTitle>\r\n                    </CardHeader>\r\n                    <CardContent className=\"space-y-4\">\r\n                        <div>\r\n                            <Label>Profissional</Label>\r\n                            <Select value={profissionalSelecionado} onValueChange={setProfissionalSelecionado}>\r\n                                <SelectTrigger>\r\n                                    <SelectValue placeholder=\"Selecione\" />\r\n                                </SelectTrigger>\r\n                                <SelectContent>\r\n                                    {profissionais.map(p => (\r\n                                        <SelectItem key={p.id} value={p.id}>{p.nome}</SelectItem>\r\n                                    ))}\r\n                                </SelectContent>\r\n                            </Select>\r\n                        </div>\r\n\r\n                        <div>\r\n                            <Label>Servi├ºo</Label>\r\n                            <Select value={servicoSelecionado} onValueChange={setServicoSelecionado}>\r\n                                <SelectTrigger>\r\n                                    <SelectValue placeholder=\"Selecione\" />\r\n                                </SelectTrigger>\r\n                                <SelectContent>\r\n                                    {servicos.map(s => (\r\n                                        <SelectItem key={s.id} value={s.id}>\r\n                                            {s.nome} - {s.duracao_minutos}min - R$ {s.valor}\r\n                                        </SelectItem>\r\n                                    ))}\r\n                                </SelectContent>\r\n                            </Select>\r\n                        </div>\r\n\r\n                        <Button\r\n                            className=\"w-full\"\r\n                            onClick={() => setStep(2)}\r\n                            disabled={!profissionalSelecionado || !servicoSelecionado}\r\n                        >\r\n                            Pr├│ximo: Escolher Data\r\n                        </Button>\r\n                    </CardContent>\r\n                </Card>\r\n            )}\r\n\r\n            {/* Step 2: Data */}\r\n            {step === 2 && (\r\n                <Card>\r\n                    <CardHeader>\r\n                        <CardTitle className=\"flex items-center gap-2\">\r\n                            <CalendarIcon className=\"h-5 w-5\" />\r\n                            Escolha a Data\r\n                        </CardTitle>\r\n                    </CardHeader>\r\n                    <CardContent className=\"space-y-4\">\r\n                        <div className=\"flex justify-center\">\r\n                            <Calendar\r\n                                mode=\"single\"\r\n                                selected={dataSelecionada}\r\n                                onSelect={setDataSelecionada}\r\n                                disabled={(date) =>\r\n                                    isBefore(date, new Date()) ||\r\n                                    isAfter(date, addDays(new Date(), 60))\r\n                                }\r\n                                locale={ptBR}\r\n                                className=\"rounded-md border\"\r\n                            />\r\n                        </div>\r\n\r\n                        <div className=\"flex gap-2\">\r\n                            <Button variant=\"outline\" onClick={() => setStep(1)} className=\"flex-1\">\r\n                                Voltar\r\n                            </Button>\r\n                            <Button\r\n                                onClick={() => setStep(3)}\r\n                                disabled={!dataSelecionada}\r\n                                className=\"flex-1\"\r\n                            >\r\n                                Pr├│ximo: Hor├írio\r\n                            </Button>\r\n                        </div>\r\n                    </CardContent>\r\n                </Card>\r\n            )}\r\n\r\n            {/* Step 3: Hor├írio */}\r\n            {step === 3 && (\r\n                <Card>\r\n                    <CardHeader>\r\n                        <CardTitle className=\"flex items-center gap-2\">\r\n                            <Clock className=\"h-5 w-5\" />\r\n                            Escolha o Hor├írio\r\n                        </CardTitle>\r\n                    </CardHeader>\r\n                    <CardContent className=\"space-y-4\">\r\n                        {loading ? (\r\n                            <div className=\"text-center py-8\">Carregando...</div>\r\n                        ) : horariosDisponiveis.length === 0 ? (\r\n                            <div className=\"text-center py-8\">\r\n                                <p>Nenhum hor├írio dispon├¡vel</p>\r\n                                <Button variant=\"outline\" onClick={() => setStep(2)} className=\"mt-4\">\r\n                                    Outra Data\r\n                                </Button>\r\n                            </div>\r\n                        ) : (\r\n                            <>\r\n                                <div className=\"grid grid-cols-3 gap-2 max-h-96 overflow-y-auto\">\r\n                                    {horariosDisponiveis.map((horario, i) => (\r\n                                        <Button\r\n                                            key={i}\r\n                                            variant={horarioSelecionado === horario.inicio.toISOString() ? \"default\" : \"outline\"}\r\n                                            onClick={() => setHorarioSelecionado(horario.inicio.toISOString())}\r\n                                        >\r\n                                            {format(horario.inicio, 'HH:mm')}\r\n                                        </Button>\r\n                                    ))}\r\n                                </div>\r\n\r\n                                <div>\r\n                                    <Label>Observa├º├Áes</Label>\r\n                                    <Textarea\r\n                                        value={observacoes}\r\n                                        onChange={(e) => setObservacoes(e.target.value)}\r\n                                        rows={3}\r\n                                    />\r\n                                </div>\r\n\r\n                                <div className=\"flex gap-2\">\r\n                                    <Button variant=\"outline\" onClick={() => setStep(2)} className=\"flex-1\">\r\n                                        Voltar\r\n                                    </Button>\r\n                                    <Button\r\n                                        onClick={handleConfirmarAgendamento}\r\n                                        disabled={!horarioSelecionado || loading}\r\n                                        className=\"flex-1\"\r\n                                    >\r\n                                        Confirmar\r\n                                    </Button>\r\n                                </div>\r\n                            </>\r\n                        )}\r\n                    </CardContent>\r\n                </Card>\r\n            )}\r\n\r\n            {/* Step 4: Confirma├º├úo */}\r\n            {step === 4 && (\r\n                <Card className=\"border-green-200 bg-green-50\">\r\n                    <CardContent className=\"pt-6 text-center space-y-4\">\r\n                        <CheckCircle2 className=\"h-16 w-16 text-green-600 mx-auto\" />\r\n                        <h3 className=\"text-2xl font-bold\">Agendamento Confirmado!</h3>\r\n                        <p>Voc├¬ receber├í uma confirma├º├úo por WhatsApp.</p>\r\n                    </CardContent>\r\n                </Card>\r\n            )}\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\planos\\EditPlanoSaudeDialog.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchPlano'. Either include it or remove the dependency array.","line":37,"column":6,"nodeType":"ArrayExpression","endLine":37,"endColumn":21,"suggestions":[{"desc":"Update the dependencies array to be: [fetchPlano, open, planoId]","fix":{"range":[1055,1070],"text":"[fetchPlano, open, planoId]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\nimport { Dialog, DialogContent, DialogHeader, DialogTitle } from \"@/components/ui/dialog\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { Loader2 } from \"lucide-react\";\n\ninterface EditPlanoSaudeDialogProps {\n  planoId: string;\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  onSuccess?: () => void;\n}\n\nexport function EditPlanoSaudeDialog({\n  planoId,\n  open,\n  onOpenChange,\n  onSuccess,\n}: EditPlanoSaudeDialogProps) {\n  const [isLoading, setIsLoading] = useState(false);\n  const [formData, setFormData] = useState({\n    nome: \"\",\n    descricao: \"\",\n    ativo: true,\n  });\n  const { toast } = useToast();\n\n  useEffect(() => {\n    if (open && planoId) {\n      fetchPlano();\n    }\n  }, [open, planoId]);\n\n  const fetchPlano = async () => {\n    try {\n      const { data, error } = await supabase\n        .from(\"planos_saude\")\n        .select(\"*\")\n        .eq(\"id\", planoId)\n        .single();\n\n      if (error) throw error;\n\n      setFormData({\n        nome: data.nome,\n        descricao: data.descricao || \"\",\n        ativo: data.ativo,\n      });\n    } catch (error: any) {\n      toast({\n        title: \"Erro ao carregar plano\",\n        description: error.message,\n        variant: \"destructive\",\n      });\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsLoading(true);\n\n    try {\n      const { error } = await supabase\n        .from(\"planos_saude\")\n        .update({\n          nome: formData.nome.trim(),\n          descricao: formData.descricao.trim() || null,\n          ativo: formData.ativo,\n        })\n        .eq(\"id\", planoId);\n\n      if (error) throw error;\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Plano atualizado com sucesso.\",\n      });\n\n      onOpenChange(false);\n      onSuccess?.();\n    } catch (error: any) {\n      toast({\n        title: \"Erro ao atualizar plano\",\n        description: error.message,\n        variant: \"destructive\",\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      <DialogContent className=\"sm:max-w-[500px]\">\n        <DialogHeader>\n          <DialogTitle>Editar Plano de Sa├║de</DialogTitle>\n        </DialogHeader>\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"nome\">Nome do Plano *</Label>\n            <Input\n              id=\"nome\"\n              value={formData.nome}\n              onChange={(e) => setFormData({ ...formData, nome: e.target.value })}\n              required\n            />\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"descricao\">Descri├º├úo</Label>\n            <Textarea\n              id=\"descricao\"\n              value={formData.descricao}\n              onChange={(e) => setFormData({ ...formData, descricao: e.target.value })}\n              rows={3}\n            />\n          </div>\n\n          <div className=\"flex items-center space-x-2\">\n            <Switch\n              id=\"ativo\"\n              checked={formData.ativo}\n              onCheckedChange={(checked) => setFormData({ ...formData, ativo: checked })}\n            />\n            <Label htmlFor=\"ativo\">Plano ativo</Label>\n          </div>\n\n          <div className=\"flex gap-3 pt-4\">\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              onClick={() => onOpenChange(false)}\n              className=\"flex-1\"\n            >\n              Cancelar\n            </Button>\n            <Button type=\"submit\" disabled={isLoading} className=\"flex-1\">\n              {isLoading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n              Salvar Altera├º├Áes\n            </Button>\n          </div>\n        </form>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\planos\\NewPlanoSaudeDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\prontuario\\ProntuarioForm.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchPacienteInfo'. Either include it or remove the dependency array.","line":48,"column":6,"nodeType":"ArrayExpression","endLine":48,"endColumn":18,"suggestions":[{"desc":"Update the dependencies array to be: [fetchPacienteInfo, pacienteId]","fix":{"range":[1576,1588],"text":"[fetchPacienteInfo, pacienteId]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { toast } from \"sonner\";\nimport { Save, FileSignature, Calendar } from \"lucide-react\";\nimport { RegistroMedico } from \"./RegistroMedico\";\nimport { format, differenceInYears } from \"date-fns\";\nimport { ptBR } from \"date-fns/locale\";\n\ninterface ProntuarioFormProps {\n  pacienteId: string;\n  agendamentoId?: string;\n  onSave?: () => void;\n}\n\nexport default function ProntuarioForm({ pacienteId, agendamentoId, onSave }: ProntuarioFormProps) {\n  const [loading, setLoading] = useState(false);\n  const [prontuarioId, setProntuarioId] = useState<string | null>(null);\n  const [pacienteInfo, setPacienteInfo] = useState<any>(null);\n  const [formData, setFormData] = useState({\n    // SOAP\n    subjetivo: \"\",\n    objetivo: \"\",\n    avaliacao: \"\",\n    plano: \"\",\n    // Vitais\n    pressao_arterial: \"\",\n    frequencia_cardiaca: \"\",\n    temperatura: \"\",\n    peso: \"\",\n    altura: \"\",\n    // CID-10\n    cid10_principal: \"\",\n    // Prescri├º├Áes\n    prescricoes: \"\",\n    procedimentos: \"\",\n    exames_solicitados: \"\",\n  });\n\n  useEffect(() => {\n    fetchPacienteInfo();\n  }, [pacienteId]);\n\n  const fetchPacienteInfo = async () => {\n    try {\n      const { data, error } = await (supabase as any)\n        .from('pacientes')\n        .select('nome, data_nascimento')\n        .eq('id', pacienteId)\n        .maybeSingle();\n\n      if (error) throw error;\n      setPacienteInfo(data);\n    } catch (error) {\n      console.error('Erro ao buscar informa├º├Áes do paciente:', error);\n    }\n  };\n\n  const calcularIdade = () => {\n    if (pacienteInfo?.data_nascimento) {\n      return differenceInYears(new Date(), new Date(pacienteInfo.data_nascimento));\n    }\n    return null;\n  };\n\n  const handleInputChange = (field: string, value: string) => {\n    setFormData(prev => ({ ...prev, [field]: value }));\n  };\n\n  const calculateIMC = () => {\n    if (formData.peso && formData.altura) {\n      const peso = parseFloat(formData.peso);\n      const altura = parseFloat(formData.altura);\n      if (peso > 0 && altura > 0) {\n        return (peso / (altura * altura)).toFixed(2);\n      }\n    }\n    return null;\n  };\n\n  const handleSave = async (status: 'rascunho' | 'finalizado') => {\n    setLoading(true);\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) throw new Error('Usu├írio n├úo autenticado');\n\n      const { data: profile } = await supabase\n        .from('profiles')\n        .select('tenant_id')\n        .eq('id', user.id)\n        .single();\n\n      if (!profile) throw new Error('Perfil n├úo encontrado');\n\n      const imc = calculateIMC();\n      \n      const { data, error } = await (supabase as any).from('prontuarios').insert({\n        tenant_id: profile.tenant_id,\n        paciente_id: pacienteId,\n        profissional_id: user.id,\n        agendamento_id: agendamentoId,\n        status,\n        ...formData,\n        frequencia_cardiaca: formData.frequencia_cardiaca ? parseInt(formData.frequencia_cardiaca) : null,\n        temperatura: formData.temperatura ? parseFloat(formData.temperatura) : null,\n        peso: null, // Peso agora ├® gerenciado pelo hist├│rico\n        altura: null, // Altura agora ├® gerenciada pelo RegistroMedico\n        imc: null // IMC calculado automaticamente no hist├│rico de peso\n      }).select().single();\n\n      if (error) throw error;\n      \n      if (data) {\n        setProntuarioId(data.id);\n      }\n\n      toast.success(status === 'finalizado' ? 'Prontu├írio salvo com sucesso!' : 'Rascunho salvo!');\n      onSave?.();\n    } catch (error: any) {\n      console.error('Erro ao salvar prontu├írio:', error);\n      toast.error(error.message || 'Erro ao salvar prontu├írio');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {pacienteInfo && (\n        <Card>\n          <CardHeader>\n            <div className=\"flex items-center justify-between\">\n              <CardTitle>Informa├º├Áes do Paciente</CardTitle>\n              {pacienteInfo.data_nascimento && (\n                <Badge variant=\"secondary\" className=\"flex items-center gap-2\">\n                  <Calendar className=\"h-4 w-4\" />\n                  {calcularIdade()} anos\n                </Badge>\n              )}\n            </div>\n          </CardHeader>\n          <CardContent>\n            <div className=\"space-y-2\">\n              <p className=\"text-lg font-semibold\">{pacienteInfo.nome}</p>\n              {pacienteInfo.data_nascimento && (\n                <p className=\"text-sm text-muted-foreground\">\n                  Nascimento: {format(new Date(pacienteInfo.data_nascimento), \"dd 'de' MMMM 'de' yyyy\", { locale: ptBR })}\n                </p>\n              )}\n            </div>\n          </CardContent>\n        </Card>\n      )}\n\n      {prontuarioId && (\n        <RegistroMedico \n          prontuarioId={prontuarioId} \n          pacienteId={pacienteId} \n        />\n      )}\n\n      <Card>\n      <CardHeader>\n        <CardTitle>Prontu├írio Eletr├┤nico</CardTitle>\n      </CardHeader>\n      <CardContent>\n        <Tabs defaultValue=\"soap\" className=\"space-y-4\">\n          <TabsList className=\"grid w-full grid-cols-4\">\n            <TabsTrigger value=\"soap\">SOAP</TabsTrigger>\n            <TabsTrigger value=\"vitais\">Sinais Vitais</TabsTrigger>\n            <TabsTrigger value=\"diagnostico\">Diagn├│stico</TabsTrigger>\n            <TabsTrigger value=\"prescricoes\">Prescri├º├Áes</TabsTrigger>\n          </TabsList>\n\n          <TabsContent value=\"soap\" className=\"space-y-4\">\n            <div className=\"space-y-2\">\n              <Label>Subjetivo (S)</Label>\n              <Textarea\n                placeholder=\"Sintomas relatados pelo paciente, queixa principal, hist├│ria da doen├ºa atual...\"\n                value={formData.subjetivo}\n                onChange={(e) => handleInputChange('subjetivo', e.target.value)}\n                rows={4}\n              />\n            </div>\n            <div className=\"space-y-2\">\n              <Label>Objetivo (O)</Label>\n              <Textarea\n                placeholder=\"Observa├º├Áes cl├¡nicas objetivas, exame f├¡sico, resultados de exames...\"\n                value={formData.objetivo}\n                onChange={(e) => handleInputChange('objetivo', e.target.value)}\n                rows={4}\n              />\n            </div>\n            <div className=\"space-y-2\">\n              <Label>Avalia├º├úo (A)</Label>\n              <Textarea\n                placeholder=\"Avalia├º├úo cl├¡nica, diagn├│stico, impress├úo diagn├│stica...\"\n                value={formData.avaliacao}\n                onChange={(e) => handleInputChange('avaliacao', e.target.value)}\n                rows={4}\n              />\n            </div>\n            <div className=\"space-y-2\">\n              <Label>Plano (P)</Label>\n              <Textarea\n                placeholder=\"Plano terap├¬utico, orienta├º├Áes, retorno, encaminhamentos...\"\n                value={formData.plano}\n                onChange={(e) => handleInputChange('plano', e.target.value)}\n                rows={4}\n              />\n            </div>\n          </TabsContent>\n\n          <TabsContent value=\"vitais\" className=\"space-y-4\">\n            <div className=\"grid grid-cols-2 gap-4\">\n              <div className=\"space-y-2\">\n                <Label>Press├úo Arterial</Label>\n                <Input\n                  placeholder=\"120/80 mmHg\"\n                  value={formData.pressao_arterial}\n                  onChange={(e) => handleInputChange('pressao_arterial', e.target.value)}\n                />\n              </div>\n              <div className=\"space-y-2\">\n                <Label>Frequ├¬ncia Card├¡aca</Label>\n                <Input\n                  type=\"number\"\n                  placeholder=\"75 bpm\"\n                  value={formData.frequencia_cardiaca}\n                  onChange={(e) => handleInputChange('frequencia_cardiaca', e.target.value)}\n                />\n              </div>\n              <div className=\"space-y-2\">\n                <Label>Temperatura (┬░C)</Label>\n                <Input\n                  type=\"number\"\n                  step=\"0.1\"\n                  placeholder=\"36.5\"\n                  value={formData.temperatura}\n                  onChange={(e) => handleInputChange('temperatura', e.target.value)}\n                />\n              </div>\n              <div className=\"space-y-2\">\n                <Label>Peso (kg)</Label>\n                <Input\n                  type=\"number\"\n                  step=\"0.1\"\n                  placeholder=\"70.5\"\n                  value={formData.peso}\n                  onChange={(e) => handleInputChange('peso', e.target.value)}\n                />\n              </div>\n              <div className=\"space-y-2\">\n                <Label>Altura (m)</Label>\n                <Input\n                  type=\"number\"\n                  step=\"0.01\"\n                  placeholder=\"1.75\"\n                  value={formData.altura}\n                  onChange={(e) => handleInputChange('altura', e.target.value)}\n                />\n              </div>\n              <div className=\"space-y-2\">\n                <Label>IMC</Label>\n                <Input\n                  value={calculateIMC() || '-'}\n                  disabled\n                  className=\"bg-muted\"\n                />\n              </div>\n            </div>\n          </TabsContent>\n\n          <TabsContent value=\"diagnostico\" className=\"space-y-4\">\n            <div className=\"space-y-2\">\n              <Label>CID-10 Principal</Label>\n              <Input\n                placeholder=\"Ex: A09 - Diarreia e gastroenterite\"\n                value={formData.cid10_principal}\n                onChange={(e) => handleInputChange('cid10_principal', e.target.value)}\n              />\n            </div>\n          </TabsContent>\n\n          <TabsContent value=\"prescricoes\" className=\"space-y-4\">\n            <div className=\"space-y-2\">\n              <Label>Prescri├º├Áes</Label>\n              <Textarea\n                placeholder=\"Medicamentos prescritos, dosagem, frequ├¬ncia, dura├º├úo...\"\n                value={formData.prescricoes}\n                onChange={(e) => handleInputChange('prescricoes', e.target.value)}\n                rows={4}\n              />\n            </div>\n            <div className=\"space-y-2\">\n              <Label>Procedimentos Realizados</Label>\n              <Textarea\n                placeholder=\"Procedimentos realizados durante a consulta...\"\n                value={formData.procedimentos}\n                onChange={(e) => handleInputChange('procedimentos', e.target.value)}\n                rows={3}\n              />\n            </div>\n            <div className=\"space-y-2\">\n              <Label>Exames Solicitados</Label>\n              <Textarea\n                placeholder=\"Exames complementares solicitados...\"\n                value={formData.exames_solicitados}\n                onChange={(e) => handleInputChange('exames_solicitados', e.target.value)}\n                rows={3}\n              />\n            </div>\n          </TabsContent>\n        </Tabs>\n\n        <div className=\"flex gap-2 mt-6\">\n          <Button\n            onClick={() => handleSave('rascunho')}\n            variant=\"outline\"\n            disabled={loading}\n          >\n            <Save className=\"h-4 w-4 mr-2\" />\n            Salvar Rascunho\n          </Button>\n          <Button\n            onClick={() => handleSave('finalizado')}\n            disabled={loading}\n          >\n            <FileSignature className=\"h-4 w-4 mr-2\" />\n            Finalizar Prontu├írio\n          </Button>\n          </div>\n        </CardContent>\n      </Card>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\prontuario\\RegistroMedico.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchDados'. Either include it or remove the dependency array.","line":43,"column":6,"nodeType":"ArrayExpression","endLine":43,"endColumn":32,"suggestions":[{"desc":"Update the dependencies array to be: [prontuarioId, pacienteId, fetchDados]","fix":{"range":[1543,1569],"text":"[prontuarioId, pacienteId, fetchDados]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { Ruler, Weight, TrendingUp, Plus, Pencil, Trash2 } from \"lucide-react\";\nimport { format } from \"date-fns\";\nimport { ptBR } from \"date-fns/locale\";\n\ninterface RegistroMedicoProps {\n  prontuarioId: string;\n  pacienteId: string;\n  readOnly?: boolean;\n}\n\ninterface RegistroPeso {\n  id: string;\n  peso_kg: number;\n  imc: number | null;\n  data_registro: string;\n  observacoes: string | null;\n}\n\nexport function RegistroMedico({ prontuarioId, pacienteId, readOnly = false }: RegistroMedicoProps) {\n  const [altura, setAltura] = useState<number | null>(null);\n  const [editandoAltura, setEditandoAltura] = useState(false);\n  const [novaAltura, setNovaAltura] = useState(\"\");\n  \n  const [registrosPeso, setRegistrosPeso] = useState<RegistroPeso[]>([]);\n  const [adicionandoPeso, setAdicionandoPeso] = useState(false);\n  const [novoPeso, setNovoPeso] = useState(\"\");\n  const [observacaoPeso, setObservacaoPeso] = useState(\"\");\n  \n  const [loading, setLoading] = useState(true);\n  const { toast } = useToast();\n\n  useEffect(() => {\n    fetchDados();\n  }, [prontuarioId, pacienteId]);\n\n  const fetchDados = async () => {\n    try {\n      setLoading(true);\n      \n      // Buscar altura do prontu├írio\n      const { data: prontuario, error: errorProntuario } = await (supabase as any)\n        .from('prontuarios')\n        .select('altura_cm')\n        .eq('id', prontuarioId)\n        .maybeSingle();\n\n      if (errorProntuario) throw errorProntuario;\n      if (prontuario) {\n        setAltura(prontuario.altura_cm);\n      }\n\n      // Buscar hist├│rico de peso\n      const { data: historico, error: errorHistorico } = await (supabase as any)\n        .from('historico_peso')\n        .select('*')\n        .eq('paciente_id', pacienteId)\n        .order('data_registro', { ascending: false });\n\n      if (errorHistorico) throw errorHistorico;\n      setRegistrosPeso(historico || []);\n    } catch (error: any) {\n      console.error('Erro ao buscar dados m├®dicos:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os dados m├®dicos.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSalvarAltura = async () => {\n    if (!novaAltura || isNaN(parseFloat(novaAltura))) {\n      toast({\n        title: \"Erro\",\n        description: \"Digite uma altura v├ílida.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    try {\n      const { error } = await (supabase as any)\n        .from('prontuarios')\n        .update({ altura_cm: parseFloat(novaAltura) })\n        .eq('id', prontuarioId);\n\n      if (error) throw error;\n\n      setAltura(parseFloat(novaAltura));\n      setEditandoAltura(false);\n      setNovaAltura(\"\");\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Altura atualizada.\"\n      });\n\n      // Recalcular IMC dos registros de peso existentes\n      fetchDados();\n    } catch (error: any) {\n      console.error('Erro ao salvar altura:', error);\n      toast({\n        title: \"Erro\",\n        description: error.message || \"N├úo foi poss├¡vel salvar a altura.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const handleAdicionarPeso = async () => {\n    if (!novoPeso || isNaN(parseFloat(novoPeso))) {\n      toast({\n        title: \"Erro\",\n        description: \"Digite um peso v├ílido.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) throw new Error(\"Usu├írio n├úo autenticado\");\n\n      const { data: profile } = await supabase\n        .from('profiles')\n        .select('tenant_id')\n        .eq('id', user.id)\n        .maybeSingle();\n\n      if (!profile?.tenant_id) throw new Error(\"Tenant n├úo encontrado\");\n\n      const { error } = await (supabase as any)\n        .from('historico_peso')\n        .insert({\n          tenant_id: profile.tenant_id,\n          paciente_id: pacienteId,\n          profissional_id: user.id,\n          prontuario_id: prontuarioId,\n          peso_kg: parseFloat(novoPeso),\n          observacoes: observacaoPeso || null\n        });\n\n      if (error) throw error;\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Registro de peso adicionado.\"\n      });\n\n      setNovoPeso(\"\");\n      setObservacaoPeso(\"\");\n      setAdicionandoPeso(false);\n      fetchDados();\n    } catch (error: any) {\n      console.error('Erro ao adicionar peso:', error);\n      toast({\n        title: \"Erro\",\n        description: error.message || \"N├úo foi poss├¡vel adicionar o registro de peso.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const handleExcluirPeso = async (id: string) => {\n    if (!confirm(\"Deseja excluir este registro de peso?\")) return;\n\n    try {\n      const { error } = await (supabase as any)\n        .from('historico_peso')\n        .delete()\n        .eq('id', id);\n\n      if (error) throw error;\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Registro exclu├¡do.\"\n      });\n\n      fetchDados();\n    } catch (error: any) {\n      console.error('Erro ao excluir:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel excluir o registro.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const classificarIMC = (imc: number | null) => {\n    if (!imc) return { texto: \"N/A\", cor: \"secondary\" };\n    if (imc < 18.5) return { texto: \"Abaixo do peso\", cor: \"destructive\" };\n    if (imc < 25) return { texto: \"Peso normal\", cor: \"default\" };\n    if (imc < 30) return { texto: \"Sobrepeso\", cor: \"secondary\" };\n    return { texto: \"Obesidade\", cor: \"destructive\" };\n  };\n\n  if (loading) {\n    return <div className=\"text-center py-4\">Carregando dados m├®dicos...</div>;\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Altura */}\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"flex items-center gap-2\">\n            <Ruler className=\"h-5 w-5\" />\n            Altura\n          </CardTitle>\n          <CardDescription>Registro ├║nico da altura do paciente</CardDescription>\n        </CardHeader>\n        <CardContent>\n          {editandoAltura ? (\n            <div className=\"space-y-3\">\n              <div className=\"flex gap-2\">\n                <Input\n                  type=\"number\"\n                  step=\"0.01\"\n                  value={novaAltura}\n                  onChange={(e) => setNovaAltura(e.target.value)}\n                  placeholder=\"Ex: 175.5\"\n                  className=\"max-w-xs\"\n                />\n                <span className=\"flex items-center\">cm</span>\n              </div>\n              <div className=\"flex gap-2\">\n                <Button onClick={handleSalvarAltura} size=\"sm\">\n                  Salvar\n                </Button>\n                <Button \n                  onClick={() => {\n                    setEditandoAltura(false);\n                    setNovaAltura(\"\");\n                  }} \n                  variant=\"outline\" \n                  size=\"sm\"\n                >\n                  Cancelar\n                </Button>\n              </div>\n            </div>\n          ) : (\n            <div className=\"flex items-center justify-between\">\n              <div>\n                {altura ? (\n                  <p className=\"text-2xl font-bold\">{altura} cm</p>\n                ) : (\n                  <p className=\"text-muted-foreground\">N├úo cadastrada</p>\n                )}\n              </div>\n              {!readOnly && (\n                <Button \n                  onClick={() => {\n                    setEditandoAltura(true);\n                    setNovaAltura(altura?.toString() || \"\");\n                  }} \n                  variant=\"outline\" \n                  size=\"sm\"\n                >\n                  <Pencil className=\"h-4 w-4 mr-2\" />\n                  {altura ? \"Editar\" : \"Cadastrar\"}\n                </Button>\n              )}\n            </div>\n          )}\n        </CardContent>\n      </Card>\n\n      {/* Peso */}\n      <Card>\n        <CardHeader>\n          <div className=\"flex items-center justify-between\">\n            <div>\n              <CardTitle className=\"flex items-center gap-2\">\n                <Weight className=\"h-5 w-5\" />\n                Hist├│rico de Peso\n              </CardTitle>\n              <CardDescription>Registros de peso ao longo do tempo</CardDescription>\n            </div>\n            {!readOnly && !adicionandoPeso && (\n              <Button onClick={() => setAdicionandoPeso(true)} size=\"sm\">\n                <Plus className=\"h-4 w-4 mr-2\" />\n                Novo Registro\n              </Button>\n            )}\n          </div>\n        </CardHeader>\n        <CardContent className=\"space-y-4\">\n          {adicionandoPeso && (\n            <div className=\"space-y-3 p-4 border rounded-lg bg-muted/50\">\n              <div className=\"space-y-2\">\n                <Label>Peso (kg)</Label>\n                <Input\n                  type=\"number\"\n                  step=\"0.1\"\n                  value={novoPeso}\n                  onChange={(e) => setNovoPeso(e.target.value)}\n                  placeholder=\"Ex: 75.5\"\n                  className=\"max-w-xs\"\n                />\n              </div>\n              <div className=\"space-y-2\">\n                <Label>Observa├º├Áes (opcional)</Label>\n                <Textarea\n                  value={observacaoPeso}\n                  onChange={(e) => setObservacaoPeso(e.target.value)}\n                  placeholder=\"Observa├º├Áes sobre a medi├º├úo\"\n                  rows={2}\n                />\n              </div>\n              <div className=\"flex gap-2\">\n                <Button onClick={handleAdicionarPeso} size=\"sm\">\n                  Adicionar\n                </Button>\n                <Button \n                  onClick={() => {\n                    setAdicionandoPeso(false);\n                    setNovoPeso(\"\");\n                    setObservacaoPeso(\"\");\n                  }} \n                  variant=\"outline\" \n                  size=\"sm\"\n                >\n                  Cancelar\n                </Button>\n              </div>\n            </div>\n          )}\n\n          {registrosPeso.length === 0 ? (\n            <p className=\"text-center text-muted-foreground py-4\">\n              Nenhum registro de peso cadastrado\n            </p>\n          ) : (\n            <div className=\"space-y-3\">\n              {registrosPeso.map((registro) => {\n                const classificacao = classificarIMC(registro.imc);\n                return (\n                  <div \n                    key={registro.id} \n                    className=\"flex items-start justify-between p-3 border rounded-lg\"\n                  >\n                    <div className=\"space-y-1 flex-1\">\n                      <div className=\"flex items-center gap-3\">\n                        <p className=\"text-lg font-semibold\">{registro.peso_kg} kg</p>\n                        {registro.imc && (\n                          <div className=\"flex items-center gap-2\">\n                            <Badge variant={classificacao.cor as any}>\n                              IMC: {registro.imc.toFixed(1)}\n                            </Badge>\n                            <span className=\"text-sm text-muted-foreground\">\n                              {classificacao.texto}\n                            </span>\n                          </div>\n                        )}\n                      </div>\n                      <p className=\"text-sm text-muted-foreground\">\n                        {format(new Date(registro.data_registro), \"dd 'de' MMMM 'de' yyyy '├ás' HH:mm\", { locale: ptBR })}\n                      </p>\n                      {registro.observacoes && (\n                        <p className=\"text-sm mt-2\">{registro.observacoes}</p>\n                      )}\n                    </div>\n                    {!readOnly && (\n                      <Button\n                        variant=\"ghost\"\n                        size=\"sm\"\n                        onClick={() => handleExcluirPeso(registro.id)}\n                      >\n                        <Trash2 className=\"h-4 w-4\" />\n                      </Button>\n                    )}\n                  </div>\n                );\n              })}\n            </div>\n          )}\n        </CardContent>\n      </Card>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\DeleteProfessionalDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\DigitalClock.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\DragSchedule.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\EditAppointmentDialog.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'fetchAppointmentData' and 'fetchData'. Either include them or remove the dependency array.","line":90,"column":6,"nodeType":"ArrayExpression","endLine":90,"endColumn":27,"suggestions":[{"desc":"Update the dependencies array to be: [open, appointmentId, fetchData, fetchAppointmentData]","fix":{"range":[3162,3183],"text":"[open, appointmentId, fetchData, fetchAppointmentData]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger, DialogDescription } from \"@/components/ui/dialog\";\nimport { Button } from \"@/components/ui/button\";\nimport { Label } from \"@/components/ui/label\";\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\nimport { Input } from \"@/components/ui/input\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Calendar } from \"@/components/ui/calendar\";\nimport { Popover, PopoverContent, PopoverTrigger } from \"@/components/ui/popover\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { format, parse } from \"date-fns\";\nimport { ptBR } from \"date-fns/locale\";\nimport { CalendarIcon, Loader2 } from \"lucide-react\";\nimport { cn } from \"@/lib/utils\";\nimport { PatientCombobox } from \"./PatientCombobox\";\nimport { ProfessionalCombobox } from \"./ProfessionalCombobox\";\nimport { PackageUsageNotification } from \"@/components/pacotes/PackageUsageNotification\";\n\ninterface EditAppointmentDialogProps {\n  children: React.ReactNode;\n  appointmentId: string;\n  onSuccess?: () => void;\n}\n\nexport function EditAppointmentDialog({ children, appointmentId, onSuccess }: EditAppointmentDialogProps) {\n  const [open, setOpen] = useState(false);\n\n  // Abrir automaticamente quando houver appointmentId\n  useEffect(() => {\n    if (appointmentId) {\n      setOpen(true);\n    }\n  }, [appointmentId]);\n\n  const [isLoading, setIsLoading] = useState(false);\n  const [isFetchingData, setIsFetchingData] = useState(true);\n  const [packageUsageNotification, setPackageUsageNotification] = useState<any>(null);\n  const [showPackageNotification, setShowPackageNotification] = useState(false);\n\n  const [pacientes, setPacientes] = useState<any[]>([]);\n  const [profissionais, setProfissionais] = useState<any[]>([]);\n  const [servicos, setServicos] = useState<any[]>([]);\n  const [pacientesPacotes, setPacientesPacotes] = useState<any[]>([]);\n\n  const [formData, setFormData] = useState<{\n    paciente_id: string;\n    profissional_id: string;\n    servico_id: string;\n    paciente_pacote_id: string;\n    data: Date;\n    hora_inicio: string;\n    sala: string;\n    notas: string;\n    status: any;\n    tipo_atendimento: string;\n    plano_saude_id: string;\n    valor_consulta: string;\n    forma_pagamento_id: string;\n    conta_pix_id: string;\n  }>({\n    paciente_id: \"\",\n    profissional_id: \"\",\n    servico_id: \"\",\n    paciente_pacote_id: \"\",\n    data: new Date(),\n    hora_inicio: \"\",\n    sala: \"\",\n    notas: \"\",\n    status: \"agendado\",\n    tipo_atendimento: \"particular\",\n    plano_saude_id: \"\",\n    valor_consulta: \"\",\n    forma_pagamento_id: \"\",\n    conta_pix_id: \"\"\n  });\n\n  const [planosSaude, setPlanosSaude] = useState<any[]>([]);\n  const [formasPagamento, setFormasPagamento] = useState<any[]>([]);\n  const [contasPix, setContasPix] = useState<any[]>([]);\n  const [canEditValues, setCanEditValues] = useState(false);\n\n  const { toast } = useToast();\n\n  useEffect(() => {\n    if (open) {\n      fetchData();\n      fetchAppointmentData();\n    }\n  }, [open, appointmentId]);\n\n  const fetchAppointmentData = async () => {\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) throw new Error(\"Usu├írio n├úo autenticado\");\n\n      // Verificar permiss├úo para alterar valores\n      const { data: profileData } = await supabase\n        .from('profiles')\n        .select('pode_alterar_valores, role')\n        .eq('id', user.id)\n        .single();\n\n      setCanEditValues(profileData?.pode_alterar_valores === true || profileData?.role === 'admin');\n\n      const { data, error } = await supabase\n        .from('agenda')\n        .select('*')\n        .eq('id', appointmentId)\n        .single();\n\n      if (error) throw error;\n\n      const inicioDate = new Date(data.inicio);\n\n      setFormData({\n        paciente_id: data.paciente_id,\n        profissional_id: data.profissional_id || \"\",\n        servico_id: data.servico_id,\n        paciente_pacote_id: data.paciente_pacote_id || \"\",\n        data: inicioDate,\n        hora_inicio: format(inicioDate, 'HH:mm'),\n        sala: data.sala || \"\",\n        notas: data.notas || \"\",\n        status: data.status || \"agendado\",\n        tipo_atendimento: data.tipo_atendimento || \"particular\",\n        plano_saude_id: data.plano_saude_id || \"\",\n        valor_consulta: data.valor_consulta?.toString() || \"\",\n        forma_pagamento_id: data.forma_pagamento_id || \"\",\n        conta_pix_id: data.conta_pix_id || \"\"\n      });\n\n      // Buscar pacotes do paciente\n      if (data.paciente_id) {\n        fetchPacotesPaciente(data.paciente_id);\n      }\n    } catch (error) {\n      console.error('Erro ao buscar dados do agendamento:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os dados do agendamento.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const fetchData = async () => {\n    try {\n      setIsFetchingData(true);\n\n      const { data: { user } } = await supabase.auth.getUser();\n      if (!user) throw new Error(\"Usu├írio n├úo autenticado\");\n\n      const { data: profileData } = await supabase\n        .from('profiles')\n        .select('tenant_id')\n        .eq('id', user.id)\n        .single();\n\n      if (!profileData) throw new Error(\"Perfil n├úo encontrado\");\n\n      const [pacientesRes, profissionaisRes, servicosRes, planosSaudeRes, formasPagamentoRes, contasPixRes] = await Promise.all([\n        supabase.from('pacientes').select('id, nome, telefone').eq('tenant_id', profileData.tenant_id).order('nome'),\n        supabase.from('profiles').select('id, nome, role').eq('tenant_id', profileData.tenant_id).order('nome'),\n        supabase.from('servicos').select('id, nome, duracao_minutos, preco').eq('tenant_id', profileData.tenant_id).eq('ativo', true).order('nome'),\n        supabase.from('planos_saude').select('id, nome').eq('tenant_id', profileData.tenant_id).eq('ativo', true).order('nome'),\n        supabase.from('formas_pagamento').select('id, nome, tipo').eq('tenant_id', profileData.tenant_id).eq('ativo', true).order('ordem'),\n        supabase.from('contas_pix').select('id, nome, chave_pix').eq('tenant_id', profileData.tenant_id).eq('ativo', true).order('nome')\n      ]);\n\n      if (pacientesRes.error) throw pacientesRes.error;\n      if (profissionaisRes.error) throw profissionaisRes.error;\n      if (servicosRes.error) throw servicosRes.error;\n\n      const profissionaisFiltrados = (profissionaisRes.data || []).filter(\n        prof => prof.role === 'profissional' || prof.role === 'admin' || prof.role === 'admin_tenant'\n      );\n\n      setPacientes(pacientesRes.data || []);\n      setProfissionais(profissionaisFiltrados);\n      setServicos(servicosRes.data || []);\n      setPlanosSaude(planosSaudeRes.data || []);\n      setFormasPagamento(formasPagamentoRes.data || []);\n      setContasPix(contasPixRes.data || []);\n    } catch (error) {\n      console.error('Erro ao buscar dados:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os dados necess├írios.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsFetchingData(false);\n    }\n  };\n\n  const fetchPacotesPaciente = async (pacienteId: string) => {\n    if (!pacienteId) {\n      setPacientesPacotes([]);\n      return;\n    }\n\n    try {\n      const { data, error } = await supabase\n        .from('pacientes_pacotes')\n        .select('*, pacotes(nome)')\n        .eq('paciente_id', pacienteId)\n        .eq('status', 'ativo')\n        .gt('sessoes_restantes', 0);\n\n      if (error) throw error;\n      setPacientesPacotes(data || []);\n    } catch (error) {\n      console.error('Erro ao buscar pacotes do paciente:', error);\n      setPacientesPacotes([]);\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.paciente_id || !formData.profissional_id || !formData.servico_id || !formData.hora_inicio) {\n      toast({\n        title: \"Campos obrigat├│rios\",\n        description: \"Por favor, preencha todos os campos obrigat├│rios.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    try {\n      setIsLoading(true);\n\n      const servico = servicos.find(s => s.id === formData.servico_id);\n      if (!servico) throw new Error(\"Servi├ºo n├úo encontrado\");\n\n      const [hours, minutes] = formData.hora_inicio.split(':');\n      const inicio = new Date(formData.data);\n      inicio.setHours(parseInt(hours), parseInt(minutes), 0, 0);\n\n      // Validar se o hor├írio ├® futuro\n      const now = new Date();\n      if (inicio < now) {\n        toast({\n          title: \"Hor├írio inv├ílido\",\n          description: \"N├úo ├® poss├¡vel agendar para um hor├írio que j├í passou.\",\n          variant: \"destructive\"\n        });\n        return;\n      }\n\n      const fim = new Date(inicio);\n      fim.setMinutes(inicio.getMinutes() + servico.duracao_minutos);\n\n      const updateData: any = {\n        paciente_id: formData.paciente_id,\n        profissional_id: formData.profissional_id,\n        servico_id: formData.servico_id,\n        paciente_pacote_id: formData.paciente_pacote_id || null,\n        inicio: inicio.toISOString(),\n        fim: fim.toISOString(),\n        sala: formData.sala || null,\n        notas: formData.notas || null,\n        status: formData.status,\n        updated_at: new Date().toISOString()\n      };\n\n      // S├│ permitir altera├º├úo de valores financeiros se o usu├írio tiver permiss├úo\n      if (canEditValues) {\n        updateData.tipo_atendimento = formData.tipo_atendimento;\n        updateData.plano_saude_id = formData.tipo_atendimento === 'plano' ? formData.plano_saude_id || null : null;\n        updateData.valor_consulta = formData.valor_consulta ? parseFloat(formData.valor_consulta) : null;\n        updateData.forma_pagamento_id = formData.tipo_atendimento === 'particular' ? formData.forma_pagamento_id || null : null;\n        updateData.conta_pix_id = formData.conta_pix_id || null;\n      }\n\n      const { error } = await supabase\n        .from('agenda')\n        .update(updateData)\n        .eq('id', appointmentId);\n\n      if (error) throw error;\n\n      // Se status mudou para \"realizado\" e h├í um pacote vinculado, processar uso\n      if (formData.status === 'realizado' && formData.paciente_pacote_id) {\n        const { data: usageData, error: usageError } = await supabase\n          .rpc('usar_sessao_pacote', {\n            p_paciente_pacote_id: formData.paciente_pacote_id,\n            p_agendamento_id: appointmentId\n          });\n\n        if (usageError) {\n          console.error('Erro ao usar sess├úo do pacote:', usageError);\n          toast({\n            title: \"Aviso\",\n            description: \"Consulta atualizada, mas houve erro ao processar o pacote.\",\n            variant: \"destructive\"\n          });\n        } else if (usageData && typeof usageData === 'object' && 'success' in usageData && usageData.success) {\n          setPackageUsageNotification(usageData);\n          setShowPackageNotification(true);\n        }\n      }\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Consulta atualizada com sucesso.\"\n      });\n\n      setOpen(false);\n      setTimeout(() => {\n        if (onSuccess) onSuccess();\n      }, 150);\n    } catch (error) {\n      console.error('Erro ao atualizar consulta:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel atualizar a consulta.\",\n        variant: \"destructive\"\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={(isOpen) => {\n      setOpen(isOpen);\n      if (!isOpen && onSuccess) {\n        onSuccess();\n      }\n    }}>\n      <DialogTrigger asChild>\n        {children}\n      </DialogTrigger>\n      <DialogContent className=\"max-w-4xl max-h-[95vh] overflow-hidden flex flex-col\">\n        <DialogHeader className=\"flex-shrink-0\">\n          <DialogTitle className=\"text-xl\">Editar Consulta</DialogTitle>\n          <DialogDescription className=\"text-sm\">Altere os dados da consulta agendada.</DialogDescription>\n        </DialogHeader>\n\n        {isFetchingData ? (\n          <div className=\"flex items-center justify-center py-8\">\n            <Loader2 className=\"h-8 w-8 animate-spin text-primary\" />\n          </div>\n        ) : (\n          <form onSubmit={handleSubmit} className=\"space-y-4 flex-1 overflow-y-auto\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n              <div className=\"space-y-2\">\n                <Label htmlFor=\"paciente\">Paciente *</Label>\n                <PatientCombobox\n                  value={formData.paciente_id}\n                  onValueChange={(value) => {\n                    setFormData({ ...formData, paciente_id: value, paciente_pacote_id: \"\" });\n                    fetchPacotesPaciente(value);\n                  }}\n                  patients={pacientes}\n                />\n              </div>\n\n              <div className=\"space-y-2\">\n                <Label htmlFor=\"profissional\">Profissional *</Label>\n                <ProfessionalCombobox\n                  value={formData.profissional_id}\n                  onValueChange={(value) => setFormData({ ...formData, profissional_id: value })}\n                  professionals={profissionais}\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n              <div className=\"space-y-1.5\">\n                <Label htmlFor=\"servico\">Procedimento *</Label>\n                <Select\n                  value={formData.servico_id}\n                  onValueChange={(value) => setFormData({ ...formData, servico_id: value })}\n                >\n                  <SelectTrigger id=\"servico\">\n                    <SelectValue placeholder=\"Selecione o procedimento\" />\n                  </SelectTrigger>\n                  <SelectContent className=\"bg-background z-50\">\n                    {servicos.map((servico) => (\n                      <SelectItem key={servico.id} value={servico.id}>\n                        {servico.nome} - {servico.duracao_minutos}min\n                        {servico.preco && ` - R$ ${servico.preco}`}\n                      </SelectItem>\n                    ))}\n                  </SelectContent>\n                </Select>\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <Label htmlFor=\"status\">Status *</Label>\n                <Select\n                  value={formData.status}\n                  onValueChange={(value) => setFormData({ ...formData, status: value as any })}\n                >\n                  <SelectTrigger id=\"status\">\n                    <SelectValue placeholder=\"Selecione o status\" />\n                  </SelectTrigger>\n                  <SelectContent className=\"bg-background z-50\">\n                    <SelectItem value=\"agendado\">Agendado</SelectItem>\n                    <SelectItem value=\"confirmado\">Confirmado</SelectItem>\n                    <SelectItem value=\"em_andamento\">Em Andamento</SelectItem>\n                    <SelectItem value=\"concluido\">Conclu├¡do</SelectItem>\n                    <SelectItem value=\"cancelado\">Cancelado</SelectItem>\n                    <SelectItem value=\"faltou\">Faltou</SelectItem>\n                  </SelectContent>\n                </Select>\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n              <div className=\"space-y-1.5\">\n                <Label>Data *</Label>\n                <Popover>\n                  <PopoverTrigger asChild>\n                    <Button\n                      variant=\"outline\"\n                      className={cn(\n                        \"w-full justify-start text-left font-normal\",\n                        !formData.data && \"text-muted-foreground\"\n                      )}\n                    >\n                      <CalendarIcon className=\"mr-2 h-4 w-4 flex-shrink-0\" />\n                      <span className=\"truncate\">\n                        {formData.data ? format(formData.data, \"dd/MM/yyyy\") : \"Selecione a data\"}\n                      </span>\n                    </Button>\n                  </PopoverTrigger>\n                  <PopoverContent className=\"w-auto p-0 bg-background z-50\" align=\"start\">\n                    <Calendar\n                      mode=\"single\"\n                      selected={formData.data}\n                      onSelect={(date) => date && setFormData({ ...formData, data: date })}\n                      initialFocus\n                      locale={ptBR}\n                      disabled={(date) => date < new Date(new Date().setHours(0, 0, 0, 0))}\n                      className={cn(\"p-3 pointer-events-auto\")}\n                    />\n                  </PopoverContent>\n                </Popover>\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <Label htmlFor=\"hora_inicio\">Hor├írio *</Label>\n                <Input\n                  id=\"hora_inicio\"\n                  type=\"time\"\n                  value={formData.hora_inicio}\n                  onChange={(e) => setFormData({ ...formData, hora_inicio: e.target.value })}\n                  className=\"w-full\"\n                />\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <Label htmlFor=\"sala\">Sala/Consult├│rio</Label>\n                <Input\n                  id=\"sala\"\n                  value={formData.sala}\n                  onChange={(e) => setFormData({ ...formData, sala: e.target.value })}\n                  placeholder=\"Ex: Consult├│rio 1\"\n                  className=\"w-full\"\n                />\n              </div>\n            </div>\n\n            {canEditValues && (\n              <>\n                <div className=\"space-y-1.5\">\n                  <Label>Tipo de Atendimento</Label>\n                  <Select\n                    value={formData.tipo_atendimento}\n                    onValueChange={(value) => setFormData({ ...formData, tipo_atendimento: value, plano_saude_id: \"\", forma_pagamento_id: \"\", conta_pix_id: \"\" })}\n                  >\n                    <SelectTrigger>\n                      <SelectValue />\n                    </SelectTrigger>\n                    <SelectContent className=\"bg-background z-50\">\n                      <SelectItem value=\"particular\">Particular</SelectItem>\n                      <SelectItem value=\"plano\">Plano de Sa├║de</SelectItem>\n                    </SelectContent>\n                  </Select>\n                </div>\n\n                {formData.tipo_atendimento === 'plano' && (\n                  <div className=\"space-y-1.5\">\n                    <Label>Plano de Sa├║de</Label>\n                    <Select\n                      value={formData.plano_saude_id}\n                      onValueChange={(value) => setFormData({ ...formData, plano_saude_id: value })}\n                    >\n                      <SelectTrigger>\n                        <SelectValue placeholder=\"Selecione o plano\" />\n                      </SelectTrigger>\n                      <SelectContent className=\"bg-background z-50\">\n                        {planosSaude.map((plano) => (\n                          <SelectItem key={plano.id} value={plano.id}>\n                            {plano.nome}\n                          </SelectItem>\n                        ))}\n                      </SelectContent>\n                    </Select>\n                  </div>\n                )}\n\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n                  <div className=\"space-y-1.5\">\n                    <Label>Valor da Consulta</Label>\n                    <Input\n                      type=\"number\"\n                      step=\"0.01\"\n                      value={formData.valor_consulta}\n                      onChange={(e) => setFormData({ ...formData, valor_consulta: e.target.value })}\n                      placeholder=\"R$ 0,00\"\n                    />\n                  </div>\n\n                  {formData.tipo_atendimento === 'particular' && (\n                    <div className=\"space-y-1.5\">\n                      <Label>Forma de Pagamento</Label>\n                      <Select\n                        value={formData.forma_pagamento_id}\n                        onValueChange={(value) => {\n                          setFormData({ ...formData, forma_pagamento_id: value });\n                          const forma = formasPagamento.find(f => f.id === value);\n                          if (forma?.tipo !== 'pix') {\n                            setFormData(prev => ({ ...prev, conta_pix_id: \"\" }));\n                          }\n                        }}\n                      >\n                        <SelectTrigger>\n                          <SelectValue placeholder=\"Selecione\" />\n                        </SelectTrigger>\n                        <SelectContent className=\"bg-background z-50\">\n                          {formasPagamento.map((forma) => (\n                            <SelectItem key={forma.id} value={forma.id}>\n                              {forma.nome}\n                            </SelectItem>\n                          ))}\n                        </SelectContent>\n                      </Select>\n                    </div>\n                  )}\n                </div>\n\n                {formData.tipo_atendimento === 'particular' &&\n                  formasPagamento.find(f => f.id === formData.forma_pagamento_id)?.tipo === 'pix' && (\n                    <div className=\"space-y-1.5\">\n                      <Label>Conta PIX</Label>\n                      <Select\n                        value={formData.conta_pix_id}\n                        onValueChange={(value) => setFormData({ ...formData, conta_pix_id: value })}\n                      >\n                        <SelectTrigger>\n                          <SelectValue placeholder=\"Selecione a conta PIX\" />\n                        </SelectTrigger>\n                        <SelectContent className=\"bg-background z-50\">\n                          {contasPix.map((conta) => (\n                            <SelectItem key={conta.id} value={conta.id}>\n                              {conta.nome} - {conta.chave_pix}\n                            </SelectItem>\n                          ))}\n                        </SelectContent>\n                      </Select>\n                    </div>\n                  )}\n              </>\n            )}\n\n            <div className=\"space-y-1.5\">\n              <Label htmlFor=\"notas\">Observa├º├Áes</Label>\n              <Textarea\n                id=\"notas\"\n                value={formData.notas}\n                onChange={(e) => setFormData({ ...formData, notas: e.target.value })}\n                placeholder=\"Notas adicionais sobre a consulta...\"\n                rows={2}\n                className=\"resize-none\"\n              />\n            </div>\n\n            <div className=\"flex justify-end gap-3 pt-2 flex-shrink-0 border-t mt-4\">\n              <Button\n                type=\"button\"\n                variant=\"outline\"\n                onClick={() => setOpen(false)}\n                disabled={isLoading}\n              >\n                Cancelar\n              </Button>\n              <Button type=\"submit\" disabled={isLoading}>\n                {isLoading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n                Salvar Altera├º├Áes\n              </Button>\n            </div>\n          </form>\n        )}\n      </DialogContent>\n\n      {packageUsageNotification && (\n        <PackageUsageNotification\n          open={showPackageNotification}\n          onOpenChange={setShowPackageNotification}\n          packageName={packageUsageNotification.pacote_nome || \"\"}\n          currentSession={packageUsageNotification.sessao_atual || 0}\n          totalSessions={packageUsageNotification.sessoes_totais || 0}\n          remainingSessions={packageUsageNotification.sessoes_restantes || 0}\n          shouldOfferRenewal={packageUsageNotification.deve_oferecer_renovacao || false}\n          onRenewPackage={() => {\n            toast({\n              title: \"Renova├º├úo de Pacote\",\n              description: \"Funcionalidade de renova├º├úo ser├í implementada em breve.\"\n            });\n          }}\n        />\n      )}\n    </Dialog>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gugur\\CleanFlow\\src\\components\\schedule\\EditEspecialidadeDialog.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchEspecialidade'. Either include it or remove the dependency array.","line":37,"column":6,"nodeType":"ArrayExpression","endLine":37,"endColumn":29,"suggestions":[{"desc":"Update the dependencies array to be: [open, especialidadeId, fetchEspecialidade]","fix":{"range":[1080,1103],"text":"[open, especialidadeId, fetchEspecialidade]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription } from \"@/components/ui/dialog\";\nimport { Button } from \"@/components/ui/button\";\nimport { Label } from \"@/components/ui/label\";\nimport { Input } from \"@/components/ui/input\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport { Loader2 } from \"lucide-react\";\n\ninterface EditEspecialidadeDialogProps {\n  especialidadeId: string;\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  onSuccess?: () => void;\n}\n\nexport function EditEspecialidadeDialog({ \n  especialidadeId, \n  open, \n  onOpenChange, \n  onSuccess \n}: EditEspecialidadeDialogProps) {\n  const [isLoading, setIsLoading] = useState(false);\n  const [formData, setFormData] = useState({\n    nome: \"\",\n    codigo_cfm: \"\",\n    descricao: \"\"\n  });\n\n  const { toast } = useToast();\n\n  useEffect(() => {\n    if (open && especialidadeId) {\n      fetchEspecialidade();\n    }\n  }, [open, especialidadeId]);\n\n  const fetchEspecialidade = async () => {\n    try {\n      const { data, error } = await supabase\n        .from('especialidades')\n        .select('*')\n        .eq('id', especialidadeId)\n        .single();\n\n      if (error) throw error;\n\n      setFormData({\n        nome: data.nome || \"\",\n        codigo_cfm: data.codigo_cfm || \"\",\n        descricao: data.descricao || \"\"\n      });\n    } catch (error) {\n      console.error('Erro ao buscar especialidade:', error);\n      toast({\n        title: \"Erro\",\n        description: \"N├úo foi poss├¡vel carregar os dados da especialidade.\",\n        variant: \"destructive\"\n      });\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.nome) {\n      toast({\n        title: \"Campo obrigat├│rio\",\n        description: \"Nome da especialidade ├® obrigat├│rio.\",\n        variant: \"destructive\"\n      });\n      return;\n    }\n\n    try {\n      setIsLoading(true);\n\n      const { error } = await supabase\n        .from('especialidades')\n        .update({\n          nome: formData.nome.trim(),\n          codigo_cfm: formData.codigo_cfm.trim() || null,\n          descricao: formData.descricao.trim() || null,\n          updated_at: new Date().toISOString()\n        })\n        .eq('id', especialidadeId);\n\n      if (error) {\n        if (error.code === '23505') {\n          throw new Error(\"J├í existe uma especialidade com este nome\");\n        }\n        throw error;\n      }\n\n      toast({\n        title: \"Sucesso!\",\n        description: \"Especialidade atualizada com sucesso.\"\n      });\n\n      onOpenChange(false);\n\n      if (onSuccess) {\n        onSuccess()