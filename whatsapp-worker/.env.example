# WhatsApp worker (Node). Copie para `.env` nesta pasta, ou defina as variáveis no ambiente
# (o docker-compose.yml da raiz repassa estas variáveis ao container). Nunca versione o `.env`.
# Referência completa: docs/CONFIGURACAO_AMBIENTE.md

# URL do projeto Supabase
SUPABASE_URL=

# Chave service_role do Supabase. SECRETA: ignora o RLS, nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Chave AES-256-GCM que cifra as sessões do WhatsApp. Deve ter EXATAMENTE 32 caracteres.
# Trocar a chave invalida as sessões já salvas.
WA_MASTER_KEY=

# Nível de log (opcional, padrão: info). O logger lê esta variável antes de carregar
# whatsapp-worker/.env, então ela só tem efeito se vier do ambiente do processo ou do
# `.env` da raiz do repositório (no Docker, o compose repassa).
LOG_LEVEL=info
